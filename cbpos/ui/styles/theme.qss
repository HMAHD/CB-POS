/* 
    Ceylon Byte POS - Industrial Theme 
    Palette:
    - Background: #001F3F (Deep Navy)
    - Panel: #003366 (Lighter Navy)
    - Accent: #00BCEB (Cyan)
    - Success: #39FF14 (Neon Green)
    - Warning: #FFDC00 (Yellow)
    - Error: #FF4136 (Red)
    - Text: #FFFFFF (White)
*/

/* Global Font Enforcement - MUST come first */
* {
    font-family: "Noto Sans", "Iskoola Pota", "Segoe UI", sans-serif;
}

/* Global Reset */
QWidget {
    background-color: #001F3F;
    color: #FFFFFF;
    font-size: 14px;
}

/* Inputs */
QLineEdit {
    background-color: #003366;
    border: 1px solid #00509E;
    border-radius: 4px;
    padding: 8px;
    font-size: 16px;
    color: #FFFFFF;
}

QLineEdit:focus {
    border: 2px solid #00BCEB;
}

/* Buttons */
QPushButton {
    background-color: #003366;
    border: 1px solid #00509E;
    border-radius: 4px;
    padding: 10px;
    font-weight: bold;
    text-transform: uppercase;
}

QPushButton:hover {
    background-color: #004080;
    border: 1px solid #00BCEB;
}

QPushButton:pressed {
    background-color: #002855;
}

/* Primary Action Button (e.g., Pay) */
QPushButton[class="primary"] {
    background-color: #39FF14;
    color: #000000;
    border: none;
}

QPushButton[class="primary"]:hover {
    background-color: #32E010;
}

/* Danger Button (e.g., Void) */
QPushButton[class="danger"] {
    background-color: #FF4136;
    color: #FFFFFF;
    border: none;
}

/* Warning Button (e.g., Hold) */
QPushButton[class="warning"] {
    background-color: #FFDC00;
    color: #000000;
    border: none;
}

/* Tables */
QTableWidget {
    background-color: #001F3F;
    gridline-color: #003366;
    border: 1px solid #003366;
    selection-background-color: #39FF14;
    selection-color: #000000;
}

QHeaderView::section {
    background-color: #00BCEB;
    color: #000000;
    padding: 8px;
    font-weight: bold;
    border: none;
}

QTableCornerButton::section {
    background-color: #00BCEB;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #001F3F;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #00509E;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #003366;
    background-color: #001F3F;
}

QTabBar::tab {
    background: #003366;
    color: #FFFFFF;
    padding: 10px 20px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #00BCEB;
    color: #000000;
    font-weight: bold;
}

/* Group Box */
QGroupBox {
    border: 1px solid #00509E;
    border-radius: 4px;
    margin-top: 20px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #00BCEB;
}
