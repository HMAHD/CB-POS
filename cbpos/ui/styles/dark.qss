/* === SETTINGS PAGE SHARED STYLES === */

/* Warning hint text (restart required, tax warning) */
QLabel[class="warning-hint"] {
    color: {{DANGER}};
    font-size: 12px;
    background: transparent;
}

/* Positive counterpart of warning-hint (hardware test passed, #624) */
QLabel[class="success-hint"] {
    color: {{SUCCESS}};
    font-size: 12px;
    background: transparent;
}

/* Inline field validation error (e.g. Settings > Documents number format) */
QLabel[class="error"] {
    color: {{DANGER}};
    font-size: 12px;
    background: transparent;
}

/* Link-style text button */
QPushButton[class="link"] {
    background: transparent;
    color: {{ACCENT}};
    border: none;
    padding: 4px 12px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton[class="link"]:hover {
    color: {{ACCENT}};
}

/* Icon-only transparent button */
QPushButton#BtnInfoIcon {
    background: transparent;
    border: none;
}
QPushButton#BtnInfoIcon:hover {
    background: rgba(0, 188, 235, 0.15);
    border-radius: 14px;
}

/* Settings & Inventory scroll area transparency */
QScrollArea#SettingsScrollArea,
QScrollArea#InventoryScrollArea {
    background: transparent;
    border: none;
}
QWidget#SettingsScrollInner,
QWidget#InventoryScrollInner {
    background: transparent;
}
QWidget#SettingsScrollInner QCheckBox {
    margin-left: 4px;
}

/* Settings page section headers */
QLabel#SettingsSectionTitle {
    color: {{ACCENT}};
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 0.5px;
    background: transparent;
}
QFrame#SettingsSectionLine {
    background-color: {{BORDER}};
    max-height: 1px;
    min-height: 1px;
}

/* Receipt live preview */
QLabel#ReceiptPreviewTitle {
    color: {{TEXT_SECONDARY}};
    font-size: 11px;
    background: transparent;
    padding: 4px 0;
}
QTextBrowser#ReceiptPreviewBrowser {
    background-color: {{TEXT_SOFT}};
    color: {{ON_ACCENT}};
    border: 1px solid {{BORDER}};
    border-radius: 6px;
}

/* ── BackupRestoreDialog & ValuationDialog (theme-aware) ───────── */
QDialog#BackupRestoreDialog {
    background-color: {{ON_ACCENT}};
}
QDialog#BackupRestoreDialog QTabWidget::pane { border: none; background: {{ON_ACCENT}}; }
QDialog#BackupRestoreDialog QTabBar::tab {
    background: {{SELECTION}}; color: {{TEXT_SECONDARY}}; padding: 10px 22px;
    border-top-left-radius: 6px; border-top-right-radius: 6px;
    margin-right: 2px; font-size: 13px; border: none;
}
QDialog#BackupRestoreDialog QTabBar::tab:selected { background: {{SELECTION}}; color: {{ACCENT}}; font-weight: bold; }
QDialog#BackupRestoreDialog QTabBar::tab:hover { background: {{SELECTION}}; color: {{TEXT}}; }

QLabel#DialogTitle { color: {{ACCENT}}; font-size: 20px; font-weight: bold; margin-bottom: 8px; }
QLabel#DialogSubtitle { color: {{TEXT_SECONDARY}}; font-size: 12px; margin-bottom: 16px; }
QLabel#SectionTitle { font-size: 16px; font-weight: bold; color: white; margin-top: 20px; }

QLabel[class="value"] { color: {{TEXT_SOFT}}; font-size: 13px; font-weight: bold; }
QLabel[class="status-ok"] { color: {{SUCCESS}}; font-weight: bold; font-size: 13px; }
QLabel[class="status-err"] { color: {{DANGER}}; font-weight: bold; font-size: 13px; }
QLabel[class="card-value"] { color: white; font-size: 28px; font-weight: bold; }
QLabel[class="card-value-positive"] { color: {{SUCCESS}}; font-size: 28px; font-weight: bold; }
QLabel[class="card-value-negative"] { color: {{DANGER}}; font-size: 28px; font-weight: bold; }

QGroupBox[class="card"] {
    background-color: {{SELECTION}}; border: 1px solid {{SELECTION}}; border-radius: 8px;
    margin-top: 16px; padding: 20px 16px 16px 16px; font-weight: bold; color: {{ACCENT}};
}
QGroupBox[class="card"]::title { subcontrol-origin: margin; left: 16px; padding: 0 8px; }

QFrame#ValueCard { background-color: {{SELECTION}}; border-radius: 8px; padding: 15px; }
QFrame#Separator { background-color: {{SELECTION}}; }

QTableWidget#BackupTable, QTableWidget#ValuationTable {
    background-color: {{ON_ACCENT}}; border: 1px solid {{SELECTION}}; border-radius: 6px;
    gridline-color: {{SELECTION}}; color: {{TEXT_SOFT}}; selection-background-color: {{SELECTION}}; font-size: 12px;
}
QTableWidget#BackupTable::item, QTableWidget#ValuationTable::item { padding: 6px; }
QLabel#RestoreWarning {
    background-color: rgba(255, 65, 54, 0.12); border: 1px solid {{DANGER}};
    border-radius: 6px; padding: 12px 16px; color: {{DANGER}}; font-size: 12px;
}

