/* 
    Ceylon Byte POS - Command Center Dark Theme 
    Palette:
    - Background: #1E1E1E (Global BG) / #252526 (Surface)
    - Text: #FFFFFF (Primary) / #AAAAAA (Secondary)
    - Border: #3E3E42
    - Accent: #00BCEB (Cyan)
    - Success: #39FF14 (Neon Green)
    - Warning: #FFDC00
    - Error: #FF4136
*/

/* Global Font Enforcement */
* {
    font-family: "{{FONT_FAMILY}}", "Noto Sans Sinhala", "Noto Sans Tamil", "Noto Sans";
}

QLabel.PlaceholderLabel {
    color: {{TEXT_SECONDARY}};
}

QLabel.AboutLabel {
    font-size: 16px;
    color: {{TEXT_SECONDARY}};
}

/* Global Reset */
QWidget {
    background-color: {{SURFACE_0}};
    color: {{TEXT}};
    font-size: {{FONT_SIZE}};
}

/* Inputs - Global Baseline */
QLineEdit {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER_STRONG}};
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 14px;
    color: {{TEXT}};
    min-height: 36px;
    selection-background-color: {{ACCENT}};
    selection-color: {{SURFACE_0}};
}

QLineEdit:hover {
    border: 1px solid {{ACCENT}};
}

QLineEdit:focus {
    border: 1px solid {{ACCENT}};
    background-color: {{SURFACE_2}};
}

QLineEdit:disabled {
    background-color: {{SURFACE_0}};
    color: {{TEXT_DISABLED}};
    border-color: {{SURFACE_3}};
}

QLineEdit[error="true"] {
    border: 1px solid {{DANGER}};
}

/* Date pickers - Global Baseline (13 of 15 sites in the app had no styling
   at all before this; only #ReportDateEdit/#PeriodDateEdit had one-off
   rules). A generic type selector styles every QDateEdit automatically,
   including any without an objectName. */
QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER_STRONG}};
    border-radius: 6px;
    padding: 8px 12px;
    padding-right: 28px;
    font-size: 14px;
    color: {{TEXT}};
    min-height: 36px;
}

QDateEdit:hover, QTimeEdit:hover, QDateTimeEdit:hover {
    border: 1px solid {{ACCENT}};
}

QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border: 1px solid {{ACCENT}};
    background-color: {{SURFACE_2}};
}

QDateEdit:disabled, QTimeEdit:disabled, QDateTimeEdit:disabled {
    background-color: {{SURFACE_0}};
    color: {{TEXT_DISABLED}};
    border-color: {{SURFACE_3}};
}

QDateEdit[error="true"], QTimeEdit[error="true"], QDateTimeEdit[error="true"] {
    border: 1px solid {{DANGER}};
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid {{BORDER_STRONG}};
    background-color: {{SURFACE_2}};
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QDateEdit::drop-down:hover {
    background-color: {{SURFACE_3}};
}

/* Context/dropdown menus - Global Baseline. Previously the only QMenu
   rule in this file was scoped to QCalendarWidget QMenu, so every other
   right-click menu in the app (e.g. the Sales screen's cart line-item
   menu) rendered with the OS's native popup chrome instead of this
   theme, even though the surrounding code already manually re-tints
   the menu's icons per theme. A generic selector styles every QMenu at
   once, the same way QDateEdit/QLineEdit above do for their types. */
QMenu {
    background-color: {{SURFACE_1}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: rgba(0, 188, 235, 0.14);
    color: {{TEXT}};
}

QMenu::item:disabled {
    color: {{TEXT_DISABLED}};
}

QMenu::separator {
    height: 1px;
    background-color: {{BORDER}};
    margin: 4px 8px;
}

QMenu::icon {
    padding-left: 8px;
}

QCalendarWidget {
    background-color: {{SURFACE_1}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    border-radius: 4px;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: {{SURFACE_2}};
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: {{TEXT}};
    font-size: 13px;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton:hover {
    background-color: {{SURFACE_3}};
}

QCalendarWidget QMenu {
    background-color: {{SURFACE_1}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
}

QCalendarWidget QSpinBox {
    background-color: {{SURFACE_2}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    border-radius: 4px;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: {{SURFACE_1}};
    color: {{TEXT}};
    selection-background-color: {{ACCENT}};
    selection-color: {{SURFACE_0}};
    outline: none;
}

QCalendarWidget QAbstractItemView:disabled {
    color: {{TEXT_DISABLED}};
}

/* The app-wide QHeaderView::section rule (accent underline, bold, meant
   for real tables) also matches QCalendarWidget's internal day-name header
   row -- this scoped override is a deliberate exception (#554) that keeps
   the popup's header compact and neutral instead of a table-style bar. */
QCalendarWidget QHeaderView::section {
    background-color: {{SURFACE_2}};
    color: {{TEXT_SECONDARY}};
    padding: 4px;
    font-weight: normal;
    font-size: 12px;
    border: none;
    border-bottom: 1px solid {{BORDER}};
}

/* ComboBox - Dropdown Selector */
QComboBox {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER_STRONG}};
    border-radius: 6px;
    padding: 8px 12px;
    padding-right: 35px;  /* Space for arrow */
    font-size: 14px;
    color: {{TEXT}};
    min-height: 36px;
}

QComboBox:hover {
    border: 1px solid {{ACCENT}};
    background-color: {{SURFACE_2}};
}

QComboBox:focus {
    border: 1px solid {{ACCENT}};
    background-color: {{SURFACE_2}};
}

QComboBox:disabled {
    background-color: {{SURFACE_0}};
    color: {{TEXT_DISABLED}};
    border-color: {{SURFACE_3}};
}

QComboBox[error="true"] {
    border: 1px solid {{DANGER}};
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid {{BORDER_STRONG}};  /* Separator line */
    background: {{BORDER}};
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

QComboBox::drop-down:hover {
    background: {{SELECTION}};  /* Darker hover */
    border-left: 1px solid {{ACCENT}};
}

QComboBox::down-arrow {
    image: url(cbpos/assets/icons/chevron-down-white.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: {{SURFACE_1}};
    border: 1px solid {{ACCENT}};
    selection-background-color: {{ACCENT}};
    selection-color: {{SURFACE_0}};
    color: {{TEXT}};
    padding: 4px;

}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 28px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: {{SURFACE_2}};
    color: {{ACCENT}};
}

QComboBox QAbstractItemView::item:selected {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
}

/* SpinBox - Number Input (Modern Touch-Friendly Design) */
QSpinBox, QDoubleSpinBox {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER_STRONG}};
    border-radius: 6px;
    padding: 8px 12px;
    padding-right: 35px;  /* Space for wider buttons */
    font-size: 14px;
    color: {{TEXT}};
    min-height: 36px;  /* Unified input height */
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid {{ACCENT}};
    background-color: {{SURFACE_2}};
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid {{ACCENT}};
    background-color: {{SURFACE_2}};
}

QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: {{SURFACE_0}};
    color: {{TEXT_DISABLED}};
    border-color: {{SURFACE_3}};
}

QSpinBox[error="true"], QDoubleSpinBox[error="true"] {
    border: 1px solid {{DANGER}};
}

/* UP Button (+) - Clear plus icon */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 30px;
    height: 18px;
    border-left: 1px solid {{BORDER_STRONG}};
    border-bottom: 1px solid {{BORDER_STRONG}};
    background-color: {{BORDER}};
    border-top-right-radius: 6px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: {{ACCENT}};
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed {
    background-color: {{ACCENT}};
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(cbpos/assets/icons/plus-white.svg);
    width: 12px;
    height: 12px;
}

/* DOWN Button (-) - Clear minus icon */
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 30px;
    height: 18px;
    border-left: 1px solid {{BORDER_STRONG}};
    border-top: 1px solid {{BORDER_STRONG}};
    background-color: {{BORDER}};
    border-bottom-right-radius: 6px;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: {{ACCENT}};
}

QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: {{ACCENT}};
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(cbpos/assets/icons/minus-white.svg);
    width: 12px;
    height: 12px;
}

/* Denomination Widget (Start Shift / Shift Closing cash count, #525) */
QLabel#DenomLabel {
    font-size: 14px;
    font-weight: bold;
    color: {{TEXT_SOFT}};
}

QLabel#DenomRowTotal {
    font-size: 13px;
    color: {{TEXT_SECONDARY}};
}

QLabel#DenomGrandTotalLabel {
    font-size: 16px;
    font-weight: bold;
    color: {{ACCENT}};
}

QLabel#DenomGrandTotalValue {
    font-size: 20px;
    font-weight: bold;
    color: {{SUCCESS}};
}

/* Checkboxes - Toggle Style with Checkmark */
QCheckBox {
    spacing: 10px;
    color: {{TEXT_SOFT}};
    background-color: transparent;
}

/* Unchecked State - Empty box with visible border */
QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid {{BORDER_STRONG}};
    border-radius: 4px;
    background-color: transparent;
}

/* Unchecked Hover - Cyan glow */
QCheckBox::indicator:unchecked:hover {
    border-color: {{ACCENT}};
    background-color: rgba(0, 188, 235, 0.1);
}

/* Checked State - Cyan fill with white checkmark */
QCheckBox::indicator:checked {
    background-color: {{ACCENT}};
    border-color: {{ACCENT}};
    image: url(cbpos/assets/icons/check-white.svg);
}

/* Checked Hover - Brighter cyan with checkmark */
QCheckBox::indicator:checked:hover {
    background-color: {{ACCENT}};
    border-color: {{ACCENT}};
    image: url(cbpos/assets/icons/check-white.svg);
}

/* Tree/table item checkboxes (e.g. Permission Manager) rendered plain
   grey native OS squares -- ::indicator on QTreeWidget/QTableWidget
   picks up the exact same themed style as a real QCheckBox (#298). */
QTreeWidget::indicator, QTableWidget::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid {{BORDER_STRONG}};
    border-radius: 4px;
    background-color: transparent;
}

QTreeWidget::indicator:checked, QTableWidget::indicator:checked {
    background-color: {{ACCENT}};
    border-color: {{ACCENT}};
    image: url(cbpos/assets/icons/check-white.svg);
}

QTreeWidget::indicator:indeterminate, QTableWidget::indicator:indeterminate {
    background-color: {{ACCENT}};
    border-color: {{ACCENT}};
    image: url(cbpos/assets/icons/minus-white.svg);
}

/* Locked cells (e.g. Admin's critical permissions, #614) */
QTreeWidget::indicator:checked:disabled, QTableWidget::indicator:checked:disabled {
    background-color: {{BORDER}};
    border-color: {{BORDER}};
}

QTreeWidget::indicator:indeterminate:disabled, QTableWidget::indicator:indeterminate:disabled {
    background-color: {{BORDER}};
    border-color: {{BORDER}};
    image: url(cbpos/assets/icons/minus-white.svg);
}

/* Buttons */
QPushButton {
    background-color: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    border-radius: 4px;
    padding: 10px 20px;
    font-weight: bold;
    color: {{TEXT}};
}

QPushButton:hover {
    background-color: {{BORDER}};
    border: 1px solid {{BORDER_STRONG}};
}

QPushButton:pressed {
    background-color: {{ACCENT}};
}

/* Keyboard focus (#553). Qt otherwise draws the platform's dotted focus
   rectangle (Windows) inside buttons and around the current cell of
   every item view. Item views show the current row through the
   selection instead; focusable buttons/checkboxes swap the dotted rect
   for a solid theme-accent ring. `outline` (not `border`) is used on
   purpose: it is drawn by the focus-rect primitive, so it still shows on
   buttons whose own #ID rule sets `border` and would out-rank a plain
   QPushButton:focus border. NoFocus buttons (numpads, cards) never get
   focus, so they never show it. */
QAbstractItemView {
    outline: 0;
}

QPushButton:focus, QToolButton:focus {
    outline: 2px solid {{ACCENT}};
}

QCheckBox:focus, QRadioButton:focus {
    outline: 1px solid {{ACCENT}};
}

/* Accent-filled buttons: an accent ring would vanish into the fill. */
QPushButton[class="accent"]:focus,
QPushButton#BtnSearchSelect:focus,
#RunReportBtn:focus,
QPushButton#CreditAddBtn:focus,
QPushButton#CreditPayBtn:focus,
QPushButton#PayablePayBtn:focus,
QPushButton#DocNewQuotationBtn:focus,
QPushButton#DocConvertBtn:focus,
QPushButton#PriceListAddBtn:focus,
QPushButton#PMCardBtn[class="accent"]:focus,
QPushButton#SaleHistoryReprint:focus {
    outline-color: {{SURFACE_0}};
}

/* Primary Action Button (Green) */
QPushButton#BtnSave, QPushButton#PayBtn, QPushButton[class="primary"] {
    background-color: {{SUCCESS}};
    color: {{ON_ACCENT}};
    border: none;
}

QPushButton#BtnSave:hover, QPushButton#PayBtn:hover, QPushButton[class="primary"]:hover {
    background-color: {{SUCCESS}};
}

/* Danger Button (Red) */
QPushButton#VoidBtn, QPushButton[class="danger"] {
    background-color: {{DANGER}};
    color: {{TEXT}};
    border: none;
}

QPushButton#VoidBtn:hover, QPushButton[class="danger"]:hover {
    background-color: {{DANGER}};
}

/* Accent Button (Cyan) */
QPushButton[class="accent"] {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    border: none;
    font-weight: bold;
}

QPushButton[class="accent"]:hover {
    background-color: {{ACCENT}};
}

/* Secondary Button (neutral -- dismiss/close/utility actions). */
QPushButton#BtnCancel, QPushButton#ReceiptBtnClose, QPushButton[class="secondary"] {
    background-color: {{SURFACE_2}};
    color: {{TEXT_SOFT}};
    border: 1px solid {{BORDER}};
}

QPushButton#BtnCancel:hover, QPushButton#ReceiptBtnClose:hover, QPushButton[class="secondary"]:hover {
    background-color: {{SURFACE_3}};
    color: {{TEXT}};
    border-color: {{BORDER_STRONG}};
}

QPushButton#BtnCancel:pressed, QPushButton#ReceiptBtnClose:pressed, QPushButton[class="secondary"]:pressed {
    background-color: {{SURFACE_0}};
}

QPushButton#BtnCancel:disabled, QPushButton#ReceiptBtnClose:disabled, QPushButton[class="secondary"]:disabled {
    background-color: {{SURFACE_1}};
    color: {{TEXT_DISABLED}};
    border: 1px solid {{SURFACE_3}};
}

/* Warning Button (Yellow) */
QPushButton[class="warning"] {
    background-color: {{WARNING}};
    color: {{ON_ACCENT}};
    border: none;
}

/* --- Dialog Label Classes --- */
QLabel[class="dialog-title"] {
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}

/* The one muted/secondary-text rule (a later one-line duplicate used to
   override this). 13px + >=4.5:1 contrast so Sinhala/Tamil hints stay
   readable (#566). */
QLabel[class="muted"] {
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
    background: transparent;
}

QLabel[class="debit"] {
    font-weight: bold;
    color: {{DANGER}};
    background: transparent;
}

QLabel[class="credit"] {
    font-weight: bold;
    color: {{SUCCESS}};
    background: transparent;
}

QLabel[class="bold"] {
    font-weight: bold;
    background: transparent;
}

QLabel[class="transparent"] {
    background: transparent;
}

QLabel#GrnTotalLabel {
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}

QLabel[status="danger"], QLabel[class="status-err"] {
    color: {{DANGER}};
    font-weight: bold;
}

QLabel[status="success"], QLabel[class="status-ok"] {
    color: {{SUCCESS}};
    font-weight: bold;
}

QLabel[status="neutral"] {
    color: {{TEXT_SOFT}};
    font-weight: bold;
}

QLabel#PriceListStatusBadge {
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: bold;
}

QLabel#PriceListStatusBadge[status="success"] {
    color: {{SUCCESS}};
}

QLabel#PriceListStatusBadge[status="neutral"] {
    color: {{TEXT_DISABLED}};
}

QLabel#PriceListStatusBadge[status="accent"] {
    color: {{ACCENT}};
}

QLabel#BulkPriceBadge {
    font-weight: bold;
    padding: 4px 10px;
    border-radius: 4px;
    background-color: rgba(0, 188, 235, 0.15);
    color: {{ACCENT}};
}

QLabel#ColorSwatch {
    border: 1px solid {{BORDER}};
    border-radius: 4px;
    background-color: transparent;
}

QLabel#SetupCardIcon {
    font-size: 36px;
    background: transparent;
}

QLabel#HistoryDetailsBanner {
    padding: 10px;
    background-color: {{SURFACE_0}};
    border: 1px solid {{BORDER}};
    border-radius: 6px;
    color: {{TEXT_SOFT}};
}

QLabel#EmptyStateLabel {
    color: {{TEXT_DISABLED}};
    font-size: 14px;
}

QPushButton#ActiveOrderTab {
    font-weight: bold;
    border-bottom: 3px solid {{ACCENT}};
}

QLabel#SyncDot {
    font-size: 12px;
    color: {{TEXT_DISABLED}};
}
QLabel#SyncDot[status="connected"] { color: {{SUCCESS}}; }
QLabel#SyncDot[status="syncing"] { color: {{WARNING}}; }
QLabel#SyncDot[status="disconnected"] { color: {{DANGER}}; }
QLabel#SyncDot[status="main"] { color: {{ACCENT}}; }
QLabel#SyncDot[status="standalone"] { color: {{TEXT_DISABLED}}; }
QLabel#SyncDot[status="error"] { color: {{DANGER}}; }

QLabel#SyncLabel {
    font-size: 11px;
    color: {{TEXT_DISABLED}};
    padding: 0 4px;
}

/* FormCard & ScrollArea Primitives */
QFrame#FormCard {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
}

QFrame#FormCard QLabel#FormCardTitle {
    font-size: 11px;
    font-weight: bold;
    color: {{TEXT_SECONDARY}};
    background: transparent;
    margin-bottom: 2px;
}

QScrollArea#DialogScrollArea {
    background: transparent;
    border: none;
}

/* Log Detail Dialog Metadata Card */
QFrame#LogMetaCard {
    background-color: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
}

QFrame#LogMetaCard QLabel {
    background: transparent;
}

QLabel#LogLevelBadge {
    border-radius: 4px;
    padding: 2px 8px;
    font-weight: bold;
    font-size: 11px;
}

QLabel#LogLevelBadge[level="CRITICAL"] {
    background-color: rgba(255, 65, 54, 0.28);
    color: {{DANGER}};
    border: 1px solid {{DANGER}};
}

QLabel#LogLevelBadge[level="ERROR"] {
    background-color: rgba(255, 65, 54, 0.18);
    color: {{DANGER}};
    border: 1px solid rgba(255, 107, 107, 0.5);
}

QLabel#LogLevelBadge[level="WARNING"] {
    background-color: rgba(255, 193, 7, 0.18);
    color: {{WARNING}};
    border: 1px solid rgba(255, 212, 59, 0.5);
}

QLabel#LogLevelBadge[level="INFO"] {
    background-color: rgba(0, 188, 235, 0.15);
    color: {{ACCENT}};
    border: 1px solid rgba(0, 188, 235, 0.4);
}


/* Lists, Tables & Trees -- QTreeWidget/QTreeView used to be missing
   here, so a tree with alternating rows fell back to the native
   (white) alternate base under the theme's text color (#567). */
QListWidget, QTableView, QTableWidget, QTreeWidget, QTreeView {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};

    gridline-color: {{BORDER}};
    alternate-background-color: {{SURFACE_2}};
}

QListWidget::item, QTableView::item, QTableWidget::item {
    padding: 10px 12px;
    border-bottom: 1px solid {{BORDER}};
}

QListWidget::item:selected, QTableView::item:selected, QTableWidget::item:selected {
    background-color: {{ACCENT}};
    color: {{TEXT}};
}

QListWidget::item:hover, QTableView::item:hover, QTableWidget::item:hover {
    background-color: {{SURFACE_3}};
}

/* Trees: compact items (the 12px list/table padding is too tall for a
   hierarchy), a visible selection, and a deeper indent so children read
   as children. ::branch is deliberately not styled -- any ::branch rule
   makes Qt stop drawing the native expand arrows. */
QTreeView {
    qproperty-indentation: 24;
}

QTreeView::item {
    padding: 6px;
    border: none;
}

QTreeView::item:hover {
    background-color: {{SURFACE_3}};
}

QTreeView::item:selected {
    background-color: {{ACCENT}};
    color: {{TEXT}};
}

/* Table headers (#554): ONE app-wide look -- accent text over an accent
   underline. Do not add per-table QHeaderView::section rules; a scoped
   rule outranks this one and silently forks the look again. The only
   deliberate exceptions are QCalendarWidget's day-name row (above) and
   vertical row-number headers (below). #00BCEB on #2D2D30 is 6.1:1.
   Numeric columns right-align their header in code (TextAlignmentRole),
   not here -- QSS has no per-column selector. */
QHeaderView::section {
    background-color: {{SURFACE_2}};
    color: {{ACCENT}};
    font-weight: bold;
    font-size: 12px;
    padding: 6px 8px;
    border: none;
    border-bottom: 2px solid {{ACCENT}};
}

/* Row-number headers: a cyan underline under every row would be noise. */
QHeaderView::section:vertical {
    color: {{TEXT_SECONDARY}};
    font-weight: normal;
    border-bottom: 1px solid {{BORDER}};
}

QTableCornerButton::section {
    background-color: {{SURFACE_2}};
    border: none;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: {{SURFACE_0}};
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: {{BORDER}};
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: {{SURFACE_0}};
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: {{BORDER}};
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: {{BORDER_STRONG}};
}

/* Without this the page areas either side of the handle can fall back
   to the native (patterned) track on Windows. */
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* Tooltips -- no rule existed, so every tooltip used the OS's native
   pale-yellow look regardless of theme (#567). */
QToolTip {
    background-color: {{SURFACE_2}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    padding: 6px 8px;
}

/* Multi-line text inputs and progress bars had no base rule (#567). */
QTextEdit, QPlainTextEdit {
    background-color: {{SURFACE_1}};
    color: {{TEXT}};
    border: 1px solid {{BORDER_STRONG}};
    border-radius: 4px;
    padding: 8px 12px;
    font-size: 14px;
    selection-background-color: {{ACCENT}};
}

QTextEdit:hover, QPlainTextEdit:hover {
    border: 1px solid {{ACCENT}};
}

QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid {{ACCENT}};
    background-color: {{SURFACE_2}};
}

QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: {{SURFACE_0}};
    color: {{TEXT_DISABLED}};
    border-color: {{SURFACE_3}};
}

QTextEdit[error="true"], QPlainTextEdit[error="true"] {
    border: 1px solid {{DANGER}};
}

QProgressBar {
    background-color: {{SURFACE_2}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    border-radius: 4px;
    text-align: center;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: {{ACCENT}};
    border-radius: 3px;
}

/* ScrollArea Transparency Fix */
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid {{BORDER}};
    background-color: {{SURFACE_1}};
}

/* Inactive tabs used to be #2D2D30 with no border or hover on a #1E1E1E
   page -- they didn't read as clickable (#571). */
QTabBar::tab {
    background: {{SURFACE_3}};
    color: {{TEXT_SECONDARY}};
    border: 1px solid {{BORDER}};
    border-bottom: none;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:hover:!selected {
    background: {{BORDER}};
    color: {{TEXT}};
}

QTabBar::tab:selected {
    background: {{ACCENT}};
    border-color: {{ACCENT}};
    color: {{TEXT}};
    font-weight: bold;
}

/* Group Box */
QGroupBox {
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 16px;
    font-weight: bold;
    background-color: {{SURFACE_1}};
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: {{ACCENT}};
}

/* --- FIX: Force Transparency for Labels & Checkboxes inside GroupBoxes --- */
QGroupBox QLabel {
    background-color: transparent;
    color: {{TEXT_SOFT}};
}

QGroupBox QCheckBox {
    background-color: transparent;
    color: {{TEXT_SOFT}};
}

/* --- Sidebar --- */
/* Sidebar Container - Dark Mode */
QWidget#Sidebar,
QFrame#Sidebar,
QFrame#SidebarContainer {
    background-color: {{SURFACE_1}};
    border-right: 1px solid {{SURFACE_2}};
}

/* User Profile Section - Dark Mode (KILL THE LINES) */
QWidget#UserProfileContainer {
    background-color: transparent;  /* Blend with sidebar */
    border: none;  /* Remove all borders */
    border: none;  /* Remove focus outline */
}

/* ── POS Side Menu (Hamburger Panel) ─ Dark ────────────────────── */
QWidget#POSSideMenu {
    background-color: {{SURFACE_0}};
    border-left: 1px solid {{SURFACE_2}};
}

QWidget#POSSideMenu QLabel {
    background-color: transparent;
    color: {{TEXT_SOFT}};
}

QWidget#POSSideMenu QFrame[frameShape="4"] {
    background-color: {{SURFACE_2}};
}

/* Nav tiles scroll on short screens; profile and toolbar stay pinned (#590) */
QScrollArea#SideMenuScroll {
    background: transparent;
    border: none;
}

QWidget#SideMenuScrollInner {
    background: transparent;
}

/* Section Header */
QLabel#MenuSectionHeader {
    color: {{TEXT_DISABLED}};
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    background: transparent;
}

/* Nav Tiles — 2-column grid */
QPushButton#NavTile {
    background-color: {{SURFACE_1}};
    border: 2px solid {{SURFACE_3}};
    border-radius: 8px;
}

QPushButton#NavTile:hover {
    background-color: {{SURFACE_2}};
    border-color: {{ACCENT}};
}

QPushButton#NavTile[active="true"] {
    border: 2px solid {{ACCENT}};
    background-color: rgba(0, 188, 235, 0.15);
}

QLabel#NavTileIcon {
    background: transparent;
}

/* pt scales with DPI (px doesn't) — #207 */
QLabel#NavTileText {
    font-size: 9pt;
    background: transparent;
    color: {{TEXT_SOFT}};
}

QLabel#NavTileText[active="true"] {
    color: {{ACCENT}};
}

/* User Profile Row */
QWidget#UserProfileRow {
    background-color: rgba(255, 255, 255, 0.03);
}

QLabel#MenuUsername {
    color: {{TEXT}};
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}

QLabel#MenuRole {
    color: {{TEXT_DISABLED}};
    font-size: 12px;
    font-weight: normal;
    background: transparent;
}

/* Sign Out button -- one bordered, touch-sized button carrying its own
   icon (#607); hover tints it so the target is obvious. */
QPushButton#SignOutBtn {
    background-color: transparent;
    border: 1px solid rgba(255, 65, 54, 0.35);
    border-radius: 8px;
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
    font-weight: bold;
    padding: 0 12px;
    min-height: 40px;
}

QPushButton#SignOutBtn:hover {
    background-color: rgba(255, 65, 54, 0.12);
    border-color: {{DANGER}};
    color: {{DANGER}};
}

QPushButton#SignOutBtn:pressed {
    background-color: rgba(255, 65, 54, 0.22);
}

/* Icon Buttons (bottom toolbar) */
QPushButton#IconButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
}

QPushButton#IconButton:hover {
    background-color: {{SURFACE_2}};
}

QPushButton#IconButton:pressed {
    background-color: {{SURFACE_3}};
}

QLabel#SidebarLogo {
    color: white;
    font-weight: bold;
    font-size: 20px;  /* Larger for better visibility */
}

QToolButton#SidebarToggle {
    border: none;
    background: transparent;
    padding: 4px;
}

/* Sidebar section break -- a resting point between groups of nav items
   (operational screens vs. management/admin ones), instead of one flat,
   undifferentiated 10-item list (#315). The divider line stays visible
   in collapsed mode; the label text hides (no room for it, see
   CollapsibleSidebar._update_all_styles). */
QFrame#SidebarSectionDivider {
    background-color: {{SURFACE_3}};
    border: none;
    margin: 6px 16px 0 16px;
}

QLabel#SidebarSectionLabel {
    color: {{TEXT_DISABLED}};
    font-size: 10px;
    font-weight: bold;
    padding: 6px 20px 4px 20px;
    background: transparent;
}

/* Sidebar Buttons -- a floating rounded pill (inset margin + radius)
   instead of a flat, edge-to-edge square with a hairline accent bar. */
QToolButton#SidebarButton {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    border: none;
    border-radius: 8px;
    text-align: left;
    padding-left: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin: 1px 10px;
    min-height: 36px;
    font-size: 15px;  /* Slightly larger for readability */
    font-weight: normal;
}

QToolButton#SidebarButton:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: white;
}

QToolButton#SidebarButton:checked, QToolButton#SidebarButton[active="true"] {
    background-color: rgba(0, 188, 235, 0.14);
    color: {{ACCENT}};
    font-weight: bold;
}

/* Collapsed State (via Property) */
QToolButton#SidebarButton[collapsed="true"] {
    padding-left: 0px;
    padding-right: 0px;
    text-align: center;
    margin: 1px 10px;
}

/* Bottom "exit cluster" divider -- pulls POS/Logout visually away from
   the nav list above, so they read as two consequential actions rather
   than two more rows in the same list. */
QFrame#SidebarBottomDivider {
    background-color: {{SURFACE_3}};
    border: none;
    margin: 0 16px;
}

/* Special Sidebar Buttons -- rounded, tinted action chips (matching the
   bordered-pill treatment BtnLogout already had) instead of a flat,
   full-width bar. */
QToolButton#BtnPos {
    color: {{SUCCESS}};
    background-color: rgba(57, 255, 20, 0.12);
    border: 1px solid rgba(57, 255, 20, 0.35);
    border-radius: 8px;
    min-height: 40px;
    text-align: left;
    padding-left: 16px;
    margin: 4px 10px;
    font-weight: bold;
}

QToolButton#BtnPos:hover {
    background-color: rgba(57, 255, 20, 0.2);
}

QToolButton#BtnPos[collapsed="true"] {
    text-align: center;
    padding-left: 0px;
    padding-right: 0px;
    margin: 4px 10px;
}

QToolButton#BtnLogout {
    color: {{DANGER}};
    background-color: rgba(255, 65, 54, 0.12);
    border: 1px solid rgba(255, 65, 54, 0.35);
    border-radius: 8px;
    min-height: 40px;
    text-align: left;
    padding-left: 16px;
    margin: 4px 10px 8px 10px;
    font-weight: bold;
}

QToolButton#BtnLogout:hover {
    background-color: rgba(255, 65, 54, 0.2);
}

QToolButton#BtnLogout[collapsed="true"] {
    text-align: center;
    padding-left: 0px;
    padding-right: 0px;
    margin: 4px 10px 8px 10px;
}

/* Sidebar nav list scrolls on short screens; POS/Logout stay pinned
   below it. Compact mode (window under ~800px) trims button padding so
   the 40px buttons don't clip their text (#591). */
QScrollArea#SidebarNavScroll {
    background: transparent;
    border: none;
}

QWidget#SidebarNavInner,
QWidget#SidebarSectionWrapper {
    background: transparent;
}

QToolButton#SidebarButton[compact="true"] {
    min-height: 0px;
    padding-top: 2px;
    padding-bottom: 2px;
}

QToolButton#BtnPos[compact="true"],
QToolButton#BtnLogout[compact="true"] {
    min-height: 0px;
    margin-top: 2px;
    margin-bottom: 2px;
}

/* --- Management Header & Top Bar Surface Unification --- */
QWidget#SidebarHeader,
QFrame#SidebarHeader {
    background: transparent;
    border: none;
}

QWidget#TopBar,
QFrame#TopBar,
QFrame#ManagementHeader,
QFrame#SettingsHeader {
    background-color: {{SURFACE_1}};
    border-bottom: 1px solid {{SURFACE_2}};
}

/* Dark Mode Paper-Cut Sidebar Edge Toggle */
QPushButton#SidebarEdgeToggle {
    background-color: {{SURFACE_0}};
    color: {{TEXT_SECONDARY}};
    border-top: 1px solid {{SURFACE_3}};
    border-bottom: 1px solid {{SURFACE_3}};
    border-left: 1px solid {{SURFACE_3}};
    border-right: none;
    border-top-left-radius: 9px;
    border-bottom-left-radius: 9px;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    font-size: 14px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#SidebarEdgeToggle:hover {
    background-color: {{SURFACE_1}};
    color: {{ACCENT}};
    border-color: {{ACCENT}};
}

QPushButton#SidebarEdgeToggle:pressed {
    background-color: {{SURFACE_0}};
}

QLabel#ManagementHeaderTitle,
QLabel#SettingsHeaderTitle {
    color: {{TEXT_SOFT}};
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QLabel#ManagementHeaderClock,
QLabel#SettingsHeaderClock {
    color: {{TEXT_SECONDARY}};
    font-size: 12px;
    font-weight: 600;
    background: transparent;
}

QToolButton#ManagementHeaderPosBtn,
QToolButton#SettingsHeaderPosBtn {
    background-color: {{SUCCESS_BG}};
    color: {{TEXT}};
    border: none;
    border-radius: 6px;
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 600;
}

QToolButton#ManagementHeaderPosBtn:hover,
QToolButton#SettingsHeaderPosBtn:hover {
    background-color: {{SUCCESS}};
}

QToolButton#ManagementHeaderPosBtn:pressed,
QToolButton#SettingsHeaderPosBtn:pressed {
    background-color: {{SUCCESS_BG}};
}

QToolButton#ManagementHeaderLogoutBtn,
QToolButton#SettingsHeaderLogoutBtn {
    background-color: transparent;
    color: {{DANGER}};
    border: 1px solid {{DANGER_BG}};
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: 600;
}

QToolButton#ManagementHeaderLogoutBtn:hover,
QToolButton#SettingsHeaderLogoutBtn:hover {
    background-color: {{DANGER}};
    color: {{TEXT}};
    border-color: {{DANGER}};
}

QToolButton#ManagementHeaderLogoutBtn:pressed,
QToolButton#SettingsHeaderLogoutBtn:pressed {
    background-color: {{DANGER}};
    color: {{TEXT}};
}

/* --- Sales View Specifics --- */

/* Header */
QWidget#HeaderWidget {
    background-color: {{SURFACE_1}};
    border-bottom: 1px solid {{SURFACE_2}};
}

QWidget#HeaderWidget QLabel {
    background: transparent;
}

QWidget#HeaderWidget QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
}

QWidget#HeaderWidget QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

QLabel#SalesHeaderClock {
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
    font-weight: 600;
    background: transparent;
    padding-right: 14px;
}

QToolButton#HeaderCalculatorBtn {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    padding: 6px;
    margin-right: 8px;
    color: white;
}

QToolButton#HeaderCalculatorBtn:hover {
    background-color: rgba(255, 255, 255, 0.2);
    border-color: {{ACCENT}};
}

QToolButton#HeaderCalculatorBtn:pressed {
    background-color: rgba(0, 188, 235, 0.3);
}

QLabel#LogoLabel {
    color: {{ACCENT}};
    font-weight: bold;
    font-size: 16px;
    background: transparent;
}

QLabel#HeaderLogo {
    background: transparent;
}

QLabel#ItemCountLabel {
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
    background: transparent;
}

QLabel#EmptyCartLabel, QLabel#EmptyTableLabel {
    color: {{TEXT_DISABLED}};
    font-size: 16px;
    background: transparent;
    padding: 40px;
}

/* EmptyStateWidget's own layout already centers and spaces its icon/
   title/subtitle, so these carry no padding of their own (unlike the
   plain-label overlays above, which relied on padding to keep text off
   the container's edges). */
QLabel#EmptyStateIcon {
    background: transparent;
}

QLabel#EmptyStateTitle {
    color: {{TEXT_DISABLED}};
    font-size: 16px;
    background: transparent;
}

QLabel#EmptyStateSubtitle {
    color: {{TEXT_DISABLED}};
    font-size: 13px;
    background: transparent;
    padding: 0 40px;
}

/* Search Bar & Filters */
QWidget#SearchWidget {
    background-color: transparent;
}

QToolButton#SearchModeBtn {
    background-color: {{SURFACE_2}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
}

QToolButton#SearchModeBtn:checked {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    font-weight: bold;
}

/* Cart Table */
QTableWidget#CartTable {
    background-color: {{SURFACE_1}};
    color: {{TEXT}};
    gridline-color: {{BORDER}};
}

QTableWidget#CartTable::item:selected {
    background-color: rgba(0, 188, 235, 0.18);
    color: {{TEXT}};
}

QLabel[class="StrikethroughPrice"] {
    background-color: transparent;
    color: white;
}

QLabel[class="StrikethroughPrice"][discounted="true"] {
    background-color: {{SURFACE_0}};
}

QLabel#UndoToast {
    background-color: rgba(0, 31, 63, 0.92);
    color: {{ACCENT}};
    border: 1px solid {{ACCENT}};
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}

/* No-receipt-printer notice on the Sales screen (#623) */
QFrame#PrinterNotice {
    background-color: rgba(255, 220, 0, 0.10);
    border-bottom: 1px solid {{WARNING}};
}
QLabel#PrinterNoticeText {
    color: {{WARNING}};
    font-size: 13px;
    background: transparent;
}
QPushButton#PrinterNoticeSetupBtn {
    background-color: transparent;
    color: {{WARNING}};
    border: 1px solid {{WARNING}};
    border-radius: 4px;
    padding: 4px 12px;
    font-weight: bold;
}
QPushButton#PrinterNoticeSetupBtn:hover {
    background-color: rgba(255, 220, 0, 0.18);
}
QToolButton#PrinterNoticeCloseBtn {
    background: transparent;
    color: {{TEXT_SECONDARY}};
    border: none;
    padding: 4px 8px;
}
QToolButton#PrinterNoticeCloseBtn:hover {
    color: {{TEXT}};
}

/* Total Widget (#536: distinct enclosed card panel) */
QWidget#TotalWidget {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
}

QWidget#TotalWidget QLabel {
    background: transparent;
}

QLabel#GrandTotalCaption {
    color: {{TEXT_SECONDARY}};
    font-size: 11px;
    font-weight: bold;
    background: transparent;
}

QLabel#SubtotalLabel, QLabel#TaxLabel, QLabel#DiscountLabel {
    color: {{TEXT_SECONDARY}};
    font-size: 14px;
    background: transparent;
}

QLabel#TotalLabel {
    font-size: 48px;
    font-weight: bold;
    color: {{SUCCESS}};
    background: transparent;
}

QLabel#TotalLabel[compact="true"] {
    font-size: 36px;
}

/* Action Panel */
QWidget#ActionPanel {
    background-color: {{SURFACE_0}};
    border-left: 1px solid {{BORDER}};
}

QWidget#ActionPanel QLabel {
    background: transparent;
}

/* Section Headers */
QLabel#ActionSectionLabel {
    color: {{TEXT}};
    font-size: 13px;
    font-weight: bold;
    background: transparent;
    padding-left: 2px;
}

QLabel#CustTitle {
    color: {{TEXT_DISABLED}};
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    background: transparent;
}

QFrame#CustomerPanel {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: 10px;
}

QFrame#CustomerPanel[hasCustomer="true"] {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER_STRONG}};
}

QFrame#CustomerPanel[hasCustomer="false"]:hover {
    border-color: {{ACCENT}};
    background-color: {{SURFACE_2}};
}

QFrame#CustomerPanel QLabel {
    background: transparent;
}

QLabel#CustAvatar {
    border-radius: 8px;
    font-weight: bold;
    font-size: 13px;
    background: rgba(0, 188, 235, 0.12);
    border: 1px solid rgba(0, 188, 235, 0.35);
    color: {{ACCENT}};
}

QLabel#CustAvatar[hasCustomer="false"] {
    background: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    color: {{TEXT_DISABLED}};
}

QLabel#CustomerLabel {
    font-weight: bold;
    font-size: 15px;
    color: {{TEXT}};
    background: transparent;
}

QLabel#CustomerPhoneLabel {
    font-size: 12px;
    color: {{TEXT_SECONDARY}};
    background: transparent;
}

QPushButton#BtnCustomerSelect {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    border: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 12px;
    padding: 4px 10px;
    min-height: 24px;
}

QPushButton#BtnCustomerSelect:hover {
    background-color: {{ACCENT}};
}

QPushButton#BtnCustomerSelect[mode="change"] {
    background-color: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    border-radius: 6px;
    color: {{TEXT_SOFT}};
    font-size: 11px;
    font-weight: 600;
    padding: 3px 9px;
    min-height: 22px;
}

QPushButton#BtnCustomerSelect[mode="change"]:hover {
    background-color: {{BORDER}};
    border-color: {{ACCENT}};
    color: {{TEXT}};
}

QFrame#PointsDivider {
    background-color: {{SURFACE_3}};
    border: none;
}

QWidget#PointsRow {
    background: rgba(255, 220, 0, 0.12);
    border: 1px solid rgba(255, 220, 0, 0.3);
    border-radius: 10px;
}

QFrame#CustomerPanel QLabel#PointsLabel {
    color: {{WARNING}};
    font-weight: bold;
    font-size: 11px;
    background: transparent;
}

QLabel#PointsIcon {
    background: transparent;
}

QPushButton#BtnCustomerClear {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: {{TEXT_DISABLED}};
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
}

QPushButton#BtnCustomerClear:hover {
    background-color: rgba(255, 65, 54, 0.15);
    color: {{DANGER}};
    border-color: rgba(255, 65, 54, 0.3);
}

/* Select Customer Dialog Footers */
QDialog#CustomerSelectionDialog QPushButton#BtnDialogCustomerSelect {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    border: none;
    border-radius: 6px;
    font-weight: 600;
    font-size: 13px;
    min-height: 38px;
    min-width: 105px;
    padding: 0 16px;
}

QDialog#CustomerSelectionDialog QPushButton#BtnDialogCustomerSelect:hover {
    background-color: {{ACCENT}};
}

QDialog#CustomerSelectionDialog QPushButton#BtnDialogCustomerSelect:pressed {
    background-color: {{ACCENT}};
}


/* Action Grid Button */
QPushButton#ActionGridBtn {
    background-color: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    color: {{TEXT}};
    border-radius: 6px;
    padding: 0px;
}

QPushButton#ActionGridBtn:hover {
    background-color: {{SURFACE_3}};
    border-color: {{ACCENT}};
}

QPushButton#ActionGridBtn:pressed {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
}

QPushButton#ActionGridBtn QLabel#lblIcon {
    background: transparent;
}

/* pt scales with DPI (px doesn't) — #207: these were inline px in Python,
   invisible at 150-200% Windows scaling. */
QPushButton#ActionGridBtn QLabel#lblText {
    font-size: 9pt;
    font-weight: 500;
    color: {{TEXT}};
    background: transparent;
}

/* Shortcut key badge (#604): a small keycap chip, distinct from the
   label and readable (the old plain gray text was ~2:1). */
QPushButton#ActionGridBtn QLabel#lblShortcut {
    font-size: 7pt;
    font-weight: bold;
    color: {{TEXT_SOFT}};
    background-color: {{BORDER}};
    border-radius: 3px;
    padding: 0px 4px;
}

/* Color accents — bottom border */
QPushButton#ActionGridBtn[btnColor="#FFDC00"] { border-bottom: 2px solid {{WARNING}}; }
QPushButton#ActionGridBtn[btnColor="#FF4136"] { border-bottom: 2px solid {{DANGER}}; }

/* No ":pressed QLabel" color rule here: Qt QSS doesn't evaluate a
   pseudo-state on an *ancestor*, so such a rule matched the tile labels
   at all times and turned them unreadable once the old inline label
   colors were gone (#603). */

/* Pay Button */
QPushButton#BtnPay {
    background-color: {{SUCCESS}};
    color: {{ON_ACCENT}};
    font-size: 24px;
    font-weight: bold;
    border: none;
    border-radius: 8px;
    /* Room on the right for the F5 badge, so a long label (Tamil) can't run into it (#604) */
    padding: 0px 44px 0px 12px;
}

QPushButton#BtnPay:hover {
    background-color: {{SUCCESS}};
}

QPushButton#BtnPay:pressed {
    background-color: {{SUCCESS}};
}

QPushButton#BtnPay QLabel#lblShortcut {
    font-size: 10pt;
    font-weight: bold;
    color: {{TEXT}};
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 4px;
    padding: 1px 6px;
}

/* Brief flash when PAY is clicked on an empty cart (#209) */
QPushButton#BtnPay[state="error"] {
    background-color: {{DANGER}};
    border: 2px solid {{DANGER}};
}

/* Dashboard Cards */
QWidget#InfoCard {
    background-color: {{SELECTION}};
    border-radius: 8px;
    border: 1px solid {{SELECTION}};
}

QLabel#InfoCardTitle {
    font-size: 12px;
    color: {{TEXT_SECONDARY}};
}

/* Settings View — sidebar uses SidebarContainer + SidebarButton (shared with Management) */
QWidget#SettingsContent {
    background-color: {{SURFACE_0}};
    color: {{TEXT}};
}

/* Settings Content Area - Improved Input Styling */
QWidget#SettingsContent QLineEdit,
QWidget#SettingsContent QComboBox,
QWidget#SettingsContent QSpinBox,
QWidget#SettingsContent QDoubleSpinBox,
QWidget#SettingsContent QTextEdit {
    background-color: {{SURFACE_3}};
    color: {{TEXT_SOFT}};
    border: 1px solid {{BORDER_STRONG}};
    border-radius: 4px;
    padding-left: 10px;
    min-height: 32px;
    font-size: 14px;
}

QWidget#SettingsContent QLineEdit:focus,
QWidget#SettingsContent QComboBox:focus,
QWidget#SettingsContent QSpinBox:focus,
QWidget#SettingsContent QDoubleSpinBox:focus,
QWidget#SettingsContent QTextEdit:focus {
    border: 1px solid {{ACCENT}};
    background-color: {{BORDER}};
}

/* Settings Form Labels */
QWidget#SettingsContent QLabel {
    color: {{TEXT_SOFT}};
    font-size: 14px;
}

/* The rule above (#ID-scoped) out-ranks the shared muted/warning-hint
   classes, which turned every Settings hint -- including the tax
   warning -- into plain body text (#566). */
QWidget#SettingsContent QLabel[class="muted"] {
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
}

QWidget#SettingsContent QLabel[class="warning-hint"] {
    color: {{DANGER}};
    font-size: 12px;
}

/* Hardware test passed (Settings -> Hardware Test Print / Open Drawer, #624) */
QWidget#SettingsContent QLabel[class="success-hint"] {
    color: {{SUCCESS}};
    font-size: 12px;
}

/* Disabled state (#564). Once a stylesheet styles an input, Qt stops
   drawing its native greyed-out look, so a disabled spinbox/combo/check
   looked fully editable. The SettingsContent copies are needed because
   that #ID-scoped input rule above out-ranks the generic ones. */
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QTimeEdit:disabled,
QDateTimeEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QWidget#SettingsContent QLineEdit:disabled,
QWidget#SettingsContent QComboBox:disabled,
QWidget#SettingsContent QSpinBox:disabled,
QWidget#SettingsContent QDoubleSpinBox:disabled,
QWidget#SettingsContent QTextEdit:disabled {
    background-color: {{SURFACE_2}};
    color: {{TEXT_DISABLED}};
    border: 1px solid {{BORDER}};
}

QSpinBox::up-button:disabled, QSpinBox::down-button:disabled,
QDoubleSpinBox::up-button:disabled, QDoubleSpinBox::down-button:disabled,
QComboBox::drop-down:disabled {
    background-color: {{SURFACE_2}};
}

QCheckBox:disabled, QRadioButton:disabled,
QLabel:disabled,
QWidget#SettingsContent QLabel:disabled {
    color: {{TEXT_DISABLED}};
}

QCheckBox::indicator:disabled {
    border-color: {{BORDER}};
    background-color: {{SURFACE_2}};
}

QCheckBox::indicator:checked:disabled {
    background-color: {{BORDER}};
    border-color: {{BORDER}};
}

QLabel[class="SectionHeader"] {
    font-size: 18px;
    font-weight: bold;
    color: {{ACCENT}};
    margin-bottom: 20px;
}

/* Settings action bar -- under the content area only, never under the
   sidebar (#616). Status text: muted on tool pages ("save automatically"),
   warning while pages are unsaved, success once everything is saved. */
QFrame#SettingsActionBar {
    background-color: {{SURFACE_2}};
    border-top: 1px solid {{BORDER}};
}

QLabel#SettingsSaveStatus {
    color: {{TEXT_SECONDARY}};
    background: transparent;
}

QLabel#SettingsSaveStatus[state="unsaved"] {
    color: {{WARNING}};
    font-weight: bold;
}

QLabel#SettingsSaveStatus[state="saved"] {
    color: {{SUCCESS}};
}

/* --- Dialogs --- */

/* ── Payment Dialog ── */
QDialog#PaymentDialog {
    background-color: {{SURFACE_0}};
    color: {{TEXT}};
}

QDialog#PaymentDialog QLabel {
    background: transparent;
    color: {{TEXT}};
}

QLabel#PaymentRemainingLabel {
    font-size: 28px;
    color: {{DANGER}};
    font-weight: bold;
    background-color: rgba(255, 65, 54, 0.1);
    border: 2px solid {{DANGER}};
    border-radius: 8px;
    padding: 10px;
}

QLabel#PaymentRemainingLabel[state="change"] {
    color: {{SUCCESS}};
    background-color: rgba(57, 255, 20, 0.08);
    border-color: {{SUCCESS}};
}

QLabel#PaymentFieldLabel {
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
    font-weight: bold;
}

QLabel#PaymentMethodLabel {
    font-weight: bold;
    font-size: 18px;
    color: {{ACCENT}};
}

QLineEdit#PaymentAmountInput {
    background-color: {{SURFACE_1}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    border-radius: 6px;
    padding: 8px;
    font-size: 28px;
}

QLineEdit#PaymentAmountInput:focus {
    border-color: {{ACCENT}};
}

QComboBox#PaymentCustomerCombo {
    font-size: 14px;
    padding: 5px;
    color: {{TEXT}};
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: 4px;
}

QPushButton#BtnAddPayment {
    background-color: {{SURFACE_3}};
    color: {{TEXT}};
    font-weight: bold;
    font-size: 14px;
    padding: 10px;
    border: 1px solid {{BORDER}};
    border-radius: 6px;
}

QPushButton#BtnAddPayment:hover {
    background-color: {{BORDER}};
    border-color: {{ACCENT}};
}

QListWidget#PaymentList {
    font-size: 14px;
    color: {{TEXT}};
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER_STRONG}};
    border-radius: 6px;
    padding: 2px;
}

/* Overrides the generic "QListWidget::item, QTableWidget::item { padding:
   12px; border-bottom: 1px; }" rule above for this specific list. That
   box model is applied by the view AFTER setSizeHint() already reserved
   a rect for the row, invisible to the Python layout code -- it was
   insetting the embedded row widget by 12+12+1=25px inside whatever
   height setSizeHint() reserved, squeezing a 61px-tall row down to a
   36px-tall widget and badly clipping both the remove button and the
   row's own text. The separator is a real child widget inside the row
   now (see PaymentListItemSeparator), so this list needs none of the
   generic rule's own decoration. */
QListWidget#PaymentList::item {
    padding: 0;
    border-bottom: none;
}

QWidget#PaymentListItemWidget, QWidget#PaymentListItemRow {
    background: transparent;
}

QFrame#PaymentListItemSeparator {
    background-color: {{BORDER}};
}

QLabel#PaymentListItemLabel {
    color: {{TEXT}};
    font-size: 14px;
    background: transparent;
}

QPushButton#BtnRemovePayment {
    background-color: transparent;
    border: 1px solid {{DANGER}};
    border-radius: 6px;
    padding: 4px;
}

QPushButton#BtnRemovePayment:hover {
    background-color: rgba(255, 65, 54, 0.2);
    border-color: {{DANGER}};
}

QFrame#PaymentSeparator {
    background-color: {{BORDER}};
    max-height: 1px;
}

QPushButton#BtnFinishSale {
    background-color: {{SURFACE_3}};
    color: {{TEXT_DISABLED}};
    font-size: 16px;
    font-weight: bold;
    border: none;
    border-radius: 8px;
}

QPushButton#BtnFinishSale:enabled {
    background-color: {{SUCCESS}};
    color: {{ON_ACCENT}};
}

QPushButton#BtnFinishSale:enabled:hover {
    background-color: {{SUCCESS}};
}

QLabel#PaymentMethodsHeader {
    font-size: 13px;
    font-weight: bold;
    color: {{TEXT_SECONDARY}};
    letter-spacing: 1px;
}

QFrame#PaymentLoyaltyFrame {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    padding: 4px;
}

QLabel#PaymentLoyaltyInfo {
    font-size: 13px;
    color: {{TEXT_SOFT}};
}

QLabel#PaymentLoyaltyRedeemed {
    font-size: 13px;
    font-weight: bold;
    color: {{SUCCESS}};
}

QPushButton#BtnRedeemLoyalty {
    background-color: {{ACCENT}};
    color: {{TEXT}};
    font-weight: bold;
    font-size: 12px;
    border-radius: 4px;
    padding: 4px 12px;
}

QPushButton#BtnRedeemLoyalty:hover {
    background-color: {{ACCENT}};
}

QPushButton#BtnRedeemLoyalty:disabled {
    background-color: {{SURFACE_3}};
    color: {{TEXT_DISABLED}};
}

QPushButton#BtnCancelLoyalty {
    background-color: {{DANGER_BG}};
    color: {{DANGER}};
    border: 1px solid {{DANGER}};
    font-size: 12px;
    border-radius: 4px;
    padding: 4px 12px;
}

QPushButton#BtnCancelLoyalty:hover {
    background-color: {{DANGER_BG}};
}

/* Payment Method Buttons */
QPushButton#PayMethodBtn {
    background-color: {{SURFACE_1}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    padding: 0px;
}

QPushButton#PayMethodBtn:hover {
    background-color: {{SURFACE_3}};
    border-color: {{ACCENT}};
}

QPushButton#PayMethodBtn[selected="true"] {
    border: 2px solid {{ACCENT}};
    background-color: rgba(0, 188, 235, 0.12);
}

QPushButton#PayMethodBtn[methodType="cash"] {
    background-color: {{SUCCESS_BG}};
    border: 1px solid {{SUCCESS_BG}};
}

QPushButton#PayMethodBtn[methodType="cash"]:hover {
    background-color: {{SUCCESS_BG}};
    border-color: {{SUCCESS}};
}

QPushButton#PayMethodBtn[methodType="cash"][selected="true"] {
    border: 2px solid {{SUCCESS}};
    background-color: {{SUCCESS_BG}};
}

QPushButton#PayMethodBtn QLabel#PayMethodShortcut {
    color: {{TEXT_DISABLED}};
    font-size: 9px;
    font-weight: normal;
    background: transparent;
}

QPushButton#PayMethodBtn QLabel#PayMethodName {
    color: {{TEXT}};
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}

QPushButton#PayMethodBtn[methodType="cash"] QLabel#PayMethodName {
    color: {{TEXT}};
}

QPushButton#PayMethodBtn[methodType="cash"] QLabel#PayMethodShortcut {
    color: rgba(255, 255, 255, 0.6);
}

/* ── Advanced Search Dialog ── */
QDialog#AdvancedSearchDialog {
    background-color: {{SURFACE_0}};
    color: {{TEXT}};
}

QDialog#AdvancedSearchDialog QLabel {
    background: transparent;
    color: {{TEXT}};
}

QLabel#AdvSearchTitle {
    font-size: 20px;
    font-weight: bold;
    color: {{TEXT}};
}

QLabel#SearchFilterLabel {
    color: {{TEXT_SECONDARY}};
    font-size: 14px;
}

QLabel#SearchResultCount {
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
}

QTableWidget#SearchResultsTable {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    gridline-color: {{BORDER}};
    color: {{TEXT}};
}

QTableWidget#SearchResultsTable::item:selected {
    background-color: rgba(0, 188, 235, 0.2);
}

QPushButton#BtnSearchSelect {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    font-weight: bold;
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
}

QPushButton#BtnSearchSelect:hover {
    background-color: {{ACCENT_HOVER}};
}

/* Quantity Dialog */
QDialog#QuantityDialog, QDialog#VoidReasonDialog, QDialog#BackupPasswordDialog {
    background-color: {{SURFACE_0}};
}

QLabel#QtyProductName {
    color: {{TEXT}};
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}

QLineEdit#QtyInput {
    background-color: {{SURFACE_2}};
    color: {{TEXT}};
    font-size: 24px;
    font-weight: bold;
    border: 2px solid {{BORDER}};
    border-radius: 6px;
    padding: 8px;
}

QLineEdit#QtyInput:focus {
    border: 2px solid {{ACCENT}};
}

/* Discount Dialog */
/* This dialog used to be styled entirely in a "navy" palette
   (#001F3F/#002B55/#003366/#004080) left over from before the app's
   navy-retirement pass (#260) -- every OTHER dialog in this app (e.g.
   QDialog#PaymentDialog) uses the real dark theme's #1E1E1E/#252526
   surfaces, so this dialog visibly looked like it belonged to a
   different, older app. The bright accent colors (#00BCEB cyan, #39FF14
   green, #FF4136 red) were already correct and are unchanged below. */
QDialog#DiscountDialog {
    background-color: {{SURFACE_0}};
    color: white;
}

QDialog#DiscountDialog QLabel[class="dialog-title"] {
    font-size: 18px;
    font-weight: bold;
    color: {{TEXT}};
    padding: 0 0 4px;
}

QFrame#DiscountTypeFrame {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: 6px;
}

/* Checkable QPushButtons, not QRadioButtons -- see discount_dialog.py.
   QPushButton centers its own text, which a segmented control needs. */
QPushButton#RbPercent, QPushButton#RbFixed {
    background-color: transparent;
    color: {{TEXT}};
    font-size: 15px;
    font-weight: bold;
    padding: 10px 12px;
    border: none;
    border-radius: 4px;
}

QPushButton#RbPercent:hover, QPushButton#RbFixed:hover {
    background-color: rgba(0, 188, 235, 0.12);
}

QPushButton#RbPercent:checked, QPushButton#RbFixed:checked {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
}

QDoubleSpinBox#DiscountValueInput {
    font-size: 36px;
    font-weight: bold;
    padding: 12px;
    border: 2px solid {{ACCENT}};
    border-radius: 8px;
    background-color: {{SURFACE_1}};
    color: {{TEXT}};
    min-height: 50px;
}

QDoubleSpinBox#DiscountValueInput:focus {
    border-color: {{ACCENT}};
}

QDoubleSpinBox#DiscountValueInput::up-button,
QDoubleSpinBox#DiscountValueInput::down-button {
    width: 0px;
}

QPushButton[class="PresetBtn"] {
    background-color: {{SURFACE_1}};
    color: {{ACCENT}};
    font-weight: bold;
    font-size: 15px;
    border: 1px solid {{ACCENT}};
    border-radius: 6px;
    padding: 8px;
}

QPushButton[class="PresetBtn"]:hover {
    background-color: rgba(0, 188, 235, 0.15);
    color: {{TEXT}};
}

QPushButton[class="PresetBtn"]:pressed {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
}

QPushButton[class="PresetBtn"]:disabled {
    background-color: {{SURFACE_0}};
    color: {{TEXT_DISABLED}};
    border-color: {{BORDER}};
}


QPushButton#BtnApplyDiscount {
    background-color: {{SUCCESS}};
    color: {{ON_ACCENT}};
    font-weight: bold;
    font-size: 15px;
    border: none;
    border-radius: 6px;
}

QLabel#ProformaTotalLabel,
QLabel#GrnTotalLabel {
    font-size: 16px;
    font-weight: bold;
    color: {{TEXT}};
}

QPushButton#BtnApplyDiscount:hover {
    background-color: {{SUCCESS}};
}

QPushButton#BtnApplyDiscount:pressed {
    background-color: {{SUCCESS}};
}

/* Customer Editor */
QDialog#CustomerEditor, QDialog#CustomerQuickAddDialog {
    background-color: {{SURFACE_0}};
    color: white;
}

/* ── Receipt Options Dialog — Dark ──────────────────────────────── */
QDialog#ReceiptOptionsDialog {
    background-color: {{SURFACE_0}};
    color: {{TEXT_SOFT}};
}

QLabel#ReceiptSuccessIcon {
    background: transparent;
}

QLabel#ReceiptTitle {
    font-size: 20px;
    font-weight: bold;
    color: {{SUCCESS}};
    background: transparent;
}

QWidget#ReceiptInfoCard {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
}

QLabel#ReceiptInfoOrder {
    font-size: 13px;
    color: {{TEXT_SECONDARY}};
    background: transparent;
}

QLabel#ReceiptInfoTotal {
    font-size: 22px;
    font-weight: bold;
    color: {{TEXT}};
    background: transparent;
}

QPushButton#ReceiptBtnPrint {
    background-color: {{SURFACE_1}};
    color: {{TEXT}};
    border: 1px solid {{ACCENT}};
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding-left: 16px;
    text-align: left;
}

QPushButton#ReceiptBtnPrint:hover {
    background-color: rgba(0, 188, 235, 0.12);
    border-color: {{ACCENT}};
}

QPushButton#ReceiptBtnPrint:pressed {
    background-color: rgba(0, 188, 235, 0.22);
}

QPushButton#ReceiptBtnEmail {
    background-color: {{SURFACE_1}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding-left: 16px;
    text-align: left;
}

QPushButton#ReceiptBtnEmail:hover {
    background-color: {{SURFACE_2}};
    border-color: {{BORDER_STRONG}};
}

QPushButton#ReceiptBtnEmail:pressed {
    background-color: {{SURFACE_3}};
}

QPushButton#ReceiptBtnSavePdf {
    background-color: {{SURFACE_1}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding-left: 16px;
    text-align: left;
}

QPushButton#ReceiptBtnSavePdf:hover {
    background-color: {{SURFACE_2}};
    border-color: {{BORDER_STRONG}};
}

QPushButton#ReceiptBtnSavePdf:pressed {
    background-color: {{SURFACE_3}};
}


/* ===================================================================
   LOGIN VIEW STYLES - Dark Theme
   ================================================================ */

/* === LOGIN LEFT PANEL === */
QWidget#LoginLeftPanel {
    background-color: {{ON_ACCENT}};  /* Deep navy branding panel */
}

/* Ensure all labels in login left panel have transparent backgrounds */
QWidget#LoginLeftPanel QLabel {
    background-color: transparent;
}

QLabel#WelcomeText {
    font-size: 24px;
    color: {{ACCENT}};  /* Cyan accent */
    font-weight: bold;
    margin-top: 20px;
}

QLabel#LoginTagline {
    color: {{ACCENT_HOVER}};
    font-size: 13px;
    background: transparent;
    padding: 0 30px;
}

QLabel#FooterLabel {
    color: {{TEXT_SOFT}};  /* Lighter gray for better visibility */
    font-size: 12px;
}

QLabel#LogoText {
    color: white;
    font-size: 36px;
    font-weight: bold;
}

/* === LOGIN RIGHT PANEL === */
QWidget#LoginRightPanel {
    background-color: {{SURFACE_0}};
}

QLabel#PinHeading {
    font-size: 22px;
    font-weight: bold;
    color: {{TEXT}};
    margin-bottom: 10px;
    background: transparent;
}

QLabel#LoginErrorLabel {
    color: {{DANGER}};
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}

QLabel#LoginHelpHint {
    color: {{TEXT_SECONDARY}};
    font-size: 12px;
    background: transparent;
    margin-top: 15px;
}

/* === PIN INPUT FIELD === */
QLineEdit#PinInput {
    background-color: {{SURFACE_0}};
    border: 2px solid {{ACCENT}};  /* Cyan border */
    border-radius: 8px;
    padding: 15px;
    font-size: 32px;
    font-weight: bold;
    letter-spacing: 8px;  /* Space out PIN dots */
    color: white;
}

QLineEdit#PinInput:focus {
    border: 2px solid {{ACCENT_HOVER}};  /* Brighter cyan on focus */
    background-color: {{SURFACE_2}};  /* Slightly lighter background */
}

/* === NUMPAD BUTTONS === */
/* Base styling for all numpad buttons */
QWidget#NumpadContainer {
    background: transparent;
}

QPushButton#NumpadBtn {
    background-color: {{SURFACE_2}};
    border: 2px solid {{BORDER}};
    border-radius: 8px;
    color: white;
    font-size: 24px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#NumpadBtn:hover {
    background-color: {{BORDER}};
    border-color: {{ACCENT}};
}

QPushButton#NumpadBtn:pressed {
    background-color: {{SURFACE_0}};
}

/* Clear button (Red) */
QPushButton#NumpadBtn[btnType="clear"] {
    color: {{DANGER}};  /* Brighter red for dark theme */
    border-color: {{DANGER}};
    background-color: {{SURFACE_0}};
}

QPushButton#NumpadBtn[btnType="clear"]:hover {
    background-color: {{SURFACE_1}};
    border-color: {{DANGER}};
}

/* Enter button (Green) */
QPushButton#NumpadBtn[btnType="enter"] {
    color: {{SUCCESS}};  /* Brighter green for dark theme */
    border-color: {{SUCCESS_BG}};
    background-color: {{SURFACE_0}};
}

QPushButton#NumpadBtn[btnType="enter"]:hover {
    background-color: {{SURFACE_1}};
    border-color: {{SUCCESS}};
}

/* ===================================================================
   DASHBOARD / MANAGEMENT VIEW STYLES - Dark Theme
   ================================================================ */

/* === INFO CARDS (#543) === */
QFrame#InfoCard {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
}

QFrame#InfoCard:hover {
    border-color: {{BORDER_STRONG}};
}

QLabel#InfoCardIcon {
    background-color: transparent;
}

QLabel#InfoCardTitle {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

QLabel#InfoCardValue {
    background-color: transparent;
    color: {{TEXT}};
    font-size: 18px;
    font-weight: bold;
}

QLabel#CardTrend[trendType="positive"] {
    color: {{SUCCESS}};  /* Clean green */
}

QLabel#CardTrend[trendType="negative"] {
