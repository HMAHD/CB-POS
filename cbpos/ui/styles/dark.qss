/* 
    Ceylon Byte POS - Command Center Dark Theme 
    Palette:
    - Background: #1E1E1E (Global BG) / #252526 (Surface)
    - Text: #FFFFFF (Primary) / #AAAAAA (Secondary)
    - Border: #3E3E42
    - Accent: #00BCEB (Cyan)
    - Success: #39FF14 (Neon Green)
    - Warning: #FFDC00
    - Error: #FF4136
*/

/* Global Font Enforcement */
* {
    font-family: "{{FONT_FAMILY}}", "Noto Sans";
}

QLabel.PlaceholderLabel {
    color: #AAAAAA;
}

QLabel.AboutLabel {
    font-size: 16px;
    color: #AAAAAA;
}

/* Global Reset */
QWidget {
    background-color: #1E1E1E;
    color: #FFFFFF;
    font-size: {{FONT_SIZE}};
}

/* Inputs - Global Baseline */
QLineEdit {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 8px;
    font-size: 16px;
    color: #FFFFFF;
    selection-background-color: #00BCEB;
    selection-color: #000000;
}

QLineEdit:focus {
    border: 1px solid #00BCEB;
    background-color: #2D2D30;
}

/* Date pickers - Global Baseline (13 of 15 sites in the app had no styling
   at all before this; only #ReportDateEdit/#PeriodDateEdit had one-off
   rules). A generic type selector styles every QDateEdit automatically,
   including any without an objectName. */
QDateEdit {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 14px;
    color: #FFFFFF;
}

QDateEdit:focus {
    border: 1px solid #00BCEB;
    background-color: #2D2D30;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #3E3E42;
    background-color: #2D2D30;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QDateEdit::drop-down:hover {
    background-color: #333333;
}

/* Context/dropdown menus - Global Baseline. Previously the only QMenu
   rule in this file was scoped to QCalendarWidget QMenu, so every other
   right-click menu in the app (e.g. the Sales screen's cart line-item
   menu) rendered with the OS's native popup chrome instead of this
   theme, even though the surrounding code already manually re-tints
   the menu's icons per theme. A generic selector styles every QMenu at
   once, the same way QDateEdit/QLineEdit above do for their types. */
QMenu {
    background-color: #252526;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: rgba(0, 188, 235, 0.14);
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #666666;
}

QMenu::separator {
    height: 1px;
    background-color: #3E3E42;
    margin: 4px 8px;
}

QMenu::icon {
    padding-left: 8px;
}

QCalendarWidget {
    background-color: #252526;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #2D2D30;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #FFFFFF;
    font-size: 13px;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton:hover {
    background-color: #333333;
}

QCalendarWidget QMenu {
    background-color: #252526;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
}

QCalendarWidget QSpinBox {
    background-color: #2D2D30;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #252526;
    color: #FFFFFF;
    selection-background-color: #00BCEB;
    selection-color: #000000;
    outline: none;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #5A5A5A;
}

/* The app-wide QHeaderView::section rule (navy, bold, 10px padding, meant
   for real tables) also matches QCalendarWidget's internal day-name header
   row -- this scoped override keeps the popup's header compact instead of
   an oversized navy bar. */
QCalendarWidget QHeaderView::section {
    background-color: #2D2D30;
    color: #AAAAAA;
    padding: 4px;
    font-weight: normal;
    font-size: 12px;
    border: none;
    border-bottom: 1px solid #3E3E42;
}

/* ComboBox - Dropdown Selector */
QComboBox {
    background-color: #2D2D30;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 8px 12px;
    padding-right: 35px;  /* Space for arrow */
    font-size: 14px;
    color: #FFFFFF;
    min-height: 32px;
}

QComboBox:hover {
    border: 1px solid #00BCEB;
    background-color: #333337;
}

QComboBox:focus {
    border: 2px solid #00BCEB;
    background-color: #333337;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #555555;  /* Separator line */
    background: #3E3E42;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::drop-down:hover {
    background: #004466;  /* Darker hover */
    border-left: 1px solid #00BCEB;
}

QComboBox::down-arrow {
    image: url(cbpos/assets/icons/chevron-down-cyan.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #252526;
    border: 1px solid #00BCEB;
    selection-background-color: #00BCEB;
    selection-color: #000000;
    color: #FFFFFF;
    padding: 4px;

}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 28px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #2D2D30;
    color: #00BCEB;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #00BCEB;
    color: #000000;
}

/* SpinBox - Number Input (Modern Touch-Friendly Design) */
QSpinBox, QDoubleSpinBox {
    background-color: #2D2D30;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 8px 12px;
    padding-right: 35px;  /* Space for wider buttons */
    font-size: 14px;
    color: #FFFFFF;
    min-height: 36px;  /* Touch-friendly height */
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #00BCEB;
    background-color: #333337;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #00BCEB;
    background-color: #333337;
}

/* UP Button (+) - Clear plus icon */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 30px;
    height: 18px;
    border-left: 1px solid #555555;
    border-bottom: 1px solid #555555;
    background-color: #3E3E42;
    border-top-right-radius: 4px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #00BCEB;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed {
    background-color: #0099CC;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(cbpos/assets/icons/plus-white.svg);
    width: 12px;
    height: 12px;
}

/* DOWN Button (-) - Clear minus icon */
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 30px;
    height: 18px;
    border-left: 1px solid #555555;
    border-top: 1px solid #555555;
    background-color: #3E3E42;
    border-bottom-right-radius: 4px;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #00BCEB;
}

QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #0099CC;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(cbpos/assets/icons/minus-white.svg);
    width: 12px;
    height: 12px;
}

/* Denomination Widget (Start Shift / Shift Closing cash count, #525) */
QLabel#DenomLabel {
    font-size: 14px;
    font-weight: bold;
    color: #E0E0E0;
}

QLabel#DenomRowTotal {
    font-size: 13px;
    color: #AAAAAA;
}

QLabel#DenomGrandTotalLabel {
    font-size: 16px;
    font-weight: bold;
    color: #00BCEB;
}

QLabel#DenomGrandTotalValue {
    font-size: 20px;
    font-weight: bold;
    color: #39FF14;
}

/* Checkboxes - Toggle Style with Checkmark */
QCheckBox {
    spacing: 10px;
    color: #E0E0E0;
    background-color: transparent;
}

/* Unchecked State - Empty box with visible border */
QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #666666;
    border-radius: 4px;
    background-color: transparent;
}

/* Unchecked Hover - Cyan glow */
QCheckBox::indicator:unchecked:hover {
    border-color: #00BCEB;
    background-color: rgba(0, 188, 235, 0.1);
}

/* Checked State - Cyan fill with white checkmark */
QCheckBox::indicator:checked {
    background-color: #00BCEB;
    border-color: #00BCEB;
    image: url(cbpos/assets/icons/check-white.svg);
}

/* Checked Hover - Brighter cyan with checkmark */
QCheckBox::indicator:checked:hover {
    background-color: #00E5FF;
    border-color: #00E5FF;
    image: url(cbpos/assets/icons/check-white.svg);
}

/* Tree/table item checkboxes (e.g. Permission Manager) rendered plain
   grey native OS squares -- ::indicator on QTreeWidget/QTableWidget
   picks up the exact same themed style as a real QCheckBox (#298). */
QTreeWidget::indicator, QTableWidget::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #666666;
    border-radius: 4px;
    background-color: transparent;
}

QTreeWidget::indicator:checked, QTableWidget::indicator:checked {
    background-color: #00BCEB;
    border-color: #00BCEB;
    image: url(cbpos/assets/icons/check-white.svg);
}

/* Locked cells (e.g. Admin's critical permissions, #614) */
QTreeWidget::indicator:checked:disabled, QTableWidget::indicator:checked:disabled {
    background-color: #3E3E42;
    border-color: #3E3E42;
}

/* Buttons */
QPushButton {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 10px 20px;
    font-weight: bold;
    color: #FFFFFF;
}

QPushButton:hover {
    background-color: #3E3E42;
    border: 1px solid #555;
}

QPushButton:pressed {
    background-color: #007ACC;
}

/* Primary Action Button (Green) */
QPushButton#BtnSave, QPushButton#PayBtn, QPushButton[class="primary"] {
    background-color: #2ECC40;
    color: #001F3F;
    border: none;
}

QPushButton#BtnSave:hover, QPushButton#PayBtn:hover, QPushButton[class="primary"]:hover {
    background-color: #27AE36;
}

/* Danger Button (Red) */
QPushButton#BtnCancel, QPushButton#VoidBtn, QPushButton[class="danger"] {
    background-color: #FF4136;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnCancel:hover, QPushButton#VoidBtn:hover, QPushButton[class="danger"]:hover {
    background-color: #E0362C;
}

/* Accent Button (Cyan) */
QPushButton[class="accent"] {
    background-color: #00BCEB;
    color: #001F3F;
    border: none;
    font-weight: bold;
}

QPushButton[class="accent"]:hover {
    background-color: #00A5D0;
}

/* Secondary Button (neutral, outlined -- dismiss/close actions that
   aren't destructive enough for the red Danger style) */
QPushButton[class="secondary"] {
    background-color: transparent;
    color: #E5E5E5;
    border: 1px solid #3E3E42;
}

QPushButton[class="secondary"]:hover {
    background-color: #3E3E42;
}

/* Warning Button (Yellow) */
QPushButton[class="warning"] {
    background-color: #FFDC00;
    color: #001F3F;
    border: none;
}

/* --- Dialog Label Classes --- */
QLabel[class="dialog-title"] {
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}

QLabel[class="muted"] {
    color: #AAAAAA;
    background: transparent;
}

QLabel[class="debit"] {
    font-weight: bold;
    color: #FF4136;
    background: transparent;
}

QLabel[class="credit"] {
    font-weight: bold;
    color: #39FF14;
    background: transparent;
}

QLabel[class="bold"] {
    font-weight: bold;
    background: transparent;
}

QLabel[class="transparent"] {
    background: transparent;
}

/* Lists & Tables */
QListWidget, QTableWidget {
    background-color: #252526;
    border: 1px solid #3E3E42;

    gridline-color: #3E3E42;
    alternate-background-color: #2D2D30;
}

QListWidget::item, QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #3E3E42;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #007ACC;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #003366; /* Navy Header */
    color: #FFFFFF;
    padding: 10px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #00BCEB;
}

QTableCornerButton::section {
    background-color: #003366;
    border: none;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #1E1E1E;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #444;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ScrollArea Transparency Fix */
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #3E3E42;
    background-color: #252526;
}

QTabBar::tab {
    background: #2D2D30;
    color: #AAAAAA;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #007ACC;
    color: #FFFFFF;
    font-weight: bold;
}

/* Group Box */
QGroupBox {
    border: 1px solid #3E3E42;
    border-radius: 4px;
    margin-top: 20px;
    font-weight: bold;
    background-color: #252526;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #00BCEB;
}

/* --- FIX: Force Transparency for Labels & Checkboxes inside GroupBoxes --- */
QGroupBox QLabel {
    background-color: transparent;
    color: #E0E0E0;
}

QGroupBox QCheckBox {
    background-color: transparent;
    color: #E0E0E0;
}

/* --- Sidebar --- */
/* Sidebar Container - Dark Mode */
QFrame#SidebarContainer,
QFrame#Sidebar {
    background-color: #252526;  /* Documented Surface tone -- distinct from the #1E1E1E canvas */
    border-right: 1px solid #333333;
}

/* User Profile Section - Dark Mode (KILL THE LINES) */
QWidget#UserProfileContainer {
    background-color: transparent;  /* Blend with sidebar */
    border: none;  /* Remove all borders */
    border: none;  /* Remove focus outline */
}

/* ── POS Side Menu (Hamburger Panel) ─ Dark ────────────────────── */
QWidget#POSSideMenu {
    background-color: #1A1A1A;
    border-left: 1px solid #2A2A2A;
}

QWidget#POSSideMenu QLabel {
    background-color: transparent;
    color: #E0E0E0;
}

QWidget#POSSideMenu QFrame[frameShape="4"] {
    background-color: #2A2A2A;
}

/* Section Header */
QLabel#MenuSectionHeader {
    color: #555555;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    background: transparent;
}

/* Nav Tiles — 2-column grid */
QPushButton#NavTile {
    background-color: #252526;
    border: 1px solid #333333;
    border-radius: 8px;
}

QPushButton#NavTile:hover {
    background-color: #2D2D30;
    border-color: #00BCEB;
}

QPushButton#NavTile[active="true"] {
    background-color: rgba(0, 188, 235, 0.10);
    border-color: #00BCEB;
}

/* pt scales with DPI (px doesn't) — #207 */
QLabel#NavTileText {
    font-size: 9pt;
}

/* User Profile Row */
QWidget#UserProfileRow {
    background-color: rgba(255, 255, 255, 0.03);
}

QLabel#MenuUsername {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}

QLabel#MenuRole {
    color: #777777;
    font-size: 12px;
    font-weight: normal;
    background: transparent;
}

/* Sign Out button */
QPushButton#SignOutBtn {
    background: transparent;
    border: none;
    color: #999999;
    font-size: 13px;
    font-weight: normal;
    text-align: left;
    padding: 0;

}

QPushButton#SignOutBtn:hover {
    color: #FF4136;
}

/* Icon Buttons (bottom toolbar) */
QPushButton#IconButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
}

QPushButton#IconButton:hover {
    background-color: #2A2A2A;
}

QPushButton#IconButton:pressed {
    background-color: #333333;
}

QLabel#SidebarLogo {
    color: white;
    font-weight: bold;
    font-size: 20px;  /* Larger for better visibility */
}

QToolButton#SidebarToggle {
    border: none;
    background: transparent;
}

/* Sidebar section break -- a resting point between groups of nav items
   (operational screens vs. management/admin ones), instead of one flat,
   undifferentiated 10-item list (#315). The divider line stays visible
   in collapsed mode; the label text hides (no room for it, see
   CollapsibleSidebar._update_all_styles). */
QFrame#SidebarSectionDivider {
    background-color: #333333;
    border: none;
    margin: 6px 16px 0 16px;
}

QLabel#SidebarSectionLabel {
    color: #6B7280;
    font-size: 10px;
    font-weight: bold;
    padding: 6px 20px 4px 20px;
    background: transparent;
}

/* Sidebar Buttons -- a floating rounded pill (inset margin + radius)
   instead of a flat, edge-to-edge square with a hairline accent bar. */
QToolButton#SidebarButton {
    background-color: transparent;
    color: #AAAAAA;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding-left: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin: 1px 10px;
    min-height: 36px;
    font-size: 15px;  /* Slightly larger for readability */
    font-weight: normal;
}

QToolButton#SidebarButton:hover {
    background-color: rgba(255, 255, 255, 0.06);
    color: white;
}

QToolButton#SidebarButton:checked, QToolButton#SidebarButton[active="true"] {
    background-color: rgba(0, 188, 235, 0.14);
    color: #00BCEB;
    font-weight: bold;
}

/* Collapsed State (via Property) */
QToolButton#SidebarButton[collapsed="true"] {
    padding-left: 0px;
    padding-right: 0px;
    text-align: center;
    margin: 1px 10px;
}

/* Bottom "exit cluster" divider -- pulls POS/Logout visually away from
   the nav list above, so they read as two consequential actions rather
   than two more rows in the same list. */
QFrame#SidebarBottomDivider {
    background-color: #333333;
    border: none;
    margin: 0 16px;
}

/* Special Sidebar Buttons -- rounded, tinted action chips (matching the
   bordered-pill treatment BtnLogout already had) instead of a flat,
   full-width bar. */
QToolButton#BtnPos {
    color: #39FF14;
    background-color: rgba(57, 255, 20, 0.12);
    border: 1px solid rgba(57, 255, 20, 0.35);
    border-radius: 8px;
    min-height: 40px;
    text-align: left;
    padding-left: 16px;
    margin: 4px 10px;
    font-weight: bold;
}

QToolButton#BtnPos:hover {
    background-color: rgba(57, 255, 20, 0.2);
}

QToolButton#BtnPos[collapsed="true"] {
    text-align: center;
    padding-left: 0px;
    margin: 4px 10px;
}

QToolButton#BtnLogout {
    color: #FF4136;
    background-color: rgba(255, 65, 54, 0.12);
    border: 1px solid rgba(255, 65, 54, 0.35);
    border-radius: 8px;
    min-height: 40px;
    text-align: left;
    padding-left: 16px;
    margin: 4px 10px 8px 10px;
    font-weight: bold;
}

QToolButton#BtnLogout:hover {
    background-color: rgba(255, 65, 54, 0.2);
}

QToolButton#BtnLogout[collapsed="true"] {
    text-align: center;
    padding-left: 0px;
    margin: 4px 10px 8px 10px;
}

/* --- Sales View Specifics --- */

/* Header */
QWidget#HeaderWidget {
    background-color: #001226;
    border-bottom: 1px solid #003366;
}

QWidget#HeaderWidget QLabel {
    background: transparent;
}

QWidget#HeaderWidget QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
}

QWidget#HeaderWidget QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

QLabel#LogoLabel {
    color: #00BCEB;
    font-weight: bold;
    font-size: 16px;
    background: transparent;
}

QLabel#HeaderLogo {
    background: transparent;
}

QLabel#ItemCountLabel {
    color: #AAAAAA;
    font-size: 13px;
    background: transparent;
}

QLabel#EmptyCartLabel, QLabel#EmptyTableLabel {
    color: #555555;
    font-size: 16px;
    background: transparent;
    padding: 40px;
}

/* EmptyStateWidget's own layout already centers and spaces its icon/
   title/subtitle, so these carry no padding of their own (unlike the
   plain-label overlays above, which relied on padding to keep text off
   the container's edges). */
QLabel#EmptyStateIcon {
    background: transparent;
}

QLabel#EmptyStateTitle {
    color: #555555;
    font-size: 16px;
    background: transparent;
}

QLabel#EmptyStateSubtitle {
    color: #6B7280;
    font-size: 13px;
    background: transparent;
    padding: 0 40px;
}

/* Search Bar & Filters */
QWidget#SearchWidget {
    background-color: transparent;
}

QToolButton#SearchModeBtn {
    background-color: #2D2D30;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
}

QToolButton#SearchModeBtn:checked {
    background-color: #00BCEB;
    color: #000000;
    font-weight: bold;
}

/* Cart Table */
QTableWidget#CartTable {
    background-color: #252526;
    color: #FFFFFF;
    gridline-color: #3E3E42;
}

QTableWidget#CartTable::item:selected {
    background-color: rgba(0, 188, 235, 0.18);
    color: #FFFFFF;
}

QLabel[class="StrikethroughPrice"] {
    background-color: transparent;
    color: white;
}

QLabel#UndoToast {
    background-color: rgba(0, 31, 63, 0.92);
    color: #00BCEB;
    border: 1px solid #00BCEB;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}

/* No-receipt-printer notice on the Sales screen (#623) */
QFrame#PrinterNotice {
    background-color: rgba(255, 220, 0, 0.10);
    border-bottom: 1px solid #FFDC00;
}
QLabel#PrinterNoticeText {
    color: #FFDC00;
    font-size: 13px;
    background: transparent;
}
QPushButton#PrinterNoticeSetupBtn {
    background-color: transparent;
    color: #FFDC00;
    border: 1px solid #FFDC00;
    border-radius: 4px;
    padding: 4px 12px;
    font-weight: bold;
}
QPushButton#PrinterNoticeSetupBtn:hover {
    background-color: rgba(255, 220, 0, 0.18);
}
QToolButton#PrinterNoticeCloseBtn {
    background: transparent;
    color: #AAAAAA;
    border: none;
    padding: 4px 8px;
}
QToolButton#PrinterNoticeCloseBtn:hover {
    color: #FFFFFF;
}

/* Total Widget */
QWidget#TotalWidget {
    background-color: #252526;
    border-top: 2px solid #3E3E42;
    border-radius: 5px;
}

QWidget#TotalWidget QLabel {
    background: transparent;
}

QLabel#SubtotalLabel, QLabel#TaxLabel, QLabel#DiscountLabel {
    color: #AAAAAA;
    font-size: 14px;
    background: transparent;
}

QLabel#TotalLabel {
    font-size: 48px;
    font-weight: bold;
    color: #2ECC40;
    background: transparent;
}

QLabel#TotalLabel[compact="true"] {
    font-size: 36px;
}

/* Action Panel */
QWidget#ActionPanel {
    background-color: #1E1E1E;
    border-left: 1px solid #3E3E42;
}

QWidget#ActionPanel QLabel {
    background: transparent;
}

/* Section Headers */
QLabel#ActionSectionLabel {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
    padding-left: 2px;
}

QLabel#CustTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}

QFrame#CustomerPanel {
    background-color: #252528;
    border: 1px solid #3E3E42;
    border-radius: 8px;
}

QFrame#CustomerPanel QLabel {
    background: transparent;
}

QLabel#CustomerLabel {
    font-weight: bold;
    font-size: 14px;
    color: white;
    background: transparent;
}

QPushButton#BtnCustomerSelect {
    background-color: #007ACC;
    color: white;
    border: none;
    border-radius: 4px;
    font-weight: bold;
    padding: 5px 10px;
}

QPushButton#BtnCustomerSelect:hover {
    background-color: #0098E6;
}

QPushButton#BtnCustomerSelect:pressed {
    background-color: #005F99;
}

QFrame#PointsDivider {
    background-color: #3E3E42;
    border: none;
}

/* Without this, the row paints Qt's global QWidget background
   (#1E1E1E) instead of letting CustomerPanel's own #252528 surface
   show through, showing up as a separate darker block under the
   points row. */
QWidget#PointsRow {
    background: transparent;
}

/* No fill/border at all -- a badge/chip here read as a separate
   highlighted box floating on the card instead of plain card content,
   whatever tint it used. Plain colored text on the card's own theme
   background (transparent, so it shows the card's #252528) matches how
   every other label in this panel is styled. */
QFrame#CustomerPanel QLabel#PointsLabel {
    color: #FFDC00;
    font-weight: bold;
    font-size: 12px;
    background: transparent;
}

QPushButton#BtnCustomerClear {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    color: #888888;
}

QPushButton#BtnCustomerClear:hover {
    background-color: #3A3A3D;
    color: #FF4136;
}

/* Action Grid Button */
QPushButton#ActionGridBtn {
    background-color: #2A2A2D;
    border: 1px solid #3A3A3D;
    color: #FFFFFF;
    border-radius: 6px;
    padding: 0px;
}

QPushButton#ActionGridBtn:hover {
    background-color: #353538;
    border-color: #00BCEB;
}

QPushButton#ActionGridBtn:pressed {
    background-color: #00BCEB;
    color: #000000;
}

/* pt scales with DPI (px doesn't) — #207: these were inline px in Python,
   invisible at 150-200% Windows scaling. */
QPushButton#ActionGridBtn QLabel#lblText {
    font-size: 9pt;
    font-weight: 500;
}

QPushButton#ActionGridBtn QLabel#lblShortcut {
    font-size: 7pt;
}

/* Color accents — bottom border */
QPushButton#ActionGridBtn[btnColor="#FFDC00"] { border-bottom: 2px solid #FFDC00; }
QPushButton#ActionGridBtn[btnColor="#FF4136"] { border-bottom: 2px solid #FF4136; }

QPushButton#ActionGridBtn:pressed QLabel,
QPushButton#ActionGridBtn:pressed QLabel#lblText,
QPushButton#ActionGridBtn:pressed QLabel#lblShortcut {
    color: #000000;
}

/* Pay Button */
QPushButton#BtnPay {
    background-color: #2ECC40;
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    border: none;
    border-radius: 8px;
}

QPushButton#BtnPay:hover {
    background-color: #32E012;
}

QPushButton#BtnPay:pressed {
    background-color: #28B40E;
}

/* Brief flash when PAY is clicked on an empty cart (#209) */
QPushButton#BtnPay[state="error"] {
    background-color: #FF4136;
    border: 2px solid #FF6B5E;
}

/* Dashboard Cards */
QWidget#InfoCard {
    background-color: #003366;
    border-radius: 8px;
    border: 1px solid #00509E;
}

QLabel#InfoCardTitle {
    font-size: 12px;
    color: #AAAAAA;
}

/* Settings View — sidebar uses SidebarContainer + SidebarButton (shared with Management) */
QWidget#SettingsContent {
    background-color: #1E1E1E;
    color: #FFFFFF;
}

/* Settings Content Area - Improved Input Styling */
QWidget#SettingsContent QLineEdit,
QWidget#SettingsContent QComboBox,
QWidget#SettingsContent QSpinBox,
QWidget#SettingsContent QDoubleSpinBox,
QWidget#SettingsContent QTextEdit {
    background-color: #333337;
    color: #EEEEEE;
    border: 1px solid #555555;
    border-radius: 4px;
    padding-left: 10px;
    min-height: 32px;
    font-size: 14px;
}

QWidget#SettingsContent QLineEdit:focus,
QWidget#SettingsContent QComboBox:focus,
QWidget#SettingsContent QSpinBox:focus,
QWidget#SettingsContent QDoubleSpinBox:focus,
QWidget#SettingsContent QTextEdit:focus {
    border: 1px solid #00BCEB;
    background-color: #3A3A3E;
}

/* Settings Form Labels */
QWidget#SettingsContent QLabel {
    color: #DDDDDD;
    font-size: 14px;
}

QLabel[class="SectionHeader"] {
    font-size: 18px;
    font-weight: bold;
    color: #00BCEB;
    margin-bottom: 20px;
}

QFrame#SettingsFooter {
    background-color: #2D2D30;
    border-top: 1px solid #3E3E42;
}

/* --- Dialogs --- */

/* ── Payment Dialog ── */
QDialog#PaymentDialog {
    background-color: #1E1E1E;
    color: #FFFFFF;
}

QDialog#PaymentDialog QLabel {
    background: transparent;
    color: #FFFFFF;
}

QLabel#PaymentRemainingLabel {
    font-size: 28px;
    color: #FF6B6B;
    font-weight: bold;
    background-color: rgba(255, 65, 54, 0.1);
    border: 2px solid #FF4136;
    border-radius: 8px;
    padding: 10px;
}

QLabel#PaymentRemainingLabel[state="change"] {
    color: #39FF14;
    background-color: rgba(57, 255, 20, 0.08);
    border-color: #39FF14;
}

QLabel#PaymentFieldLabel {
    color: #AAAAAA;
    font-size: 13px;
    font-weight: bold;
}

QLabel#PaymentMethodLabel {
    font-weight: bold;
    font-size: 18px;
    color: #00BCEB;
}

QLineEdit#PaymentAmountInput {
    background-color: #252526;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 6px;
    padding: 8px;
    font-size: 28px;
}

QLineEdit#PaymentAmountInput:focus {
    border-color: #00BCEB;
}

QComboBox#PaymentCustomerCombo {
    font-size: 14px;
    padding: 5px;
    color: #FFFFFF;
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 4px;
}

QPushButton#BtnAddPayment {
    background-color: #333333;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 14px;
    padding: 10px;
    border: 1px solid #3E3E42;
    border-radius: 6px;
}

QPushButton#BtnAddPayment:hover {
    background-color: #404040;
    border-color: #00BCEB;
}

QListWidget#PaymentList {
    font-size: 14px;
    color: #FFFFFF;
    background-color: #252526;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 2px;
}

/* Overrides the generic "QListWidget::item, QTableWidget::item { padding:
   12px; border-bottom: 1px; }" rule above for this specific list. That
   box model is applied by the view AFTER setSizeHint() already reserved
   a rect for the row, invisible to the Python layout code -- it was
   insetting the embedded row widget by 12+12+1=25px inside whatever
   height setSizeHint() reserved, squeezing a 61px-tall row down to a
   36px-tall widget and badly clipping both the remove button and the
   row's own text. The separator is a real child widget inside the row
   now (see PaymentListItemSeparator), so this list needs none of the
   generic rule's own decoration. */
QListWidget#PaymentList::item {
    padding: 0;
    border-bottom: none;
}

QWidget#PaymentListItemWidget, QWidget#PaymentListItemRow {
    background: transparent;
}

QFrame#PaymentListItemSeparator {
    background-color: #3E3E42;
}

QLabel#PaymentListItemLabel {
    color: #FFFFFF;
    font-size: 14px;
    background: transparent;
}

QPushButton#BtnRemovePayment {
    background-color: transparent;
    border: 1px solid #FF4136;
    border-radius: 6px;
    padding: 4px;
}

QPushButton#BtnRemovePayment:hover {
    background-color: rgba(255, 65, 54, 0.2);
    border-color: #FF6B6B;
}

QFrame#PaymentSeparator {
    background-color: #3E3E42;
    max-height: 1px;
}

QPushButton#BtnFinishSale {
    background-color: #333333;
    color: #888888;
    font-size: 16px;
    font-weight: bold;
    border: none;
    border-radius: 8px;
}

QPushButton#BtnFinishSale:enabled {
    background-color: #39FF14;
    color: #001F3F;
}

QPushButton#BtnFinishSale:enabled:hover {
    background-color: #4DFF33;
}

QLabel#PaymentMethodsHeader {
    font-size: 13px;
    font-weight: bold;
    color: #AAAAAA;
    letter-spacing: 1px;
}

/* Payment Method Buttons */
QPushButton#PayMethodBtn {
    background-color: #252526;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 8px;
    padding: 0px;
}

QPushButton#PayMethodBtn:hover {
    background-color: #333333;
    border-color: #00BCEB;
}

QPushButton#PayMethodBtn[selected="true"] {
    border: 2px solid #00BCEB;
    background-color: rgba(0, 188, 235, 0.12);
}

QPushButton#PayMethodBtn[methodType="cash"] {
    background-color: #0D6832;
    border: 1px solid #1B8A4A;
}

QPushButton#PayMethodBtn[methodType="cash"]:hover {
    background-color: #0F7A3B;
    border-color: #39FF14;
}

QPushButton#PayMethodBtn[methodType="cash"][selected="true"] {
    border: 2px solid #39FF14;
    background-color: #0F7A3B;
}

QPushButton#PayMethodBtn QLabel#PayMethodShortcut {
    color: #888888;
    font-size: 9px;
    font-weight: normal;
    background: transparent;
}

QPushButton#PayMethodBtn QLabel#PayMethodName {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}

QPushButton#PayMethodBtn[methodType="cash"] QLabel#PayMethodName {
    color: #FFFFFF;
}

QPushButton#PayMethodBtn[methodType="cash"] QLabel#PayMethodShortcut {
    color: rgba(255, 255, 255, 0.6);
}

/* ── Advanced Search Dialog ── */
QDialog#AdvancedSearchDialog {
    background-color: #1E1E1E;
    color: #FFFFFF;
}

QDialog#AdvancedSearchDialog QLabel {
    background: transparent;
    color: #FFFFFF;
}

QLabel#AdvSearchTitle {
    font-size: 20px;
    font-weight: bold;
    color: #FFFFFF;
}

QLabel#SearchFilterLabel {
    color: #AAAAAA;
    font-size: 14px;
}

QLabel#SearchResultCount {
    color: #AAAAAA;
    font-size: 13px;
}

QTableWidget#SearchResultsTable {
    background-color: #252526;
    border: 1px solid #3E3E42;
    gridline-color: #3E3E42;
    color: #FFFFFF;
}

QTableWidget#SearchResultsTable::item:selected {
    background-color: rgba(0, 188, 235, 0.2);
}

QPushButton#BtnSearchSelect {
    background-color: #00BCEB;
    color: #000000;
    font-weight: bold;
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
}

QPushButton#BtnSearchSelect:hover {
    background-color: #33CCFF;
}

/* Quantity Dialog */
QDialog#QuantityDialog, QDialog#VoidReasonDialog {
    background-color: #1E1E1E;
}

QLabel#QtyProductName {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}

QLineEdit#QtyInput {
    background-color: #2A2A2A;
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    border: 2px solid #3E3E42;
    border-radius: 6px;
    padding: 8px;
}

QLineEdit#QtyInput:focus {
    border: 2px solid #00BCEB;
}

/* Discount Dialog */
/* This dialog used to be styled entirely in a "navy" palette
   (#001F3F/#002B55/#003366/#004080) left over from before the app's
   navy-retirement pass (#260) -- every OTHER dialog in this app (e.g.
   QDialog#PaymentDialog) uses the real dark theme's #1E1E1E/#252526
   surfaces, so this dialog visibly looked like it belonged to a
   different, older app. The bright accent colors (#00BCEB cyan, #39FF14
   green, #FF4136 red) were already correct and are unchanged below. */
QDialog#DiscountDialog {
    background-color: #1E1E1E;
    color: white;
}

QDialog#DiscountDialog QLabel[class="dialog-title"] {
    font-size: 18px;
    font-weight: bold;
    color: #FFFFFF;
    padding: 0 0 4px;
}

QFrame#DiscountTypeFrame {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 6px;
}

/* Checkable QPushButtons, not QRadioButtons -- see discount_dialog.py.
   QPushButton centers its own text, which a segmented control needs. */
QPushButton#RbPercent, QPushButton#RbFixed {
    background-color: transparent;
    color: #FFFFFF;
    font-size: 15px;
    font-weight: bold;
    padding: 10px 12px;
    border: none;
    border-radius: 4px;
}

QPushButton#RbPercent:hover, QPushButton#RbFixed:hover {
    background-color: rgba(0, 188, 235, 0.12);
}

QPushButton#RbPercent:checked, QPushButton#RbFixed:checked {
    background-color: #00BCEB;
    color: #1E1E1E;
}

QDoubleSpinBox#DiscountValueInput {
    font-size: 36px;
    font-weight: bold;
    padding: 12px;
    border: 2px solid #00BCEB;
    border-radius: 8px;
    background-color: #252526;
    color: #FFFFFF;
    min-height: 50px;
}

QDoubleSpinBox#DiscountValueInput:focus {
    border-color: #00BCEB;
}

QDoubleSpinBox#DiscountValueInput::up-button,
QDoubleSpinBox#DiscountValueInput::down-button {
    width: 0px;
}

QPushButton[class="PresetBtn"] {
    background-color: #252526;
    color: #00BCEB;
    font-weight: bold;
    font-size: 15px;
    border: 1px solid #00BCEB;
    border-radius: 6px;
    padding: 8px;
}

QPushButton[class="PresetBtn"]:hover {
    background-color: rgba(0, 188, 235, 0.15);
    color: #FFFFFF;
}

QPushButton[class="PresetBtn"]:pressed {
    background-color: #00BCEB;
    color: #1E1E1E;
}

QPushButton[class="PresetBtn"]:disabled {
    background-color: #1A1A1A;
    color: #555;
    border-color: #333;
}

/* Scoped to DiscountDialog specifically -- #BtnCancel is a shared object name
   used by several other dialogs, which already get the solid "Danger" style
   above. An unscoped rule here would collide with those (and, before the
   :not() selector elsewhere in this file was fixed to be valid CSS, a stray
   parse failure happened to mask this collision by accident). */
QDialog#DiscountDialog QPushButton#BtnCancel {
    background-color: transparent;
    color: #FF4136;
    font-weight: bold;
    font-size: 15px;
    border: 2px solid #FF4136;
    border-radius: 6px;
}

QDialog#DiscountDialog QPushButton#BtnCancel:hover {
    background-color: #FF4136;
    color: white;
}

QPushButton#BtnApplyDiscount {
    background-color: #39FF14;
    color: #001F3F;
    font-weight: bold;
    font-size: 15px;
    border: none;
    border-radius: 6px;
}

QPushButton#BtnApplyDiscount:hover {
    background-color: #2ECC40;
}

QPushButton#BtnApplyDiscount:pressed {
    background-color: #27AE36;
}

/* Customer Editor */
QDialog#CustomerEditor, QDialog#CustomerQuickAddDialog {
    background-color: #1E1E1E;
    color: white;
}

/* ── Receipt Options Dialog — Dark ──────────────────────────────── */
QDialog#ReceiptOptionsDialog {
    background-color: #1E1E1E;
    color: #E0E0E0;
}

QLabel#ReceiptSuccessIcon {
    background: transparent;
}

QLabel#ReceiptTitle {
    font-size: 20px;
    font-weight: bold;
    color: #39FF14;
    background: transparent;
}

QWidget#ReceiptInfoCard {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 8px;
}

QLabel#ReceiptInfoOrder {
    font-size: 13px;
    color: #AAAAAA;
    background: transparent;
}

QLabel#ReceiptInfoTotal {
    font-size: 22px;
    font-weight: bold;
    color: #FFFFFF;
    background: transparent;
}

QPushButton#ReceiptBtnPrint {
    background-color: #252526;
    color: #FFFFFF;
    border: 1px solid #00BCEB;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding-left: 16px;
    text-align: left;
}

QPushButton#ReceiptBtnPrint:hover {
    background-color: rgba(0, 188, 235, 0.12);
    border-color: #00BCEB;
}

QPushButton#ReceiptBtnPrint:pressed {
    background-color: rgba(0, 188, 235, 0.22);
}

QPushButton#ReceiptBtnEmail {
    background-color: #252526;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding-left: 16px;
    text-align: left;
}

QPushButton#ReceiptBtnEmail:hover {
    background-color: #2D2D30;
    border-color: #555555;
}

QPushButton#ReceiptBtnEmail:pressed {
    background-color: #333336;
}

QPushButton#ReceiptBtnSavePdf {
    background-color: #252526;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding-left: 16px;
    text-align: left;
}

QPushButton#ReceiptBtnSavePdf:hover {
    background-color: #2D2D30;
    border-color: #555555;
}

QPushButton#ReceiptBtnSavePdf:pressed {
    background-color: #333336;
}

QPushButton#ReceiptBtnClose {
    background-color: transparent;
    color: #888888;
    border: 1px solid #3E3E42;
    border-radius: 6px;
    font-size: 13px;
}

QPushButton#ReceiptBtnClose:hover {
    color: #CCCCCC;
    border-color: #555555;
    background-color: #2D2D30;
}

/* ===================================================================
   LOGIN VIEW STYLES - Dark Theme
   ================================================================ */

/* === LOGIN LEFT PANEL === */
QWidget#LoginLeftPanel {
    background-color: #001226;  /* Deep navy branding panel */
}

/* Ensure all labels in login left panel have transparent backgrounds */
QWidget#LoginLeftPanel QLabel {
    background-color: transparent;
}

QLabel#WelcomeText {
    font-size: 24px;
    color: #00BCEB;  /* Cyan accent */
    font-weight: bold;
    margin-top: 20px;
}

QLabel#LoginTagline {
    color: #7FAACC;
    font-size: 13px;
    background: transparent;
    padding: 0 30px;
}

QLabel#FooterLabel {
    color: #CCCCCC;  /* Lighter gray for better visibility */
    font-size: 12px;
}

QLabel#LogoText {
    color: white;
    font-size: 36px;
    font-weight: bold;
}

/* === LOGIN RIGHT PANEL === */
QWidget#LoginRightPanel {
    background-color: #1A1A1A;
}

QLabel#PinHeading {
    font-size: 22px;
    font-weight: bold;
    color: #FFFFFF;
    margin-bottom: 10px;
    background: transparent;
}

QLabel#LoginErrorLabel {
    color: #FF6B6B;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}

QLabel#LoginHelpHint {
    color: #666666;
    font-size: 11px;
    background: transparent;
    margin-top: 15px;
}

/* === PIN INPUT FIELD === */
QLineEdit#PinInput {
    background-color: #1A1A1A;
    border: 2px solid #00BCEB;  /* Cyan border */
    border-radius: 8px;
    padding: 15px;
    font-size: 32px;
    font-weight: bold;
    letter-spacing: 8px;  /* Space out PIN dots */
    color: white;
}

QLineEdit#PinInput:focus {
    border: 2px solid #33D4FF;  /* Brighter cyan on focus */
    background-color: #2A2A2A;  /* Slightly lighter background */
}

/* === NUMPAD BUTTONS === */
/* Base styling for all numpad buttons */
QWidget#NumpadContainer {
    background: transparent;
}

QPushButton#NumpadBtn {
    background-color: #2A2A2A;
    border: 2px solid #404040;
    border-radius: 8px;
    color: white;
    font-size: 24px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#NumpadBtn:hover {
    background-color: #3A3A3A;
    border-color: #00BCEB;
}

QPushButton#NumpadBtn:pressed {
    background-color: #1A1A1A;
}

/* Clear button (Red) */
QPushButton#NumpadBtn[btnType="clear"] {
    color: #FF6B6B;  /* Brighter red for dark theme */
    border-color: #DC3545;
    background-color: #2A1A1A;
}

QPushButton#NumpadBtn[btnType="clear"]:hover {
    background-color: #3A2020;
    border-color: #FF4136;
}

/* Enter button (Green) */
QPushButton#NumpadBtn[btnType="enter"] {
    color: #51CF66;  /* Brighter green for dark theme */
    border-color: #198754;
    background-color: #1A2A1A;
}

QPushButton#NumpadBtn[btnType="enter"]:hover {
    background-color: #203A20;
    border-color: #39FF14;
}

/* ===================================================================
   DASHBOARD / MANAGEMENT VIEW STYLES - Dark Theme
   ================================================================ */

/* === INFO CARDS === */
QFrame#InfoCard {
    background-color: #1A1A1A;  /* Flat dark gray - no gradient */
    border: 1px solid #2A2A2A;
    border-radius: 8px;
}

QLabel#CardIcon {
    background-color: transparent;
}

QLabel#CardTitle {
    background-color: transparent;
    color: #888888;  /* Muted gray for labels */
    font-size: 11px;
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QLabel#CardValue {
    background-color: transparent;
    color: #FFFFFF;
    font-size: 32px;
    font-weight: bold;
}

QLabel#CardTrend {
    background-color: transparent;
    font-size: 10px;
    font-weight: normal;
}

QLabel#CardTrend[trendType="positive"] {
    color: #10B981;  /* Clean green */
}

QLabel#CardTrend[trendType="negative"] {
    color: #EF4444;  /* Clean red */
}

/* === DASHBOARD PANELS === */
QFrame#MonthlyChartPanel, QFrame#YearlySummaryPanel,
QFrame#TopProductsPanel, QFrame#HourlySalesPanel, QFrame#QuickStatsPanel,
QFrame#TaxTodayPanel, QFrame#TopCategoriesPanel, QFrame#TopCustomersPanel {
    background-color: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
}

QFrame#PeriodHeader {
    background-color: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
}

QScrollArea#DashboardScroll {
    background-color: transparent;
    border: none;
}

/* === PANEL TITLES === */
QLabel#PanelTitle {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#PanelSubtitle {
    color: #666666;
    font-size: 10px;
    background-color: transparent;
}

/* === YEARLY SUMMARY === */
QLabel#SummaryLabel {
    color: #888888;
    font-size: 11px;
    text-transform: uppercase;
    background-color: transparent;
}

QLabel#SummaryBigValue {
    color: #FFFFFF;
    font-size: 32px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#SummaryHighlight {
    color: #00BCEB;
    font-size: 18px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#SummarySubValue {
    color: #CCCCCC;
    font-size: 14px;
    background-color: transparent;
}

/* === QUICK STATS === */
QLabel#StatLabel {
    color: #888888;
    font-size: 10px;
    text-transform: uppercase;
    background-color: transparent;
}

QLabel#StatBigValue {
    color: #FFFFFF;
    font-size: 26px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#StatValue {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: bold;
    background-color: transparent;
}

/* === YEAR NAV & PERIOD CONTROLS === */
QToolButton#YearNavButton {
    background-color: #2A2A2A;
    color: #CCCCCC;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

QToolButton#YearNavButton:hover {
    background-color: #333333;
    color: #FFFFFF;
}

QDateEdit#PeriodDateEdit {
    background-color: #2A2A2A;
    color: #CCCCCC;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

QLabel#PeriodDash {
    color: #666666;
    font-size: 14px;
    background-color: transparent;
}

QToolButton#PeriodRefreshBtn {
    background-color: #2A2A2A;
    color: #00BCEB;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 16px;
    font-weight: bold;
}

QToolButton#PeriodRefreshBtn:hover {
    background-color: #333333;
}

/* === SECTION TITLES (legacy compat) === */
QLabel#SectionTitle {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
    margin-top: 10px;
    margin-bottom: 8px;
    background-color: transparent;
}

/* === DASHBOARD TABLES === */
QTableWidget#DashboardTable {
    background-color: #1A1A1A;
    border: none;
    gridline-color: transparent;
}

QTableWidget#DashboardTable::item {
    padding: 10px;
    border-bottom: 1px solid #2A2A2A;
    color: #E5E5E5;
}

QTableWidget#DashboardTable::item:selected {
    background-color: #2A2A2A;
    color: white;
}

QTableWidget#DashboardTable::item:hover {
    background-color: #252525;
}

QTableWidget#DashboardTable QHeaderView::section {
    background-color: #2A2A2A;
    color: #00BCEB;
    font-weight: bold;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: none;
    padding: 10px;
}

/* ===================================================================
   UNIFIED COMPONENTS - Dark Theme
   ================================================================ */

/* === GENERIC TABLE VIEWS === */
QTableView {
    background-color: #1A1A1A;
    alternate-background-color: #202020;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    gridline-color: #2A2A2A;
    selection-background-color: #2A2A2A;
    selection-color: white;
}

QTableView::item {
    padding: 8px;
    border: none;
}

QTableView::item:hover {
    background-color: #252525;
}

QTableView QHeaderView::section {
    background-color: #2A2A2A;
    color: #00BCEB;
    font-weight: bold;
    font-size: 10px;
    text-transform: uppercase;
    border: none;
    padding: 10px;
}

/* === BUTTONS ===
   A second generic QPushButton rule used to live here, meant to exclude
   NumpadBtn/ActionGridBtn/NavTile/SignOutBtn/IconButton via a :not()
   selector chain -- invalid in Qt Style Sheets (Qt doesn't support :not()),
   so Qt silently dropped all 4 of its rules (base/hover/pressed/disabled)
   and logged "Could not parse application stylesheet" the first time any
   QPushButton was polished. Since it never actually applied, every plain
   button in the app has always been styled solely by the real, valid
   generic QPushButton rule near the top of this file, in the earlier
   Buttons section. Deleted rather than fixed into valid CSS: making it
   valid would have made it start winning the cascade over that
   already-shipped rule (both being plain-type selectors, later-in-file
   wins), silently reskinning ~80 buttons across the app that were never
   meant to change. */

/* === SEARCH/INPUT FIELDS === */
QLineEdit {
    background-color: #2A2A2A;
    color: #E5E5E5;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #00BCEB;
}

QLineEdit:focus {
    border-color: #00BCEB;
    background-color: #252525;
}

QLineEdit:disabled {
    background-color: #1A1A1A;
    color: #666666;
}

/* === NETWORK SETTINGS === */
QLineEdit#InputNetwork,
QSpinBox#InputNetwork,
QComboBox#InputNetwork {
    background-color: #2A2A2A;
    color: #E5E5E5;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}

/* Higher specificity than "QWidget#SettingsContent QSpinBox" (below) is
   required here, or that rule's min-height wins and stretches this
   spinbox (and its up/down buttons) far taller than its sibling
   QLineEdit/QComboBox fields. */
QWidget#SettingsContent QSpinBox#InputNetwork {
    min-height: 18px;
    max-height: 18px;
}

QSpinBox#InputNetwork::up-button,
QSpinBox#InputNetwork::down-button {
    width: 20px;
    height: 12px;
}

QSpinBox#InputNetwork::up-arrow,
QSpinBox#InputNetwork::down-arrow {
    width: 8px;
    height: 8px;
}

QLineEdit#InputNetwork:focus,
QSpinBox#InputNetwork:focus,
QComboBox#InputNetwork:focus {
    border-color: #00BCEB;
    background-color: #252525;
}

QGroupBox#NetworkCredentialsGroup {
    background-color: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 20px;
    font-weight: bold;
    color: #E5E5E5;
}

QGroupBox#NetworkCredentialsGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 8px;
    color: #00BCEB;
}

QPushButton#BtnTestConnection {
    background-color: transparent;
    color: #00BCEB;
    border: 2px solid #00BCEB;
    border-radius: 6px;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 14px;
    min-width: 150px;
}

QPushButton#BtnTestConnection:hover {
    background-color: rgba(0, 188, 235, 0.1);
    border-color: #00D4FF;
}

QPushButton#BtnTestConnection:pressed {
    background-color: rgba(0, 188, 235, 0.2);
}

QLabel#NetworkWarningLabel {
    background-color: rgba(255, 193, 7, 0.1);
    color: #FFC107;
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: 6px;
    padding: 12px;
    font-size: 12px;
}

/* === NETWORK SETTINGS - CARD-BASED DESIGN === */

/* Hero Status Card */
QFrame#StatusCard {
    background-color: #2D2D30;
    border: 1px solid #444;
    border-radius: 8px;
    padding: 20px;
}

QLabel#StatusIcon {
    background-color: transparent;
    font-size: 32px;
    min-width: 50px;
}

/* Every QLabel below needs its own "background: transparent" -- none of
   them set a background-color, so without it Qt's global
   "QWidget { background-color: #1E1E1E; }" rule still wins for that one
   property despite these more specific ID selectors, showing up as a
   separate near-black block behind the text on every card here (#2D2D30
   StatusCard/MigrationCard, #252526 NetworkCard). */
QLabel#StatusTitle {
    font-size: 18px;
    font-weight: bold;
    color: white;
    background: transparent;
}

QLabel#StatusSubtitle {
    color: #AAA;
    font-size: 14px;
    margin-top: 4px;
    background: transparent;
}

QLabel#StatusModeLabel {
    color: #999;
    font-size: 12px;
    margin-bottom: 4px;
    background: transparent;
}

QComboBox#StatusModeSelector {
    background-color: #3A3A3C;
    color: white;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 150px;
}

/* Server Configuration Card */
QFrame#NetworkCard {
    background-color: #252526;
    border: 1px solid #333;
    border-radius: 8px;
    padding: 15px;
    margin-top: 10px;
}

QLabel#CardTitle {
    font-size: 16px;
    font-weight: bold;
    color: white;
    margin-bottom: 10px;
    background: transparent;
}

QLabel#IPHelper {
    color: #00BCEB;
    font-size: 13px;
    background-color: rgba(0, 188, 235, 0.1);
    border-left: 3px solid #00BCEB;
    padding: 8px 12px;
    border-radius: 4px;
}

QLabel#FormLabel {
    color: #CCC;
    font-size: 13px;
    font-weight: bold;
    min-width: 110px;
    padding-right: 8px;
    background: transparent;
}

/* Test Connection Button */
QPushButton#BtnTestNetwork {
    background-color: transparent;
    border: 2px solid #00BCEB;
    color: #00BCEB;
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#BtnTestNetwork:hover {
    background-color: #00BCEB;
    color: black;
}

QPushButton#BtnTestNetwork:disabled {
    border-color: #444;
    color: #666;
}

QLabel#TestStatus {
    font-size: 14px;
    font-weight: bold;
    padding-left: 10px;
    background: transparent;
}

/* Migration Card */
QFrame#MigrationCard {
    background-color: #2D2D30;
    border: 2px solid #6C5CE7;
    border-radius: 8px;
    padding: 15px;
}

QLabel#MigrationInfo {
    background-color: transparent;
    color: #CCC;
    font-size: 13px;
    line-height: 1.4;
}

/* The Magic Button (Purple Accent) */
QPushButton#BtnMigrate {
    background-color: #6C5CE7;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 14px 24px;
    font-weight: bold;
    font-size: 14px;
    min-height: 45px;
}

QPushButton#BtnMigrate:hover {
    background-color: #5D4FC4;
}

QPushButton#BtnMigrate:pressed {
    background-color: #4E3FA8;
}

QPushButton#BtnMigrate:disabled {
    background-color: #444;
    color: #888;
}

/* ===================================================================
   CREDIT BOOK VIEW - Transparent Labels
   ================================================================ */

/* Credit Header Card - All labels transparent */
QFrame#CreditHeaderCard QLabel {
    background-color: transparent;
}

/* Credit Book - Filter bar labels */
QWidget#CreditBookView QLabel {
    background-color: transparent;
}

/* ===================================================================
   DOCUMENT BROWSER VIEW - Transparent Labels
   ================================================================ */

/* Filter bar labels */
QFrame#FilterBar QLabel {
    background-color: transparent;
}

/* Details panel labels */
QFrame#DocDetailsPanel QLabel {
    background-color: transparent;
}

/* ===================================================================
   RECEIVE PAYMENT DIALOG - Transparent Labels
   ================================================================ */

/* Balance frame labels */
QFrame#BalanceFrame QLabel {
    background-color: transparent;
}

QDialog#ReceivePaymentDialog QLabel {
    background-color: transparent;
}

/* Warning Footer */
QLabel#NetworkWarning {
    background-color: rgba(255, 193, 7, 0.1);
    color: #FFC107;
    border-left: 3px solid #FFC107;
    padding: 10px;
    border-radius: 4px;
    font-size: 12px;
}

/* ===================================================================
   CRUD MANAGER DIALOGS (Category, Unit)
   ================================================================ */

QDialog#CategoryManagerDialog,
QDialog#UnitManagerDialog {
    background-color: #1E1E1E;
}

QDialog#CategoryManagerDialog QGroupBox,
QDialog#UnitManagerDialog QGroupBox {
    background-color: #252526;
    border: 1px solid #2A2A2A;
    border-radius: 6px;
    margin-top: 16px;
    padding: 12px;
    padding-top: 24px;
}

QDialog#CategoryManagerDialog QGroupBox::title,
QDialog#UnitManagerDialog QGroupBox::title {
    color: #00BCEB;
    font-weight: bold;
    font-size: 13px;
}

QDialog#CategoryManagerDialog QGroupBox QLabel,
QDialog#UnitManagerDialog QGroupBox QLabel {
    background-color: transparent;
    color: #CCCCCC;
}

/* Tree widget in category manager */
QDialog#CategoryManagerDialog QTreeWidget {
    background-color: #1A1A1A;
    alternate-background-color: #202020;
    border: 1px solid #2A2A2A;
    border-radius: 6px;
}

QDialog#CategoryManagerDialog QTreeWidget::item {
    padding: 6px;
    border: none;
}

QDialog#CategoryManagerDialog QTreeWidget::item:selected {
    background-color: #2A2A2A;
    color: #00BCEB;
}

QDialog#CategoryManagerDialog QTreeWidget::item:hover {
    background-color: #252525;
}

QDialog#CategoryManagerDialog QTreeWidget QHeaderView::section {
    background-color: #2A2A2A;
    color: #00BCEB;
    font-weight: bold;
    font-size: 11px;
    text-transform: uppercase;
    border: none;
    padding: 8px;
}

/* SMTP Setup Guide Dialog */
QFrame#SmtpGuideStep {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 8px;
}

QLabel#SmtpGuideStepNum {
    background-color: #00BCEB;
    color: #001F3F;
    font-size: 16px;
    font-weight: bold;
    border-radius: 16px;
}

/* === DATA SAFETY VIEW === */
QLabel#RestoreWarning {
    background-color: rgba(255, 65, 54, 0.12);
    border: 1px solid #FF4136;
    border-radius: 6px;
    padding: 12px;
    color: #FF8C85;
    font-size: 12px;
}

/* === SETTINGS PAGE SHARED STYLES === */

/* Warning hint text (restart required, tax warning) */
QLabel[class="warning-hint"] {
    color: #FF8C85;
    font-size: 11px;
    font-style: italic;
    background: transparent;
}

/* Inline field validation error (e.g. Settings > Documents number format) */
QLabel[class="error"] {
    color: #FF4136;
    font-size: 12px;
    background: transparent;
}

/* Link-style text button */
QPushButton[class="link"] {
    background: transparent;
    color: #00BCEB;
    border: none;
    padding: 4px 12px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton[class="link"]:hover {
    color: #00A5D0;
}

/* Icon-only transparent button */
QPushButton#BtnInfoIcon {
    background: transparent;
    border: none;
}
QPushButton#BtnInfoIcon:hover {
    background: rgba(0, 188, 235, 0.15);
    border-radius: 14px;
}

/* Settings scroll area transparency */
QScrollArea#SettingsScrollArea {
    background: transparent;
    border: none;
}
QWidget#SettingsScrollInner {
    background: transparent;
}

/* Settings page section headers */
QLabel#SettingsSectionTitle {
    color: #00BCEB;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 0.5px;
    background: transparent;
}
QFrame#SettingsSectionLine {
    background-color: #3E3E42;
    max-height: 1px;
    min-height: 1px;
}

/* Receipt live preview */
QLabel#ReceiptPreviewTitle {
    color: #8899AA;
    font-size: 11px;
    background: transparent;
    padding: 4px 0;
}
QTextBrowser#ReceiptPreviewBrowser {
    background-color: #d0d0d0;
    color: #000000;
    border: 1px solid #3E3E42;
    border-radius: 6px;
}

/* ── BackupRestoreDialog & ValuationDialog (theme-aware) ───────── */
QDialog#BackupRestoreDialog {
    background-color: #001F3F;
}
QDialog#BackupRestoreDialog QTabWidget::pane { border: none; background: #001F3F; }
QDialog#BackupRestoreDialog QTabBar::tab {
    background: #003366; color: #B0B0B0; padding: 10px 22px;
    border-top-left-radius: 6px; border-top-right-radius: 6px;
    margin-right: 2px; font-size: 13px;
}
QDialog#BackupRestoreDialog QTabBar::tab:selected { background: #004080; color: #00BCEB; font-weight: bold; }
QDialog#BackupRestoreDialog QTabBar::tab:hover { background: #004080; color: #FFFFFF; }

QLabel#DialogTitle { color: #00BCEB; font-size: 20px; font-weight: bold; margin-bottom: 8px; }
QLabel#DialogSubtitle { color: #8899AA; font-size: 12px; margin-bottom: 16px; }
QLabel#SectionTitle { font-size: 16px; font-weight: bold; color: white; margin-top: 20px; }

QLabel[class="muted"] { color: #B0B0B0; font-size: 12px; }
QLabel[class="value"] { color: #E0E0E0; font-size: 13px; font-weight: bold; }
QLabel[class="status-ok"] { color: #39FF14; font-weight: bold; font-size: 13px; }
QLabel[class="status-err"] { color: #FF4136; font-weight: bold; font-size: 13px; }
QLabel[class="card-value"] { color: white; font-size: 28px; font-weight: bold; }
QLabel[class="card-value-positive"] { color: #39FF14; font-size: 28px; font-weight: bold; }
QLabel[class="card-value-negative"] { color: #FF4136; font-size: 28px; font-weight: bold; }

QGroupBox[class="card"] {
    background-color: #003366; border: 1px solid #004080; border-radius: 8px;
    margin-top: 16px; padding: 20px 16px 16px 16px; font-weight: bold; color: #00BCEB;
}
QGroupBox[class="card"]::title { subcontrol-origin: margin; left: 16px; padding: 0 8px; }

QFrame#ValueCard { background-color: #003366; border-radius: 8px; padding: 15px; }
QFrame#Separator { background-color: #004080; }

QTableWidget#BackupTable, QTableWidget#ValuationTable {
    background-color: #002244; border: 1px solid #004080; border-radius: 6px;
    gridline-color: #003366; color: #E0E0E0; selection-background-color: #004080; font-size: 12px;
}
QTableWidget#BackupTable::item, QTableWidget#ValuationTable::item { padding: 6px; }
QTableWidget#BackupTable QHeaderView::section, QTableWidget#ValuationTable QHeaderView::section {
    background-color: #003366; color: #00BCEB; padding: 8px;
    border: none; border-bottom: 2px solid #00BCEB; font-weight: bold; font-size: 12px;
}

QLabel#RestoreWarning {
    background-color: rgba(255, 65, 54, 0.12); border: 1px solid #FF4136;
    border-radius: 6px; padding: 12px; color: #FF8C85; font-size: 12px;
}

/* ── Label Print Dialog ── */
QDialog#LabelPrintDialog {
    background-color: #1E1E1E;
}

QTableWidget#LabelQueueTable {
    font-size: 14px;
}

QTableWidget#LabelQueueTable::item {
    padding: 8px;
}

/* ── Label Preview Dialog ── */
QDialog#LabelPreviewDialog {
    background-color: #1E1E1E;
}

QDialog#LabelPreviewDialog QLabel {
    background: transparent;
}

QLabel#LabelPreviewHeader {
    font-size: 14px;
    font-weight: bold;
    color: #00BCEB;
}

QLabel#LabelPreviewHint {
    font-size: 11px;
    color: #888888;
    font-style: italic;
}

/* ── CSV Import Dialog ── */
QDialog#CsvImportDialog {
    background-color: #1E1E1E;
}

QDialog#CsvImportDialog QLabel {
    background: transparent;
    color: #E0E0E0;
}

/* ── Add/Edit Supplier Dialog ── */
QDialog#SupplierDialog {
    background-color: #1E1E1E;
}

QDialog#SupplierDialog QLabel {
    background: transparent;
    color: #E0E0E0;
}

/* ── Toggle Hint — compact inline description below checkboxes ── */
/* Reusable: set objectName("ToggleHint") on any QLabel used as a toggle hint */
QLabel#ToggleHint {
    color: #6E6E6E;
    font-size: 11px;
    background: transparent;
    padding: 0px;
}

/* ── Product Image Preview placeholder ── */
QLabel#ProductImagePreview {
    border: 1px solid #3E3E42;
    background-color: #252526;
    color: #6E6E6E;
    border-radius: 4px;
    font-size: 12px;
}

/* ═══════════════════════════════════════════════════════════════════════
   REPORT VIEWER — Data Observatory
   ═══════════════════════════════════════════════════════════════════════ */

#ReportViewer {
    background-color: #1E1E1E;
}

/* ── Splitter ── */
#ReportSplitter::handle {
    background-color: #3E3E42;
    width: 1px;
}

/* ── Sidebar ── */
#ReportSidebarPanel {
    background-color: #252526;
    border-right: 1px solid #3E3E42;
}

#ReportSidebarTitle {
    color: #00BCEB;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 3px;
    padding: 18px 20px 14px 20px;
    background: transparent;
    border-bottom: 1px solid #3E3E42;
}

#ReportSidebarScroll {
    background: transparent;
    border: none;
}

#ReportNavContainer {
    background: transparent;
}

/* Category header */
#ReportCategoryLabel {
    color: #AAAAAA;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
    background: transparent;
}

#ReportCategoryCount {
    color: #888888;
    background-color: #2D2D30;
    font-size: 10px;
    font-weight: bold;
    border-radius: 8px;
    min-height: 16px;
    max-height: 16px;
}

/* Report nav items */
QPushButton#ReportNavItem {
    background-color: transparent;
    color: #AAAAAA;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    font-size: 14px;
    text-align: left;
    padding: 11px 12px 11px 14px;
}

QPushButton#ReportNavItem:hover {
    background-color: #2D2D30;
    color: #FFFFFF;
    border-left: 3px solid #3E3E42;
}

QPushButton#ReportNavItem:checked {
    background-color: #333333;
    color: #00BCEB;
    border-left: 3px solid #00BCEB;
    font-weight: bold;
}

/* ── Content Panel ── */
#ReportContentPanel {
    background-color: #1E1E1E;
}

/* ── Report Header ── */
#ReportHeader {
    background-color: #333333;
    border-bottom: 1px solid #3E3E42;
}

#ReportTitle {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: bold;
    background: transparent;
}

#ReportDescription {
    color: #00BCEB;
    font-size: 13px;
    background: transparent;
}

/* ── Filter Bar ── */
#ReportFilterBar {
    background-color: #252526;
    border-bottom: 1px solid #3E3E42;
    min-height: 48px;
}

#ReportFilterWidget {
    background: transparent;
}

#ReportFilterLabel {
    color: #AAAAAA;
    font-size: 13px;
    background: transparent;
}

#ReportDateEdit {
    background-color: #2D2D30;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 6px 10px;
    min-width: 120px;
    font-size: 13px;
}

#ReportDateEdit:focus {
    border: 1px solid #00BCEB;
}

#ReportDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #3E3E42;
    background-color: #2D2D30;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

#ReportDateEdit::drop-down:hover {
    background-color: #16324F;
}

#ReportFilterCombo {
    background-color: #2D2D30;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 6px 10px;
    min-width: 130px;
    font-size: 13px;
}

#ReportFilterCombo:focus {
    border: 1px solid #00BCEB;
}

#RunReportBtn {
    background-color: #00BCEB;
    color: #1E1E1E;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-radius: 6px;
    padding: 8px 28px;
    min-width: 130px;
}

#RunReportBtn:hover {
    background-color: #33CCFF;
}

#RunReportBtn:pressed {
    background-color: #0099CC;
}

#RunReportBtn:disabled {
    background-color: #2D2D30;
    color: #888888;
}

/* ── Data Table ── */
#ReportDataView {
    background-color: #252526;
    alternate-background-color: #2D2D30;
    color: #E0E0E0;
    border: none;
    gridline-color: #3E3E42;
    selection-background-color: #3E3E42;
    selection-color: #FFFFFF;
    font-size: 13px;
}

#ReportDataView::item {
    padding: 6px 12px;
    min-height: 18px;
}

#ReportDataView QHeaderView::section {
    background-color: #2D2D30;
    color: #00BCEB;
    font-weight: bold;
    font-size: 12px;
    padding: 10px 12px;
    border: none;
    border-right: 1px solid #3E3E42;
    border-bottom: 2px solid #00BCEB;
}

#ReportDataView QHeaderView::section:hover {
    background-color: #3E3E42;
}

/* ── Action Bar ── */
#ReportActionBar {
    background-color: #252526;
    border-top: 1px solid #3E3E42;
    min-height: 44px;
}

#ReportRowCount {
    color: #AAAAAA;
    font-size: 13px;
    background: transparent;
    font-weight: bold;
}

#ReportPrintBtn,
#ReportExportExcelBtn,
#ReportExportPdfBtn,
#ReportEmailBtn {
    background-color: #2D2D30;
    color: #AAAAAA;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 7px 18px;
    font-size: 13px;
}

#ReportPrintBtn:hover,
#ReportExportExcelBtn:hover,
#ReportExportPdfBtn:hover,
#ReportEmailBtn:hover {
    background-color: #3E3E42;
    color: #FFFFFF;
    border-color: #00BCEB;
}

#ReportPrintBtn:pressed,
#ReportExportExcelBtn:pressed,
#ReportExportPdfBtn:pressed,
#ReportEmailBtn:pressed {
    background-color: #00BCEB;
    color: #1E1E1E;
}

/* ===================================================================
   CREDIT BOOK VIEW — Drill-down Navigation
   ================================================================ */

QLabel#CreditPageTitle, QLabel#PayablePageTitle {
    font-size: 22px;
    font-weight: bold;
    color: #00BCEB;
    background-color: transparent;
}

QLineEdit#CreditSearchInput, QLineEdit#PayableSearchInput {
    padding: 8px 12px;
    font-size: 13px;
    border: 1px solid #003366;
    border-radius: 6px;
    background-color: #2A2A2A;
    color: #E0E0E0;
}

QLineEdit#CreditSearchInput:focus, QLineEdit#PayableSearchInput:focus {
    border-color: #00BCEB;
}

QPushButton#CreditAddBtn {
    background-color: #00BCEB;
    color: #1E1E1E;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#CreditAddBtn:hover {
    background-color: #33CBF0;
}

QTableWidget#CreditCustomerTable, QTableWidget#CreditLedgerTable,
QTableWidget#PayableSupplierTable, QTableWidget#PayableLedgerTable {
    background-color: #252526;
    alternate-background-color: #2D2D30;
    color: #E0E0E0;
    gridline-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#CreditCustomerTable::item:selected, QTableWidget#CreditLedgerTable::item:selected,
QTableWidget#PayableSupplierTable::item:selected, QTableWidget#PayableLedgerTable::item:selected {
    background-color: #003366;
    color: #FFFFFF;
}

QTableWidget#CreditCustomerTable QHeaderView::section, QTableWidget#CreditLedgerTable QHeaderView::section,
QTableWidget#PayableSupplierTable QHeaderView::section, QTableWidget#PayableLedgerTable QHeaderView::section {
    background-color: #2D2D30;
    color: #00BCEB;
    font-weight: bold;
    font-size: 12px;
    padding: 6px 8px;
    border: none;
    border-bottom: 2px solid #00BCEB;
}

QFrame#CreditListFooter, QFrame#CreditLedgerFooter,
QFrame#PayableLedgerFooter {
    background-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 6px;
}

QLabel#CreditFooterLabel, QLabel#CreditFooterDebt,
QLabel#PayableLedgerDebit, QLabel#PayableLedgerCredit, QLabel#PayableLedgerClosing {
    background-color: transparent;
    font-size: 13px;
    font-weight: bold;
}

QLabel#CreditFooterDebt, QLabel#PayableLedgerDebit {
    color: #FF4136;
}

QLabel#CreditLedgerDebit {
    color: #FF4136;
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

QLabel#CreditLedgerCredit, QLabel#PayableLedgerCredit {
    color: #39FF14;
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

QLabel#CreditLedgerClosing, QLabel#PayableLedgerClosing {
    color: #FFFFFF;
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

/* Back button */
QPushButton#CreditBackBtn, QPushButton#PayableBackBtn {
    background-color: transparent;
    color: #00BCEB;
    border: none;
    font-size: 13px;
    font-weight: bold;
    padding: 4px 8px;
}

QPushButton#CreditBackBtn:hover, QPushButton#PayableBackBtn:hover {
    color: #33CBF0;
    text-decoration: underline;
}

/* Payable/Credit date-range mismatch hint (#282/#284) */
QFrame#PayableRangeHint, QFrame#CreditRangeHint {
    background-color: rgba(255, 220, 0, 0.1);
    border: 1px solid #FFDC00;
    border-radius: 6px;
}

QLabel#PayableRangeHintLabel, QLabel#CreditRangeHintLabel {
    background-color: transparent;
    color: #FFDC00;
    font-size: 12px;
}

QPushButton#PayableRangeHintBtn, QPushButton#CreditRangeHintBtn {
    background-color: #FFDC00;
    color: #1E1E1E;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 4px 12px;
}

QPushButton#PayableRangeHintBtn:hover, QPushButton#CreditRangeHintBtn:hover {
    background-color: #FFE440;
}

/* Header Card */
QFrame#CreditHeaderCard, QFrame#PayableHeaderCard {
    background-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 8px;
}

QFrame#CreditHeaderCard QLabel, QFrame#PayableHeaderCard QLabel {
    background-color: transparent;
}

QLabel#CreditCustName, QLabel#PayableCustName {
    font-size: 18px;
    font-weight: bold;
    color: #FFFFFF;
}

QLabel#CreditCustPhone, QLabel#PayableCustPhone {
    font-size: 13px;
    color: #AAAAAA;
}

QLabel#CreditMetricDebt, QLabel#PayableMetricDebt {
    font-size: 14px;
    font-weight: bold;
    color: #FF4136;
}

QLabel#CreditMetricAvail {
    font-size: 14px;
    font-weight: bold;
    color: #39FF14;
}

QLabel#CreditMetricLast, QLabel#PayableMetricLast {
    font-size: 13px;
    color: #AAAAAA;
}

/* Action buttons */
QPushButton#CreditPayBtn, QPushButton#PayablePayBtn {
    background-color: #00BCEB;
    color: #1E1E1E;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#CreditPayBtn:hover, QPushButton#PayablePayBtn:hover {
    background-color: #33CBF0;
}

QPushButton#CreditPrintBtn {
    background-color: #003366;
    color: #E0E0E0;
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid #2D2D30;
    font-size: 13px;
}

QPushButton#CreditPrintBtn:hover {
    border-color: #00BCEB;
    color: #00BCEB;
}

QPushButton#CreditAdjustBtn, QPushButton#PayableAdjustBtn {
    background-color: #003366;
    color: #E0E0E0;
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid #2D2D30;
    font-size: 13px;
}

QPushButton#CreditAdjustBtn:hover, QPushButton#PayableAdjustBtn:hover {
    border-color: #00BCEB;
    color: #00BCEB;
}

QPushButton#CreditEditBtn {
    background-color: #003366;
    color: #E0E0E0;
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid #2D2D30;
    font-size: 13px;
}

QPushButton#CreditEditBtn:hover {
    border-color: #00BCEB;
    color: #00BCEB;
}

/* Filter bar labels */
QLabel#CreditFilterLabel, QLabel#PayableFilterLabel {
    background-color: transparent;
    color: #AAAAAA;
    font-size: 13px;
}

QPushButton#CreditAllDatesBtn, QPushButton#PayableAllDatesBtn {
    background-color: #003366;
    color: #E0E0E0;
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid #2D2D30;
    font-size: 12px;
}

QPushButton#CreditAllDatesBtn:hover, QPushButton#PayableAllDatesBtn:hover {
    border-color: #00BCEB;
}

/* ===================================================================
   PAGE HEADER — Shared icon+title strip for every Management screen
   ================================================================ */

QWidget#PageHeader {
    background-color: transparent;
}

QLabel#PageHeaderIcon {
    background-color: transparent;
}

QLabel#PageHeaderTitle {
    font-size: 18px;
    font-weight: bold;
    color: #00BCEB;
    background-color: transparent;
}

/* ===================================================================
   DOCUMENT BROWSER VIEW — Full-width with Detail Panel
   ================================================================ */

QLabel#DocBrowserTitle {
    font-size: 22px;
    font-weight: bold;
    color: #00BCEB;
    background-color: transparent;
}

QPushButton#DocNewQuotationBtn {
    background-color: #00BCEB;
    color: #1E1E1E;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#DocNewQuotationBtn:hover {
    background-color: #33CBF0;
}

QFrame#DocFilterBar {
    background-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 6px;
}

QLabel#DocFilterLabel {
    background-color: transparent;
    color: #AAAAAA;
    font-size: 13px;
}

QLineEdit#DocSearchInput {
    padding: 6px 10px;
    font-size: 13px;
    border: 1px solid #003366;
    border-radius: 4px;
    background-color: #2A2A2A;
    color: #E0E0E0;
}

QLineEdit#DocSearchInput:focus {
    border-color: #00BCEB;
}

QPushButton#DocFilterBtn {
    background-color: #003366;
    color: #E0E0E0;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #2D2D30;
    font-size: 13px;
}

QPushButton#DocFilterBtn:hover {
    border-color: #00BCEB;
    color: #00BCEB;
}

QPushButton#DocClearBtn {
    background-color: transparent;
    color: #AAAAAA;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #2D2D30;
    font-size: 13px;
}

QPushButton#DocClearBtn:hover {
    color: #E0E0E0;
    border-color: #AAAAAA;
}

QTableWidget#DocTable {
    background-color: #252526;
    alternate-background-color: #2D2D30;
    color: #E0E0E0;
    gridline-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#DocTable::item:selected {
    background-color: #003366;
    color: #FFFFFF;
}

QTableWidget#DocTable QHeaderView::section {
    background-color: #2D2D30;
    color: #00BCEB;
    font-weight: bold;
    font-size: 12px;
    padding: 6px 8px;
    border: none;
    border-bottom: 2px solid #00BCEB;
}

/* Detail Panel */
QFrame#DocDetailPanel {
    background-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 8px;
}

QLabel#DocDetailTitle {
    font-size: 16px;
    font-weight: bold;
    color: #00BCEB;
    background-color: transparent;
}

QPushButton#DocDetailCloseBtn {
    background-color: transparent;
    color: #AAAAAA;
    border: 1px solid #2D2D30;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}

QPushButton#DocDetailCloseBtn:hover {
    color: #E0E0E0;
    border-color: #AAAAAA;
}

QLabel#DocInfoLabel, QLabel#DocPaymentLabel, QLabel#DocItemsTitle {
    background-color: transparent;
    color: #E0E0E0;
    font-size: 13px;
}

QLabel#DocItemsTitle {
    font-weight: bold;
    color: #00BCEB;
}

QTableWidget#DocItemsTable {
    background-color: #252526;
    alternate-background-color: #2D2D30;
    color: #E0E0E0;
    gridline-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 4px;
    font-size: 12px;
}

QTableWidget#DocItemsTable QHeaderView::section {
    background-color: #2D2D30;
    color: #00BCEB;
    font-weight: bold;
    font-size: 11px;
    padding: 4px 6px;
    border: none;
    border-bottom: 1px solid #00BCEB;
}

/* Action buttons */
QPushButton#DocReprintBtn, QPushButton#DocConvertBtn {
    background-color: #003366;
    color: #E0E0E0;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #2D2D30;
    font-size: 13px;
}

QPushButton#DocReprintBtn:hover, QPushButton#DocConvertBtn:hover {
    border-color: #00BCEB;
    color: #00BCEB;
}

QPushButton#DocConvertBtn:enabled {
    background-color: #00BCEB;
    color: #1E1E1E;
    font-weight: bold;
    border: none;
}

QPushButton#DocRefundBtn, QPushButton#DocVoidBtn {
    background-color: #330A08;
    color: #FF4136;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #551A18;
    font-size: 13px;
}

QPushButton#DocRefundBtn:hover, QPushButton#DocVoidBtn:hover {
    background-color: #441210;
    border-color: #FF4136;
}

/* Pagination */
QLabel#DocPageLabel {
    background-color: transparent;
    color: #AAAAAA;
    font-size: 12px;
}

QPushButton#DocPrevBtn, QPushButton#DocNextBtn {
    background-color: #003366;
    color: #E0E0E0;
    padding: 4px 12px;
    border-radius: 4px;
    border: 1px solid #2D2D30;
    font-size: 12px;
}

QPushButton#DocPrevBtn:hover, QPushButton#DocNextBtn:hover {
    border-color: #00BCEB;
    color: #00BCEB;
}

/* ===================================================================
   PRICE LIST VIEW — Sidebar Navigation
   ================================================================ */

QWidget#PriceListSidebarPanel {
    background-color: #252526;
    border-right: 1px solid #2D2D30;
}

QLabel#PriceListSidebarTitle {
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
    color: #00BCEB;
    background-color: transparent;
    padding-bottom: 4px;
}

QScrollArea#PriceListSidebarScroll {
    background-color: transparent;
    border: none;
}

QWidget#PriceListNavContainer {
    background-color: transparent;
}

QPushButton#PriceListNavItem {
    text-align: left;
    padding: 14px 14px;
    font-size: 14px;
    color: #AAAAAA;
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
}

QPushButton#PriceListNavItem:hover {
    background-color: #2D2D30;
    color: #E0E0E0;
}

QPushButton#PriceListNavItem:checked {
    background-color: #2D2D30;
    color: #00BCEB;
    font-weight: bold;
    border-left: 3px solid #00BCEB;
}

QPushButton#PriceListAddBtn {
    background-color: #00BCEB;
    color: #1E1E1E;
    font-weight: bold;
    padding: 8px 12px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#PriceListAddBtn:hover {
    background-color: #33CBF0;
}

QPushButton#PriceListDeleteBtn {
    background-color: #FF4136;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 12px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#PriceListDeleteBtn:hover {
    background-color: #E0362C;
}

QWidget#PriceListContentPanel {
    background-color: #1E1E1E;
}

/* Empty state */
QLabel#PriceListEmptyText {
    font-size: 18px;
    font-weight: bold;
    color: #AAAAAA;
    background-color: transparent;
}

QLabel#PriceListEmptySubtext {
    font-size: 13px;
    color: #888888;
    background-color: transparent;
}

/* Header */
QFrame#PriceListHeader {
    background-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 6px;
}

QLabel#PriceListTitle {
    font-size: 18px;
    font-weight: bold;
    color: #FFFFFF;
    background-color: transparent;
}

QLabel#PriceListDates {
    font-size: 13px;
    color: #AAAAAA;
    background-color: transparent;
}

/* Data table */
QTableWidget#PriceListDataTable {
    background-color: #252526;
    alternate-background-color: #2D2D30;
    color: #E0E0E0;
    gridline-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#PriceListDataTable::item:selected {
    background-color: #003366;
    color: #FFFFFF;
}

QTableWidget#PriceListDataTable QHeaderView::section {
    background-color: #2D2D30;
    color: #00BCEB;
    font-weight: bold;
    font-size: 12px;
    padding: 6px 8px;
    border: none;
    border-bottom: 2px solid #00BCEB;
}

/* Footer */
QFrame#PriceListFooter {
    background-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 6px;
}

QLabel#PriceListFooterLabel {
    background-color: transparent;
    color: #AAAAAA;
    font-size: 12px;
}

QLabel#PriceListFooterHint {
    background-color: transparent;
    color: #888888;
    font-size: 11px;
    font-style: italic;
}

/* Splitter handle */
QSplitter#PriceListSplitter::handle {
    background-color: #2D2D30;
    width: 1px;
}

/* ── Payment Methods Card List ── */
#PMCardScroll {
    background: transparent;
}

#PMCard {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 6px;
}

#PMCard:hover {
    border-color: #00BCEB;
}

QLabel#PMCardName {
    font-size: 14px;
    font-weight: bold;
    color: #FFFFFF;
    background: transparent;
}

QLabel#PMCardTags {
    font-size: 11px;
    color: #8892B0;
    background: transparent;
}

QLabel#PMCardStatus {
    font-size: 11px;
    font-weight: bold;
    border-radius: 10px;
    padding: 3px 10px;
}

QLabel#PMCardStatus[class="pm-active"] {
    background-color: #0D3B1E;
    color: #39FF14;
    border: 1px solid #39FF14;
}

QLabel#PMCardStatus[class="pm-inactive"] {
    background-color: #3B1A1A;
    color: #FF6B6B;
    border: 1px solid #FF6B6B;
}

QPushButton#PMCardBtn {
    padding: 5px 16px;
    font-size: 12px;
    font-weight: bold;
    border-radius: 4px;
    color: #FFFFFF;
    background-color: #1E3A5F;
    border: 1px solid #2A4A6F;
}

QPushButton#PMCardBtn:hover {
    background-color: #2A4A6F;
    border-color: #3A5A7F;
}

QPushButton#PMCardBtn[class="danger"] {
    background-color: #FF4136;
    color: #FFFFFF;
    border: none;
}

QPushButton#PMCardBtn[class="danger"]:hover {
    background-color: #E0362C;
}

QPushButton#PMCardBtn[class="warning"] {
    background-color: #FFDC00;
    color: #001F3F;
    border: none;
}

QPushButton#PMCardBtn[class="warning"]:hover {
    background-color: #E6C600;
}

QPushButton#PMCardBtn[class="accent"] {
    background-color: #00BCEB;
    color: #001F3F;
    border: none;
}

QPushButton#PMCardBtn[class="accent"]:hover {
    background-color: #00A5D0;
}

/* ═══════════════════════════════════════════════════════════════
   Sale History Dialog
   ═══════════════════════════════════════════════════════════════ */

QDialog#SaleHistoryDialog {
    background-color: #1E1E1E;
}

/* Quick Filter Buttons */
QPushButton#QuickFilterBtn {
    background-color: #252526;
    color: #AAAAAA;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#QuickFilterBtn:hover {
    background-color: #2D2D30;
    color: #FFFFFF;
}

QPushButton#QuickFilterBtn:checked {
    background-color: #00BCEB;
    color: #001F3F;
    border-color: #00BCEB;
    font-weight: 600;
}

/* Search Input */
QLineEdit#SaleHistorySearch {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 14px;
    color: #FFFFFF;
}

QLineEdit#SaleHistorySearch:focus {
    border-color: #00BCEB;
}

/* Sales Table */
QTableWidget#SaleHistoryTable {
    background-color: #252526;
    alternate-background-color: #2A2A2E;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    gridline-color: #3E3E42;
    selection-background-color: #003366;
    selection-color: #FFFFFF;
}

QTableWidget#SaleHistoryTable QHeaderView::section {
    background-color: #1E1E1E;
    color: #AAAAAA;
    border: none;
    border-bottom: 1px solid #3E3E42;
    padding: 6px;
    font-weight: 600;
    font-size: 12px;
}

/* Details Panel */
QWidget#SaleHistoryDetails {
    background-color: #1E1E1E;
}

QFrame#SaleInfoFrame {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 4px;
}

/* Line Items Table */
QTableWidget#SaleHistoryItems {
    background-color: #252526;
    alternate-background-color: #2A2A2E;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    gridline-color: #3E3E42;
}

QTableWidget#SaleHistoryItems QHeaderView::section {
    background-color: #1E1E1E;
    color: #AAAAAA;
    border: none;
    border-bottom: 1px solid #3E3E42;
    padding: 4px;
    font-weight: 600;
    font-size: 12px;
}

/* Action Buttons */
QPushButton#SaleHistoryReprint {
    background-color: #00BCEB;
    color: #001F3F;
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: 600;
}

QPushButton#SaleHistoryReprint:hover {
    background-color: #00A5D0;
}

QPushButton#SaleHistoryReprint:disabled {
    background-color: #3E3E42;
    color: #666666;
}

QPushButton#SaleHistoryRefund {
    background-color: #FF4136;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: 600;
}

QPushButton#SaleHistoryRefund:hover {
    background-color: #E0362D;
}

QPushButton#SaleHistoryRefund:disabled {
    background-color: #3E3E42;
    color: #666666;
}

/* Refund Inline Panel */
QFrame#RefundInlinePanel {
    background-color: #3D1010;
    border: 1px solid #FF4136;
    border-radius: 6px;
}

/* ═══════════════════════════════════════════════════════════════
   Database Setup Dialog
   ═══════════════════════════════════════════════════════════════ */

QDialog#DatabaseSetupDialog {
    background-color: #1E1E1E;
}

QFrame#SetupCard {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 8px;
}

QFrame#SetupCard:hover {
    border-color: #00BCEB;
}
