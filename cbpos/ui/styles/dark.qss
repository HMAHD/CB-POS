}

/* ── Sidebar ── */
#ReportSidebarPanel {
    background-color: {{SURFACE_1}};
    border-right: 1px solid {{BORDER}};
}

#ReportSidebarTitle {
    color: {{ACCENT}};
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 3px;
    padding: 18px 20px 14px 20px;
    background: transparent;
    border-bottom: 1px solid {{BORDER}};
}

#ReportSidebarScroll {
    background: transparent;
    border: none;
}

#ReportNavContainer {
    background: transparent;
}

/* Category header */
#ReportCategoryLabel {
    color: {{TEXT_SECONDARY}};
    font-size: 11px;
    font-weight: bold;
    background: transparent;
}

#ReportCategoryCount {
    color: {{TEXT_DISABLED}};
    background-color: {{SURFACE_2}};
    font-size: 10px;
    font-weight: bold;
    border-radius: 8px;
    min-height: 16px;
    max-height: 16px;
}

/* Report nav items */
QPushButton#ReportNavItem {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    font-size: 14px;
    text-align: left;
    padding: 11px 12px 11px 14px;
}

QPushButton#ReportNavItem:hover {
    background-color: {{SURFACE_2}};
    color: {{TEXT}};
    border-left: 3px solid {{BORDER}};
}

QPushButton#ReportNavItem:checked {
    background-color: {{SURFACE_3}};
    color: {{ACCENT}};
    border-left: 3px solid {{ACCENT}};
    font-weight: bold;
}

/* ── Content Panel ── */
#ReportContentPanel {
    background-color: {{SURFACE_0}};
}

/* ── Report Header ── */
#ReportHeader {
    background-color: {{SURFACE_3}};
    border-bottom: 1px solid {{BORDER}};
}

#ReportTitle {
    color: {{TEXT}};
    font-size: 20px;
    font-weight: bold;
    background: transparent;
}

#ReportDescription {
    color: {{ACCENT}};
    font-size: 13px;
    background: transparent;
}

QPushButton#ReportFavoriteBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 2px;
}

QPushButton#ReportFavoriteBtn:hover {
    background-color: {{BORDER}};
    border-color: {{BORDER_STRONG}};
}

/* ── Filter Bar ── */
#ReportFilterBar {
    background-color: {{SURFACE_1}};
    border-bottom: 1px solid {{BORDER}};
    min-height: 48px;
}

#ReportFilterWidget {
    background: transparent;
}

#ReportFilterLabel {
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
    background: transparent;
}

#ReportDateEdit {
    min-width: 120px;
}

#ReportFilterCombo {
    min-width: 130px;
}

#RunReportBtn {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-radius: 6px;
    padding: 8px 28px;
    min-width: 130px;
}

#RunReportBtn:hover {
    background-color: {{ACCENT_HOVER}};
}

#RunReportBtn:pressed {
    background-color: {{ACCENT}};
}

#RunReportBtn:disabled {
    background-color: {{SURFACE_2}};
    color: {{TEXT_DISABLED}};
}

/* ── Data Table ── */
#ReportDataView {
    background-color: {{SURFACE_1}};
    alternate-background-color: {{SURFACE_2}};
    color: {{TEXT_SOFT}};
    border: none;
    gridline-color: {{BORDER}};
    selection-background-color: {{BORDER}};
    selection-color: {{TEXT}};
    font-size: 13px;
}

#ReportDataView::item {
    padding: 6px 12px;
    min-height: 18px;
}

/* ── Action Bar ── */
#ReportActionBar {
    background-color: {{SURFACE_1}};
    border-top: 1px solid {{BORDER}};
    min-height: 44px;
}

#ReportRowCount {
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
    background: transparent;
    font-weight: bold;
}

/* Export buttons wrap onto a second row when narrow (#611) */
#ReportExportButtons {
    background: transparent;
}

#ReportPrintBtn,
#ReportExportExcelBtn,
#ReportExportPdfBtn,
#ReportEmailBtn {
    background-color: {{SURFACE_2}};
    color: {{TEXT_SECONDARY}};
    border: 1px solid {{BORDER}};
    border-radius: 4px;
    padding: 7px 18px;
    font-size: 13px;
}

#ReportPrintBtn:hover,
#ReportExportExcelBtn:hover,
#ReportExportPdfBtn:hover,
#ReportEmailBtn:hover {
    background-color: {{BORDER}};
    color: {{TEXT}};
    border-color: {{ACCENT}};
}

#ReportPrintBtn:pressed,
#ReportExportExcelBtn:pressed,
#ReportExportPdfBtn:pressed,
#ReportEmailBtn:pressed {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
}

/* ===================================================================
   CREDIT BOOK VIEW — Drill-down Navigation
   ================================================================ */

QLabel#CreditPageTitle, QLabel#PayablePageTitle {
    font-size: 22px;
    font-weight: bold;
    color: {{ACCENT}};
    background-color: transparent;
}

QLineEdit#CreditSearchInput, QLineEdit#PayableSearchInput {
    padding: 8px 12px;
    font-size: 13px;
    border: 1px solid {{SELECTION}};
    border-radius: 6px;
    background-color: {{SURFACE_2}};
    color: {{TEXT_SOFT}};
}

QLineEdit#CreditSearchInput:focus, QLineEdit#PayableSearchInput:focus {
    border-color: {{ACCENT}};
}

QPushButton#CreditAddBtn {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#CreditAddBtn:hover {
    background-color: {{ACCENT_HOVER}};
}

QTableWidget#CreditCustomerTable, QTableWidget#CreditLedgerTable,
QTableWidget#PayableSupplierTable, QTableWidget#PayableLedgerTable {
    background-color: {{SURFACE_1}};
    alternate-background-color: {{SURFACE_2}};
    color: {{TEXT_SOFT}};
    gridline-color: {{SURFACE_2}};
    border: 1px solid {{SURFACE_2}};
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#CreditCustomerTable::item:selected, QTableWidget#CreditLedgerTable::item:selected,
QTableWidget#PayableSupplierTable::item:selected, QTableWidget#PayableLedgerTable::item:selected {
    background-color: {{SELECTION}};
    color: {{TEXT}};
}

QFrame#CreditListFooter, QFrame#CreditLedgerFooter,
QFrame#PayableLedgerFooter {
    background-color: {{SURFACE_2}};
    border: 1px solid {{SURFACE_2}};
    border-radius: 6px;
}

QLabel#CreditFooterLabel, QLabel#CreditFooterDebt,
QLabel#PayableLedgerDebit, QLabel#PayableLedgerCredit, QLabel#PayableLedgerClosing {
    background-color: transparent;
    font-size: 13px;
    font-weight: bold;
}

QLabel#CreditFooterDebt, QLabel#PayableLedgerDebit {
    color: {{DANGER}};
}

QLabel#CreditLedgerDebit {
    color: {{DANGER}};
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

QLabel#CreditLedgerCredit, QLabel#PayableLedgerCredit {
    color: {{SUCCESS}};
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

QLabel#CreditLedgerClosing, QLabel#PayableLedgerClosing {
    color: {{TEXT}};
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

/* Back button */
QPushButton#CreditBackBtn, QPushButton#PayableBackBtn {
    background-color: transparent;
    color: {{ACCENT}};
    border: none;
    font-size: 13px;
    font-weight: bold;
    padding: 4px 8px;
}

QPushButton#CreditBackBtn:hover, QPushButton#PayableBackBtn:hover {
    color: {{ACCENT_HOVER}};
    text-decoration: underline;
}

/* Payable date-range mismatch hint (#282) */
QFrame#PayableRangeHint {
    background-color: rgba(255, 220, 0, 0.1);
    border: 1px solid {{WARNING}};
    border-radius: 6px;
}

QLabel#PayableRangeHintLabel {
    background-color: transparent;
    color: {{WARNING}};
    font-size: 12px;
}

QPushButton#PayableRangeHintBtn {
    background-color: {{WARNING}};
    color: {{ON_ACCENT}};
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 4px 12px;
}

QPushButton#PayableRangeHintBtn:hover {
    background-color: {{WARNING}};
}

/* Payable Header Card */
QFrame#PayableHeaderCard {
    background-color: {{SURFACE_2}};
    border: 1px solid {{SURFACE_2}};
    border-radius: 8px;
}

QFrame#PayableHeaderCard QLabel {
    background-color: transparent;
}

QLabel#PayableCustName {
    font-size: 18px;
    font-weight: bold;
    color: {{TEXT}};
}

QLabel#PayableCustPhone {
    font-size: 13px;
    color: {{TEXT_SECONDARY}};
}

QLabel#PayableMetricDebt {
    font-size: 14px;
    font-weight: bold;
    color: {{DANGER}};
}

QLabel#PayableMetricLast {
    font-size: 13px;
    color: {{TEXT_SECONDARY}};
}

QPushButton#PayablePayBtn {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#PayablePayBtn:hover {
    background-color: {{ACCENT_HOVER}};
}

QPushButton#PayableAdjustBtn {
    background-color: {{SELECTION}};
    color: {{TEXT_SOFT}};
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid {{SURFACE_2}};
    font-size: 13px;
}

QPushButton#PayableAdjustBtn:hover {
    border-color: {{ACCENT}};
    color: {{ACCENT}};
}

QLabel#CreditOpenHint {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
}

QLabel#PayableFilterLabel {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
}

QPushButton#PayableAllDatesBtn {
    background-color: {{SELECTION}};
    color: {{TEXT_SOFT}};
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid {{SURFACE_2}};
    font-size: 12px;
}

QPushButton#PayableAllDatesBtn:hover {
    border-color: {{ACCENT}};
}

/* ===================================================================
   CREDIT BOOK (Customer Ledger & Drilldown)
   ================================================================ */

/* Navigation Strip */
QPushButton#CreditBackBtn {
    background-color: {{SURFACE_1}};
    color: {{TEXT_SECONDARY}};
    padding: 6px 14px;
    border-radius: 6px;
    border: 1px solid {{SURFACE_3}};
    font-size: 12px;
    font-weight: 600;
}

QPushButton#CreditBackBtn:hover {
    background-color: {{SURFACE_2}};
    border-color: {{ACCENT}};
    color: {{ACCENT}};
}

QLabel#CreditViewBadge {
    font-size: 11px;
    font-weight: 700;
    color: {{TEXT_DISABLED}};
    letter-spacing: 0.6px;
}

/* Customer Header / Hero Card */
QFrame#CreditHeaderCard {
    background-color: {{SURFACE_1}};
    border: 1px solid {{SURFACE_3}};
    border-radius: 10px;
}

QFrame#CreditHeaderCard QWidget#MetaContainer,
QFrame#CreditHeaderCard QLabel {
    background-color: transparent;
    border: none;
}

QLabel#CreditAvatarIcon {
    background-color: rgba(0, 188, 235, 0.12);
    border: 1px solid rgba(0, 188, 235, 0.28);
    border-radius: 20px;
}

QLabel#CreditCustName {
    font-size: 17px;
    font-weight: bold;
    color: {{TEXT}};
}

QLabel#CreditCustId {
    font-size: 11px;
    font-weight: 600;
    color: {{TEXT_DISABLED}};
    background-color: {{SURFACE_2}};
    border: 1px solid {{SURFACE_2}};
    border-radius: 4px;
    padding: 2px 6px;
}

QLabel#CreditCustPhone, QLabel#CreditCustAddress, QLabel#CreditCustTier {
    font-size: 12px;
    color: {{TEXT_SECONDARY}};
}

/* KPI Chips */
QFrame#CreditKpiDebt, QFrame#CreditKpiAvail, QFrame#CreditKpiLimit, QFrame#CreditKpiPoints, QFrame#CreditKpiLast {
    background-color: {{SURFACE_2}};
    border: 1px solid {{SURFACE_2}};
    border-radius: 6px;
}

QFrame#CreditKpiDebt {
    background-color: rgba(239, 68, 68, 0.08);
    border-color: rgba(239, 68, 68, 0.25);
}

QFrame#CreditKpiAvail {
    background-color: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.25);
}

QLabel#CreditKpiTitle {
    font-size: 10px;
    font-weight: 700;
    color: {{TEXT_DISABLED}};
    letter-spacing: 0.5px;
}

QLabel#CreditMetricDebt {
    font-size: 15px;
    font-weight: bold;
    color: {{DANGER}};
}

QLabel#CreditMetricAvail {
    font-size: 15px;
    font-weight: bold;
    color: {{SUCCESS}};
}

QLabel#CreditMetricLimit {
    font-size: 15px;
    font-weight: bold;
    color: {{TEXT}};
}

QLabel#CreditMetricPoints {
    font-size: 15px;
    font-weight: bold;
    color: {{WARNING}};
}

QLabel#CreditMetricLast {
    font-size: 13px;
    font-weight: 600;
    color: {{TEXT_SECONDARY}};
}

/* Action Buttons */
QPushButton#CreditPayBtn {
    background-color: {{SUCCESS}};
    color: {{ON_ACCENT}};
    font-weight: bold;
    padding: 8px 18px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#CreditPayBtn:hover {
    background-color: {{SUCCESS_BG}};
}

QPushButton#CreditPrintBtn, QPushButton#CreditAdjustBtn, QPushButton#CreditAdjustPointsBtn, QPushButton#CreditEditBtn {
    background-color: {{SURFACE_1}};
    color: {{TEXT}};
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid {{SURFACE_3}};
    font-size: 13px;
}

QPushButton#CreditPrintBtn:hover, QPushButton#CreditAdjustBtn:hover, QPushButton#CreditAdjustPointsBtn:hover, QPushButton#CreditEditBtn:hover {
    background-color: {{SURFACE_2}};
    border-color: {{ACCENT}};
    color: {{ACCENT}};
}

/* Filter bar & Presets */
QFrame#CreditFilterBar {
    background-color: {{SURFACE_1}};
    border: 1px solid {{SURFACE_3}};
    border-radius: 6px;
}

QLabel#CreditFilterLabel {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    font-size: 12px;
    font-weight: 600;
}

QPushButton#CreditPresetBtn30d, QPushButton#CreditPresetBtnMonth, QPushButton#CreditAllDatesBtn {
    background-color: {{SURFACE_0}};
    color: {{TEXT_SECONDARY}};
    padding: 5px 12px;
    border-radius: 4px;
    border: 1px solid {{SURFACE_3}};
    font-size: 12px;
    font-weight: 600;
}

QPushButton#CreditPresetBtn30d:hover, QPushButton#CreditPresetBtnMonth:hover, QPushButton#CreditAllDatesBtn:hover {
    color: {{TEXT}};
    border-color: {{BORDER_STRONG}};
}

QPushButton#CreditPresetBtn30d[presetActive="true"],
QPushButton#CreditPresetBtnMonth[presetActive="true"],
QPushButton#CreditAllDatesBtn[presetActive="true"] {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    border-color: {{ACCENT}};
    font-weight: bold;
}

/* Date-range mismatch hint (#284) */
QFrame#CreditRangeHint {
    background-color: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-left: 4px solid {{WARNING}};
    border-radius: 6px;
}

QLabel#CreditRangeHintLabel {
    background-color: transparent;
    color: {{TEXT}};
    font-size: 12px;
}

QPushButton#CreditRangeHintBtn {
    background-color: {{WARNING}};
    color: {{ON_ACCENT}};
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 4px 12px;
}

QPushButton#CreditRangeHintBtn:hover {
    background-color: {{WARNING}};
}

/* Ledger Footer */
QFrame#CreditLedgerFooter {
    background-color: {{SURFACE_1}};
    border: 1px solid {{SURFACE_3}};
    border-radius: 6px;
}

QLabel#CreditLedgerDebit {
    font-size: 13px;
    font-weight: bold;
    color: {{DANGER}};
}

QLabel#CreditLedgerCredit {
    font-size: 13px;
    font-weight: bold;
    color: {{SUCCESS}};
}

QLabel#CreditLedgerClosing {
    font-size: 14px;
    font-weight: bold;
    color: {{TEXT}};
}

/* ===================================================================
   PAGE HEADER — Shared icon+title strip for every Management screen
   ================================================================ */

QWidget#PageHeader {
    background-color: transparent;
}

QLabel#PageHeaderIcon {
    background-color: transparent;
}

QLabel#PageHeaderTitle {
    font-size: 18px;
    font-weight: bold;
    color: {{ACCENT}};
    background-color: transparent;
}

/* ===================================================================
   DOCUMENT BROWSER VIEW — Full-width with Detail Panel
   ================================================================ */

QLabel#DocBrowserTitle {
    font-size: 22px;
    font-weight: bold;
    color: {{ACCENT}};
    background-color: transparent;
}

QPushButton#DocNewQuotationBtn {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#DocNewQuotationBtn:hover {
    background-color: {{ACCENT_HOVER}};
}

QFrame#DocFilterBar {
    background-color: {{SURFACE_2}};
    border: 1px solid {{SURFACE_2}};
    border-radius: 6px;
}

QLabel#DocFilterLabel {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
}

QLineEdit#DocSearchInput {
    padding: 6px 10px;
    font-size: 13px;
    border: 1px solid {{SELECTION}};
    border-radius: 4px;
    background-color: {{SURFACE_2}};
    color: {{TEXT_SOFT}};
}

QLineEdit#DocSearchInput:focus {
    border-color: {{ACCENT}};
}

QPushButton#DocFilterBtn {
    background-color: {{SELECTION}};
    color: {{TEXT_SOFT}};
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid {{SURFACE_2}};
    font-size: 13px;
}

QPushButton#DocFilterBtn:hover {
    border-color: {{ACCENT}};
    color: {{ACCENT}};
}

QPushButton#DocClearBtn {
    padding: 6px 14px;
    border-radius: 4px;
    font-size: 13px;
}

QTableWidget#DocTable {
    background-color: {{SURFACE_1}};
    alternate-background-color: {{SURFACE_2}};
    color: {{TEXT_SOFT}};
    gridline-color: {{SURFACE_2}};
    border: 1px solid {{SURFACE_2}};
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#DocTable::item:selected {
    background-color: {{SELECTION}};
    color: {{TEXT}};
}

/* Detail Panel */
QFrame#DocDetailPanel {
    background-color: {{SURFACE_2}};
    border: 1px solid {{SURFACE_2}};
    border-radius: 8px;
}

QLabel#DocDetailTitle {
    font-size: 16px;
    font-weight: bold;
    color: {{ACCENT}};
    background-color: transparent;
}

QPushButton#DocDetailCloseBtn {
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}

/* Detail panel beside the list (#612): header bar, scrolling body, splitter */
QFrame#DocDetailHeader {
    background-color: transparent;
    border: none;
    border-bottom: 1px solid {{BORDER}};
}

QScrollArea#DocDetailScroll, QWidget#DocDetailContent {
    background-color: transparent;
    border: none;
}

QSplitter#DocBodySplitter::handle {
    background-color: {{SURFACE_2}};
    width: 6px;
}

QLabel#DocInfoLabel, QLabel#DocPaymentLabel, QLabel#DocItemsTitle {
    background-color: transparent;
    color: {{TEXT_SOFT}};
    font-size: 13px;
}

QLabel#DocItemsTitle {
    font-weight: bold;
    color: {{ACCENT}};
}

QTableWidget#DocItemsTable {
    background-color: {{SURFACE_1}};
    alternate-background-color: {{SURFACE_2}};
    color: {{TEXT_SOFT}};
    gridline-color: {{SURFACE_2}};
    border: 1px solid {{SURFACE_2}};
    border-radius: 4px;
    font-size: 12px;
}

/* Action buttons */
QPushButton#DocReprintBtn, QPushButton#DocConvertBtn {
    background-color: {{SELECTION}};
    color: {{TEXT_SOFT}};
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid {{SURFACE_2}};
    font-size: 13px;
}

QPushButton#DocReprintBtn:hover, QPushButton#DocConvertBtn:hover {
    border-color: {{ACCENT}};
    color: {{ACCENT}};
}

QPushButton#DocConvertBtn:enabled {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    font-weight: bold;
    border: none;
}

QPushButton#DocRefundBtn, QPushButton#DocVoidBtn {
    background-color: {{SURFACE_0}};
    color: {{DANGER}};
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid {{DANGER_BG}};
    font-size: 13px;
}

QPushButton#DocRefundBtn:hover, QPushButton#DocVoidBtn:hover {
    background-color: {{DANGER_BG}};
    border-color: {{DANGER}};
}

/* Pagination */
QLabel#DocPageLabel {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    font-size: 12px;
}

QPushButton#DocPrevBtn, QPushButton#DocNextBtn {
    background-color: {{SELECTION}};
    color: {{TEXT_SOFT}};
    padding: 4px 12px;
    border-radius: 4px;
    border: 1px solid {{SURFACE_2}};
    font-size: 12px;
}

QPushButton#DocPrevBtn:hover, QPushButton#DocNextBtn:hover {
    border-color: {{ACCENT}};
    color: {{ACCENT}};
}

/* ===================================================================
   PRICE LIST VIEW — Sidebar Navigation
   ================================================================ */

QWidget#PriceListSidebarPanel {
    background-color: {{SURFACE_1}};
    border-right: 1px solid {{BORDER}};
}

QLabel#PriceListSidebarTitle {
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
    color: {{ACCENT}};
    background-color: transparent;
    padding-bottom: 4px;
}

QScrollArea#PriceListSidebarScroll {
    background-color: transparent;
    border: none;
}

QWidget#PriceListNavContainer {
    background-color: transparent;
}

QPushButton#PriceListNavItem {
    text-align: left;
    padding: 14px 14px;
    font-size: 14px;
    color: {{TEXT_SECONDARY}};
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
}

QPushButton#PriceListNavItem:hover {
    background-color: {{SURFACE_2}};
    color: {{TEXT_SOFT}};
}

QPushButton#PriceListNavItem:checked {
    background-color: {{SURFACE_2}};
    color: {{ACCENT}};
    font-weight: bold;
    border-left: 3px solid {{ACCENT}};
}

QPushButton#PriceListAddBtn {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    font-weight: bold;
    padding: 8px 12px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#PriceListAddBtn:hover {
    background-color: {{ACCENT_HOVER}};
}

QPushButton#PriceListDeleteBtn {
    background-color: {{DANGER}};
    color: {{TEXT}};
    font-weight: bold;
    padding: 8px 12px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#PriceListDeleteBtn:hover {
    background-color: {{DANGER}};
}

QWidget#PriceListContentPanel {
    background-color: {{SURFACE_0}};
}

/* Empty state */
QLabel#PriceListEmptyText {
    font-size: 18px;
    font-weight: bold;
    color: {{TEXT_SECONDARY}};
    background-color: transparent;
}

QLabel#PriceListEmptySubtext {
    font-size: 13px;
    color: {{TEXT_DISABLED}};
    background-color: transparent;
}

/* Header */
QFrame#PriceListHeader {
    background-color: {{SURFACE_2}};
    border: 1px solid {{SURFACE_2}};
    border-radius: 6px;
}

QLabel#PriceListTitle {
    font-size: 18px;
    font-weight: bold;
    color: {{TEXT}};
    background-color: transparent;
}

QLabel#PriceListDates {
    font-size: 13px;
    color: {{TEXT_SECONDARY}};
    background-color: transparent;
}

/* Search input */
QLineEdit#PriceListSearchInput {
    padding: 6px 10px;
    font-size: 13px;
    border: 1px solid {{SURFACE_3}};
    border-radius: 4px;
    background-color: {{SURFACE_1}};
    color: {{TEXT_SOFT}};
}

QLineEdit#PriceListSearchInput:focus {
    border-color: {{ACCENT}};
}

/* Data table */
QTableWidget#PriceListDataTable {
    background-color: {{SURFACE_1}};
    alternate-background-color: {{SURFACE_2}};
    color: {{TEXT_SOFT}};
    gridline-color: {{SURFACE_2}};
    border: 1px solid {{SURFACE_2}};
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#PriceListDataTable::item:selected {
    background-color: {{SELECTION}};
    color: {{TEXT}};
}

/* Footer */
QFrame#PriceListFooter {
    background-color: {{SURFACE_2}};
    border: 1px solid {{SURFACE_2}};
    border-radius: 6px;
}

QLabel#PriceListFooterLabel {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    font-size: 12px;
}

QLabel#PriceListFooterHint {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
}

/* Splitter handle */
QSplitter#PriceListSplitter::handle {
    background-color: {{SURFACE_2}};
    width: 1px;
}

/* ── Payment Methods Card List ── */
#PMCardScroll {
    background: transparent;
}

#PMCard {
    background-color: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    border-radius: 6px;
}

#PMCard:hover {
    border-color: {{ACCENT}};
}

QLabel#PMCardName {
    font-size: 14px;
    font-weight: bold;
    color: {{TEXT}};
    background: transparent;
}

QLabel#PMCardTags {
    font-size: 11px;
    color: {{TEXT_SECONDARY}};
    background: transparent;
}

QLabel#PMCardStatus {
    font-size: 11px;
    font-weight: bold;
    border-radius: 10px;
    padding: 3px 10px;
}

QLabel#PMCardStatus[class="pm-active"] {
    background-color: {{SURFACE_1}};
    color: {{SUCCESS}};
}

QLabel#PMCardStatus[class="pm-inactive"] {
    background-color: {{SURFACE_1}};
    color: {{DANGER}};
}

QPushButton#PMCardBtn {
    padding: 5px 16px;
    font-size: 12px;
    font-weight: bold;
    border-radius: 4px;
}

QPushButton#PMCardBtn[class="danger"] {
    background-color: {{DANGER}};
    color: {{TEXT}};
    border: none;
}

QPushButton#PMCardBtn[class="danger"]:hover {
    background-color: {{DANGER}};
}

QPushButton#PMCardBtn[class="warning"] {
    background-color: {{WARNING}};
    color: {{ON_ACCENT}};
    border: none;
}

QPushButton#PMCardBtn[class="warning"]:hover {
    background-color: {{WARNING}};
}

QPushButton#PMCardBtn[class="accent"] {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    border: none;
}

QPushButton#PMCardBtn[class="accent"]:hover {
    background-color: {{ACCENT}};
}

/* ═══════════════════════════════════════════════════════════════
   Sale History Dialog
   ═══════════════════════════════════════════════════════════════ */

QDialog#SaleHistoryDialog {
    background-color: {{SURFACE_0}};
}

/* Quick Filter Buttons */
QPushButton#QuickFilterBtn {
    background-color: {{SURFACE_1}};
    color: {{TEXT_SECONDARY}};
    border: 1px solid {{BORDER}};
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#QuickFilterBtn:hover {
    background-color: {{SURFACE_2}};
    color: {{TEXT}};
}

QPushButton#QuickFilterBtn:checked {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    border-color: {{ACCENT}};
    font-weight: 600;
}

/* Search Input */
QLineEdit#SaleHistorySearch {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 14px;
    color: {{TEXT}};
}

QLineEdit#SaleHistorySearch:focus {
    border-color: {{ACCENT}};
}

/* Sales Table */
QTableWidget#SaleHistoryTable {
    background-color: {{SURFACE_1}};
    alternate-background-color: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    border-radius: 4px;
    gridline-color: {{BORDER}};
    selection-background-color: {{SELECTION}};
    selection-color: {{TEXT}};
}

/* Details Panel & Receipt Inspector */
QFrame#SaleHistoryDetails {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: 6px;
}

QPushButton#InvoiceBadge {
    background-color: rgba(0, 188, 235, 0.12);
    border: 1px solid rgba(0, 188, 235, 0.35);
    border-radius: 4px;
    color: {{ACCENT}};
    font-family: 'JetBrains Mono', 'Courier New', monospace;
    font-weight: 600;
    font-size: 13px;
    padding: 3px 8px;
    text-align: left;
}

QPushButton#InvoiceBadge:hover {
    background-color: rgba(0, 188, 235, 0.22);
    border: 1px solid {{ACCENT}};
}

QFrame#SaleMetadataCard {
    background-color: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    border-radius: 6px;
    padding: 4px;
}

QFrame#SaleSummaryCard {
    background-color: transparent;
    border: none;
    border-top: 1px solid {{BORDER}};
    border-radius: 0px;
    padding: 6px 2px 2px 2px;
}

QFrame#SaleSummaryCard QLabel {
    background: transparent;
}

QFrame#SaleMetadataCard QLabel {
    background: transparent;
}

QFrame#ReceiptReprintPreviewContainer {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: 6px;
}

QScrollArea#SaleReceiptScroll {
    background: transparent;
    border: none;
}

QScrollArea#SaleReceiptScroll > QWidget > QWidget {
    background: transparent;
}

QFrame#SaleInfoFrame {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: 4px;
}

/* Line Items Table */
QTableWidget#SaleHistoryItems {
    background-color: {{SURFACE_1}};
    alternate-background-color: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    border-radius: 4px;
    gridline-color: {{BORDER}};
}

/* Action Buttons */
QPushButton#SaleHistoryReprint {
    background-color: {{ACCENT}};
    color: {{ON_ACCENT}};
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: 600;
}

QPushButton#SaleHistoryReprint:hover {
    background-color: {{ACCENT}};
}

QPushButton#SaleHistoryReprint:disabled {
    background-color: {{BORDER}};
    color: {{TEXT_DISABLED}};
}

QPushButton#SaleHistoryRefund {
    background-color: {{DANGER}};
    color: {{TEXT}};
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: 600;
}

QPushButton#SaleHistoryRefund:hover {
    background-color: {{DANGER}};
}

QPushButton#SaleHistoryRefund:disabled {
    background-color: {{BORDER}};
    color: {{TEXT_DISABLED}};
}

/* Refund Inline Panel */
QFrame#RefundInlinePanel {
    background-color: {{SURFACE_0}};
    border: 1px solid {{DANGER}};
    border-radius: 6px;
}

/* ═══════════════════════════════════════════════════════════════
   Database Setup Dialog
   ═══════════════════════════════════════════════════════════════ */

QDialog#DatabaseSetupDialog {
    background-color: {{SURFACE_0}};
}

QFrame#SetupCard {
    background-color: {{SURFACE_1}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
}

QFrame#SetupCard:hover {
    border-color: {{ACCENT}};
}

/* ── Shift dialog (#605) ── */
QDialog#ShiftManagementDialog QLabel#ShiftSectionTitle {
    color: {{ACCENT}};
    font-weight: bold;
}

QDialog#ShiftManagementDialog QLabel#ShiftExpectedCashLabel,
QDialog#ShiftManagementDialog QLabel#ShiftExpectedCash {
    color: {{TEXT}};
    font-weight: bold;
}

QDialog#ShiftManagementDialog QFrame#ShiftDivider {
    background-color: {{BORDER}};
    border: none;
    max-height: 1px;
}

/* Stock Take: brief "<product> counted: N" note after a scan (#548).
   Success colour from status_colors.PALETTE. */
QLabel#StockTakeScanFeedback {
    color: {{SUCCESS}};
    font-weight: bold;
}

/* ── Bulk Price Adjust Dialog (#544) ── */
QDialog#BulkPriceAdjustDialog QFrame#BulkRuleCard {
    background-color: {{SURFACE_2}};
    border: 1px solid {{BORDER}};
    border-radius: 6px;
    padding: 12px;
}

QDialog#BulkPriceAdjustDialog QLabel#BulkBelowCostBanner {
    background-color: rgba(239, 68, 68, 0.18);
    color: {{DANGER}};
    border: 1px solid {{DANGER}};
    border-radius: 6px;
    padding: 8px 12px;
    font-weight: bold;
}

QLabel#PromotionOverlapBanner {
    background-color: rgba(245, 158, 11, 0.18);
    color: {{WARNING}};
    border: 1px solid {{WARNING}};
    border-radius: 6px;
    padding: 8px 12px;
    font-weight: 500;
}


QLabel#BulkMarginBadgeSafe {
    background-color: rgba(16, 185, 129, 0.18);
    color: {{SUCCESS}};
    border: 1px solid {{SUCCESS}};
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: bold;
}

QLabel#BulkMarginBadgeWarning {
    background-color: rgba(239, 68, 68, 0.22);
    color: {{DANGER}};
    border: 1px solid {{DANGER}};
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: bold;
}

/* Customer Statement Dialog */
QDialog#CustomerStatementDialog {
    background-color: {{SURFACE_0}};
}

QFrame#StatementHeaderCard {
    background-color: {{SURFACE_1}};
    border: 1px solid {{SURFACE_3}};
    border-radius: 8px;
}

QLabel#StatementCustName {
    font-size: 16px;
    font-weight: bold;
    color: {{TEXT}};
}

QLabel#StatementCustId {
    background-color: rgba(0, 188, 235, 0.15);
    color: {{ACCENT}};
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 11px;
    font-weight: bold;
}

QLabel#StatementCustPhone {
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
}

QLabel.statement-stat {
    background-color: {{SURFACE_1}};
    border: 1px solid {{SURFACE_3}};
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    color: {{TEXT_SOFT}};
}

QLabel.statement-stat.debit {
    border-left: 3px solid {{DANGER}};
}

QLabel.statement-stat.credit {
    border-left: 3px solid {{SUCCESS}};
}

QLabel.statement-stat.bold {
    font-weight: bold;
    border-left: 3px solid {{ACCENT}};
}

/* Adjustment Dialogs & Loyalty Overview Card */
QDialog#AdjustBalanceDialog,
QDialog#AdjustPointsDialog {
    background-color: {{SURFACE_0}};
}

QFrame#AdjustHeaderCard,
QFrame#LoyaltyOverviewCard {
    background-color: {{SURFACE_1}};
    border: 1px solid {{SURFACE_3}};
    border-radius: 8px;
}

QLabel#AdjustCustName {
    font-size: 15px;
    font-weight: bold;
    color: {{TEXT}};
}

QLabel#AdjustCustDebt,
QLabel#AdjustCustPoints {
    font-size: 13px;
    color: {{TEXT_SECONDARY}};
}

QFrame#AdjustPreviewCard {
    background-color: {{SURFACE_0}};
    border: 1px dashed {{BORDER}};
    border-radius: 6px;
}

QLabel#AdjustFormulaLabel {
    font-size: 12px;
    color: {{TEXT_SECONDARY}};
}

QLabel#AdjustPreviewLabel {
    font-size: 14px;
    font-weight: bold;
    color: {{ACCENT}};
}

QLabel#LoyaltyPointsValue {
    font-size: 18px;
    font-weight: bold;
    color: {{WARNING}};
}

QLabel#PointsHistoryHeader {
    font-size: 14px;
    font-weight: bold;
    color: {{TEXT}};
    margin-top: 6px;
}

QPushButton#ModeReduceBtn:checked {
    background-color: rgba(239, 68, 68, 0.2);
    border: 1px solid {{DANGER}};
    color: {{DANGER}};
    font-weight: bold;
}

QPushButton#ModeAddBtn:checked {
    background-color: rgba(16, 185, 129, 0.2);
    border: 1px solid {{SUCCESS}};
    color: {{SUCCESS}};
    font-weight: bold;
}

QPushButton#ModeSetBtn:checked {
    background-color: rgba(0, 188, 235, 0.2);
    border: 1px solid {{ACCENT}};
    color: {{ACCENT_HOVER}};
    font-weight: bold;
}

QPushButton#ModeDeductPtsBtn:checked {
    background-color: rgba(239, 68, 68, 0.2);
    border: 1px solid {{DANGER}};
    color: {{DANGER}};
    font-weight: bold;
}

QPushButton#ModeAddPtsBtn:checked {
    background-color: rgba(245, 158, 11, 0.2);
    border: 1px solid {{WARNING}};
    color: {{WARNING}};
    font-weight: bold;
}

QPushButton#ModeSetPtsBtn:checked {
    background-color: rgba(0, 188, 235, 0.2);
    border: 1px solid {{ACCENT}};
    color: {{ACCENT_HOVER}};
    font-weight: bold;
}



