/* 
    Ceylon Byte POS - Enterprise Light Theme 
    Palette:
    - Background: #F8F9FA (Global BG) / #FFFFFF (Surface)
    - Text: #212529 (Primary) / #495057 (Secondary)
    - Border: #DEE2E6
    - Accent: #0D6EFD (Bootstrap Blue)
    - Success: #198754 (Bootstrap Green)
    - Warning: #FFC107
    - Error: #DC3545
*/

/* Global Font Enforcement */
* {
    font-family: "{{FONT_FAMILY}}", "Noto Sans", "Segoe UI", sans-serif;
}

QLabel#BadgeLabel {
    color: #0D6EFD;
    font-weight: bold;
}

QLabel.PlaceholderLabel {
    color: #6C757D;
}

QLabel.AboutLabel {
    font-size: 16px;
    color: #495057;
}

/* Global Reset */
QWidget {
    background-color: #F8F9FA;
    color: #212529;
    font-size: 14px;
}

/* Inputs - Global Baseline */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 8px;
    font-size: 16px;
    color: #212529;
    selection-background-color: #0D6EFD;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

/* ComboBox - Dropdown Selector */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 8px 12px;
    padding-right: 30px;  /* Space for arrow */
    font-size: 14px;
    color: #212529;
    min-height: 32px;
}

QComboBox:hover {
    border: 1px solid #ADB5BD;
    background-color: #F8F9FA;
}

QComboBox:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
    background: transparent;
}

QComboBox::down-arrow {
    image: none;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 7px solid #495057;
    margin-right: 8px;
}

QComboBox:hover::down-arrow {
    border-top-color: #212529;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #0D6EFD;
    selection-background-color: #0D6EFD;
    selection-color: #FFFFFF;
    color: #212529;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 28px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #E9ECEF;
    color: #0D6EFD;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #0D6EFD;
    color: #FFFFFF;
}

/* SpinBox - Number Input */
QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 8px 12px;
    padding-right: 40px;  /* Space for buttons */
    font-size: 14px;
    color: #212529;
    min-height: 32px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #ADB5BD;
    background-color: #F8F9FA;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background-color: #E9ECEF;
    border: none;
    border-top-right-radius: 4px;
    width: 20px;
    subcontrol-origin: border;
    subcontrol-position: top right;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #CED4DA;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed {
    background-color: #0D6EFD;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-bottom: 6px solid #495057;
    width: 0;
    height: 0;
}

QSpinBox::up-button:hover::up-arrow, QDoubleSpinBox::up-button:hover::up-arrow {
    border-bottom-color: #212529;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #E9ECEF;
    border: none;
    border-bottom-right-radius: 4px;
    width: 20px;
    subcontrol-origin: border;
    subcontrol-position: bottom right;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #CED4DA;
}

QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #0D6EFD;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #495057;
    width: 0;
    height: 0;
}

QSpinBox::down-button:hover::down-arrow, QDoubleSpinBox::down-button:hover::down-arrow {
    border-top-color: #212529;
}

/* Buttons */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 10px 20px;
    font-weight: bold;
    color: #495057;
    text-transform: uppercase;
}

QPushButton:hover {
    background-color: #E9ECEF;
    border: 1px solid #ADB5BD;
    color: #212529;
}

QPushButton:pressed {
    background-color: #DEE2E6;
}

/* Primary Action Button (Green) */
QPushButton#BtnSave, QPushButton#PayBtn, QPushButton[class="primary"] {
    background-color: #198754;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnSave:hover, QPushButton#PayBtn:hover, QPushButton[class="primary"]:hover {
    background-color: #157347;
}

/* Danger Button (Red) */
QPushButton#BtnCancel, QPushButton#VoidBtn, QPushButton[class="danger"] {
    background-color: #DC3545;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnCancel:hover, QPushButton#VoidBtn:hover, QPushButton[class="danger"]:hover {
    background-color: #BB2D3B;
}

/* Warning Button (Yellow) */
QPushButton[class="warning"] {
    background-color: #FFC107;
    color: #212529;
    border: none;
}

/* Lists & Tables */
QListWidget, QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    outline: none;
    gridline-color: #F1F3F5;
    alternate-background-color: #F8F9FA;
}

QListWidget::item, QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #F1F3F5;
    color: #212529;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #E3F2FD; /* Pale Blue */
    color: #0D6EFD;
    border-left: 4px solid #0D6EFD;
}

QHeaderView::section {
    background-color: #E9ECEF; /* Light Gray Header */
    color: #495057;
    padding: 10px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #DEE2E6;
    text-transform: uppercase;
}

QTableCornerButton::section {
    background-color: #E9ECEF;
    border: none;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #F8F9FA;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #ADB5BD;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #DEE2E6;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background: #E9ECEF;
    color: #495057;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #0D6EFD;
    font-weight: bold;
    border-bottom: 2px solid #0D6EFD;
}

/* Group Box */
QGroupBox {
    border: 1px solid #DEE2E6;
    border-radius: 4px;
    margin-top: 20px;
    font-weight: bold;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #0D6EFD;
}

/* --- Sidebar --- */
QFrame#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #DEE2E6;
}

QLabel#SidebarLogo {
    color: #001F3F;
    font-weight: bold;
    font-size: 18px;
}

QToolButton#SidebarToggle {
    border: none;
    background: transparent;
}

/* Sidebar Buttons */
QToolButton#SidebarButton {
    background-color: transparent;
    color: #495057; /* Dark Gray */
    border: none;
    border-left: 4px solid transparent;
    text-align: left;
    padding-left: 20px;
    font-size: 14px;
    font-weight: normal;
}

QToolButton#SidebarButton:hover {
    background-color: #F8F9FA;
    color: #212529;
}

QToolButton#SidebarButton:checked, QToolButton#SidebarButton[active="true"] {
    background-color: #E3F2FD; /* Pale Blue */
    color: #0D6EFD;
    border-left: 4px solid #0D6EFD;
    font-weight: bold;
}

/* Collapsed State (via Property) */
QToolButton#SidebarButton[collapsed="true"] {
    padding-left: 0px;
    padding-right: 0px;
    text-align: center;
}

/* Special Sidebar Buttons */
QToolButton#BtnPos {
    color: #198754;
    border-top: 1px solid #DEE2E6;
    text-align: left;
    padding-left: 24px;
}

QToolButton#BtnPos:hover {
    background-color: #E8F5E9; /* Pale Green */
}

QToolButton#BtnPos[collapsed="true"] {
    text-align: center;
    padding-left: 0px;
}

QToolButton#BtnLogout {
    color: #DC3545;
    text-align: left;
    padding-left: 24px;
}

QToolButton#BtnLogout:hover {
    background-color: #FBE9EB; /* Pale Red */
}

QToolButton#BtnLogout[collapsed="true"] {
    text-align: center;
    padding-left: 0px;
}

/* --- Sales View Specifics --- */

/* Header (Dark Navy as requested) */
QWidget#HeaderWidget {
    background-color: #001F3F;
    border-bottom: 1px solid #003366;
}

QWidget#HeaderWidget QLabel {
    background: transparent;
}

QWidget#HeaderWidget QToolButton {
    background: transparent;
    border: none;
}

QLabel#LogoLabel {
    color: #00BCEB;
    font-weight: bold;
    font-size: 16px;
    background: transparent;
}

/* Search Bar & Filters */
QWidget#SearchWidget {
    background-color: transparent;
}

QToolButton#SearchModeBtn {
    background-color: #E0E0E0;
    color: #495057;
    border: 1px solid #CED4DA;
}

QToolButton#SearchModeBtn:checked {
    background-color: #00BCEB;
    color: #000000;
    font-weight: bold;
    border: 1px solid #00BCEB;
}

QToolButton#SearchModeBtn:hover {
    background-color: #D6D8DB;
}

/* Cart Table */
QTableWidget#CartTable {
    background-color: #FFFFFF;
    color: #212529;
    gridline-color: transparent;
}

QTableWidget#CartTable QHeaderView::section {
    background-color: #E9ECEF;
    color: #495057;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #DEE2E6;
    font-weight: bold;
}

QTableWidget#CartTable::item:selected {
    background-color: #E3F2FD;
    color: #0D6EFD;
}

QLabel[class="StrikethroughPrice"] {
    background-color: transparent;
    color: #DC3545;
}

/* Total Widget */
QWidget#TotalWidget {
    background-color: #F1F3F5;
    border-top: 1px solid #DEE2E6;
    border-radius: 0px;
}

QWidget#TotalWidget QLabel {
    background: transparent;
}

QLabel#SubtotalLabel, QLabel#TaxLabel {
    color: #495057;
    font-size: 14px;
    background: transparent;
}

QLabel#TotalLabel {
    font-size: 48px;
    font-weight: bold;
    color: #198754;
    background: transparent;
}

/* Action Panel */
QWidget#ActionPanel {
    background-color: #FFFFFF;
    border-left: 1px solid #DEE2E6;
}

QWidget#ActionPanel QLabel {
    background: transparent;
}

QFrame#CustomerPanel {
    background-color: #00BCEB;
    border-radius: 5px;
    padding: 5px;
}

QFrame#CustomerPanel QLabel {
    background: transparent;
}

QLabel#CustomerLabel {
    font-weight: bold;
    font-size: 14px;
    color: black;
    background: transparent;
}

QPushButton#BtnCustomerSelect {
    background-color: #FFFFFF;
    color: #00BCEB;
    border: 1px solid #00BCEB;
    padding: 5px;
}

QLabel#PointsLabel {
    color: black;
    font-weight: bold;
    font-size: 12px;
    background: transparent;
}

/* Action Grid Button */
QPushButton[class="ActionGridBtn"] {
    background-color: #00BCEB;
    border: 1px solid #0096C7;
    color: #000000;
    border-radius: 4px;
}

QPushButton[class="ActionGridBtn"]:hover {
    background-color: #00A8D6;
    border: 1px solid #0081AB;
}

QPushButton[class="ActionGridBtn"]:pressed {
    background-color: #0096C7;
    color: #FFFFFF;
}

/* Custom Colors for Action Buttons (Bottom Border) */
QPushButton[class="ActionGridBtn"][btnColor="#FFDC00"] { border-bottom: 3px solid #FFC107; }
QPushButton[class="ActionGridBtn"][btnColor="#FF4136"] { border-bottom: 3px solid #DC3545; }

/* Internal Labels in Grid Buttons */
QPushButton[class="ActionGridBtn"] QLabel {
    background: transparent;
    color: #000000;
}

QPushButton[class="ActionGridBtn"] QLabel#lblShortcut {
    color: #333333;
    font-size: 10px;
    font-weight: bold;
    background: transparent;
}

QPushButton[class="ActionGridBtn"] QLabel#lblText {
    color: #000000;
    font-size: 12px;
    font-weight: bold;
    background: transparent;
}

QPushButton[class="ActionGridBtn"]:pressed QLabel,
QPushButton[class="ActionGridBtn"]:pressed QLabel#lblText,
QPushButton[class="ActionGridBtn"]:pressed QLabel#lblShortcut {
    color: #FFFFFF;
}

/* Pay Button */
QPushButton#BtnPay {
    background-color: #198754;
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    border: none;
    border-radius: 5px;
}

QPushButton#BtnPay:hover {
    background-color: #157347;
}

QPushButton#BtnPay:pressed {
    background-color: #0F5132;
}

/* Dashboard Cards */
QWidget#InfoCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QLabel#InfoCardTitle {
    font-size: 12px;
    color: #6C757D;
}

/* Settings View */
QListWidget#SettingsSidebar {
    background-color: #F3F4F6;
    border: none;
    border-right: 1px solid #DEE2E6;
    outline: none;
}

QListWidget#SettingsSidebar::item {
    color: #495057;
    padding: 12px 20px;
    padding-left: 20px;
    border: none;
    border-left: 3px solid transparent;
    background-color: transparent;
}

QListWidget#SettingsSidebar::item:hover {
    background-color: #E9ECEF;
    color: #212529;
}

QListWidget#SettingsSidebar::item:selected {
    background-color: #E3F2FD;
    color: #0D6EFD;
    border-left: 3px solid #0D6EFD;
    font-weight: bold;
}

QWidget#SettingsContent {
    background-color: #FFFFFF;
    color: #212529;
}

/* Settings Content Area - Improved Input Styling */
QWidget#SettingsContent QLineEdit,
QWidget#SettingsContent QComboBox,
QWidget#SettingsContent QSpinBox,
QWidget#SettingsContent QDoubleSpinBox,
QWidget#SettingsContent QTextEdit {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding-left: 10px;
    min-height: 32px;
    font-size: 14px;
}

QWidget#SettingsContent QLineEdit:focus,
QWidget#SettingsContent QComboBox:focus,
QWidget#SettingsContent QSpinBox:focus,
QWidget#SettingsContent QDoubleSpinBox:focus,
QWidget#SettingsContent QTextEdit:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

/* Settings Form Labels */
QWidget#SettingsContent QLabel {
    color: #495057;
    font-size: 14px;
}

QLabel[class="SectionHeader"] {
    font-size: 18px;
    font-weight: bold;
    color: #0D6EFD;
    margin-bottom: 20px;
}

QFrame#SettingsFooter {
    background-color: #F8F9FA;
    border-top: 1px solid #DEE2E6;
}

/* --- Dialogs --- */

/* Payment Dialog */
QDialog#PaymentDialog {
    background-color: #FFFFFF;
    color: #212529;
}

QLabel#PaymentRemainingLabel {
    font-size: 24px;
    color: #DC3545;
    font-weight: bold;
    border: 1px solid #DC3545;
    padding: 10px;
}

QLabel#PaymentRemainingLabel[state="change"] {
    color: #198754;
    border: 1px solid #198754;
}

QWidget#PaymentEntryGroup {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QLabel#PaymentMethodLabel {
    font-weight: bold;
    font-size: 16px;
    color: #0D6EFD;
}

QComboBox#PaymentCustomerCombo {
    font-size: 18px;
    padding: 5px;
    color: #212529;
    background-color: #FFFFFF;
}

QPushButton#BtnAddPayment {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    padding: 10px;
}

QListWidget#PaymentList {
    font-size: 16px;
    color: #212529;
    background-color: #FFFFFF;
}

QPushButton#BtnFinishSale {
    background-color: #E9ECEF;
    color: #495057;
    padding: 15px;
    font-weight: bold;
}

QPushButton#BtnFinishSale:enabled {
    background-color: #198754;
    color: #FFFFFF;
}

QLabel#PaymentMethodsHeader {
    font-size: 18px;
    font-weight: bold;
    color: #495057;
}

QWidget#PaymentMethodsScroll {
    background: transparent;
    border: none;
}

QPushButton[class="PaymentMethodBtn"] {
    background-color: #FFFFFF;
    color: #0D6EFD;
    font-weight: bold;
    font-size: 14px;
    border: 2px solid #0D6EFD;
    border-radius: 8px;
}

QPushButton[class="PaymentMethodBtn"]:hover {
    background-color: #E3F2FD;
}

QPushButton[class="PaymentMethodBtnCash"] {
    background-color: #198754;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 14px;
    border: 2px solid #198754;
    border-radius: 8px;
}

QLabel#PaymentShortcutLabel {
    background: rgba(0,0,0,0.5);
    color: white;
    padding: 2px;
}

/* Discount Dialog */
QDialog#DiscountDialog {
    background-color: #FFFFFF;
    color: #212529;
}

QRadioButton#RbPercent, QRadioButton#RbFixed {
    font-size: 16px;
    font-weight: bold;
}

QDoubleSpinBox#DiscountValueInput {
    font-size: 32px;
    font-weight: bold;
    padding: 10px;
    border: 2px solid #0D6EFD;
    border-radius: 5px;
    background-color: #FFFFFF;
    color: #212529;
}

QDoubleSpinBox#DiscountValueInput::up-button, QDoubleSpinBox#DiscountValueInput::down-button {
    width: 0px;
}

QPushButton[class="PresetBtn"] {
    background-color: #E9ECEF;
    color: #212529;
    font-weight: bold;
    font-size: 16px;
    border-radius: 5px;
    border: 1px solid #CED4DA;
}

QPushButton[class="PresetBtn"]:hover {
    background-color: #DEE2E6;
}

QPushButton#BtnApplyDiscount {
    background-color: #198754;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 16px;
    border-radius: 5px;
}

/* Customer Editor */
QDialog#CustomerEditor, QDialog#CustomerQuickAddDialog {
    background-color: #FFFFFF;
    color: #212529;
}

/* Receipt Options */
QDialog#ReceiptOptionsDialog {
    background-color: #FFFFFF;
    color: #212529;
}

QLabel#ReceiptTitle {
    font-size: 24px;
    font-weight: bold;
    color: #198754;
}

QLabel#ReceiptInfo {
    font-size: 16px;
    color: #6C757D;
}

QPushButton[class="ReceiptOptionBtn"] {
    color: #212529;
    font-weight: bold;
    font-size: 16px;
    padding: 10px;
    border-radius: 5px;
}

QPushButton[class="ReceiptOptionBtn"]:hover {
    opacity: 0.9;
}

QPushButton[class="ReceiptOptionBtn"][btnColor="cyan"] { background-color: #0D6EFD; color: #FFFFFF; }
QPushButton[class="ReceiptOptionBtn"][btnColor="orange"] { background-color: #FFC107; color: #212529; }
QPushButton[class="ReceiptOptionBtn"][btnColor="gray"] { background-color: #6C757D; color: #FFFFFF; }
