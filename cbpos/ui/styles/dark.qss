/* 
    Ceylon Byte POS - Command Center Dark Theme 
    Palette:
    - Background: #1E1E1E (Global BG) / #252526 (Surface)
    - Text: #FFFFFF (Primary) / #AAAAAA (Secondary)
    - Border: #3E3E42
    - Accent: #00BCEB (Cyan)
    - Success: #39FF14 (Neon Green)
    - Warning: #FFDC00
    - Error: #FF4136
*/

/* Global Font Enforcement */
* {
    font-family: "{{FONT_FAMILY}}", "Noto Sans", "Segoe UI", sans-serif;
}

QLabel#BadgeLabel {
    color: #00BCEB;
    font-weight: bold;
}

QLabel.PlaceholderLabel {
    color: #AAAAAA;
}

QLabel.AboutLabel {
    font-size: 16px;
    color: #AAAAAA;
}

/* Global Reset */
QWidget {
    background-color: #1E1E1E;
    color: #FFFFFF;
    font-size: {{FONT_SIZE}};
}

/* Inputs - Global Baseline */
QLineEdit {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 8px;
    font-size: 16px;
    color: #FFFFFF;
    selection-background-color: #00BCEB;
    selection-color: #000000;
}

QLineEdit:focus {
    border: 1px solid #00BCEB;
    background-color: #2D2D30;
}

/* ComboBox - Dropdown Selector */
QComboBox {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 8px 12px;
    padding-right: 30px;  /* Space for arrow */
    font-size: 14px;
    color: #FFFFFF;
    min-height: 32px;
}

QComboBox:hover {
    border: 1px solid #555555;
    background-color: #333337;
}

QComboBox:focus {
    border: 1px solid #00BCEB;
    background-color: #333337;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
    background: transparent;
}

QComboBox::down-arrow {
    image: none;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 7px solid #CCCCCC;
    margin-right: 8px;
}

QComboBox:hover::down-arrow {
    border-top-color: #FFFFFF;
}

QComboBox QAbstractItemView {
    background-color: #252526;
    border: 1px solid #00BCEB;
    selection-background-color: #00BCEB;
    selection-color: #000000;
    color: #FFFFFF;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 28px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #2D2D30;
    color: #00BCEB;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #00BCEB;
    color: #000000;
}

/* SpinBox - Number Input */
QSpinBox, QDoubleSpinBox {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 8px 12px;
    padding-right: 40px;  /* Space for buttons */
    font-size: 14px;
    color: #FFFFFF;
    min-height: 32px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #555555;
    background-color: #333337;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #00BCEB;
    background-color: #333337;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background-color: #3E3E42;
    border: none;
    border-top-right-radius: 4px;
    width: 20px;
    subcontrol-origin: border;
    subcontrol-position: top right;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #555555;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed {
    background-color: #00BCEB;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-bottom: 6px solid #CCCCCC;
    width: 0;
    height: 0;
}

QSpinBox::up-button:hover::up-arrow, QDoubleSpinBox::up-button:hover::up-arrow {
    border-bottom-color: #FFFFFF;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #3E3E42;
    border: none;
    border-bottom-right-radius: 4px;
    width: 20px;
    subcontrol-origin: border;
    subcontrol-position: bottom right;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #555555;
}

QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #00BCEB;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #CCCCCC;
    width: 0;
    height: 0;
}

QSpinBox::down-button:hover::down-arrow, QDoubleSpinBox::down-button:hover::down-arrow {
    border-top-color: #FFFFFF;
}

/* Buttons */
QPushButton {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 10px 20px;
    font-weight: bold;
    color: #FFFFFF;
    text-transform: uppercase;
}

QPushButton:hover {
    background-color: #3E3E42;
    border: 1px solid #555;
}

QPushButton:pressed {
    background-color: #007ACC;
}

/* Primary Action Button (Green) */
QPushButton#BtnSave, QPushButton#PayBtn, QPushButton[class="primary"] {
    background-color: #39FF14;
    color: #001F3F;
    border: none;
}

QPushButton#BtnSave:hover, QPushButton#PayBtn:hover, QPushButton[class="primary"]:hover {
    background-color: #32E012;
}

/* Danger Button (Red) */
QPushButton#BtnCancel, QPushButton#VoidBtn, QPushButton[class="danger"] {
    background-color: #FF4136;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnCancel:hover, QPushButton#VoidBtn:hover, QPushButton[class="danger"]:hover {
    background-color: #E0362C;
}

/* Warning Button (Yellow) */
QPushButton[class="warning"] {
    background-color: #FFDC00;
    color: #001F3F;
    border: none;
}

/* Lists & Tables */
QListWidget, QTableWidget {
    background-color: #252526;
    border: 1px solid #3E3E42;
    outline: none;
    gridline-color: #3E3E42;
    alternate-background-color: #2D2D30;
}

QListWidget::item, QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #3E3E42;
    color: #FFFFFF;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #007ACC;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #003366; /* Navy Header */
    color: #FFFFFF;
    padding: 10px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #00BCEB;
    text-transform: uppercase;
}

QTableCornerButton::section {
    background-color: #003366;
    border: none;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #1E1E1E;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #444;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #3E3E42;
    background-color: #252526;
}

QTabBar::tab {
    background: #2D2D30;
    color: #AAAAAA;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #007ACC;
    color: #FFFFFF;
    font-weight: bold;
}

/* Group Box */
QGroupBox {
    border: 1px solid #3E3E42;
    border-radius: 4px;
    margin-top: 20px;
    font-weight: bold;
    background-color: #252526;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #00BCEB;
}

/* --- Sidebar --- */
QFrame#Sidebar {
    background-color: #001830;
    border-right: 1px solid #003366;
}

QLabel#SidebarLogo {
    color: white;
    font-weight: bold;
    font-size: 18px;
}

QToolButton#SidebarToggle {
    border: none;
    background: transparent;
}

/* Sidebar Buttons */
QToolButton#SidebarButton {
    background-color: transparent;
    color: #AAAAAA;
    border: none;
    border-left: 4px solid transparent;
    text-align: left;
    padding-left: 20px;
    font-size: 14px;
    font-weight: normal;
}

QToolButton#SidebarButton:hover {
    background-color: #002855;
    color: white;
}

QToolButton#SidebarButton:checked, QToolButton#SidebarButton[active="true"] {
    background-color: #003366;
    color: #00BCEB;
    border-left: 4px solid #00BCEB;
    font-weight: bold;
}

/* Collapsed State (via Property) */
QToolButton#SidebarButton[collapsed="true"] {
    padding-left: 0px;
    padding-right: 0px;
    text-align: center;
}

/* Special Sidebar Buttons */
QToolButton#BtnPos {
    color: #39FF14;
    background-color: rgba(57, 255, 20, 0.1);
    border: none;
    border-top: 1px solid #333;
    text-align: left;
    padding-left: 24px;
}

QToolButton#BtnPos:hover {
    background-color: rgba(57, 255, 20, 0.2);
}

QToolButton#BtnPos[collapsed="true"] {
    text-align: center;
    padding-left: 0px;
}

QToolButton#BtnLogout {
    color: #FF4136;
    background-color: rgba(255, 65, 54, 0.1);
    border: none;
    text-align: left;
    padding-left: 24px;
}

QToolButton#BtnLogout:hover {
    background-color: rgba(255, 65, 54, 0.2);
}

QToolButton#BtnLogout[collapsed="true"] {
    text-align: center;
    padding-left: 0px;
}

/* --- Sales View Specifics --- */

/* Header */
QWidget#HeaderWidget {
    background-color: #001226;
    border-bottom: 1px solid #003366;
}

QWidget#HeaderWidget QLabel {
    background: transparent;
}

QWidget#HeaderWidget QToolButton {
    background: transparent;
    border: none;
}

QLabel#LogoLabel {
    color: #00BCEB;
    font-weight: bold;
    font-size: 16px;
    background: transparent;
}

/* Search Bar & Filters */
QWidget#SearchWidget {
    background-color: transparent;
}

QToolButton#SearchModeBtn {
    background-color: #2D2D30;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
}

QToolButton#SearchModeBtn:checked {
    background-color: #00BCEB;
    color: #000000;
    font-weight: bold;
}

/* Cart Table */
QTableWidget#CartTable {
    background-color: #252526;
    color: #FFFFFF;
    gridline-color: #3E3E42;
}

QLabel[class="StrikethroughPrice"] {
    background-color: transparent;
    color: white;
}

/* Total Widget */
QWidget#TotalWidget {
    background-color: #252526;
    border-top: 2px solid #3E3E42;
    border-radius: 5px;
}

QWidget#TotalWidget QLabel {
    background: transparent;
}

QLabel#SubtotalLabel, QLabel#TaxLabel {
    color: #AAAAAA;
    font-size: 14px;
    background: transparent;
}

QLabel#TotalLabel {
    font-size: 48px;
    font-weight: bold;
    color: #39FF14;
    background: transparent;
}

/* Action Panel */
QWidget#ActionPanel {
    background-color: #1E1E1E;
    border-left: 1px solid #3E3E42;
}

QWidget#ActionPanel QLabel {
    background: transparent;
}

QFrame#CustomerPanel {
    background-color: #2D2D30;
    border-radius: 5px;
    padding: 5px;
}

QFrame#CustomerPanel QLabel {
    background: transparent;
}

QLabel#CustomerLabel {
    font-weight: bold;
    font-size: 14px;
    color: white;
    background: transparent;
}

QPushButton#BtnCustomerSelect {
    background-color: #007ACC;
    color: white;
    border: none;
    padding: 5px;
}

QLabel#PointsLabel {
    color: #FFDC00;
    font-weight: bold;
    font-size: 12px;
    background: transparent;
}

/* Action Grid Button */
QPushButton[class="ActionGridBtn"] {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    color: #FFFFFF;
    border-radius: 4px;
}

QPushButton[class="ActionGridBtn"]:hover {
    background-color: #3E3E42;
    border: 1px solid #00BCEB;
}

QPushButton[class="ActionGridBtn"]:pressed {
    background-color: #00BCEB;
    color: #000000;
}

/* Custom Colors for Action Buttons (Bottom Border) */
QPushButton[class="ActionGridBtn"][btnColor="#FFDC00"] { border-bottom: 3px solid #FFDC00; }
QPushButton[class="ActionGridBtn"][btnColor="#FF4136"] { border-bottom: 3px solid #FF4136; }

/* Internal Labels in Grid Buttons */
QPushButton[class="ActionGridBtn"] QLabel {
    background: transparent;
    color: #FFFFFF;
}

QPushButton[class="ActionGridBtn"] QLabel#lblShortcut {
    color: #CCCCCC;
    font-size: 10px;
    font-weight: bold;
    background: transparent;
}

QPushButton[class="ActionGridBtn"] QLabel#lblText {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: bold;
    background: transparent;
}

QPushButton[class="ActionGridBtn"]:pressed QLabel,
QPushButton[class="ActionGridBtn"]:pressed QLabel#lblText,
QPushButton[class="ActionGridBtn"]:pressed QLabel#lblShortcut {
    color: #000000;
}

/* Pay Button */
QPushButton#BtnPay {
    background-color: #39FF14;
    color: #001F3F;
    font-size: 24px;
    font-weight: bold;
    border: none;
    border-radius: 5px;
}

QPushButton#BtnPay:hover {
    background-color: #32E012;
}

QPushButton#BtnPay:pressed {
    background-color: #28B40E;
}

/* Dashboard Cards */
QWidget#InfoCard {
    background-color: #003366;
    border-radius: 8px;
    border: 1px solid #00509E;
}

QLabel#InfoCardTitle {
    font-size: 12px;
    color: #AAAAAA;
}

/* Settings View */
QListWidget#SettingsSidebar {
    background-color: #252526; /* VS Code sidebar color */
    border: none;
    border-right: 1px solid #3E3E42;
    outline: none;
}

QListWidget#SettingsSidebar::item {
    color: #CCCCCC;
    padding: 12px 20px;
    padding-left: 20px;
    border: none;
    border-left: 3px solid transparent;
    background-color: transparent;
}

QListWidget#SettingsSidebar::item:hover {
    background-color: #2D2D30;
    color: #FFFFFF;
}

QListWidget#SettingsSidebar::item:selected {
    background-color: #37373D;
    color: #00BCEB;
    border-left: 3px solid #00BCEB;
    font-weight: bold;
}

QWidget#SettingsContent {
    background-color: #1E1E1E;
    color: #FFFFFF;
}

/* Settings Content Area - Improved Input Styling */
QWidget#SettingsContent QLineEdit,
QWidget#SettingsContent QComboBox,
QWidget#SettingsContent QSpinBox,
QWidget#SettingsContent QDoubleSpinBox,
QWidget#SettingsContent QTextEdit {
    background-color: #333337;
    color: #EEEEEE;
    border: 1px solid #555555;
    border-radius: 4px;
    padding-left: 10px;
    min-height: 32px;
    font-size: 14px;
}

QWidget#SettingsContent QLineEdit:focus,
QWidget#SettingsContent QComboBox:focus,
QWidget#SettingsContent QSpinBox:focus,
QWidget#SettingsContent QDoubleSpinBox:focus,
QWidget#SettingsContent QTextEdit:focus {
    border: 1px solid #00BCEB;
    background-color: #3A3A3E;
}

/* Settings Form Labels */
QWidget#SettingsContent QLabel {
    color: #DDDDDD;
    font-size: 14px;
}

QLabel[class="SectionHeader"] {
    font-size: 18px;
    font-weight: bold;
    color: #00BCEB;
    margin-bottom: 20px;
}

QFrame#SettingsFooter {
    background-color: #2D2D30;
    border-top: 1px solid #3E3E42;
}

/* --- Dialogs --- */

/* Payment Dialog */
QDialog#PaymentDialog {
    background-color: #001F3F;
    color: white;
}

QLabel#PaymentRemainingLabel {
    font-size: 24px;
    color: #FF4136;
    font-weight: bold;
    border: 1px solid #FF4136;
    padding: 10px;
}

QLabel#PaymentRemainingLabel[state="change"] {
    color: #39FF14;
    border: 1px solid #39FF14;
}

QWidget#PaymentEntryGroup {
    background-color: #003366;
    border-radius: 8px;
}

QLabel#PaymentMethodLabel {
    font-weight: bold;
    font-size: 16px;
    color: #00BCEB;
}

QComboBox#PaymentCustomerCombo {
    font-size: 18px;
    padding: 5px;
    color: black;
    background-color: white;
}

QPushButton#BtnAddPayment {
    background-color: #00BCEB;
    color: black;
    font-weight: bold;
    padding: 10px;
}

QListWidget#PaymentList {
    font-size: 16px;
    color: black;
    background-color: white;
}

QPushButton#BtnFinishSale {
    background-color: #AAAAAA;
    color: black;
    padding: 15px;
    font-weight: bold;
}

QPushButton#BtnFinishSale:enabled {
    background-color: #39FF14;
}

QLabel#PaymentMethodsHeader {
    font-size: 18px;
    font-weight: bold;
    color: #AAAAAA;
}

QWidget#PaymentMethodsScroll {
    background: transparent;
    border: none;
}

QPushButton[class="PaymentMethodBtn"] {
    background-color: #003366;
    color: white;
    font-weight: bold;
    font-size: 14px;
    border: 2px solid #005bb5;
    border-radius: 8px;
}

QPushButton[class="PaymentMethodBtn"]:hover {
    background-color: #004080;
}

QPushButton[class="PaymentMethodBtnCash"] {
    background-color: #2ECC40;
    color: white;
    font-weight: bold;
    font-size: 14px;
    border: 2px solid #2ECC40;
    border-radius: 8px;
}

QLabel#PaymentShortcutLabel {
    background: rgba(0,0,0,0.5);
    color: white;
    padding: 2px;
}

/* Discount Dialog */
QDialog#DiscountDialog {
    background-color: #001F3F;
    color: white;
}

QRadioButton#RbPercent, QRadioButton#RbFixed {
    font-size: 16px;
    font-weight: bold;
}

QDoubleSpinBox#DiscountValueInput {
    font-size: 32px;
    font-weight: bold;
    padding: 10px;
    border: 2px solid #00BCEB;
    border-radius: 5px;
    background-color: #003366;
    color: white;
}

QDoubleSpinBox#DiscountValueInput::up-button, QDoubleSpinBox#DiscountValueInput::down-button {
    width: 0px;
}

QPushButton[class="PresetBtn"] {
    background-color: #0074D9;
    color: white;
    font-weight: bold;
    font-size: 16px;
    border-radius: 5px;
}

QPushButton[class="PresetBtn"]:hover {
    background-color: #005bb5;
}

QPushButton#BtnApplyDiscount {
    background-color: #39FF14;
    color: black;
    font-weight: bold;
    font-size: 16px;
    border-radius: 5px;
}

/* Customer Editor */
QDialog#CustomerEditor, QDialog#CustomerQuickAddDialog {
    background-color: #1E1E1E;
    color: white;
}

/* Receipt Options */
QDialog#ReceiptOptionsDialog {
    background-color: #001F3F;
    color: white;
}

QLabel#ReceiptTitle {
    font-size: 24px;
    font-weight: bold;
    color: #39FF14;
}

QLabel#ReceiptInfo {
    font-size: 16px;
    color: #AAAAAA;
}

QPushButton[class="ReceiptOptionBtn"] {
    color: black;
    font-weight: bold;
    font-size: 16px;
    padding: 10px;
    border-radius: 5px;
}

QPushButton[class="ReceiptOptionBtn"]:hover {
    background-color: white;
}

QPushButton[class="ReceiptOptionBtn"][btnColor="cyan"] { background-color: #00BCEB; }
QPushButton[class="ReceiptOptionBtn"][btnColor="orange"] { background-color: #FF851B; }
QPushButton[class="ReceiptOptionBtn"][btnColor="gray"] { background-color: #AAAAAA; }
