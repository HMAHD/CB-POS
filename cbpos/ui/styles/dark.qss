/* 
    Ceylon Byte POS - Industrial Theme 
    Palette:
    - Background: #1E1E1E (Dark Grey)
    - Sidebar/Panel: #2D2D30 (Lighter Grey)
    - Input BG: #333333
    - Accent: #00BCEB (Cyan)
    - Success: #39FF14 (Neon Green) or #4CAF50 (Material Green)
    - Warning: #FFDC00 (Yellow)
    - Error: #F44336 (Red)
    - Text: #FFFFFF (White)
*/

/* Global Font Enforcement - MUST come first */
* {
    font-family: "Noto Sans", "Iskoola Pota", "Segoe UI", sans-serif;
}

/* Global Reset */
QWidget {
    background-color: #1E1E1E;
    color: #FFFFFF;
    font-size: 14px;
}

/* Inputs */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #333333;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 8px;
    font-size: 16px;
    color: #FFFFFF;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #00BCEB;
}

/* Buttons */
QPushButton {
    background-color: #404040;
    border: none;
    border-radius: 4px;
    padding: 10px 20px;
    font-weight: bold;
    color: #FFFFFF;
    text-transform: uppercase;
}

QPushButton:hover {
    background-color: #505050;
    border: 1px solid #00BCEB;
}

QPushButton:pressed {
    background-color: #303030;
}

/* Primary Action Button (e.g., Pay, Save) */
QPushButton#BtnSave, QPushButton#PayBtn, QPushButton[class="primary"] {
    background-color: #4CAF50; /* Material Green */
    color: #FFFFFF;
}

QPushButton#BtnSave:hover, QPushButton#PayBtn:hover, QPushButton[class="primary"]:hover {
    background-color: #43A047;
}

/* Danger Button (e.g., Void, Cancel) */
QPushButton#BtnCancel, QPushButton#VoidBtn, QPushButton[class="danger"] {
    background-color: #F44336; /* Red */
    color: #FFFFFF;
}

QPushButton#BtnCancel:hover, QPushButton#VoidBtn:hover, QPushButton[class="danger"]:hover {
    background-color: #D32F2F;
}

/* Warning Button (e.g., Hold) */
QPushButton[class="warning"] {
    background-color: #FFDC00;
    color: #000000;
}

/* Lists & Tables */
QListWidget, QTableWidget {
    background-color: #1E1E1E;
    border: none;
    outline: none;
    gridline-color: #2D2D30;
}

QListWidget::item, QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #2D2D30;
    color: #FFFFFF;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #39FF14;
    color: #000000;
    border-left: 4px solid #00BCEB;
}

QHeaderView::section {
    background-color: #00BCEB;
    color: #000000;
    padding: 10px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #0099CC;
    text-transform: uppercase;
}

QTableCornerButton::section {
    background-color: #00BCEB;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #1E1E1E;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #404040;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #3E3E42;
    background-color: #1E1E1E;
}

QTabBar::tab {
    background: #2D2D30;
    color: #FFFFFF;
    padding: 10px 20px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #00BCEB;
    color: #000000;
    font-weight: bold;
}

/* Group Box */
QGroupBox {
    border: 1px solid #3E3E42;
    border-radius: 4px;
    margin-top: 20px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #00BCEB;
}

/* Sidebar Specifics */
QFrame#Sidebar {
    background-color: #001830;
}

/* Sidebar Buttons (QToolButton) */
/* Sidebar Buttons (QToolButton) */
/* Sidebar Buttons (QToolButton) */
QToolButton {
    padding-top: 15px;
    padding-bottom: 15px;
    padding-left: 24px;
    padding-right: 40px;
    margin: 0px;
    border: none;
    border-radius: 0px;
    background: transparent;
    color: #AAAAAA;
    text-align: left;
    width: 100%;
}

QToolButton:hover {
    background-color: #002855;
    color: #FFFFFF;
    border-left: 4px solid #00BCEB;
}

QToolButton:checked, QToolButton[active="true"] {
    background-color: #003366;
    color: #FFFFFF;
    border-left: 4px solid #00BCEB;
    font-weight: bold;
}

/* Special Sidebar Buttons */
QToolButton#BtnPos {
    color: #39FF14; /* Neon Green */
    font-weight: bold;
    border-top: 1px solid #333333;
    background-color: rgba(57, 255, 20, 0.1);
}

QToolButton#BtnPos:hover {
    background-color: rgba(57, 255, 20, 0.2);
    border-left: 4px solid #39FF14;
}

QToolButton#BtnLogout {
    color: #FF4136; /* Signal Red */
    background-color: rgba(255, 65, 54, 0.1);
}

QToolButton#BtnLogout:hover {
    background-color: rgba(255, 65, 54, 0.2);
    border-left: 4px solid #FF4136;
}

/* --- Phase 16: Sales View Polish --- */

/* Splitter Handle */
QSplitter::handle {
    background-color: #2D2D30;
    width: 10px;
    margin: 2px;
    border-left: 1px solid #3E3E42;
    border-right: 1px solid #3E3E42;
}

/* Action Grid Button */
QPushButton[class="ActionGridBtn"] {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    color: white;
    border-radius: 4px;
}
QPushButton[class="ActionGridBtn"]:hover {
    border: 1px solid #00BCEB;
    background-color: #3E3E42;
}
QPushButton[class="ActionGridBtn"]:pressed {
    background-color: #00BCEB;
    color: black;
}

/* Custom Colors for Action Buttons (Bottom Border) */
QPushButton[class="ActionGridBtn"][btnColor="#FFDC00"] { border-bottom: 3px solid #FFDC00; }
QPushButton[class="ActionGridBtn"][btnColor="#FF4136"] { border-bottom: 3px solid #FF4136; }

/* Internal Labels */
QPushButton[class="ActionGridBtn"] QLabel#lblShortcut {
    color: #888888;
    font-size: 10px;
    font-weight: bold;
    background: transparent;
}
QPushButton[class="ActionGridBtn"] QLabel#lblText {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: bold;
    background: transparent;
}
QPushButton[class="ActionGridBtn"]:pressed QLabel#lblText,
QPushButton[class="ActionGridBtn"]:pressed QLabel#lblShortcut {
    color: #000000;
}

/* Search Mode Buttons (Segmented Control) */
QToolButton[class="SearchModeBtn"] {
    background-color: #333333;
    border: 1px solid #555555;
    color: #AAAAAA;
    font-size: 16px;
    font-weight: bold;
    border-radius: 0px;
    margin-right: -1px; /* Overlap borders */
}
QToolButton[class="SearchModeBtn"]:first {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}
QToolButton[class="SearchModeBtn"]:last {
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    margin-right: 0px;
}
QToolButton[class="SearchModeBtn"]:checked {
    background-color: #00BCEB;
    color: #000000;
    border: 1px solid #00BCEB;
    border: 1px solid #00BCEB;
}
QToolButton[class="SearchModeBtn"]:hover {
    background-color: #444444;
    color: #FFFFFF;
}

/* --- Phase 17: UI/UX Overhaul Fixes --- */

/* 2.2 Product Search Filter Icons */
#widget_search_filters QPushButton {
    background-color: transparent;
    border: none;
    color: #B0BEC5; /* Light gray by default */
    padding: 5px;
    border-radius: 4px;
}

#widget_search_filters QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1); /* Subtle light hover */
    color: #FFFFFF;
}

#widget_search_filters QPushButton:checked {
    background-color: #00BCEB; /* Cyan accent for selected state */
    color: #FFFFFF;
}

/* 2.3 Right Panel Shortcuts & Buttons */
#frame_sales_right QPushButton {
    color: #FFFFFF;
    font-weight: bold;
}

/* Shortcut Labels */
.label-shortcut {
    color: #E0E0E0; /* Slightly muted white for shortcut hints */
    font-size: 10px;
}

/* 2.4 "ORDERS:" Label Footer Fix */
#lbl_orders_header {
    background-color: transparent; /* Remove blue bg */
    color: #00BCEB; /* Keep cyan text color */
    font-weight: bold;
    padding: 0;
    margin-bottom: 5px;
}

/* --- Sales View Specifics (Task 1) --- */

/* 1.1 Search Bar & Filters */
QWidget#SearchWidget {
    background-color: transparent;
}

QToolButton#SearchModeBtn {
    background-color: #333333;
    color: #BBBBBB;
    border: 1px solid #555555;
}

QToolButton#SearchModeBtn:checked {
    background-color: #00BCEB;
    color: #000000;
    font-weight: bold;
    border: 1px solid #00BCEB;
}

QToolButton#SearchModeBtn:hover {
    border: 1px solid #00BCEB;
}

/* 1.2 Cart Table */
QTableWidget#CartTable {
    background-color: #1E1E1E;
    gridline-color: transparent;
}

QTableWidget#CartTable QHeaderView::section {
    background-color: #003366;
    color: #00BCEB;
    padding: 8px;
    border: none;
    font-weight: bold;
}

QTableWidget#CartTable::item:selected {
    background-color: #004080;
    color: #FFFFFF;
}

/* 1.3 Total Widget */
QWidget#TotalWidget {
    background-color: #2D2D30;
    border-top: 2px solid #00BCEB;
    border-radius: 0px; /* Reset radius if needed */
}
