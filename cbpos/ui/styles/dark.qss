/* 
    Ceylon Byte POS - Command Center Dark Theme 
    Palette:
    - Background: #1E1E1E (Global BG) / #252526 (Surface)
    - Text: #FFFFFF (Primary) / #AAAAAA (Secondary)
    - Border: #3E3E42
    - Accent: #00BCEB (Cyan)
    - Success: #39FF14 (Neon Green)
    - Warning: #FFDC00
    - Error: #FF4136
*/

/* Global Font Enforcement */
* {
    font-family: "{{FONT_FAMILY}}", "Noto Sans", "Segoe UI", "Arial";
}

QLabel.PlaceholderLabel {
    color: #AAAAAA;
}

QLabel.AboutLabel {
    font-size: 16px;
    color: #AAAAAA;
}

/* Global Reset */
QWidget {
    background-color: #1E1E1E;
    color: #FFFFFF;
    font-size: {{FONT_SIZE}};
}

/* Inputs - Global Baseline */
QLineEdit {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 8px;
    font-size: 16px;
    color: #FFFFFF;
    selection-background-color: #00BCEB;
    selection-color: #000000;
}

QLineEdit:focus {
    border: 1px solid #00BCEB;
    background-color: #2D2D30;
}

/* ComboBox - Dropdown Selector */
QComboBox {
    background-color: #2D2D30;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 8px 12px;
    padding-right: 35px;  /* Space for arrow */
    font-size: 14px;
    color: #FFFFFF;
    min-height: 32px;
}

QComboBox:hover {
    border: 1px solid #00BCEB;
    background-color: #333337;
}

QComboBox:focus {
    border: 2px solid #00BCEB;
    background-color: #333337;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #555555;  /* Separator line */
    background: #3E3E42;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::drop-down:hover {
    background: #00BCEB;  /* Cyan background on hover */
}

QComboBox::down-arrow {
    image: url(cbpos/assets/icons/chevron-down-cyan.svg);
    width: 14px;
    height: 14px;
}

QComboBox::drop-down:hover QComboBox::down-arrow,
QComboBox:hover::down-arrow {
    image: url(cbpos/assets/icons/chevron-down-white.svg);
}

QComboBox QAbstractItemView {
    background-color: #252526;
    border: 1px solid #00BCEB;
    selection-background-color: #00BCEB;
    selection-color: #000000;
    color: #FFFFFF;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 28px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #2D2D30;
    color: #00BCEB;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #00BCEB;
    color: #000000;
}

/* SpinBox - Number Input (Modern Touch-Friendly Design) */
QSpinBox, QDoubleSpinBox {
    background-color: #2D2D30;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 8px 12px;
    padding-right: 35px;  /* Space for wider buttons */
    font-size: 14px;
    color: #FFFFFF;
    min-height: 36px;  /* Touch-friendly height */
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #00BCEB;
    background-color: #333337;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #00BCEB;
    background-color: #333337;
}

/* UP Button (+) - Clear plus icon */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 30px;
    height: 18px;
    border-left: 1px solid #555555;
    border-bottom: 1px solid #555555;
    background-color: #3E3E42;
    border-top-right-radius: 4px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #00BCEB;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed {
    background-color: #0099CC;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(cbpos/assets/icons/plus-white.svg);
    width: 12px;
    height: 12px;
}

QSpinBox::up-button:hover::up-arrow, QDoubleSpinBox::up-button:hover::up-arrow {
    image: url(cbpos/assets/icons/plus-black.svg);
}

/* DOWN Button (-) - Clear minus icon */
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 30px;
    height: 18px;
    border-left: 1px solid #555555;
    border-top: 1px solid #555555;
    background-color: #3E3E42;
    border-bottom-right-radius: 4px;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #00BCEB;
}

QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #0099CC;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(cbpos/assets/icons/minus-white.svg);
    width: 12px;
    height: 12px;
}

QSpinBox::down-button:hover::down-arrow, QDoubleSpinBox::down-button:hover::down-arrow {
    image: url(cbpos/assets/icons/minus-black.svg);
}

/* Checkboxes - Toggle Style with Checkmark */
QCheckBox {
    spacing: 10px;
    color: #E0E0E0;
    background-color: transparent;
}

/* Unchecked State - Empty box with visible border */
QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #666666;
    border-radius: 4px;
    background-color: transparent;
}

/* Unchecked Hover - Cyan glow */
QCheckBox::indicator:unchecked:hover {
    border-color: #00BCEB;
    background-color: rgba(0, 188, 235, 0.1);
}

/* Checked State - Cyan fill with white checkmark */
QCheckBox::indicator:checked {
    background-color: #00BCEB;
    border-color: #00BCEB;
    image: url(cbpos/assets/icons/check-white.svg);
}

/* Checked Hover - Brighter cyan with checkmark */
QCheckBox::indicator:checked:hover {
    background-color: #00E5FF;
    border-color: #00E5FF;
    image: url(cbpos/assets/icons/check-white.svg);
}

/* Buttons */
QPushButton {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 10px 20px;
    font-weight: bold;
    color: #FFFFFF;
    text-transform: uppercase;
}

QPushButton:hover {
    background-color: #3E3E42;
    border: 1px solid #555;
}

QPushButton:pressed {
    background-color: #007ACC;
}

/* Primary Action Button (Green) */
QPushButton#BtnSave, QPushButton#PayBtn, QPushButton[class="primary"] {
    background-color: #39FF14;
    color: #001F3F;
    border: none;
}

QPushButton#BtnSave:hover, QPushButton#PayBtn:hover, QPushButton[class="primary"]:hover {
    background-color: #32E012;
}

/* Danger Button (Red) */
QPushButton#BtnCancel, QPushButton#VoidBtn, QPushButton[class="danger"] {
    background-color: #FF4136;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnCancel:hover, QPushButton#VoidBtn:hover, QPushButton[class="danger"]:hover {
    background-color: #E0362C;
}

/* Accent Button (Cyan) */
QPushButton[class="accent"] {
    background-color: #00BCEB;
    color: #001F3F;
    border: none;
    font-weight: bold;
}

QPushButton[class="accent"]:hover {
    background-color: #00A5D0;
}

/* Warning Button (Yellow) */
QPushButton[class="warning"] {
    background-color: #FFDC00;
    color: #001F3F;
    border: none;
}

/* --- Dialog Label Classes --- */
QLabel[class="dialog-title"] {
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}

QLabel[class="muted"] {
    color: #AAAAAA;
    background: transparent;
}

QLabel[class="debit"] {
    font-weight: bold;
    color: #FF4136;
    background: transparent;
}

QLabel[class="credit"] {
    font-weight: bold;
    color: #39FF14;
    background: transparent;
}

QLabel[class="bold"] {
    font-weight: bold;
    background: transparent;
}

QLabel[class="transparent"] {
    background: transparent;
}

/* Lists & Tables */
QListWidget, QTableWidget {
    background-color: #252526;
    border: 1px solid #3E3E42;
    outline: none;
    gridline-color: #3E3E42;
    alternate-background-color: #2D2D30;
}

QListWidget::item, QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #3E3E42;
    color: #FFFFFF;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #007ACC;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #003366; /* Navy Header */
    color: #FFFFFF;
    padding: 10px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #00BCEB;
    text-transform: uppercase;
}

QTableCornerButton::section {
    background-color: #003366;
    border: none;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #1E1E1E;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #444;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ScrollArea Transparency Fix */
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #3E3E42;
    background-color: #252526;
}

QTabBar::tab {
    background: #2D2D30;
    color: #AAAAAA;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #007ACC;
    color: #FFFFFF;
    font-weight: bold;
}

/* Group Box */
QGroupBox {
    border: 1px solid #3E3E42;
    border-radius: 4px;
    margin-top: 20px;
    font-weight: bold;
    background-color: #252526;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #00BCEB;
}

/* --- FIX: Force Transparency for Labels & Checkboxes inside GroupBoxes --- */
QGroupBox QLabel {
    background-color: transparent;
    color: #E0E0E0;
}

QGroupBox QCheckBox {
    background-color: transparent;
    color: #E0E0E0;
}

/* --- Sidebar --- */
/* Sidebar Container - Dark Mode */
QFrame#SidebarContainer,
QFrame#Sidebar {
    background-color: #1A1A1A;  /* Flat dark gray - matches dashboard cards */
    border-right: 1px solid #2A2A2A;
}

/* User Profile Section - Dark Mode (KILL THE LINES) */
QWidget#UserProfileContainer {
    background-color: transparent;  /* Blend with sidebar */
    border: none;  /* Remove all borders */
    outline: none;  /* Remove outline */
}

/* POS Side Menu (Hamburger Menu) - Dark Mode */
QWidget#POSSideMenu {
    background-color: #1A1A1A;  /* Flat dark gray */
    border-left: 1px solid #2A2A2A;
}

/* POS Side Menu - Labels (Username, Role) */
QWidget#POSSideMenu QLabel {
    background-color: transparent;
    color: #E0E0E0;  /* Light text for dark background */
}

/* POS Side Menu - Separator Lines */
QWidget#POSSideMenu QFrame[frameShape="4"] {
    background-color: #2A2A2A;  /* Flat gray separator */
}

/* POS Side Menu - Menu Buttons */
QPushButton#MenuButton {
    background-color: transparent;
    color: #E0E0E0;
    border: none;
    text-align: left;
    padding-left: 15px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#MenuButton:hover {
    background-color: #252525;  /* Subtle gray highlight */
    color: #00BCEB;  /* Cyan highlight */
}

QPushButton#MenuButton[destructive="true"] {
    color: #FF4136;  /* Red for destructive actions */
}

QPushButton#MenuButton[destructive="true"]:hover {
    background-color: rgba(255, 65, 54, 0.1);
    color: #FF4136;
}

/* POS Side Menu - Icon Buttons (Bottom Toolbar) */
QPushButton#IconButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
}

QPushButton#IconButton:hover {
    background-color: #002855;
}

QPushButton#IconButton:pressed {
    background-color: #003366;
}

/* POS Side Menu - Username Label */
QLabel#MenuUsername {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    background-color: transparent;
}

/* POS Side Menu - Role Label */
QLabel#MenuRole {
    color: #AAAAAA;  /* Muted gray */
    font-size: 13px;
    font-weight: normal;
    background-color: transparent;
}

QLabel#SidebarLogo {
    color: white;
    font-weight: bold;
    font-size: 20px;  /* Larger for better visibility */
}

QToolButton#SidebarToggle {
    border: none;
    background: transparent;
}

/* Sidebar Buttons */
QToolButton#SidebarButton {
    background-color: transparent;
    color: #AAAAAA;
    border: none;
    border-left: 4px solid transparent;
    text-align: left;
    padding-left: 20px;
    font-size: 15px;  /* Slightly larger for readability */
    font-weight: normal;
}

QToolButton#SidebarButton:hover {
    background-color: #252525;  /* Flat gray hover */
    color: white;
}

QToolButton#SidebarButton:checked, QToolButton#SidebarButton[active="true"] {
    background-color: #2A2A2A;  /* Flat gray active state */
    color: #00BCEB;
    border-left: 4px solid #00BCEB;
    font-weight: 600;
}

/* Collapsed State (via Property) */
QToolButton#SidebarButton[collapsed="true"] {
    padding-left: 0px;
    padding-right: 0px;
    text-align: center;
}

/* Special Sidebar Buttons */
QToolButton#BtnPos {
    color: #39FF14;
    background-color: rgba(57, 255, 20, 0.1);
    border: none;
    border-top: 1px solid #333;
    text-align: left;
    padding-left: 24px;
}

QToolButton#BtnPos:hover {
    background-color: rgba(57, 255, 20, 0.2);
}

QToolButton#BtnPos[collapsed="true"] {
    text-align: center;
    padding-left: 0px;
}

QToolButton#BtnLogout {
    color: #FF4136;
    background-color: rgba(255, 65, 54, 0.1);
    border: none;
    text-align: left;
    padding-left: 24px;
}

QToolButton#BtnLogout:hover {
    background-color: rgba(255, 65, 54, 0.2);
}

QToolButton#BtnLogout[collapsed="true"] {
    text-align: center;
    padding-left: 0px;
}

/* --- Sales View Specifics --- */

/* Header */
QWidget#HeaderWidget {
    background-color: #001226;
    border-bottom: 1px solid #003366;
}

QWidget#HeaderWidget QLabel {
    background: transparent;
}

QWidget#HeaderWidget QToolButton {
    background: transparent;
    border: none;
}

QLabel#LogoLabel {
    color: #00BCEB;
    font-weight: bold;
    font-size: 16px;
    background: transparent;
}

/* Search Bar & Filters */
QWidget#SearchWidget {
    background-color: transparent;
}

QToolButton#SearchModeBtn {
    background-color: #2D2D30;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
}

QToolButton#SearchModeBtn:checked {
    background-color: #00BCEB;
    color: #000000;
    font-weight: bold;
}

/* Cart Table */
QTableWidget#CartTable {
    background-color: #252526;
    color: #FFFFFF;
    gridline-color: #3E3E42;
}

QLabel[class="StrikethroughPrice"] {
    background-color: transparent;
    color: white;
}

/* Total Widget */
QWidget#TotalWidget {
    background-color: #252526;
    border-top: 2px solid #3E3E42;
    border-radius: 5px;
}

QWidget#TotalWidget QLabel {
    background: transparent;
}

QLabel#SubtotalLabel, QLabel#TaxLabel {
    color: #AAAAAA;
    font-size: 14px;
    background: transparent;
}

QLabel#TotalLabel {
    font-size: 48px;
    font-weight: bold;
    color: #39FF14;
    background: transparent;
}

/* Action Panel */
QWidget#ActionPanel {
    background-color: #1E1E1E;
    border-left: 1px solid #3E3E42;
}

QWidget#ActionPanel QLabel {
    background: transparent;
}

QFrame#CustomerPanel {
    background-color: #2D2D30;
    border-radius: 5px;
    padding: 5px;
}

QFrame#CustomerPanel QLabel {
    background: transparent;
}

QLabel#CustomerLabel {
    font-weight: bold;
    font-size: 14px;
    color: white;
    background: transparent;
}

QPushButton#BtnCustomerSelect {
    background-color: #007ACC;
    color: white;
    border: none;
    padding: 5px;
}

QLabel#PointsLabel {
    color: #FFDC00;
    font-weight: bold;
    font-size: 12px;
    background: transparent;
}

/* Action Grid Button */
QPushButton[class="ActionGridBtn"] {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    color: #FFFFFF;
    border-radius: 4px;
}

QPushButton[class="ActionGridBtn"]:hover {
    background-color: #3E3E42;
    border: 1px solid #00BCEB;
}

QPushButton[class="ActionGridBtn"]:pressed {
    background-color: #00BCEB;
    color: #000000;
}

/* Custom Colors for Action Buttons (Bottom Border) */
QPushButton[class="ActionGridBtn"][btnColor="#FFDC00"] { border-bottom: 3px solid #FFDC00; }
QPushButton[class="ActionGridBtn"][btnColor="#FF4136"] { border-bottom: 3px solid #FF4136; }

/* Internal Labels in Grid Buttons */
QPushButton[class="ActionGridBtn"] QLabel {
    background: transparent;
    color: #FFFFFF;
}

QPushButton[class="ActionGridBtn"] QLabel#lblShortcut {
    color: #CCCCCC;
    font-size: 10px;
    font-weight: bold;
    background: transparent;
}

QPushButton[class="ActionGridBtn"] QLabel#lblText {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: bold;
    background: transparent;
}

QPushButton[class="ActionGridBtn"]:pressed QLabel,
QPushButton[class="ActionGridBtn"]:pressed QLabel#lblText,
QPushButton[class="ActionGridBtn"]:pressed QLabel#lblShortcut {
    color: #000000;
}

/* Pay Button */
QPushButton#BtnPay {
    background-color: #39FF14;
    color: #001F3F;
    font-size: 24px;
    font-weight: bold;
    border: none;
    border-radius: 5px;
}

QPushButton#BtnPay:hover {
    background-color: #32E012;
}

QPushButton#BtnPay:pressed {
    background-color: #28B40E;
}

/* Dashboard Cards */
QWidget#InfoCard {
    background-color: #003366;
    border-radius: 8px;
    border: 1px solid #00509E;
}

QLabel#InfoCardTitle {
    font-size: 12px;
    color: #AAAAAA;
}

/* Settings View */
QListWidget#SettingsSidebar {
    background-color: #252526; /* VS Code sidebar color */
    border: none;
    border-right: 1px solid #3E3E42;
    outline: none;
}

QListWidget#SettingsSidebar::item {
    color: #CCCCCC;
    padding: 12px 20px;
    padding-left: 20px;
    border: none;
    border-left: 3px solid transparent;
    background-color: transparent;
}

QListWidget#SettingsSidebar::item:hover {
    background-color: #2D2D30;
    color: #FFFFFF;
}

QListWidget#SettingsSidebar::item:selected {
    background-color: #37373D;
    color: #00BCEB;
    border-left: 3px solid #00BCEB;
    font-weight: bold;
}

QWidget#SettingsContent {
    background-color: #1E1E1E;
    color: #FFFFFF;
}

/* Settings Content Area - Improved Input Styling */
QWidget#SettingsContent QLineEdit,
QWidget#SettingsContent QComboBox,
QWidget#SettingsContent QSpinBox,
QWidget#SettingsContent QDoubleSpinBox,
QWidget#SettingsContent QTextEdit {
    background-color: #333337;
    color: #EEEEEE;
    border: 1px solid #555555;
    border-radius: 4px;
    padding-left: 10px;
    min-height: 32px;
    font-size: 14px;
}

QWidget#SettingsContent QLineEdit:focus,
QWidget#SettingsContent QComboBox:focus,
QWidget#SettingsContent QSpinBox:focus,
QWidget#SettingsContent QDoubleSpinBox:focus,
QWidget#SettingsContent QTextEdit:focus {
    border: 1px solid #00BCEB;
    background-color: #3A3A3E;
}

/* Settings Form Labels */
QWidget#SettingsContent QLabel {
    color: #DDDDDD;
    font-size: 14px;
}

QLabel[class="SectionHeader"] {
    font-size: 18px;
    font-weight: bold;
    color: #00BCEB;
    margin-bottom: 20px;
}

QFrame#SettingsFooter {
    background-color: #2D2D30;
    border-top: 1px solid #3E3E42;
}

/* --- Dialogs --- */

/* Payment Dialog */
QDialog#PaymentDialog {
    background-color: #001F3F;
    color: white;
}

QLabel#PaymentRemainingLabel {
    font-size: 24px;
    color: #FF4136;
    font-weight: bold;
    border: 1px solid #FF4136;
    padding: 10px;
}

QLabel#PaymentRemainingLabel[state="change"] {
    color: #39FF14;
    border: 1px solid #39FF14;
}

QWidget#PaymentEntryGroup {
    background-color: #003366;
    border-radius: 8px;
}

QLabel#PaymentMethodLabel {
    font-weight: bold;
    font-size: 16px;
    color: #00BCEB;
}

QComboBox#PaymentCustomerCombo {
    font-size: 18px;
    padding: 5px;
    color: black;
    background-color: white;
}

QPushButton#BtnAddPayment {
    background-color: #00BCEB;
    color: black;
    font-weight: bold;
    padding: 10px;
}

QListWidget#PaymentList {
    font-size: 16px;
    color: black;
    background-color: white;
}

QPushButton#BtnFinishSale {
    background-color: #AAAAAA;
    color: black;
    padding: 15px;
    font-weight: bold;
}

QPushButton#BtnFinishSale:enabled {
    background-color: #39FF14;
}

QLabel#PaymentMethodsHeader {
    font-size: 18px;
    font-weight: bold;
    color: #AAAAAA;
}

QWidget#PaymentMethodsScroll {
    background: transparent;
    border: none;
}

QPushButton[class="PaymentMethodBtn"] {
    background-color: #003366;
    color: white;
    font-weight: bold;
    font-size: 14px;
    border: 2px solid #005bb5;
    border-radius: 8px;
}

QPushButton[class="PaymentMethodBtn"]:hover {
    background-color: #004080;
}

QPushButton[class="PaymentMethodBtnCash"] {
    background-color: #2ECC40;
    color: white;
    font-weight: bold;
    font-size: 14px;
    border: 2px solid #2ECC40;
    border-radius: 8px;
}

QLabel#PaymentShortcutLabel {
    background: rgba(0,0,0,0.5);
    color: white;
    padding: 2px;
}

/* Discount Dialog */
QDialog#DiscountDialog {
    background-color: #001F3F;
    color: white;
}

QRadioButton#RbPercent, QRadioButton#RbFixed {
    font-size: 16px;
    font-weight: bold;
}

QDoubleSpinBox#DiscountValueInput {
    font-size: 32px;
    font-weight: bold;
    padding: 10px;
    border: 2px solid #00BCEB;
    border-radius: 5px;
    background-color: #003366;
    color: white;
}

QDoubleSpinBox#DiscountValueInput::up-button, QDoubleSpinBox#DiscountValueInput::down-button {
    width: 0px;
}

QPushButton[class="PresetBtn"] {
    background-color: #0074D9;
    color: white;
    font-weight: bold;
    font-size: 16px;
    border-radius: 5px;
}

QPushButton[class="PresetBtn"]:hover {
    background-color: #005bb5;
}

QPushButton#BtnApplyDiscount {
    background-color: #39FF14;
    color: black;
    font-weight: bold;
    font-size: 16px;
    border-radius: 5px;
}

/* Customer Editor */
QDialog#CustomerEditor, QDialog#CustomerQuickAddDialog {
    background-color: #1E1E1E;
    color: white;
}

/* Receipt Options */
QDialog#ReceiptOptionsDialog {
    background-color: #001F3F;
    color: white;
}

QLabel#ReceiptTitle {
    font-size: 24px;
    font-weight: bold;
    color: #39FF14;
}

QLabel#ReceiptInfo {
    font-size: 16px;
    color: #AAAAAA;
}

QPushButton[class="ReceiptOptionBtn"] {
    color: black;
    font-weight: bold;
    font-size: 16px;
    padding: 10px;
    border-radius: 5px;
}

QPushButton[class="ReceiptOptionBtn"]:hover {
    background-color: white;
}

QPushButton[class="ReceiptOptionBtn"][btnColor="cyan"] { background-color: #00BCEB; }
QPushButton[class="ReceiptOptionBtn"][btnColor="orange"] { background-color: #FF851B; }
QPushButton[class="ReceiptOptionBtn"][btnColor="gray"] { background-color: #AAAAAA; }

/* ===================================================================
   LOGIN VIEW STYLES - Dark Theme
   ================================================================ */

/* === LOGIN LEFT PANEL === */
QWidget#LoginLeftPanel {
    background-color: #001226;  /* Deep navy branding panel */
}

/* Ensure all labels in login left panel have transparent backgrounds */
QWidget#LoginLeftPanel QLabel {
    background-color: transparent;
}

QLabel#WelcomeText {
    font-size: 24px;
    color: #00BCEB;  /* Cyan accent */
    font-weight: bold;
    margin-top: 20px;
}

QLabel#FooterLabel {
    color: #CCCCCC;  /* Lighter gray for better visibility */
    font-size: 12px;
}

QLabel#LogoText {
    color: white;
    font-size: 36px;
    font-weight: bold;
}

/* === PIN INPUT FIELD === */
QLineEdit#PinInput {
    background-color: #1A1A1A;
    border: 2px solid #00BCEB;  /* Cyan border */
    border-radius: 8px;
    padding: 15px;
    font-size: 32px;
    font-weight: bold;
    letter-spacing: 8px;  /* Space out PIN dots */
    color: white;
}

QLineEdit#PinInput:focus {
    border: 2px solid #33D4FF;  /* Brighter cyan on focus */
    background-color: #2A2A2A;  /* Slightly lighter background */
}

/* === NUMPAD BUTTONS === */
/* Base styling for all numpad buttons */
QPushButton#NumpadBtn {
    background-color: #2A2A2A;
    border: 2px solid #404040;
    border-radius: 8px;
    color: white;
    font-size: 24px;
    font-weight: bold;
}

QPushButton#NumpadBtn:hover {
    background-color: #3A3A3A;
    border-color: #00BCEB;
}

QPushButton#NumpadBtn:pressed {
    background-color: #1A1A1A;
}

/* Clear button (Red) */
QPushButton#NumpadBtn[btnType="clear"] {
    color: #FF6B6B;  /* Brighter red for dark theme */
    border-color: #DC3545;
    background-color: #2A1A1A;
}

QPushButton#NumpadBtn[btnType="clear"]:hover {
    background-color: #3A2020;
    border-color: #FF4136;
}

/* Enter button (Green) */
QPushButton#NumpadBtn[btnType="enter"] {
    color: #51CF66;  /* Brighter green for dark theme */
    border-color: #198754;
    background-color: #1A2A1A;
}

QPushButton#NumpadBtn[btnType="enter"]:hover {
    background-color: #203A20;
    border-color: #39FF14;
}

/* ===================================================================
   DASHBOARD / MANAGEMENT VIEW STYLES - Dark Theme
   ================================================================ */

/* === INFO CARDS === */
QFrame#InfoCard {
    background-color: #1A1A1A;  /* Flat dark gray - no gradient */
    border: 1px solid #2A2A2A;
    border-radius: 8px;
}

QLabel#CardIcon {
    background-color: transparent;
}

QLabel#CardTitle {
    background-color: transparent;
    color: #888888;  /* Muted gray for labels */
    font-size: 11px;
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QLabel#CardValue {
    background-color: transparent;
    color: #FFFFFF;
    font-size: 32px;
    font-weight: bold;
}

QLabel#CardTrend {
    background-color: transparent;
    font-size: 10px;
    font-weight: normal;
}

QLabel#CardTrend[trendType="positive"] {
    color: #10B981;  /* Clean green */
}

QLabel#CardTrend[trendType="negative"] {
    color: #EF4444;  /* Clean red */
}

/* === CHART PLACEHOLDER === */
QFrame#ChartPlaceholder {
    background-color: #1A1A1A;  /* Same as cards */
    border: 1px solid #2A2A2A;
    border-radius: 8px;
}

QLabel#ChartPlaceholderText {
    color: #666666;
    font-size: 14px;
    font-weight: normal;
    background-color: transparent;
}

/* === SECTION TITLES === */
QLabel#SectionTitle {
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 600;
    margin-top: 10px;
    margin-bottom: 8px;
    background-color: transparent;
}

/* === ACTIVITY TABLE === */
QTableWidget#ActivityTable {
    background-color: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    gridline-color: transparent;
}

QTableWidget#ActivityTable::item {
    padding: 10px;
    border-bottom: 1px solid #2A2A2A;
    color: #E5E5E5;
}

QTableWidget#ActivityTable::item:selected {
    background-color: #2A2A2A;
    color: white;
}

QTableWidget#ActivityTable::item:hover {
    background-color: #252525;
}

QTableWidget#ActivityTable QHeaderView::section {
    background-color: #2A2A2A;
    color: #00BCEB;
    font-weight: 600;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: none;
    padding: 10px;
}

/* ===================================================================
   UNIFIED COMPONENTS - Dark Theme
   ================================================================ */

/* === GENERIC TABLE VIEWS === */
QTableView {
    background-color: #1A1A1A;
    alternate-background-color: #202020;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    gridline-color: #2A2A2A;
    selection-background-color: #2A2A2A;
    selection-color: white;
}

QTableView::item {
    padding: 8px;
    border: none;
}

QTableView::item:hover {
    background-color: #252525;
}

QTableView QHeaderView::section {
    background-color: #2A2A2A;
    color: #00BCEB;
    font-weight: 600;
    font-size: 10px;
    text-transform: uppercase;
    border: none;
    padding: 10px;
}

/* === BUTTONS === */
/* Generic button styling - excludes special buttons with IDs */
QPushButton:not(#NumpadBtn):not(#ActionGridBtn):not(#MenuButton):not(#IconButton) {
    background-color: #2A2A2A;
    color: #E5E5E5;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    font-size: 13px;
    min-height: 32px;
}

QPushButton:not(#NumpadBtn):not(#ActionGridBtn):not(#MenuButton):not(#IconButton):hover {
    background-color: #353535;
    border-color: #00BCEB;
}

QPushButton:not(#NumpadBtn):not(#ActionGridBtn):not(#MenuButton):not(#IconButton):pressed {
    background-color: #1A1A1A;
}

QPushButton:not(#NumpadBtn):not(#ActionGridBtn):not(#MenuButton):not(#IconButton):disabled {
    background-color: #1A1A1A;
    color: #666666;
    border-color: #2A2A2A;
}

/* === SEARCH/INPUT FIELDS === */
QLineEdit {
    background-color: #2A2A2A;
    color: #E5E5E5;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #00BCEB;
}

QLineEdit:focus {
    border-color: #00BCEB;
    background-color: #252525;
}

QLineEdit:disabled {
    background-color: #1A1A1A;
    color: #666666;
}

/* === NETWORK SETTINGS === */
QLineEdit#InputNetwork,
QSpinBox#InputNetwork,
QComboBox#InputNetwork {
    background-color: #2A2A2A;
    color: #E5E5E5;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}

QLineEdit#InputNetwork:focus,
QSpinBox#InputNetwork:focus,
QComboBox#InputNetwork:focus {
    border-color: #00BCEB;
    background-color: #252525;
}

QGroupBox#NetworkCredentialsGroup {
    background-color: #1A1A1A;
    border: 1px solid #2A2A2A;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 20px;
    font-weight: 600;
    color: #E5E5E5;
}

QGroupBox#NetworkCredentialsGroup::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 8px;
    color: #00BCEB;
}

QPushButton#BtnTestConnection {
    background-color: transparent;
    color: #00BCEB;
    border: 2px solid #00BCEB;
    border-radius: 6px;
    padding: 10px 24px;
    font-weight: 600;
    font-size: 14px;
    min-width: 150px;
}

QPushButton#BtnTestConnection:hover {
    background-color: rgba(0, 188, 235, 0.1);
    border-color: #00D4FF;
}

QPushButton#BtnTestConnection:pressed {
    background-color: rgba(0, 188, 235, 0.2);
}

QLabel#NetworkWarningLabel {
    background-color: rgba(255, 193, 7, 0.1);
    color: #FFC107;
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: 6px;
    padding: 12px;
    font-size: 12px;
}

/* === NETWORK SETTINGS - CARD-BASED DESIGN === */

/* Hero Status Card */
QFrame#StatusCard {
    background-color: #2D2D30;
    border: 1px solid #444;
    border-radius: 8px;
    padding: 20px;
}

QLabel#StatusIcon {
    font-size: 32px;
    min-width: 50px;
}

QLabel#StatusTitle {
    font-size: 18px;
    font-weight: bold;
    color: white;
}

QLabel#StatusSubtitle {
    color: #AAA;
    font-size: 14px;
    margin-top: 4px;
}

QLabel#StatusModeLabel {
    color: #999;
    font-size: 12px;
    margin-bottom: 4px;
}

QComboBox#StatusModeSelector {
    background-color: #3A3A3C;
    color: white;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 150px;
}

/* Server Configuration Card */
QFrame#NetworkCard {
    background-color: #252526;
    border: 1px solid #333;
    border-radius: 8px;
    padding: 15px;
    margin-top: 10px;
}

QLabel#CardTitle {
    font-size: 16px;
    font-weight: 600;
    color: white;
    margin-bottom: 10px;
}

QLabel#IPHelper {
    color: #00BCEB;
    font-size: 13px;
    background-color: rgba(0, 188, 235, 0.1);
    border-left: 3px solid #00BCEB;
    padding: 8px 12px;
    border-radius: 4px;
}

QLabel#FormLabel {
    color: #CCC;
    font-size: 13px;
    font-weight: 500;
    min-width: 110px;
    padding-right: 8px;
}

/* Test Connection Button */
QPushButton#BtnTestNetwork {
    background-color: transparent;
    border: 2px solid #00BCEB;
    color: #00BCEB;
    padding: 10px 20px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 14px;
}

QPushButton#BtnTestNetwork:hover {
    background-color: #00BCEB;
    color: black;
}

QPushButton#BtnTestNetwork:disabled {
    border-color: #444;
    color: #666;
}

QLabel#TestStatus {
    font-size: 14px;
    font-weight: 600;
    padding-left: 10px;
}

/* Migration Card */
QFrame#MigrationCard {
    background-color: #2D2D30;
    border: 2px solid #6C5CE7;
    border-radius: 8px;
    padding: 15px;
}

QLabel#MigrationInfo {
    background-color: transparent;
    color: #CCC;
    font-size: 13px;
    line-height: 1.4;
}

/* The Magic Button (Purple Accent) */
QPushButton#BtnMigrate {
    background-color: #6C5CE7;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 14px 24px;
    font-weight: bold;
    font-size: 14px;
    min-height: 45px;
}

QPushButton#BtnMigrate:hover {
    background-color: #5D4FC4;
}

QPushButton#BtnMigrate:pressed {
    background-color: #4E3FA8;
}

QPushButton#BtnMigrate:disabled {
    background-color: #444;
    color: #888;
}

/* ===================================================================
   CREDIT BOOK VIEW - Transparent Labels
   ================================================================ */

/* Credit Header Card - All labels transparent */
QFrame#CreditHeaderCard QLabel {
    background-color: transparent;
}

/* Credit Book - Filter bar labels */
QWidget#CreditBookView QLabel {
    background-color: transparent;
}

/* ===================================================================
   DOCUMENT BROWSER VIEW - Transparent Labels
   ================================================================ */

/* Filter bar labels */
QFrame#FilterBar QLabel {
    background-color: transparent;
}

/* Details panel labels */
QFrame#DocDetailsPanel QLabel {
    background-color: transparent;
}

/* ===================================================================
   RECEIVE PAYMENT DIALOG - Transparent Labels
   ================================================================ */

/* Balance frame labels */
QFrame#BalanceFrame QLabel {
    background-color: transparent;
}

QDialog#ReceivePaymentDialog QLabel {
    background-color: transparent;
}

/* Warning Footer */
QLabel#NetworkWarning {
    background-color: rgba(255, 193, 7, 0.1);
    color: #FFC107;
    border-left: 3px solid #FFC107;
    padding: 10px;
    border-radius: 4px;
    font-size: 12px;
}

/* ===================================================================
   CRUD MANAGER DIALOGS (Category, Unit)
   ================================================================ */

QDialog#CategoryManagerDialog,
QDialog#UnitManagerDialog {
    background-color: #1E1E1E;
}

QDialog#CategoryManagerDialog QGroupBox,
QDialog#UnitManagerDialog QGroupBox {
    background-color: #252526;
    border: 1px solid #2A2A2A;
    border-radius: 6px;
    margin-top: 16px;
    padding: 12px;
    padding-top: 24px;
}

QDialog#CategoryManagerDialog QGroupBox::title,
QDialog#UnitManagerDialog QGroupBox::title {
    color: #00BCEB;
    font-weight: 600;
    font-size: 13px;
}

QDialog#CategoryManagerDialog QGroupBox QLabel,
QDialog#UnitManagerDialog QGroupBox QLabel {
    background-color: transparent;
    color: #CCCCCC;
}

/* Tree widget in category manager */
QDialog#CategoryManagerDialog QTreeWidget {
    background-color: #1A1A1A;
    alternate-background-color: #202020;
    border: 1px solid #2A2A2A;
    border-radius: 6px;
}

QDialog#CategoryManagerDialog QTreeWidget::item {
    padding: 6px;
    border: none;
}

QDialog#CategoryManagerDialog QTreeWidget::item:selected {
    background-color: #2A2A2A;
    color: #00BCEB;
}

QDialog#CategoryManagerDialog QTreeWidget::item:hover {
    background-color: #252525;
}

QDialog#CategoryManagerDialog QTreeWidget QHeaderView::section {
    background-color: #2A2A2A;
    color: #00BCEB;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    border: none;
    padding: 8px;
}
