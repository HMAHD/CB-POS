/* 
    Ceylon Byte POS - Enterprise Light Theme 
    Palette:
    - Background: #F8F9FA (Global BG) / #FFFFFF (Surface)
    - Text: #212529 (Primary) / #495057 (Secondary)
    - Border: #DEE2E6
    - Accent: #0D6EFD (Bootstrap Blue)
    - Success: #198754 (Bootstrap Green)
    - Warning: #FFC107
    - Error: #DC3545
*/

/* Global Font Enforcement */
* {
    font-family: "Noto Sans", "Iskoola Pota", "Segoe UI", sans-serif;
}

/* Global Reset */
QWidget {
    background-color: #F8F9FA;
    color: #212529;
    font-size: 14px;
}

/* Inputs */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 8px;
    font-size: 16px;
    color: #212529;
    selection-background-color: #0D6EFD;
    selection-color: #FFFFFF;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #0D6EFD;
}

/* Buttons */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 10px 20px;
    font-weight: bold;
    color: #495057;
    text-transform: uppercase;
}

QPushButton:hover {
    background-color: #E9ECEF;
    border: 1px solid #ADB5BD;
    color: #212529;
}

QPushButton:pressed {
    background-color: #DEE2E6;
}

/* Primary Action Button (Green) */
QPushButton#BtnSave, QPushButton#PayBtn, QPushButton[class="primary"] {
    background-color: #198754;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnSave:hover, QPushButton#PayBtn:hover, QPushButton[class="primary"]:hover {
    background-color: #157347;
}

/* Danger Button (Red) */
QPushButton#BtnCancel, QPushButton#VoidBtn, QPushButton[class="danger"] {
    background-color: #DC3545;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnCancel:hover, QPushButton#VoidBtn:hover, QPushButton[class="danger"]:hover {
    background-color: #BB2D3B;
}

/* Warning Button (Yellow) */
QPushButton[class="warning"] {
    background-color: #FFC107;
    color: #212529;
    border: none;
}

/* Lists & Tables */
QListWidget, QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    outline: none;
    gridline-color: #F1F3F5;
    alternate-background-color: #F8F9FA;
}

QListWidget::item, QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #F1F3F5;
    color: #212529;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #E3F2FD; /* Pale Blue */
    color: #0D6EFD;
    border-left: 4px solid #0D6EFD;
}

QHeaderView::section {
    background-color: #E9ECEF; /* Light Gray Header */
    color: #495057;
    padding: 10px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #DEE2E6;
    text-transform: uppercase;
}

QTableCornerButton::section {
    background-color: #E9ECEF;
    border: none;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #F8F9FA;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #ADB5BD;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #DEE2E6;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background: #E9ECEF;
    color: #495057;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #0D6EFD;
    font-weight: bold;
    border-bottom: 2px solid #0D6EFD;
}

/* Group Box */
QGroupBox {
    border: 1px solid #DEE2E6;
    border-radius: 4px;
    margin-top: 20px;
    font-weight: bold;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #0D6EFD;
}

/* --- Sidebar (Task 1) --- */
QFrame#Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #DEE2E6;
}

/* Sidebar Buttons */
QToolButton {
    padding-top: 15px;
    padding-bottom: 15px;
    padding-left: 24px;
    padding-right: 40px;
    margin: 0px;
    border: none;
    border-radius: 0px;
    background: transparent;
    color: #495057; /* Dark Gray */
    text-align: left;
    width: 100%;
}

QToolButton:hover {
    background-color: #F8F9FA;
    color: #212529;
}

QToolButton:checked, QToolButton[active="true"] {
    background-color: #E3F2FD; /* Pale Blue */
    color: #0D6EFD;
    border-left: 4px solid #0D6EFD;
    font-weight: bold;
}

/* Special Sidebar Buttons */
QToolButton#BtnPos {
    color: #198754;
    border-top: 1px solid #DEE2E6;
}

QToolButton#BtnPos:hover {
    background-color: #E8F5E9; /* Pale Green */
}

QToolButton#BtnLogout {
    color: #DC3545;
}

QToolButton#BtnLogout:hover {
    background-color: #FBE9EB; /* Pale Red */
}

/* --- Sales View Specifics (Task 1) --- */

/* Header */
QWidget#HeaderWidget {
    background-color: #FFFFFF;
    border-bottom: 1px solid #DEE2E6;
}

/* 1.1 Search Bar & Filters */
QWidget#SearchWidget {
    background-color: transparent;
}

QToolButton#SearchModeBtn {
    background-color: #FFFFFF;
    color: #495057;
    border: 1px solid #CED4DA;
}

QToolButton#SearchModeBtn:checked {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    border: 1px solid #0D6EFD;
}

QToolButton#SearchModeBtn:hover {
    background-color: #E9ECEF;
}

/* 1.2 Cart Table */
QTableWidget#CartTable {
    background-color: #FFFFFF;
    color: #212529;
    gridline-color: transparent;
}

QTableWidget#CartTable QHeaderView::section {
    background-color: #E9ECEF;
    color: #495057;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #DEE2E6;
    font-weight: bold;
}

QTableWidget#CartTable::item:selected {
    background-color: #E3F2FD;
    color: #0D6EFD;
}

/* 1.3 Total Widget */
QWidget#TotalWidget {
    background-color: #F1F3F5;
    border-top: 1px solid #DEE2E6;
    border-radius: 0px;
}

/* 1.4 Action Panel */
QWidget#ActionPanel {
    background-color: #FFFFFF;
    border-left: 1px solid #DEE2E6;
}

/* Action Grid Button */
QPushButton[class="ActionGridBtn"] {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    color: #212529;
    border-radius: 4px;
}

QPushButton[class="ActionGridBtn"]:hover {
    background-color: #F8F9FA;
    border: 1px solid #0D6EFD;
}

QPushButton[class="ActionGridBtn"]:pressed {
    background-color: #0D6EFD;
    color: #FFFFFF;
}

/* Custom Colors for Action Buttons (Bottom Border) */
QPushButton[class="ActionGridBtn"][btnColor="#FFDC00"] { border-bottom: 3px solid #FFC107; }
QPushButton[class="ActionGridBtn"][btnColor="#FF4136"] { border-bottom: 3px solid #DC3545; }

/* Internal Labels in Grid Buttons */
QPushButton[class="ActionGridBtn"] QLabel#lblShortcut {
    color: #6C757D;
    font-size: 10px;
    font-weight: bold;
    background: transparent;
}

QPushButton[class="ActionGridBtn"] QLabel#lblText {
    color: #212529;
    font-size: 12px;
    font-weight: bold;
    background: transparent;
}

QPushButton[class="ActionGridBtn"]:pressed QLabel#lblText,
QPushButton[class="ActionGridBtn"]:pressed QLabel#lblShortcut {
    color: #FFFFFF;
}

/* Search Filters */
#widget_search_filters QPushButton {
    background-color: #E9ECEF;
    border: none;
    color: #495057;
    padding: 5px;
    border-radius: 4px;
}

#widget_search_filters QPushButton:hover {
    background-color: #DEE2E6;
    color: #212529;
}

#widget_search_filters QPushButton:checked {
    background-color: #0D6EFD;
    color: #FFFFFF;
}

/* Right Panel Shortcuts */
#frame_sales_right QPushButton {
    color: #212529;
    font-weight: bold;
}

/* Shortcut Labels */
.label-shortcut {
    color: #6C757D;
    font-size: 10px;
}

/* "ORDERS:" Label Footer */
#lbl_orders_header {
    background-color: transparent;
    color: #0D6EFD;
    font-weight: bold;
    padding: 0;
    margin-bottom: 5px;
}

/* Dashboard Cards (Task 4) */
QWidget#InfoCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}
