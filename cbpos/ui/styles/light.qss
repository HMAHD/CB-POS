/* 
    Ceylon Byte POS - Enterprise Light Theme 
    Palette:
    - Background: #F8F9FA (Global BG) / #FFFFFF (Surface)
    - Text: #212529 (Primary) / #495057 (Secondary)
    - Border: #DEE2E6
    - Accent: #0D6EFD (Bootstrap Blue)
    - Success: #198754 (Bootstrap Green)
    - Warning: #FFC107
    - Error: #DC3545
*/

/* Global Font Enforcement */
* {
    font-family: "{{FONT_FAMILY}}", "Noto Sans";
}

QLabel.PlaceholderLabel {
    color: #6C757D;
}

QLabel.AboutLabel {
    font-size: 16px;
    color: #495057;
}

/* Global Reset */
QWidget {
    background-color: #F8F9FA;
    color: #212529;
    font-size: 14px;
}

/* Inputs - Global Baseline */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 8px;
    font-size: 16px;
    color: #212529;
    selection-background-color: #0D6EFD;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

/* ComboBox - Dropdown Selector */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 8px 12px;
    padding-right: 35px;  /* Space for arrow */
    font-size: 14px;
    color: #212529;
    min-height: 32px;
}

QComboBox:hover {
    border: 1px solid #0D6EFD;
    background-color: #F8F9FA;
}

QComboBox:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #CED4DA;  /* Separator line */
    background: #E9ECEF;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::drop-down:hover {
    background: #D0E2FF;  /* Light blue background on hover */
    border-left: 1px solid #0D6EFD;
}

QComboBox::down-arrow {
    image: url(cbpos/assets/icons/chevron-down-blue.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #0D6EFD;
    selection-background-color: #0D6EFD;
    selection-color: #FFFFFF;
    color: #212529;
    padding: 4px;

}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 28px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #E9ECEF;
    color: #0D6EFD;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #0D6EFD;
    color: #FFFFFF;
}

/* SpinBox - Number Input (Modern Touch-Friendly Design) */
QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 8px 12px;
    padding-right: 35px;  /* Space for wider buttons */
    font-size: 14px;
    color: #212529;
    min-height: 36px;  /* Touch-friendly height */
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #0D6EFD;
    background-color: #F8F9FA;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

/* UP Button (+) - Clear plus icon */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 30px;
    height: 18px;
    border-left: 1px solid #CED4DA;
    border-bottom: 1px solid #CED4DA;
    background-color: #E9ECEF;
    border-top-right-radius: 4px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #0D6EFD;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed {
    background-color: #0B5ED7;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(cbpos/assets/icons/plus-dark.svg);
    width: 12px;
    height: 12px;
}

/* DOWN Button (-) - Clear minus icon */
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 30px;
    height: 18px;
    border-left: 1px solid #CED4DA;
    border-top: 1px solid #CED4DA;
    background-color: #E9ECEF;
    border-bottom-right-radius: 4px;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #0D6EFD;
}

QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #0B5ED7;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(cbpos/assets/icons/minus-dark.svg);
    width: 12px;
    height: 12px;
}

/* Checkboxes - Toggle Style with Checkmark */
QCheckBox {
    spacing: 10px;
    color: #212529;
    background-color: transparent;
}

/* Unchecked State - Empty box with visible border */
QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #ADB5BD;
    border-radius: 4px;
    background-color: transparent;
}

/* Unchecked Hover - Blue glow */
QCheckBox::indicator:unchecked:hover {
    border-color: #0D6EFD;
    background-color: rgba(13, 110, 253, 0.1);
}

/* Checked State - Blue fill with white checkmark */
QCheckBox::indicator:checked {
    background-color: #0D6EFD;
    border-color: #0D6EFD;
    image: url(cbpos/assets/icons/check-white.svg);
}

/* Checked Hover - Darker blue with checkmark */
QCheckBox::indicator:checked:hover {
    background-color: #0B5ED7;
    border-color: #0B5ED7;
    image: url(cbpos/assets/icons/check-white.svg);
}

/* Buttons */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 10px 20px;
    font-weight: bold;
    color: #495057;
}

QPushButton:hover {
    background-color: #E9ECEF;
    border: 1px solid #ADB5BD;
    color: #212529;
}

QPushButton:pressed {
    background-color: #DEE2E6;
}

/* Primary Action Button (Green) */
QPushButton#BtnSave, QPushButton#PayBtn, QPushButton[class="primary"] {
    background-color: #198754;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnSave:hover, QPushButton#PayBtn:hover, QPushButton[class="primary"]:hover {
    background-color: #157347;
}

/* Danger Button (Red) */
QPushButton#BtnCancel, QPushButton#VoidBtn, QPushButton[class="danger"] {
    background-color: #DC3545;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnCancel:hover, QPushButton#VoidBtn:hover, QPushButton[class="danger"]:hover {
    background-color: #BB2D3B;
}

/* Accent Button (Cyan) */
QPushButton[class="accent"] {
    background-color: #0099CC;
    color: #FFFFFF;
    border: none;
    font-weight: bold;
}

QPushButton[class="accent"]:hover {
    background-color: #0088B5;
}

/* Warning Button (Yellow) */
QPushButton[class="warning"] {
    background-color: #FFC107;
    color: #212529;
    border: none;
}

/* --- Dialog Label Classes --- */
QLabel[class="dialog-title"] {
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}

QLabel[class="muted"] {
    color: #6C757D;
    background: transparent;
}

QLabel[class="debit"] {
    font-weight: bold;
    color: #DC3545;
    background: transparent;
}

QLabel[class="credit"] {
    font-weight: bold;
    color: #198754;
    background: transparent;
}

QLabel[class="bold"] {
    font-weight: bold;
    background: transparent;
}

QLabel[class="transparent"] {
    background: transparent;
}

/* Lists & Tables */
QListWidget, QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;

    gridline-color: #F1F3F5;
    alternate-background-color: #F8F9FA;
}

QListWidget::item, QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #F1F3F5;
    color: #212529;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #E3F2FD; /* Pale Blue */
    color: #0D6EFD;
    border-left: 4px solid #0D6EFD;
}

QHeaderView::section {
    background-color: #E9ECEF; /* Light Gray Header */
    color: #495057;
    padding: 10px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #DEE2E6;
}

QTableCornerButton::section {
    background-color: #E9ECEF;
    border: none;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #F8F9FA;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #ADB5BD;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ScrollArea Transparency Fix */
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #DEE2E6;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background: #E9ECEF;
    color: #495057;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #0D6EFD;
    font-weight: bold;
    border-bottom: 2px solid #0D6EFD;
}

/* Group Box */
QGroupBox {
    border: 1px solid #DEE2E6;
    border-radius: 4px;
    margin-top: 20px;
    font-weight: bold;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #0D6EFD;
}

/* --- FIX: Force Transparency for Labels & Checkboxes inside GroupBoxes --- */
QGroupBox QLabel {
    background-color: transparent;
    color: #212529;
}

QGroupBox QCheckBox {
    background-color: transparent;
    color: #212529;
}

/* --- Sidebar --- */
/* Sidebar Container - Light Mode */
QFrame#SidebarContainer,
QFrame#Sidebar {
    background-color: #FFFFFF;  /* White Background */
    border-right: 1px solid #DEE2E6;  /* Subtle separator */
}

/* Sidebar Container Text - Dark for Light Mode */
QWidget#SidebarContainer QLabel,
QWidget#SidebarContainer QPushButton {
    color: #212529;  /* Dark Text for Light Mode */
}

/* User Profile Section - Light Mode (KILL THE LINES) */
QWidget#UserProfileContainer {
    background-color: transparent;  /* Blend with sidebar */
    border: none;  /* Remove all borders */
    border: none;  /* Remove focus outline */
}

/* ── POS Side Menu (Hamburger Panel) ─ Light ───────────────────── */
QWidget#POSSideMenu {
    background-color: #FFFFFF;
    border-left: 1px solid #E0E0E0;
}

QWidget#POSSideMenu QLabel {
    background-color: transparent;
    color: #333333;
}

QWidget#POSSideMenu QFrame[frameShape="4"] {
    background-color: #E8E8E8;
}

/* Section Header */
QLabel#MenuSectionHeader {
    color: #AAAAAA;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    background: transparent;
}

/* Nav Tiles — 2-column grid */
QPushButton#NavTile {
    background-color: #F0F2F5;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QPushButton#NavTile:hover {
    background-color: #E9ECEF;
    border-color: #0D6EFD;
}

QPushButton#NavTile[active="true"] {
    background-color: rgba(13, 110, 253, 0.08);
    border-color: #0D6EFD;
}

/* User Profile Row */
QWidget#UserProfileRow {
    background-color: rgba(0, 0, 0, 0.02);
}

QLabel#MenuUsername {
    color: #111111;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}

QLabel#MenuRole {
    color: #888888;
    font-size: 12px;
    font-weight: normal;
    background: transparent;
}

/* Sign Out button */
QPushButton#SignOutBtn {
    background: transparent;
    border: none;
    color: #777777;
    font-size: 13px;
    font-weight: normal;
    text-align: left;
    padding: 0;

}

QPushButton#SignOutBtn:hover {
    color: #DC3545;
}

/* Icon Buttons (bottom toolbar) */
QPushButton#IconButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
}

QPushButton#IconButton:hover {
    background-color: #F0F0F0;
}

QPushButton#IconButton:pressed {
    background-color: #E0E0E0;
}

QLabel#SidebarLogo {
    color: #111827;
    font-weight: bold;
    font-size: 20px;  /* Larger for better visibility */
}

QToolButton#SidebarToggle {
    border: none;
    background: transparent;
}

/* Sidebar Buttons */
QToolButton#SidebarButton {
    background-color: transparent;
    color: #6B7280;
    border: none;
    border-left: 4px solid transparent;
    text-align: left;
    padding-left: 20px;
    padding-top: 8px;
    padding-bottom: 8px;
    min-height: 36px;
    font-size: 15px;  /* Slightly larger for readability */
    font-weight: normal;
}

QToolButton#SidebarButton:hover {
    background-color: #F3F4F6;
    color: #111827;
}

QToolButton#SidebarButton:checked, QToolButton#SidebarButton[active="true"] {
    background-color: #EFF6FF;  /* Pale blue */
    color: #0066CC;
    border-left: 4px solid #0066CC;
    font-weight: bold;
}

/* Collapsed State (via Property) */
QToolButton#SidebarButton[collapsed="true"] {
    padding-left: 0px;
    padding-right: 0px;
    text-align: center;
}

/* Special Sidebar Buttons */
QToolButton#BtnPos {
    color: #198754;
    border-top: 1px solid #DEE2E6;
    text-align: left;
    padding-left: 24px;
    min-height: 36px;
}

QToolButton#BtnPos:hover {
    background-color: #E8F5E9; /* Pale Green */
}

QToolButton#BtnPos[collapsed="true"] {
    text-align: center;
    padding-left: 0px;
}

/* Sign Out Button - Professional Outlined Design */
QToolButton#BtnLogout {
    color: #DC3545;  /* Bootstrap Red */
    background-color: transparent;
    border: 1px solid #DC3545;  /* Red Border */
    border-radius: 6px;
    padding: 8px 12px;
    margin: 10px 15px;  /* Spacing from edges */
    min-height: 36px;
    font-weight: bold;
    text-align: center;  /* Center text */
}

QToolButton#BtnLogout:hover {
    background-color: #DC3545;
    color: white;  /* White text on Red background */
}

QToolButton#BtnLogout[collapsed="true"] {
    text-align: center;
    padding: 8px;
    margin: 10px 10px;
}

/* --- Sales View Specifics --- */

/* ===== 1. TOP HEADER BAR (Brand Anchor - Dark Navy in Light Mode) ===== */
QWidget#HeaderWidget {
    background-color: #001F3F;  /* Dark Navy */
    border-bottom: 2px solid #00BCEB;  /* Cyan Accent Line */
}

/* Labels/Icons inside Header - White text on Navy */
QWidget#HeaderWidget QLabel,
QWidget#HeaderWidget QPushButton {
    color: white;  /* White text on Navy */
    background: transparent;
}

QWidget#HeaderWidget QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
    color: white;
}

QWidget#HeaderWidget QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

QLabel#LogoLabel {
    color: #00BCEB;  /* Cyan brand logo */
    font-weight: bold;
    font-size: 16px;
    background: transparent;
}

QLabel#HeaderLogo {
    background: transparent;
}

QLabel#ItemCountLabel {
    color: #666666;
    font-size: 13px;
    background: transparent;
}

QLabel#EmptyCartLabel {
    color: #AAAAAA;
    font-size: 16px;
    background: transparent;
    padding: 40px;
}

/* ===== 5. SEARCH BAR & FILTER BUTTONS ===== */
QWidget#SearchWidget {
    background-color: transparent;
}

/* Search Input Field */
QWidget#SearchWidget QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #DEE2E6;
    border-radius: 4px;
    color: #212529;
    padding: 8px;
    font-size: 14px;
}

QWidget#SearchWidget QLineEdit:focus {
    border: 2px solid #00BCEB;  /* Cyan Focus */
}

/* Filter Buttons (*, |||, #) */
QToolButton#SearchModeBtn {
    background-color: #F8F9FA;
    color: #495057;
    border: 1px solid #DEE2E6;
    border-radius: 4px;
}

QToolButton#SearchModeBtn:hover {
    background-color: #E9ECEF;
    color: #212529;
}

QToolButton#SearchModeBtn:checked {
    background-color: #001F3F;  /* Navy Active */
    color: white;
    border: 1px solid #001F3F;
    font-weight: bold;
}

/* ===== 4. PRODUCT TABLE (Cart Table - Readability) ===== */
QTableWidget#CartTable {
    background-color: #FFFFFF;
    gridline-color: #F1F3F5;
}

QTableWidget#CartTable QHeaderView::section {
    background-color: #E9ECEF;  /* Darker Gray Header */
    color: #212529;  /* Almost Black Text */
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #DEE2E6;
    padding: 8px;
}

QTableWidget#CartTable::item {
    color: #212529;
}

QTableWidget#CartTable::item:selected {
    background-color: #E3F2FD;
    color: #0D6EFD;
}

QLabel[class="StrikethroughPrice"] {
    background-color: transparent;
    color: #DC3545;
}

/* Total Widget */
QWidget#TotalWidget {
    background-color: #F1F3F5;
    border-top: 1px solid #DEE2E6;
    border-radius: 0px;
}

QWidget#TotalWidget QLabel {
    background: transparent;
}

QLabel#SubtotalLabel, QLabel#TaxLabel, QLabel#DiscountLabel {
    color: #495057;
    font-size: 14px;
    background: transparent;
}

QLabel#TotalLabel {
    font-size: 48px;
    font-weight: bold;
    color: #198754;
    background: transparent;
}

/* Action Panel */
QWidget#ActionPanel {
    background-color: #FFFFFF;
    border-left: 1px solid #DEE2E6;
}

QWidget#ActionPanel QLabel {
    background: transparent;
}

/* ===== 2. CUSTOMER PANEL (Matching the Header) ===== */
/* Section Headers */
QLabel#ActionSectionLabel {
    color: #212529;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
    padding-left: 2px;
}

QLabel#CustTitle {
    color: #FFFFFF;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}

QFrame#CustomerPanel {
    background-color: #001F3F;  /* Dark Navy */
    border: 1px solid #001F3F;
    border-radius: 8px;
}

QFrame#CustomerPanel QLabel {
    color: white;  /* White text */
    background: transparent;
}

QLabel#CustomerLabel {
    font-weight: bold;
    font-size: 14px;
    color: white;  /* White text on Navy */
    background: transparent;
}

/* The "SELECT" Button inside Customer Panel */
QPushButton#BtnCustomerSelect {
    background-color: #00BCEB;  /* Cyan Button */
    color: white;
    border: none;
    border-radius: 3px;
    font-weight: bold;
    padding: 5px;
}

QPushButton#BtnCustomerSelect:hover {
    background-color: #00A8D6;  /* Slightly darker cyan */
}

QPushButton#BtnCustomerSelect:pressed {
    background-color: #0096C7;
}

QLabel#PointsLabel {
    color: white;  /* White text on Navy */
    font-weight: bold;
    font-size: 12px;
    background: transparent;
}

/* ===== 3. ACTION BUTTONS (Light theme) ===== */
QPushButton#ActionGridBtn {
    background-color: #EDF0F4;
    color: #1A1A1A;
    border: 1px solid #D0D5DB;
    border-radius: 6px;
    padding: 0px;
}

QPushButton#ActionGridBtn:hover {
    background-color: #DEE3EA;
    border-color: #0D6EFD;
}

QPushButton#ActionGridBtn:pressed {
    background-color: #0D6EFD;
    color: #FFFFFF;
}

/* Color accents — bottom border */
QPushButton#ActionGridBtn[btnColor="#FFDC00"] { border-bottom: 2px solid #FFC107; }
QPushButton#ActionGridBtn[btnColor="#FF4136"] { border-bottom: 2px solid #DC3545; }

QPushButton#ActionGridBtn:pressed QLabel,
QPushButton#ActionGridBtn:pressed QLabel#lblText,
QPushButton#ActionGridBtn:pressed QLabel#lblShortcut {
    color: #FFFFFF;
}

/* Pay Button */
QPushButton#BtnPay {
    background-color: #198754;
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    border: none;
    border-radius: 8px;
}

QPushButton#BtnPay:hover {
    background-color: #157347;
}

QPushButton#BtnPay:pressed {
    background-color: #0F5132;
}

/* Dashboard Cards */
QWidget#InfoCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QLabel#InfoCardTitle {
    font-size: 12px;
    color: #6C757D;
}

/* Settings View — sidebar uses SidebarContainer + SidebarButton (shared with Management) */
QWidget#SettingsContent {
    background-color: #FFFFFF;
    color: #212529;
}

/* Settings Content Area - Improved Input Styling */
QWidget#SettingsContent QLineEdit,
QWidget#SettingsContent QComboBox,
QWidget#SettingsContent QSpinBox,
QWidget#SettingsContent QDoubleSpinBox,
QWidget#SettingsContent QTextEdit {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding-left: 10px;
    min-height: 32px;
    font-size: 14px;
}

QWidget#SettingsContent QLineEdit:focus,
QWidget#SettingsContent QComboBox:focus,
QWidget#SettingsContent QSpinBox:focus,
QWidget#SettingsContent QDoubleSpinBox:focus,
QWidget#SettingsContent QTextEdit:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

/* Settings Form Labels */
QWidget#SettingsContent QLabel {
    color: #495057;
    font-size: 14px;
}

QLabel[class="SectionHeader"] {
    font-size: 18px;
    font-weight: bold;
    color: #0D6EFD;
    margin-bottom: 20px;
}

QFrame#SettingsFooter {
    background-color: #F8F9FA;
    border-top: 1px solid #DEE2E6;
}

/* --- Dialogs --- */

/* ── Payment Dialog ── */
QDialog#PaymentDialog {
    background-color: #F8F9FA;
    color: #212529;
}

QDialog#PaymentDialog QLabel {
    background: transparent;
    color: #212529;
}

QLabel#PaymentRemainingLabel {
    font-size: 28px;
    color: #DC3545;
    font-weight: bold;
    background-color: rgba(220, 53, 69, 0.06);
    border: 2px solid #DC3545;
    border-radius: 8px;
    padding: 10px;
}

QLabel#PaymentRemainingLabel[state="change"] {
    color: #198754;
    background-color: rgba(25, 135, 84, 0.06);
    border-color: #198754;
}

QLabel#PaymentFieldLabel {
    color: #6C757D;
    font-size: 13px;
    font-weight: bold;
}

QLabel#PaymentMethodLabel {
    font-weight: bold;
    font-size: 18px;
    color: #0D6EFD;
}

QLineEdit#PaymentAmountInput {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #CED4DA;
    border-radius: 6px;
    padding: 8px;
    font-size: 28px;
}

QLineEdit#PaymentAmountInput:focus {
    border-color: #0D6EFD;
}

QComboBox#PaymentCustomerCombo {
    font-size: 14px;
    padding: 5px;
    color: #212529;
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
}

QPushButton#BtnAddPayment {
    background-color: #E9ECEF;
    color: #212529;
    font-weight: bold;
    font-size: 14px;
    padding: 10px;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

QPushButton#BtnAddPayment:hover {
    background-color: #DEE2E6;
    border-color: #0D6EFD;
}

QListWidget#PaymentList {
    font-size: 14px;
    color: #212529;
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

QListWidget#PaymentList::item {
    padding: 2px 4px;
    border-bottom: 1px solid #F0F0F0;
    min-height: 44px;
}

QWidget#PaymentListItemWidget {
    background: transparent;
}

QLabel#PaymentListItemLabel {
    color: #212529;
    font-size: 14px;
    background: transparent;
}

QPushButton#BtnRemovePayment {
    background-color: transparent;
    border: 1px solid #DC3545;
    border-radius: 6px;
    padding: 4px;
}

QPushButton#BtnRemovePayment:hover {
    background-color: rgba(220, 53, 69, 0.15);
    border-color: #BB2D3B;
}

QFrame#PaymentSeparator {
    background-color: #DEE2E6;
    max-height: 1px;
}

QPushButton#BtnFinishSale {
    background-color: #E9ECEF;
    color: #6C757D;
    font-size: 16px;
    font-weight: bold;
    border: none;
    border-radius: 8px;
}

QPushButton#BtnFinishSale:enabled {
    background-color: #198754;
    color: #FFFFFF;
}

QPushButton#BtnFinishSale:enabled:hover {
    background-color: #157347;
}

QLabel#PaymentMethodsHeader {
    font-size: 13px;
    font-weight: bold;
    color: #6C757D;
    letter-spacing: 1px;
}

/* Payment Method Buttons */
QPushButton#PayMethodBtn {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    padding: 0px;
}

QPushButton#PayMethodBtn:hover {
    background-color: #E9ECEF;
    border-color: #0D6EFD;
}

QPushButton#PayMethodBtn[selected="true"] {
    border: 2px solid #0D6EFD;
    background-color: #F0F4FF;
}

QPushButton#PayMethodBtn[methodType="cash"] {
    background-color: #198754;
    border-color: #198754;
}

QPushButton#PayMethodBtn[methodType="cash"]:hover {
    background-color: #157347;
}

QPushButton#PayMethodBtn[methodType="cash"][selected="true"] {
    border: 2px solid #146C43;
}

QPushButton#PayMethodBtn QLabel#PayMethodShortcut {
    color: #6C757D;
    font-size: 9px;
    font-weight: normal;
    background: transparent;
}

QPushButton#PayMethodBtn QLabel#PayMethodName {
    color: #212529;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}

QPushButton#PayMethodBtn[methodType="cash"] QLabel#PayMethodName,
QPushButton#PayMethodBtn[methodType="cash"] QLabel#PayMethodShortcut {
    color: #FFFFFF;
}

/* ── Advanced Search Dialog ── */
QDialog#AdvancedSearchDialog {
    background-color: #F8F9FA;
    color: #212529;
}

QDialog#AdvancedSearchDialog QLabel {
    background: transparent;
    color: #212529;
}

QLabel#AdvSearchTitle {
    font-size: 20px;
    font-weight: bold;
    color: #212529;
}

QLabel#SearchFilterLabel {
    color: #6C757D;
    font-size: 14px;
}

QLabel#SearchResultCount {
    color: #6C757D;
    font-size: 13px;
}

QTableWidget#SearchResultsTable {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    gridline-color: #DEE2E6;
    color: #212529;
}

QTableWidget#SearchResultsTable::item:selected {
    background-color: rgba(13, 110, 253, 0.15);
}

QPushButton#BtnSearchSelect {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
}

QPushButton#BtnSearchSelect:hover {
    background-color: #0B5ED7;
}

/* Quantity Dialog */
QDialog#QuantityDialog {
    background-color: #FFFFFF;
}

QLabel#QtyProductName {
    color: #212529;
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}

QLineEdit#QtyInput {
    background-color: #F8F9FA;
    color: #212529;
    font-size: 24px;
    font-weight: bold;
    border: 2px solid #CED4DA;
    border-radius: 6px;
    padding: 8px;
}

QLineEdit#QtyInput:focus {
    border: 2px solid #0D6EFD;
}

/* Discount Dialog */
QDialog#DiscountDialog {
    background-color: #FFFFFF;
    color: #212529;
}

QDialog#DiscountDialog QLabel[class="dialog-title"] {
    font-size: 18px;
    font-weight: bold;
    color: #212529;
    padding: 0 0 4px;
}

QFrame#DiscountTypeFrame {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

QRadioButton#RbPercent, QRadioButton#RbFixed {
    font-size: 15px;
    font-weight: bold;
    color: #212529;
    padding: 8px 12px;
    spacing: 8px;
}

QDoubleSpinBox#DiscountValueInput {
    font-size: 36px;
    font-weight: bold;
    padding: 12px;
    border: 2px solid #0D6EFD;
    border-radius: 8px;
    background-color: #FFFFFF;
    color: #212529;
    min-height: 50px;
}

QDoubleSpinBox#DiscountValueInput::up-button,
QDoubleSpinBox#DiscountValueInput::down-button {
    width: 0px;
}

QPushButton[class="PresetBtn"] {
    background-color: #F8F9FA;
    color: #0D6EFD;
    font-weight: bold;
    font-size: 15px;
    border: 1px solid #0D6EFD;
    border-radius: 6px;
    padding: 8px;
}

QPushButton[class="PresetBtn"]:hover {
    background-color: #E7F1FF;
}

QPushButton[class="PresetBtn"]:pressed {
    background-color: #0D6EFD;
    color: white;
}

QPushButton[class="PresetBtn"]:disabled {
    background-color: #F0F0F0;
    color: #AAA;
    border-color: #DDD;
}

QPushButton#BtnCancel {
    background-color: transparent;
    color: #DC3545;
    font-weight: bold;
    font-size: 15px;
    border: 2px solid #DC3545;
    border-radius: 6px;
}

QPushButton#BtnCancel:hover {
    background-color: #DC3545;
    color: white;
}

QPushButton#BtnApplyDiscount {
    background-color: #198754;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 15px;
    border: none;
    border-radius: 6px;
}

QPushButton#BtnApplyDiscount:hover {
    background-color: #157347;
}

QPushButton#BtnApplyDiscount:pressed {
    background-color: #0F5132;
}

/* Customer Editor */
QDialog#CustomerEditor, QDialog#CustomerQuickAddDialog {
    background-color: #FFFFFF;
    color: #212529;
}

/* ── Receipt Options Dialog — Light ─────────────────────────────── */
QDialog#ReceiptOptionsDialog {
    background-color: #F8F9FA;
    color: #212529;
}

QLabel#ReceiptSuccessIcon {
    background: transparent;
}

QLabel#ReceiptTitle {
    font-size: 20px;
    font-weight: bold;
    color: #198754;
    background: transparent;
}

QWidget#ReceiptInfoCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QLabel#ReceiptInfoOrder {
    font-size: 13px;
    color: #6C757D;
    background: transparent;
}

QLabel#ReceiptInfoTotal {
    font-size: 22px;
    font-weight: bold;
    color: #212529;
    background: transparent;
}

QPushButton#ReceiptBtnPrint {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #0D6EFD;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding-left: 16px;
    text-align: left;
}

QPushButton#ReceiptBtnPrint:hover {
    background-color: rgba(13, 110, 253, 0.08);
    border-color: #0D6EFD;
}

QPushButton#ReceiptBtnPrint:pressed {
    background-color: rgba(13, 110, 253, 0.16);
}

QPushButton#ReceiptBtnEmail {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding-left: 16px;
    text-align: left;
}

QPushButton#ReceiptBtnEmail:hover {
    background-color: #F0F0F0;
    border-color: #ADB5BD;
}

QPushButton#ReceiptBtnEmail:pressed {
    background-color: #E9ECEF;
}

QPushButton#ReceiptBtnClose {
    background-color: transparent;
    color: #6C757D;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
    font-size: 13px;
}

QPushButton#ReceiptBtnClose:hover {
    color: #212529;
    border-color: #ADB5BD;
    background-color: #E9ECEF;
}

/* ===================================================================
   LOGIN VIEW STYLES - Light Theme
   ================================================================ */

/* === LOGIN LEFT PANEL === */
QWidget#LoginLeftPanel {
    background-color: #001226;  /* Deep navy branding panel */
}

/* Ensure all labels in login left panel have transparent backgrounds */
QWidget#LoginLeftPanel QLabel {
    background-color: transparent;
}

QLabel#WelcomeText {
    font-size: 24px;
    color: #00BCEB;  /* Cyan accent */
    font-weight: bold;
    margin-top: 20px;
}

QLabel#LoginTagline {
    color: #7FAACC;
    font-size: 13px;
    background: transparent;
    padding: 0 30px;
}

QLabel#FooterLabel {
    color: #CCCCCC;  /* Lighter gray for better visibility on navy */
    font-size: 12px;
}

QLabel#LogoText {
    color: white;
    font-size: 36px;
    font-weight: bold;
}

/* === LOGIN RIGHT PANEL === */
QWidget#LoginRightPanel {
    background-color: #F5F5F5;
}

QLabel#PinHeading {
    font-size: 22px;
    font-weight: bold;
    color: #1A1A1A;
    margin-bottom: 10px;
    background: transparent;
}

QLabel#LoginErrorLabel {
    color: #DC3545;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}

QLabel#LoginHelpHint {
    color: #999999;
    font-size: 11px;
    background: transparent;
    margin-top: 15px;
}

/* === PIN INPUT FIELD === */
QLineEdit#PinInput {
    background-color: white;
    border: 2px solid #00BCEB;  /* Cyan border */
    border-radius: 8px;
    padding: 15px;
    font-size: 32px;
    font-weight: bold;
    letter-spacing: 8px;  /* Space out PIN dots */
    color: #001F3F;
}

QLineEdit#PinInput:focus {
    border: 2px solid #0099CC;  /* Darker cyan on focus */
    background-color: #F0F9FF;  /* Subtle blue tint */
}

/* === NUMPAD BUTTONS === */
/* Base styling for all numpad buttons */
QWidget#NumpadContainer {
    background: transparent;
}

QPushButton#NumpadBtn {
    background-color: #F5F5F5;
    border: 2px solid #E0E0E0;
    border-radius: 8px;
    color: #001F3F;
    font-size: 24px;
    font-weight: bold;
    padding: 0px;
}

QPushButton#NumpadBtn:hover {
    background-color: #E8E8E8;
    border-color: #00BCEB;
}

QPushButton#NumpadBtn:pressed {
    background-color: #D0D0D0;
}

/* Clear button (Red) */
QPushButton#NumpadBtn[btnType="clear"] {
    color: #DC3545;  /* Red for clear */
    border-color: #DC3545;
    background-color: #FFF5F5;
}

QPushButton#NumpadBtn[btnType="clear"]:hover {
    background-color: #FFE8E8;
    border-color: #BB2D3B;
}

/* Enter button (Green) */
QPushButton#NumpadBtn[btnType="enter"] {
    color: #198754;  /* Green for enter */
    border-color: #198754;
    background-color: #F0FFF4;
}

QPushButton#NumpadBtn[btnType="enter"]:hover {
    background-color: #E0FFE8;
    border-color: #146C43;
}

/* ===================================================================
   DASHBOARD / MANAGEMENT VIEW STYLES - Light Theme
   ================================================================ */

/* === INFO CARDS === */
QFrame#InfoCard {
    background-color: #FFFFFF;  /* Clean white - no gradient */
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

QLabel#CardIcon {
    background-color: transparent;
}

QLabel#CardTitle {
    background-color: transparent;
    color: #6B7280;  /* Muted gray for labels */
    font-size: 11px;
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QLabel#CardValue {
    background-color: transparent;
    color: #111827;  /* Dark gray for values */
    font-size: 32px;
    font-weight: bold;
}

QLabel#CardTrend {
    background-color: transparent;
    font-size: 10px;
    font-weight: normal;
}

QLabel#CardTrend[trendType="positive"] {
    color: #10B981;  /* Clean green */
}

QLabel#CardTrend[trendType="negative"] {
    color: #EF4444;  /* Clean red */
}

/* === DASHBOARD PANELS === */
QFrame#MonthlyChartPanel, QFrame#YearlySummaryPanel,
QFrame#TopProductsPanel, QFrame#HourlySalesPanel, QFrame#QuickStatsPanel,
QFrame#TaxTodayPanel, QFrame#TopCategoriesPanel, QFrame#TopCustomersPanel {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

QFrame#PeriodHeader {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

QScrollArea#DashboardScroll {
    background-color: transparent;
    border: none;
}

/* === PANEL TITLES === */
QLabel#PanelTitle {
    color: #111827;
    font-size: 14px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#PanelSubtitle {
    color: #9CA3AF;
    font-size: 10px;
    background-color: transparent;
}

/* === YEARLY SUMMARY === */
QLabel#SummaryLabel {
    color: #6B7280;
    font-size: 11px;
    text-transform: uppercase;
    background-color: transparent;
}

QLabel#SummaryBigValue {
    color: #111827;
    font-size: 32px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#SummaryHighlight {
    color: #0066CC;
    font-size: 18px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#SummarySubValue {
    color: #374151;
    font-size: 14px;
    background-color: transparent;
}

/* === QUICK STATS === */
QLabel#StatLabel {
    color: #6B7280;
    font-size: 10px;
    text-transform: uppercase;
    background-color: transparent;
}

QLabel#StatBigValue {
    color: #111827;
    font-size: 26px;
    font-weight: bold;
    background-color: transparent;
}

QLabel#StatValue {
    color: #111827;
    font-size: 20px;
    font-weight: bold;
    background-color: transparent;
}

/* === YEAR NAV & PERIOD CONTROLS === */
QToolButton#YearNavButton {
    background-color: #F3F4F6;
    color: #374151;
    border: 1px solid #DEE2E6;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

QToolButton#YearNavButton:hover {
    background-color: #E5E7EB;
    color: #111827;
}

QDateEdit#PeriodDateEdit {
    background-color: #F9FAFB;
    color: #374151;
    border: 1px solid #DEE2E6;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 12px;
}

QLabel#PeriodDash {
    color: #9CA3AF;
    font-size: 14px;
    background-color: transparent;
}

QToolButton#PeriodRefreshBtn {
    background-color: #F3F4F6;
    color: #0066CC;
    border: 1px solid #DEE2E6;
    border-radius: 4px;
    padding: 4px 10px;
    font-size: 16px;
    font-weight: bold;
}

QToolButton#PeriodRefreshBtn:hover {
    background-color: #E5E7EB;
}

/* === SECTION TITLES (legacy compat) === */
QLabel#SectionTitle {
    color: #111827;
    font-size: 14px;
    font-weight: bold;
    margin-top: 10px;
    margin-bottom: 8px;
    background-color: transparent;
}

/* === DASHBOARD TABLES === */
QTableWidget#DashboardTable {
    background-color: #FFFFFF;
    border: none;
    gridline-color: transparent;
}

QTableWidget#DashboardTable::item {
    padding: 10px;
    border-bottom: 1px solid #F3F4F6;
    color: #374151;
}

QTableWidget#DashboardTable::item:selected {
    background-color: #EFF6FF;
    color: #1E40AF;
}

QTableWidget#DashboardTable::item:hover {
    background-color: #F9FAFB;
}

QTableWidget#DashboardTable QHeaderView::section {
    background-color: #F9FAFB;
    color: #4B5563;
    font-weight: bold;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: none;
    padding: 10px;
}

/* ===================================================================
   UNIFIED COMPONENTS - Light Theme
   ================================================================ */

/* === GENERIC TABLE VIEWS === */
QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    gridline-color: #E5E7EB;
    selection-background-color: #EFF6FF;
    selection-color: #1E40AF;
}

QTableView::item {
    padding: 8px;
    border: none;
}

QTableView::item:hover {
    background-color: #F3F4F6;
}

QTableView QHeaderView::section {
    background-color: #F9FAFB;
    color: #4B5563;
    font-weight: bold;
    font-size: 10px;
    text-transform: uppercase;
    border: none;
    padding: 10px;
}

/* === BUTTONS === */
/* Generic button styling - excludes special buttons with IDs */
QPushButton:not(#NumpadBtn):not(#ActionGridBtn):not(#NavTile):not(#SignOutBtn):not(#IconButton) {
    background-color: #F3F4F6;
    color: #374151;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 13px;
    min-height: 32px;
}

QPushButton:not(#NumpadBtn):not(#ActionGridBtn):not(#NavTile):not(#SignOutBtn):not(#IconButton):hover {
    background-color: #E5E7EB;
    border-color: #0066CC;
}

QPushButton:not(#NumpadBtn):not(#ActionGridBtn):not(#NavTile):not(#SignOutBtn):not(#IconButton):pressed {
    background-color: #D1D5DB;
}

QPushButton:not(#NumpadBtn):not(#ActionGridBtn):not(#NavTile):not(#SignOutBtn):not(#IconButton):disabled {
    background-color: #F9FAFB;
    color: #9CA3AF;
    border-color: #E5E7EB;
}

/* === SEARCH/INPUT FIELDS === */
QLineEdit {
    background-color: #FFFFFF;
    color: #374151;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #0066CC;
    selection-color: white;
}

QLineEdit:focus {
    border-color: #0066CC;
    background-color: #FFFFFF;
}

QLineEdit:disabled {
    background-color: #F9FAFB;
    color: #9CA3AF;
}

/* ========================================
   NETWORK SETTINGS PAGE - CARD BASED DESIGN
   ======================================== */

/* Hero Status Card (Top Banner) */
QFrame#StatusCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    padding: 20px;
}

QLabel#StatusIcon {
    font-size: 32px;
    min-width: 50px;
}

QLabel#StatusTitle {
    font-size: 18px;
    font-weight: bold;
    color: #111827;
}

QLabel#StatusSubtitle {
    color: #6B7280;
    font-size: 14px;
    margin-top: 4px;
}

QLabel#StatusModeLabel {
    color: #6B7280;
    font-size: 12px;
    margin-bottom: 4px;
}

QComboBox#StatusModeSelector {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 150px;
}

/* Server Configuration Card */
QFrame#NetworkCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    padding: 15px;
    margin-top: 10px;
}

QLabel#CardTitle {
    font-size: 16px;
    font-weight: bold;
    color: #111827;
    margin-bottom: 10px;
}

QLabel#IPHelper {
    color: #0066CC;
    font-size: 13px;
    background-color: rgba(0, 102, 204, 0.1);
    border-left: 3px solid #0066CC;
    padding: 8px 12px;
    border-radius: 4px;
}

QLabel#FormLabel {
    color: #374151;
    font-size: 13px;
    font-weight: bold;
    min-width: 110px;
    padding-right: 8px;
}

/* Network Input Fields */
QLineEdit#InputNetwork,
QSpinBox#InputNetwork,
QComboBox#InputNetwork {
    background-color: #FFFFFF;
    color: #374151;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}

QLineEdit#InputNetwork:focus,
QSpinBox#InputNetwork:focus,
QComboBox#InputNetwork:focus {
    border-color: #0066CC;
    background-color: #F9FAFB;
}

/* Higher specificity than "QWidget#SettingsContent QSpinBox" (above) is
   required here, or that rule's min-height wins and stretches this
   spinbox (and its up/down buttons) far taller than its sibling
   QLineEdit/QComboBox fields. */
QWidget#SettingsContent QSpinBox#InputNetwork {
    min-height: 18px;
    max-height: 18px;
}

QSpinBox#InputNetwork::up-button,
QSpinBox#InputNetwork::down-button {
    width: 20px;
    height: 12px;
}

QSpinBox#InputNetwork::up-arrow,
QSpinBox#InputNetwork::down-arrow {
    width: 8px;
    height: 8px;
}

/* Test Connection Button (Cyan Outline) */
QPushButton#BtnTestNetwork {
    background-color: transparent;
    border: 2px solid #00BCEB;
    color: #00BCEB;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 13px;
    min-height: 38px;
}

QPushButton#BtnTestNetwork:hover {
    background-color: rgba(0, 188, 235, 0.1);
}

QPushButton#BtnTestNetwork:pressed {
    background-color: rgba(0, 188, 235, 0.2);
}

QPushButton#BtnTestNetwork:disabled {
    background-color: transparent;
    border-color: #9CA3AF;
    color: #9CA3AF;
}

QLabel#TestStatus {
    font-size: 14px;
    font-weight: bold;
    padding-left: 10px;
}

/* Migration Card (Purple Accent) */
QFrame#MigrationCard {
    background-color: #FFFFFF;
    border: 2px solid #6C5CE7;
    border-radius: 8px;
    padding: 15px;
}

QLabel#MigrationInfo {
    background-color: transparent;
    color: #6B7280;
    font-size: 13px;
    line-height: 1.4;
}

/* Migration Button (Purple Solid - Brand Accent) */
QPushButton#BtnMigrate {
    background-color: #6C5CE7;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 14px 24px;
    font-weight: bold;
    font-size: 14px;
    min-height: 45px;
}

QPushButton#BtnMigrate:hover {
    background-color: #5B4CD9;
}

QPushButton#BtnMigrate:pressed {
    background-color: #4A3BB8;
}

QPushButton#BtnMigrate:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
}

/* Warning Footer */
QLabel#NetworkWarning {
    background-color: rgba(255, 193, 7, 0.1);
    color: #D97706;
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: 6px;
    padding: 12px;
    font-size: 12px;
}

/* SMTP Setup Guide Dialog */
QFrame#SmtpGuideStep {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QLabel#SmtpGuideStepNum {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    border-radius: 16px;
}

/* === DATA SAFETY VIEW === */
QLabel#RestoreWarning {
    background-color: rgba(220, 53, 69, 0.08);
    border: 1px solid #DC3545;
    border-radius: 6px;
    padding: 12px;
    color: #842029;
    font-size: 12px;
}

/* === SETTINGS PAGE SHARED STYLES === */

/* Warning hint text (restart required, tax warning) */
QLabel[class="warning-hint"] {
    color: #DC3545;
    font-size: 11px;
    font-style: italic;
    background: transparent;
}

/* Link-style text button */
QPushButton[class="link"] {
    background: transparent;
    color: #0D6EFD;
    border: none;
    padding: 4px 12px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton[class="link"]:hover {
    color: #0A58CA;
}

/* Icon-only transparent button */
QPushButton#BtnInfoIcon {
    background: transparent;
    border: none;
}
QPushButton#BtnInfoIcon:hover {
    background: rgba(13, 110, 253, 0.1);
    border-radius: 14px;
}

/* Settings scroll area transparency */
QScrollArea#SettingsScrollArea {
    background: transparent;
    border: none;
}
QWidget#SettingsScrollInner {
    background: transparent;
}

/* Settings page section headers */
QLabel#SettingsSectionTitle {
    color: #0D6EFD;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 0.5px;
    background: transparent;
}
QFrame#SettingsSectionLine {
    background-color: #CCCCCC;
    max-height: 1px;
    min-height: 1px;
}

/* Receipt live preview */
QLabel#ReceiptPreviewTitle {
    color: #888888;
    font-size: 11px;
    background: transparent;
    padding: 4px 0;
}
QTextBrowser#ReceiptPreviewBrowser {
    background-color: #d0d0d0;
    color: #000000;
    border: 1px solid #CCCCCC;
    border-radius: 6px;
}

/* ── BackupRestoreDialog & ValuationDialog (light theme) ───────── */
QDialog#BackupRestoreDialog {
    background-color: #F8F9FA;
}
QDialog#BackupRestoreDialog QTabWidget::pane { border: none; background: #F8F9FA; }
QDialog#BackupRestoreDialog QTabBar::tab {
    background: #E9ECEF; color: #6C757D; padding: 10px 22px;
    border-top-left-radius: 6px; border-top-right-radius: 6px;
    margin-right: 2px; font-size: 13px;
}
QDialog#BackupRestoreDialog QTabBar::tab:selected { background: #FFFFFF; color: #0D6EFD; font-weight: bold; }
QDialog#BackupRestoreDialog QTabBar::tab:hover { background: #DEE2E6; color: #212529; }

QLabel#DialogTitle { color: #0D6EFD; font-size: 20px; font-weight: bold; margin-bottom: 8px; }
QLabel#DialogSubtitle { color: #6C757D; font-size: 12px; margin-bottom: 16px; }
QLabel#SectionTitle { font-size: 16px; font-weight: bold; color: #212529; margin-top: 20px; }

QLabel[class="muted"] { color: #6C757D; font-size: 12px; }
QLabel[class="value"] { color: #212529; font-size: 13px; font-weight: bold; }
QLabel[class="status-ok"] { color: #198754; font-weight: bold; font-size: 13px; }
QLabel[class="status-err"] { color: #DC3545; font-weight: bold; font-size: 13px; }
QLabel[class="card-value"] { color: #212529; font-size: 28px; font-weight: bold; }
QLabel[class="card-value-positive"] { color: #198754; font-size: 28px; font-weight: bold; }
QLabel[class="card-value-negative"] { color: #DC3545; font-size: 28px; font-weight: bold; }

QGroupBox[class="card"] {
    background-color: #FFFFFF; border: 1px solid #DEE2E6; border-radius: 8px;
    margin-top: 16px; padding: 20px 16px 16px 16px; font-weight: bold; color: #0D6EFD;
}
QGroupBox[class="card"]::title { subcontrol-origin: margin; left: 16px; padding: 0 8px; }

QFrame#ValueCard { background-color: #FFFFFF; border: 1px solid #DEE2E6; border-radius: 8px; padding: 15px; }
QFrame#Separator { background-color: #DEE2E6; }

QTableWidget#BackupTable, QTableWidget#ValuationTable {
    background-color: #FFFFFF; border: 1px solid #DEE2E6; border-radius: 6px;
    gridline-color: #E9ECEF; color: #212529; selection-background-color: #E7F1FF; font-size: 12px;
}
QTableWidget#BackupTable::item, QTableWidget#ValuationTable::item { padding: 6px; }
QTableWidget#BackupTable QHeaderView::section, QTableWidget#ValuationTable QHeaderView::section {
    background-color: #F8F9FA; color: #0D6EFD; padding: 8px;
    border: none; border-bottom: 2px solid #0D6EFD; font-weight: bold; font-size: 12px;
}

QLabel#RestoreWarning {
    background-color: rgba(220, 53, 69, 0.08); border: 1px solid #DC3545;
    border-radius: 6px; padding: 12px; color: #842029; font-size: 12px;
}

/* ── Label Print Dialog ── */
QDialog#LabelPrintDialog {
    background-color: #F8F9FA;
}

QTableWidget#LabelQueueTable {
    font-size: 14px;
}

QTableWidget#LabelQueueTable::item {
    padding: 8px;
}

/* ── Label Preview Dialog ── */
QDialog#LabelPreviewDialog {
    background-color: #E9ECEF;
}

QDialog#LabelPreviewDialog QLabel {
    background: transparent;
}

QLabel#LabelPreviewHeader {
    font-size: 14px;
    font-weight: bold;
    color: #0D6EFD;
}

QLabel#LabelPreviewHint {
    font-size: 11px;
    color: #6C757D;
    font-style: italic;
}

/* ── CSV Import Dialog ── */
QDialog#CsvImportDialog {
    background-color: #F8F9FA;
}

QDialog#CsvImportDialog QLabel {
    background: transparent;
    color: #212529;
}

/* ── Toggle Hint — compact inline description below checkboxes ── */
/* Reusable: set objectName("ToggleHint") on any QLabel used as a toggle hint */
QLabel#ToggleHint {
    color: #8C959F;
    font-size: 11px;
    background: transparent;
    padding: 0px;
}

/* ── Product Image Preview placeholder ── */
QLabel#ProductImagePreview {
    border: 1px solid #DEE2E6;
    background-color: #FFFFFF;
    color: #8C959F;
    border-radius: 4px;
    font-size: 12px;
}

/* ═══════════════════════════════════════════════════════════════════════
   REPORT VIEWER — Data Observatory (Light)
   ═══════════════════════════════════════════════════════════════════════ */

#ReportViewer {
    background-color: #F5F7FA;
}

/* ── Splitter ── */
#ReportSplitter::handle {
    background-color: #E2E8F0;
    width: 1px;
}

/* ── Sidebar ── */
#ReportSidebarPanel {
    background-color: #FFFFFF;
    border-right: 1px solid #E2E8F0;
}

#ReportSidebarTitle {
    color: #0D6EFD;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 3px;
    padding: 18px 20px 14px 20px;
    background: transparent;
    border-bottom: 1px solid #E2E8F0;
}

#ReportSidebarScroll {
    background: transparent;
    border: none;
}

#ReportNavContainer {
    background: transparent;
}

/* Category header */
#ReportCategoryLabel {
    color: #94A3B8;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
    background: transparent;
}

#ReportCategoryCount {
    color: #94A3B8;
    background-color: #F1F5F9;
    font-size: 10px;
    font-weight: bold;
    border-radius: 8px;
    min-height: 16px;
    max-height: 16px;
}

/* Report nav items */
QPushButton#ReportNavItem {
    background-color: transparent;
    color: #64748B;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    font-size: 14px;
    text-align: left;
    padding: 11px 12px 11px 14px;
}

QPushButton#ReportNavItem:hover {
    background-color: #F0F4FF;
    color: #1E293B;
    border-left: 3px solid #CBD5E1;
}

QPushButton#ReportNavItem:checked {
    background-color: #EBF2FF;
    color: #0D6EFD;
    border-left: 3px solid #0D6EFD;
    font-weight: bold;
}

/* ── Content Panel ── */
#ReportContentPanel {
    background-color: #F5F7FA;
}

/* ── Report Header ── */
#ReportHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
}

#ReportTitle {
    color: #1E293B;
    font-size: 20px;
    font-weight: bold;
    background: transparent;
}

#ReportDescription {
    color: #0D6EFD;
    font-size: 13px;
    background: transparent;
}

/* ── Filter Bar ── */
#ReportFilterBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    min-height: 48px;
}

#ReportFilterWidget {
    background: transparent;
}

#ReportFilterLabel {
    color: #64748B;
    font-size: 13px;
    background: transparent;
}

#ReportDateEdit {
    background-color: #F8FAFC;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 6px 10px;
    min-width: 120px;
    font-size: 13px;
}

#ReportDateEdit:focus {
    border: 1px solid #0D6EFD;
}

#ReportDateEdit::drop-down {
    border: none;
    width: 20px;
}

#ReportFilterCombo {
    background-color: #F8FAFC;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 6px 10px;
    min-width: 130px;
    font-size: 13px;
}

#ReportFilterCombo:focus {
    border: 1px solid #0D6EFD;
}

#RunReportBtn {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-radius: 6px;
    padding: 8px 28px;
    min-width: 130px;
}

#RunReportBtn:hover {
    background-color: #0B5ED7;
}

#RunReportBtn:pressed {
    background-color: #0A58CA;
}

#RunReportBtn:disabled {
    background-color: #E2E8F0;
    color: #94A3B8;
}

/* ── Empty State ── */
#ReportEmptyState {
    background-color: #F5F7FA;
}

#ReportEmptyIcon {
    color: #CBD5E1;
    font-size: 56px;
    background: transparent;
    padding-bottom: 4px;
}

#ReportEmptyText {
    color: #64748B;
    font-size: 20px;
    font-weight: bold;
    background: transparent;
    padding-top: 12px;
}

#ReportEmptySubtext {
    color: #94A3B8;
    font-size: 14px;
    background: transparent;
    padding-top: 4px;
}

/* ── Data Table ── */
#ReportDataView {
    background-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    color: #1E293B;
    border: none;
    gridline-color: #E2E8F0;
    selection-background-color: #EBF2FF;
    selection-color: #0D6EFD;
    font-size: 13px;
}

#ReportDataView::item {
    padding: 6px 12px;
    min-height: 18px;
}

#ReportDataView QHeaderView::section {
    background-color: #F8FAFC;
    color: #0D6EFD;
    font-weight: bold;
    font-size: 12px;
    padding: 10px 12px;
    border: none;
    border-right: 1px solid #E2E8F0;
    border-bottom: 2px solid #0D6EFD;
}

#ReportDataView QHeaderView::section:hover {
    background-color: #EBF2FF;
}

/* ── Action Bar ── */
#ReportActionBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E2E8F0;
    min-height: 44px;
}

#ReportRowCount {
    color: #64748B;
    font-size: 13px;
    background: transparent;
    font-weight: bold;
}

#ReportPrintBtn,
#ReportExportExcelBtn,
#ReportExportPdfBtn,
#ReportEmailBtn {
    background-color: #F8FAFC;
    color: #64748B;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 7px 18px;
    font-size: 13px;
}

#ReportPrintBtn:hover,
#ReportExportExcelBtn:hover,
#ReportExportPdfBtn:hover,
#ReportEmailBtn:hover {
    background-color: #EBF2FF;
    color: #1E293B;
    border-color: #0D6EFD;
}

#ReportPrintBtn:pressed,
#ReportExportExcelBtn:pressed,
#ReportExportPdfBtn:pressed,
#ReportEmailBtn:pressed {
    background-color: #0D6EFD;
    color: #FFFFFF;
}

/* ===================================================================
   CREDIT BOOK VIEW — Drill-down Navigation (Light)
   ================================================================ */

QLabel#CreditPageTitle, QLabel#PayablePageTitle {
    font-size: 22px;
    font-weight: bold;
    color: #0D6EFD;
    background-color: transparent;
}

QLineEdit#CreditSearchInput, QLineEdit#PayableSearchInput {
    padding: 8px 12px;
    font-size: 13px;
    border: 1px solid #CED4DA;
    border-radius: 6px;
    background-color: #FFFFFF;
    color: #212529;
}

QLineEdit#CreditSearchInput:focus, QLineEdit#PayableSearchInput:focus {
    border-color: #0D6EFD;
}

QPushButton#CreditAddBtn {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#CreditAddBtn:hover {
    background-color: #0B5ED7;
}

QTableWidget#CreditCustomerTable, QTableWidget#CreditLedgerTable,
QTableWidget#PayableSupplierTable, QTableWidget#PayableLedgerTable {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    color: #212529;
    gridline-color: #E9ECEF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#CreditCustomerTable::item:selected, QTableWidget#CreditLedgerTable::item:selected,
QTableWidget#PayableSupplierTable::item:selected, QTableWidget#PayableLedgerTable::item:selected {
    background-color: #E7F1FF;
    color: #0D6EFD;
}

QTableWidget#CreditCustomerTable QHeaderView::section, QTableWidget#CreditLedgerTable QHeaderView::section,
QTableWidget#PayableSupplierTable QHeaderView::section, QTableWidget#PayableLedgerTable QHeaderView::section {
    background-color: #F8F9FA;
    color: #0D6EFD;
    font-weight: bold;
    font-size: 12px;
    padding: 6px 8px;
    border: none;
    border-bottom: 2px solid #0D6EFD;
}

QFrame#CreditListFooter, QFrame#CreditLedgerFooter,
QFrame#PayableLedgerFooter {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

QLabel#CreditFooterLabel {
    background-color: transparent;
    font-size: 13px;
    font-weight: bold;
    color: #495057;
}

QLabel#CreditFooterDebt, QLabel#CreditLedgerDebit,
QLabel#PayableLedgerDebit {
    color: #DC3545;
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

QLabel#CreditLedgerCredit, QLabel#PayableLedgerCredit {
    color: #198754;
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

QLabel#CreditLedgerClosing, QLabel#PayableLedgerClosing {
    color: #212529;
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#CreditBackBtn, QPushButton#PayableBackBtn {
    background-color: transparent;
    color: #0D6EFD;
    border: none;
    font-size: 13px;
    font-weight: bold;
    padding: 4px 8px;
}

QPushButton#CreditBackBtn:hover, QPushButton#PayableBackBtn:hover {
    color: #0B5ED7;
}

QFrame#CreditHeaderCard, QFrame#PayableHeaderCard {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QFrame#CreditHeaderCard QLabel, QFrame#PayableHeaderCard QLabel {
    background-color: transparent;
}

QLabel#CreditCustName, QLabel#PayableCustName {
    font-size: 18px;
    font-weight: bold;
    color: #212529;
}

QLabel#CreditCustPhone, QLabel#PayableCustPhone {
    font-size: 13px;
    color: #6C757D;
}

QLabel#CreditMetricDebt, QLabel#PayableMetricDebt {
    font-size: 14px;
    font-weight: bold;
    color: #DC3545;
}

QLabel#CreditMetricAvail {
    font-size: 14px;
    font-weight: bold;
    color: #198754;
}

QLabel#CreditMetricLast, QLabel#PayableMetricLast {
    font-size: 13px;
    color: #6C757D;
}

QPushButton#CreditPayBtn, QPushButton#PayablePayBtn {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#CreditPayBtn:hover, QPushButton#PayablePayBtn:hover {
    background-color: #0B5ED7;
}

QPushButton#CreditPrintBtn, QPushButton#CreditEditBtn {
    background-color: #F8F9FA;
    color: #495057;
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid #CED4DA;
    font-size: 13px;
}

QPushButton#CreditPrintBtn:hover, QPushButton#CreditEditBtn:hover {
    border-color: #0D6EFD;
    color: #0D6EFD;
}

QPushButton#CreditAdjustBtn, QPushButton#PayableAdjustBtn {
    background-color: #FFF3CD;
    color: #856404;
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid #FFE69C;
    font-size: 13px;
}

QPushButton#CreditAdjustBtn:hover, QPushButton#PayableAdjustBtn:hover {
    background-color: #FFECB5;
    border-color: #FFD666;
}

QLabel#CreditFilterLabel, QLabel#PayableFilterLabel {
    background-color: transparent;
    color: #6C757D;
    font-size: 13px;
}

QPushButton#CreditAllDatesBtn, QPushButton#PayableAllDatesBtn {
    background-color: #F8F9FA;
    color: #495057;
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid #CED4DA;
    font-size: 12px;
}

QPushButton#CreditAllDatesBtn:hover, QPushButton#PayableAllDatesBtn:hover {
    border-color: #0D6EFD;
}

/* ===================================================================
   DOCUMENT BROWSER VIEW — Full-width with Detail Panel (Light)
   ================================================================ */

QLabel#DocBrowserTitle {
    font-size: 22px;
    font-weight: bold;
    color: #0D6EFD;
    background-color: transparent;
}

QPushButton#DocNewQuotationBtn {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#DocNewQuotationBtn:hover {
    background-color: #0B5ED7;
}

QFrame#DocFilterBar {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

QLabel#DocFilterLabel {
    background-color: transparent;
    color: #6C757D;
    font-size: 13px;
}

QLineEdit#DocSearchInput {
    padding: 6px 10px;
    font-size: 13px;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    background-color: #FFFFFF;
    color: #212529;
}

QLineEdit#DocSearchInput:focus {
    border-color: #0D6EFD;
}

QPushButton#DocFilterBtn {
    background-color: #F8F9FA;
    color: #495057;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #CED4DA;
    font-size: 13px;
}

QPushButton#DocFilterBtn:hover {
    border-color: #0D6EFD;
    color: #0D6EFD;
}

QPushButton#DocClearBtn {
    background-color: transparent;
    color: #6C757D;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #CED4DA;
    font-size: 13px;
}

QPushButton#DocClearBtn:hover {
    color: #212529;
    border-color: #6C757D;
}

QTableWidget#DocTable {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    color: #212529;
    gridline-color: #E9ECEF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#DocTable::item:selected {
    background-color: #E7F1FF;
    color: #0D6EFD;
}

QTableWidget#DocTable QHeaderView::section {
    background-color: #F8F9FA;
    color: #0D6EFD;
    font-weight: bold;
    font-size: 12px;
    padding: 6px 8px;
    border: none;
    border-bottom: 2px solid #0D6EFD;
}

QFrame#DocDetailPanel {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QLabel#DocDetailTitle {
    font-size: 16px;
    font-weight: bold;
    color: #0D6EFD;
    background-color: transparent;
}

QPushButton#DocDetailCloseBtn {
    background-color: transparent;
    color: #6C757D;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}

QPushButton#DocDetailCloseBtn:hover {
    color: #212529;
    border-color: #6C757D;
}

QLabel#DocInfoLabel, QLabel#DocPaymentLabel, QLabel#DocItemsTitle {
    background-color: transparent;
    color: #212529;
    font-size: 13px;
}

QLabel#DocItemsTitle {
    font-weight: bold;
    color: #0D6EFD;
}

QTableWidget#DocItemsTable {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    color: #212529;
    gridline-color: #E9ECEF;
    border: 1px solid #DEE2E6;
    border-radius: 4px;
    font-size: 12px;
}

QTableWidget#DocItemsTable QHeaderView::section {
    background-color: #F8F9FA;
    color: #0D6EFD;
    font-weight: bold;
    font-size: 11px;
    padding: 4px 6px;
    border: none;
    border-bottom: 1px solid #0D6EFD;
}

QPushButton#DocReprintBtn, QPushButton#DocConvertBtn {
    background-color: #F8F9FA;
    color: #495057;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #CED4DA;
    font-size: 13px;
}

QPushButton#DocReprintBtn:hover, QPushButton#DocConvertBtn:hover {
    border-color: #0D6EFD;
    color: #0D6EFD;
}

QPushButton#DocConvertBtn:enabled {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    border: none;
}

QPushButton#DocRefundBtn, QPushButton#DocVoidBtn {
    background-color: #FFF5F5;
    color: #DC3545;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #F5C2C7;
    font-size: 13px;
}

QPushButton#DocRefundBtn:hover, QPushButton#DocVoidBtn:hover {
    background-color: #F8D7DA;
    border-color: #DC3545;
}

QLabel#DocPageLabel {
    background-color: transparent;
    color: #6C757D;
    font-size: 12px;
}

QPushButton#DocPrevBtn, QPushButton#DocNextBtn {
    background-color: #F8F9FA;
    color: #495057;
    padding: 4px 12px;
    border-radius: 4px;
    border: 1px solid #CED4DA;
    font-size: 12px;
}

QPushButton#DocPrevBtn:hover, QPushButton#DocNextBtn:hover {
    border-color: #0D6EFD;
    color: #0D6EFD;
}

/* ===================================================================
   PRICE LIST VIEW — Sidebar Navigation (Light)
   ================================================================ */

QWidget#PriceListSidebarPanel {
    background-color: #FFFFFF;
    border-right: 1px solid #DEE2E6;
}

QLabel#PriceListSidebarTitle {
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
    color: #0D6EFD;
    background-color: transparent;
    padding-bottom: 4px;
}

QScrollArea#PriceListSidebarScroll {
    background-color: transparent;
    border: none;
}

QWidget#PriceListNavContainer {
    background-color: transparent;
}

QPushButton#PriceListNavItem {
    text-align: left;
    padding: 10px 12px;
    font-size: 14px;
    color: #6C757D;
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
}

QPushButton#PriceListNavItem:hover {
    background-color: #F8F9FA;
    color: #212529;
}

QPushButton#PriceListNavItem:checked {
    background-color: #E7F1FF;
    color: #0D6EFD;
    font-weight: bold;
    border-left: 3px solid #0D6EFD;
}

QPushButton#PriceListAddBtn {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 12px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#PriceListAddBtn:hover {
    background-color: #0B5ED7;
}

QWidget#PriceListContentPanel {
    background-color: #F5F7FA;
}

QLabel#PriceListEmptyText {
    font-size: 18px;
    font-weight: bold;
    color: #6C757D;
    background-color: transparent;
}

QLabel#PriceListEmptySubtext {
    font-size: 13px;
    color: #ADB5BD;
    background-color: transparent;
}

QFrame#PriceListHeader {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

QLabel#PriceListTitle {
    font-size: 18px;
    font-weight: bold;
    color: #212529;
    background-color: transparent;
}

QLabel#PriceListDates {
    font-size: 13px;
    color: #6C757D;
    background-color: transparent;
}

QTableWidget#PriceListDataTable {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    color: #212529;
    gridline-color: #E9ECEF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#PriceListDataTable::item:selected {
    background-color: #E7F1FF;
    color: #0D6EFD;
}

QTableWidget#PriceListDataTable QHeaderView::section {
    background-color: #F8F9FA;
    color: #0D6EFD;
    font-weight: bold;
    font-size: 12px;
    padding: 6px 8px;
    border: none;
    border-bottom: 2px solid #0D6EFD;
}

QFrame#PriceListFooter {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

QLabel#PriceListFooterLabel {
    background-color: transparent;
    color: #6C757D;
    font-size: 12px;
}

QLabel#PriceListFooterHint {
    background-color: transparent;
    color: #ADB5BD;
    font-size: 11px;
    font-style: italic;
}

QSplitter#PriceListSplitter::handle {
    background-color: #DEE2E6;
    width: 1px;
}

/* ── Payment Methods Card List ── */
#PMCardScroll {
    background: transparent;
}

#PMCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

#PMCard:hover {
    border-color: #0D6EFD;
}

QLabel#PMCardName {
    font-size: 14px;
    font-weight: bold;
    color: #212529;
    background: transparent;
}

QLabel#PMCardTags {
    font-size: 11px;
    color: #6C757D;
    background: transparent;
}

QLabel#PMCardStatus {
    font-size: 11px;
    font-weight: bold;
    border-radius: 10px;
    padding: 3px 10px;
}

QLabel#PMCardStatus[class="pm-active"] {
    background-color: #D1E7DD;
    color: #0F5132;
    border: 1px solid #BADBCC;
}

QLabel#PMCardStatus[class="pm-inactive"] {
    background-color: #F8D7DA;
    color: #842029;
    border: 1px solid #F5C2C7;
}

QPushButton#PMCardBtn {
    padding: 5px 16px;
    font-size: 12px;
    font-weight: bold;
    border-radius: 4px;
    color: #495057;
    background-color: #F8F9FA;
    border: 1px solid #CED4DA;
}

QPushButton#PMCardBtn:hover {
    background-color: #E9ECEF;
    border-color: #ADB5BD;
}

QPushButton#PMCardBtn[class="danger"] {
    background-color: #DC3545;
    color: #FFFFFF;
    border: none;
}

QPushButton#PMCardBtn[class="danger"]:hover {
    background-color: #C82333;
}

QPushButton#PMCardBtn[class="warning"] {
    background-color: #FFC107;
    color: #212529;
    border: none;
}

QPushButton#PMCardBtn[class="warning"]:hover {
    background-color: #E0A800;
}

QPushButton#PMCardBtn[class="accent"] {
    background-color: #0D6EFD;
    color: #FFFFFF;
    border: none;
}

QPushButton#PMCardBtn[class="accent"]:hover {
    background-color: #0B5ED7;
}

/* ═══════════════════════════════════════════════════════════════
   Sale History Dialog
   ═══════════════════════════════════════════════════════════════ */

QDialog#SaleHistoryDialog {
    background-color: #F5F5F5;
}

/* Quick Filter Buttons */
QPushButton#QuickFilterBtn {
    background-color: #FFFFFF;
    color: #555555;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#QuickFilterBtn:hover {
    background-color: #E8E8E8;
    color: #333333;
}

QPushButton#QuickFilterBtn:checked {
    background-color: #0D6EFD;
    color: #FFFFFF;
    border-color: #0D6EFD;
    font-weight: 600;
}

/* Search Input */
QLineEdit#SaleHistorySearch {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 14px;
    color: #333333;
}

QLineEdit#SaleHistorySearch:focus {
    border-color: #0D6EFD;
}

/* Sales Table */
QTableWidget#SaleHistoryTable {
    background-color: #FFFFFF;
    alternate-background-color: #F9F9F9;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    gridline-color: #E0E0E0;
    selection-background-color: #CCE5FF;
    selection-color: #333333;
}

QTableWidget#SaleHistoryTable QHeaderView::section {
    background-color: #F0F0F0;
    color: #555555;
    border: none;
    border-bottom: 1px solid #CCCCCC;
    padding: 6px;
    font-weight: 600;
    font-size: 12px;
}

/* Details Panel */
QWidget#SaleHistoryDetails {
    background-color: #F5F5F5;
}

QFrame#SaleInfoFrame {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
}

/* Line Items Table */
QTableWidget#SaleHistoryItems {
    background-color: #FFFFFF;
    alternate-background-color: #F9F9F9;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    gridline-color: #E0E0E0;
}

QTableWidget#SaleHistoryItems QHeaderView::section {
    background-color: #F0F0F0;
    color: #555555;
    border: none;
    border-bottom: 1px solid #CCCCCC;
    padding: 4px;
    font-weight: 600;
    font-size: 12px;
}

/* Action Buttons */
QPushButton#SaleHistoryReprint {
    background-color: #0D6EFD;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: 600;
}

QPushButton#SaleHistoryReprint:hover {
    background-color: #0B5ED7;
}

QPushButton#SaleHistoryReprint:disabled {
    background-color: #CCCCCC;
    color: #888888;
}

QPushButton#SaleHistoryRefund {
    background-color: #DC3545;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: 600;
}

QPushButton#SaleHistoryRefund:hover {
    background-color: #BB2D3B;
}

QPushButton#SaleHistoryRefund:disabled {
    background-color: #CCCCCC;
    color: #888888;
}

/* Refund Inline Panel */
QFrame#RefundInlinePanel {
    background-color: #FFF3F3;
    border: 1px solid #DC3545;
    border-radius: 6px;
}

/* ═══════════════════════════════════════════════════════════════
   Database Setup Dialog
   ═══════════════════════════════════════════════════════════════ */

QDialog#DatabaseSetupDialog {
    background-color: #F5F5F5;
}

QFrame#SetupCard {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 8px;
}

QFrame#SetupCard:hover {
    border-color: #0D6EFD;
}

/* ===================================================================
   CRUD MANAGER DIALOGS (Category, Unit) - Light Theme
   =================================================================== */

QDialog#CategoryManagerDialog,
QDialog#UnitManagerDialog {
    background-color: #FFFFFF;
}

QDialog#CategoryManagerDialog QGroupBox,
QDialog#UnitManagerDialog QGroupBox {
    background-color: #F8F9FA;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    margin-top: 16px;
    padding: 12px;
    padding-top: 24px;
}

QDialog#CategoryManagerDialog QGroupBox::title,
QDialog#UnitManagerDialog QGroupBox::title {
    color: #0D6EFD;
    font-weight: bold;
    font-size: 13px;
}

QDialog#CategoryManagerDialog QGroupBox QLabel,
QDialog#UnitManagerDialog QGroupBox QLabel {
    background-color: transparent;
    color: #1F2937;
}

QDialog#CategoryManagerDialog QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
}

QDialog#CategoryManagerDialog QTreeWidget::item {
    padding: 6px;
    border: none;
}

QDialog#CategoryManagerDialog QTreeWidget::item:selected {
    background-color: #E7F1FF;
    color: #0D6EFD;
}

QDialog#CategoryManagerDialog QTreeWidget::item:hover {
    background-color: #F0F4F8;
}

QDialog#CategoryManagerDialog QTreeWidget QHeaderView::section {
    background-color: #F0F4F8;
    color: #0D6EFD;
    font-weight: bold;
    font-size: 11px;
    text-transform: uppercase;
    border: none;
    padding: 8px;
}

/* ===================================================================
   RECEIVE PAYMENT DIALOG - Transparent Labels (Light Theme)
   =================================================================== */

QDialog#ReceivePaymentDialog QLabel {
    background-color: transparent;
    color: #1F2937;
}

QFrame#BalanceFrame QLabel {
    background-color: transparent;
    color: #1F2937;
}

/* ===================================================================
   DOCUMENT BROWSER VIEW - Transparent Labels (Light Theme)
   =================================================================== */

QFrame#FilterBar QLabel {
    background-color: transparent;
    color: #374151;
}

QFrame#DocDetailsPanel QLabel {
    background-color: transparent;
    color: #374151;
}

/* ===================================================================
   NETWORK SETTINGS - Light Theme
   =================================================================== */

QPushButton#BtnTestConnection {
    background-color: transparent;
    color: #0D6EFD;
    border: 2px solid #0D6EFD;
    border-radius: 6px;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 14px;
    min-width: 150px;
}

QPushButton#BtnTestConnection:hover {
    background-color: rgba(13, 110, 253, 0.1);
    border-color: #0B5ED7;
}

QPushButton#BtnTestConnection:pressed {
    background-color: rgba(13, 110, 253, 0.2);
}

QLabel#NetworkWarningLabel {
    background-color: #FEF2F2;
    color: #DC3545;
    border: 1px solid rgba(220, 53, 69, 0.3);
    border-radius: 6px;
    padding: 12px;
    font-size: 12px;
}
