/* ===================================================================
   CRUD MANAGER DIALOGS (Category, Unit)
   ================================================================ */

QDialog#CategoryManagerDialog,
QDialog#UnitManagerDialog {
    background-color: #1E1E1E;
}

QDialog#CategoryManagerDialog QGroupBox,
QDialog#UnitManagerDialog QGroupBox {
    background-color: #252526;
    border: 1px solid #2A2A2A;
    border-radius: 6px;
    margin-top: 16px;
    padding: 12px;
    padding-top: 24px;
}

QDialog#CategoryManagerDialog QGroupBox::title,
QDialog#UnitManagerDialog QGroupBox::title {
    color: #00BCEB;
    font-weight: bold;
    font-size: 13px;
}

QDialog#CategoryManagerDialog QGroupBox QLabel,
QDialog#UnitManagerDialog QGroupBox QLabel {
    background-color: transparent;
    color: #CCCCCC;
}

/* Tree widget in category manager */
QDialog#CategoryManagerDialog QTreeWidget {
    background-color: #1A1A1A;
    alternate-background-color: #202020;
    border: 1px solid #2A2A2A;
    border-radius: 6px;
}

QDialog#CategoryManagerDialog QTreeWidget::item {
    padding: 6px;
    border: none;
}

QDialog#CategoryManagerDialog QTreeWidget::item:selected {
    background-color: #2A2A2A;
    color: #00BCEB;
}

QDialog#CategoryManagerDialog QTreeWidget::item:hover {
    background-color: #252525;
}

/* SMTP Setup Guide Dialog */
QFrame#SmtpGuideStep {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 8px;
}

QLabel#SmtpGuideStepNum {
    background-color: #00BCEB;
    color: #001F3F;
    font-size: 16px;
    font-weight: bold;
    border-radius: 16px;
}

/* === DATA SAFETY VIEW === */
/* Data Safety backup list: compact per-row Restore/Delete buttons (#620) */
QPushButton#BackupRowRestore, QPushButton#BackupRowDelete {
    padding: 4px 12px;
}

QLabel#RestoreWarning {
    background-color: rgba(255, 65, 54, 0.12);
    border: 1px solid #FF4136;
    border-radius: 6px;
    padding: 12px 16px;
    color: #FF8C85;
    font-size: 12px;
}

/* === SETTINGS PAGE SHARED STYLES === */

/* Warning hint text (restart required, tax warning) */
QLabel[class="warning-hint"] {
    color: #FF8C85;
    font-size: 12px;
    background: transparent;
}

/* Positive counterpart of warning-hint (hardware test passed, #624) */
QLabel[class="success-hint"] {
    color: #39FF14;
    font-size: 12px;
    background: transparent;
}

/* Inline field validation error (e.g. Settings > Documents number format) */
QLabel[class="error"] {
    color: #FF4136;
    font-size: 12px;
    background: transparent;
}

/* Link-style text button */
QPushButton[class="link"] {
    background: transparent;
    color: #00BCEB;
    border: none;
    padding: 4px 12px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton[class="link"]:hover {
    color: #00A5D0;
}

/* Icon-only transparent button */
QPushButton#BtnInfoIcon {
    background: transparent;
    border: none;
}
QPushButton#BtnInfoIcon:hover {
    background: rgba(0, 188, 235, 0.15);
    border-radius: 14px;
}

/* Settings scroll area transparency */
QScrollArea#SettingsScrollArea {
    background: transparent;
    border: none;
}
QWidget#SettingsScrollInner {
    background: transparent;
}

/* Settings page section headers */
QLabel#SettingsSectionTitle {
    color: #00BCEB;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 0.5px;
    background: transparent;
}
QFrame#SettingsSectionLine {
    background-color: #3E3E42;
    max-height: 1px;
    min-height: 1px;
}

/* Receipt live preview */
QLabel#ReceiptPreviewTitle {
    color: #8899AA;
    font-size: 11px;
    background: transparent;
    padding: 4px 0;
}
QTextBrowser#ReceiptPreviewBrowser {
    background-color: #d0d0d0;
    color: #000000;
    border: 1px solid #3E3E42;
    border-radius: 6px;
}

/* ── BackupRestoreDialog & ValuationDialog (theme-aware) ───────── */
QDialog#BackupRestoreDialog {
    background-color: #001F3F;
}
QDialog#BackupRestoreDialog QTabWidget::pane { border: none; background: #001F3F; }
QDialog#BackupRestoreDialog QTabBar::tab {
    background: #003366; color: #B0B0B0; padding: 10px 22px;
    border-top-left-radius: 6px; border-top-right-radius: 6px;
    margin-right: 2px; font-size: 13px; border: none;
}
QDialog#BackupRestoreDialog QTabBar::tab:selected { background: #004080; color: #00BCEB; font-weight: bold; }
QDialog#BackupRestoreDialog QTabBar::tab:hover { background: #004080; color: #FFFFFF; }

QLabel#DialogTitle { color: #00BCEB; font-size: 20px; font-weight: bold; margin-bottom: 8px; }
QLabel#DialogSubtitle { color: #8899AA; font-size: 12px; margin-bottom: 16px; }
QLabel#SectionTitle { font-size: 16px; font-weight: bold; color: white; margin-top: 20px; }

QLabel[class="value"] { color: #E0E0E0; font-size: 13px; font-weight: bold; }
QLabel[class="status-ok"] { color: #39FF14; font-weight: bold; font-size: 13px; }
QLabel[class="status-err"] { color: #FF4136; font-weight: bold; font-size: 13px; }
QLabel[class="card-value"] { color: white; font-size: 28px; font-weight: bold; }
QLabel[class="card-value-positive"] { color: #39FF14; font-size: 28px; font-weight: bold; }
QLabel[class="card-value-negative"] { color: #FF4136; font-size: 28px; font-weight: bold; }

QGroupBox[class="card"] {
    background-color: #003366; border: 1px solid #004080; border-radius: 8px;
    margin-top: 16px; padding: 20px 16px 16px 16px; font-weight: bold; color: #00BCEB;
}
QGroupBox[class="card"]::title { subcontrol-origin: margin; left: 16px; padding: 0 8px; }

QFrame#ValueCard { background-color: #003366; border-radius: 8px; padding: 15px; }
QFrame#Separator { background-color: #004080; }

QTableWidget#BackupTable, QTableWidget#ValuationTable {
    background-color: #002244; border: 1px solid #004080; border-radius: 6px;
    gridline-color: #003366; color: #E0E0E0; selection-background-color: #004080; font-size: 12px;
}
QTableWidget#BackupTable::item, QTableWidget#ValuationTable::item { padding: 6px; }
QLabel#RestoreWarning {
    background-color: rgba(255, 65, 54, 0.12); border: 1px solid #FF4136;
    border-radius: 6px; padding: 12px 16px; color: #FF8C85; font-size: 12px;
}

/* ── Label Print Dialog ── */
QDialog#LabelPrintDialog {
    background-color: #1E1E1E;
}

QTableWidget#LabelQueueTable {
    font-size: 14px;
}

QTableWidget#LabelQueueTable::item {
    padding: 8px;
}

/* Same in-cell editor fix as QAbstractItemView::item:focus (#569) --
   this ID rule would otherwise out-rank it and keep the Qty editor short. */
QTableWidget#LabelQueueTable::item:focus {
    padding-top: 0px;
    padding-bottom: 0px;
}

/* ── Label Preview Dialog ── */
QDialog#LabelPreviewDialog {
    background-color: #1E1E1E;
}

QDialog#LabelPreviewDialog QLabel {
    background: transparent;
}

QLabel#LabelPreviewHeader {
    font-size: 14px;
    font-weight: bold;
    color: #00BCEB;
}

QLabel#LabelPreviewHint {
    font-size: 11px;
    color: #888888;
}

/* ── CSV Import Dialog ── */
QDialog#CsvImportDialog {
    background-color: #1E1E1E;
}

QDialog#CsvImportDialog QLabel {
    background: transparent;
    color: #E0E0E0;
}

/* ── Add/Edit Supplier Dialog ── */
QDialog#SupplierDialog {
    background-color: #1E1E1E;
}

QDialog#SupplierDialog QLabel {
    background: transparent;
    color: #E0E0E0;
}

/* ── Toggle Hint — compact inline description below checkboxes ── */
/* Reusable: set objectName("ToggleHint") on any QLabel used as a toggle hint */
QLabel#ToggleHint {
    color: #6E6E6E;
    font-size: 11px;
    background: transparent;
    padding: 0px;
}

/* ── Product Image Preview placeholder ── */
QLabel#ProductImagePreview {
    border: 1px solid #3E3E42;
    background-color: #252526;
    color: #6E6E6E;
    border-radius: 4px;
    font-size: 12px;
}

/* ═══════════════════════════════════════════════════════════════════════
   REPORT VIEWER — Data Observatory
   ═══════════════════════════════════════════════════════════════════════ */

#ReportViewer {
    background-color: #1E1E1E;
}

/* ── Splitter ── */
#ReportSplitter::handle {
    background-color: #3E3E42;
    width: 1px;
}

/* ── Sidebar ── */
#ReportSidebarPanel {
    background-color: #252526;
    border-right: 1px solid #3E3E42;
}

#ReportSidebarTitle {
    color: #00BCEB;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 3px;
    padding: 18px 20px 14px 20px;
    background: transparent;
    border-bottom: 1px solid #3E3E42;
}

#ReportSidebarScroll {
    background: transparent;
    border: none;
}

#ReportNavContainer {
    background: transparent;
}

/* Category header */
#ReportCategoryLabel {
    color: #AAAAAA;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
    background: transparent;
}

#ReportCategoryCount {
    color: #888888;
    background-color: #2D2D30;
    font-size: 10px;
    font-weight: bold;
    border-radius: 8px;
    min-height: 16px;
    max-height: 16px;
}

/* Report nav items */
QPushButton#ReportNavItem {
    background-color: transparent;
    color: #AAAAAA;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    font-size: 14px;
    text-align: left;
    padding: 11px 12px 11px 14px;
}

QPushButton#ReportNavItem:hover {
    background-color: #2D2D30;
    color: #FFFFFF;
    border-left: 3px solid #3E3E42;
}

QPushButton#ReportNavItem:checked {
    background-color: #333333;
    color: #00BCEB;
    border-left: 3px solid #00BCEB;
    font-weight: bold;
}

/* ── Content Panel ── */
#ReportContentPanel {
    background-color: #1E1E1E;
}

/* ── Report Header ── */
#ReportHeader {
    background-color: #333333;
    border-bottom: 1px solid #3E3E42;
}

#ReportTitle {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: bold;
    background: transparent;
}

#ReportDescription {
    color: #00BCEB;
    font-size: 13px;
    background: transparent;
}

/* ── Filter Bar ── */
#ReportFilterBar {
    background-color: #252526;
    border-bottom: 1px solid #3E3E42;
    min-height: 48px;
}

#ReportFilterWidget {
    background: transparent;
}

#ReportFilterLabel {
    color: #AAAAAA;
    font-size: 13px;
    background: transparent;
}

#ReportDateEdit {
    background-color: #2D2D30;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 6px 10px;
    min-width: 120px;
    font-size: 13px;
}

#ReportDateEdit:focus {
    border: 1px solid #00BCEB;
}

#ReportDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #3E3E42;
    background-color: #2D2D30;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

#ReportDateEdit::drop-down:hover {
    background-color: #16324F;
}

#ReportFilterCombo {
    background-color: #2D2D30;
    color: #FFFFFF;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 6px 10px;
    min-width: 130px;
    font-size: 13px;
}

#ReportFilterCombo:focus {
    border: 1px solid #00BCEB;
}

#RunReportBtn {
    background-color: #00BCEB;
    color: #1E1E1E;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-radius: 6px;
    padding: 8px 28px;
    min-width: 130px;
}

#RunReportBtn:hover {
    background-color: #33CCFF;
}

#RunReportBtn:pressed {
    background-color: #0099CC;
}

#RunReportBtn:disabled {
    background-color: #2D2D30;
    color: #888888;
}

/* ── Data Table ── */
#ReportDataView {
    background-color: #252526;
    alternate-background-color: #2D2D30;
    color: #E0E0E0;
    border: none;
    gridline-color: #3E3E42;
    selection-background-color: #3E3E42;
    selection-color: #FFFFFF;
    font-size: 13px;
}

#ReportDataView::item {
    padding: 6px 12px;
    min-height: 18px;
}

/* ── Action Bar ── */
#ReportActionBar {
    background-color: #252526;
    border-top: 1px solid #3E3E42;
    min-height: 44px;
}

#ReportRowCount {
    color: #AAAAAA;
    font-size: 13px;
    background: transparent;
    font-weight: bold;
}

#ReportPrintBtn,
#ReportExportExcelBtn,
#ReportExportPdfBtn,
#ReportEmailBtn {
    background-color: #2D2D30;
    color: #AAAAAA;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 7px 18px;
    font-size: 13px;
}

#ReportPrintBtn:hover,
#ReportExportExcelBtn:hover,
#ReportExportPdfBtn:hover,
#ReportEmailBtn:hover {
    background-color: #3E3E42;
    color: #FFFFFF;
    border-color: #00BCEB;
}

#ReportPrintBtn:pressed,
#ReportExportExcelBtn:pressed,
#ReportExportPdfBtn:pressed,
#ReportEmailBtn:pressed {
    background-color: #00BCEB;
    color: #1E1E1E;
}

/* ===================================================================
   CREDIT BOOK VIEW — Drill-down Navigation
   ================================================================ */

QLabel#CreditPageTitle, QLabel#PayablePageTitle {
    font-size: 22px;
    font-weight: bold;
    color: #00BCEB;
    background-color: transparent;
}

QLineEdit#CreditSearchInput, QLineEdit#PayableSearchInput {
    padding: 8px 12px;
    font-size: 13px;
    border: 1px solid #003366;
    border-radius: 6px;
    background-color: #2A2A2A;
    color: #E0E0E0;
}

QLineEdit#CreditSearchInput:focus, QLineEdit#PayableSearchInput:focus {
    border-color: #00BCEB;
}

QPushButton#CreditAddBtn {
    background-color: #00BCEB;
    color: #1E1E1E;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#CreditAddBtn:hover {
    background-color: #33CBF0;
}

QTableWidget#CreditCustomerTable, QTableWidget#CreditLedgerTable,
QTableWidget#PayableSupplierTable, QTableWidget#PayableLedgerTable {
    background-color: #252526;
    alternate-background-color: #2D2D30;
    color: #E0E0E0;
    gridline-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#CreditCustomerTable::item:selected, QTableWidget#CreditLedgerTable::item:selected,
QTableWidget#PayableSupplierTable::item:selected, QTableWidget#PayableLedgerTable::item:selected {
    background-color: #003366;
    color: #FFFFFF;
}

QFrame#CreditListFooter, QFrame#CreditLedgerFooter,
QFrame#PayableLedgerFooter {
    background-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 6px;
}

QLabel#CreditFooterLabel, QLabel#CreditFooterDebt,
QLabel#PayableLedgerDebit, QLabel#PayableLedgerCredit, QLabel#PayableLedgerClosing {
    background-color: transparent;
    font-size: 13px;
    font-weight: bold;
}

QLabel#CreditFooterDebt, QLabel#PayableLedgerDebit {
    color: #FF4136;
}

QLabel#CreditLedgerDebit {
    color: #FF4136;
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

QLabel#CreditLedgerCredit, QLabel#PayableLedgerCredit {
    color: #39FF14;
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

QLabel#CreditLedgerClosing, QLabel#PayableLedgerClosing {
    color: #FFFFFF;
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

/* Back button */
QPushButton#CreditBackBtn, QPushButton#PayableBackBtn {
    background-color: transparent;
    color: #00BCEB;
    border: none;
    font-size: 13px;
    font-weight: bold;
    padding: 4px 8px;
}

QPushButton#CreditBackBtn:hover, QPushButton#PayableBackBtn:hover {
    color: #33CBF0;
    text-decoration: underline;
}

/* Payable/Credit date-range mismatch hint (#282/#284) */
QFrame#PayableRangeHint, QFrame#CreditRangeHint {
    background-color: rgba(255, 220, 0, 0.1);
    border: 1px solid #FFDC00;
    border-radius: 6px;
}

QLabel#PayableRangeHintLabel, QLabel#CreditRangeHintLabel {
    background-color: transparent;
    color: #FFDC00;
    font-size: 12px;
}

QPushButton#PayableRangeHintBtn, QPushButton#CreditRangeHintBtn {
    background-color: #FFDC00;
    color: #1E1E1E;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 4px 12px;
}

QPushButton#PayableRangeHintBtn:hover, QPushButton#CreditRangeHintBtn:hover {
    background-color: #FFE440;
}

/* Header Card */
QFrame#CreditHeaderCard, QFrame#PayableHeaderCard {
    background-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 8px;
}

QFrame#CreditHeaderCard QLabel, QFrame#PayableHeaderCard QLabel {
    background-color: transparent;
}

QLabel#CreditCustName, QLabel#PayableCustName {
    font-size: 18px;
    font-weight: bold;
    color: #FFFFFF;
}

QLabel#CreditCustPhone, QLabel#PayableCustPhone {
    font-size: 13px;
    color: #AAAAAA;
}

QLabel#CreditMetricDebt, QLabel#PayableMetricDebt {
    font-size: 14px;
    font-weight: bold;
    color: #FF4136;
}

QLabel#CreditMetricAvail {
    font-size: 14px;
    font-weight: bold;
    color: #39FF14;
}

QLabel#CreditMetricLast, QLabel#PayableMetricLast {
    font-size: 13px;
    color: #AAAAAA;
}

/* Action buttons */
QPushButton#CreditPayBtn, QPushButton#PayablePayBtn {
    background-color: #00BCEB;
    color: #1E1E1E;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#CreditPayBtn:hover, QPushButton#PayablePayBtn:hover {
    background-color: #33CBF0;
}

QPushButton#CreditPrintBtn {
    background-color: #003366;
    color: #E0E0E0;
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid #2D2D30;
    font-size: 13px;
}

QPushButton#CreditPrintBtn:hover {
    border-color: #00BCEB;
    color: #00BCEB;
}

QPushButton#CreditAdjustBtn, QPushButton#PayableAdjustBtn {
    background-color: #003366;
    color: #E0E0E0;
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid #2D2D30;
    font-size: 13px;
}

QPushButton#CreditAdjustBtn:hover, QPushButton#PayableAdjustBtn:hover {
    border-color: #00BCEB;
    color: #00BCEB;
}

QPushButton#CreditEditBtn {
    background-color: #003366;
    color: #E0E0E0;
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid #2D2D30;
    font-size: 13px;
}

QPushButton#CreditEditBtn:hover {
    border-color: #00BCEB;
    color: #00BCEB;
}

/* Filter bar labels */
QLabel#CreditFilterLabel, QLabel#PayableFilterLabel {
    background-color: transparent;
    color: #AAAAAA;
    font-size: 13px;
}

QPushButton#CreditAllDatesBtn, QPushButton#PayableAllDatesBtn {
    background-color: #003366;
    color: #E0E0E0;
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid #2D2D30;
    font-size: 12px;
}

QPushButton#CreditAllDatesBtn:hover, QPushButton#PayableAllDatesBtn:hover {
    border-color: #00BCEB;
}

/* ===================================================================
   PAGE HEADER — Shared icon+title strip for every Management screen
   ================================================================ */

QWidget#PageHeader {
    background-color: transparent;
}

QLabel#PageHeaderIcon {
    background-color: transparent;
}

QLabel#PageHeaderTitle {
    font-size: 18px;
    font-weight: bold;
    color: #00BCEB;
    background-color: transparent;
}

/* ===================================================================
   DOCUMENT BROWSER VIEW — Full-width with Detail Panel
   ================================================================ */

QLabel#DocBrowserTitle {
    font-size: 22px;
    font-weight: bold;
    color: #00BCEB;
    background-color: transparent;
}

QPushButton#DocNewQuotationBtn {
    background-color: #00BCEB;
    color: #1E1E1E;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#DocNewQuotationBtn:hover {
    background-color: #33CBF0;
}

QFrame#DocFilterBar {
    background-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 6px;
}

QLabel#DocFilterLabel {
    background-color: transparent;
    color: #AAAAAA;
    font-size: 13px;
}

QLineEdit#DocSearchInput {
    padding: 6px 10px;
    font-size: 13px;
    border: 1px solid #003366;
    border-radius: 4px;
    background-color: #2A2A2A;
    color: #E0E0E0;
}

QLineEdit#DocSearchInput:focus {
    border-color: #00BCEB;
}

QPushButton#DocFilterBtn {
    background-color: #003366;
    color: #E0E0E0;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #2D2D30;
    font-size: 13px;
}

QPushButton#DocFilterBtn:hover {
    border-color: #00BCEB;
    color: #00BCEB;
}

QPushButton#DocClearBtn {
    padding: 6px 14px;
    border-radius: 4px;
    font-size: 13px;
}

QTableWidget#DocTable {
    background-color: #252526;
    alternate-background-color: #2D2D30;
    color: #E0E0E0;
    gridline-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#DocTable::item:selected {
    background-color: #003366;
    color: #FFFFFF;
}

/* Detail Panel */
QFrame#DocDetailPanel {
    background-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 8px;
}

QLabel#DocDetailTitle {
    font-size: 16px;
    font-weight: bold;
    color: #00BCEB;
    background-color: transparent;
}

QPushButton#DocDetailCloseBtn {
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}

QLabel#DocInfoLabel, QLabel#DocPaymentLabel, QLabel#DocItemsTitle {
    background-color: transparent;
    color: #E0E0E0;
    font-size: 13px;
}

QLabel#DocItemsTitle {
    font-weight: bold;
    color: #00BCEB;
}

QTableWidget#DocItemsTable {
    background-color: #252526;
    alternate-background-color: #2D2D30;
    color: #E0E0E0;
    gridline-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 4px;
    font-size: 12px;
}

/* Action buttons */
QPushButton#DocReprintBtn, QPushButton#DocConvertBtn {
    background-color: #003366;
    color: #E0E0E0;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #2D2D30;
    font-size: 13px;
}

QPushButton#DocReprintBtn:hover, QPushButton#DocConvertBtn:hover {
    border-color: #00BCEB;
    color: #00BCEB;
}

QPushButton#DocConvertBtn:enabled {
    background-color: #00BCEB;
    color: #1E1E1E;
    font-weight: bold;
    border: none;
}

QPushButton#DocRefundBtn, QPushButton#DocVoidBtn {
    background-color: #330A08;
    color: #FF4136;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #551A18;
    font-size: 13px;
}

QPushButton#DocRefundBtn:hover, QPushButton#DocVoidBtn:hover {
    background-color: #441210;
    border-color: #FF4136;
}

/* Pagination */
QLabel#DocPageLabel {
    background-color: transparent;
    color: #AAAAAA;
    font-size: 12px;
}

QPushButton#DocPrevBtn, QPushButton#DocNextBtn {
    background-color: #003366;
    color: #E0E0E0;
    padding: 4px 12px;
    border-radius: 4px;
    border: 1px solid #2D2D30;
    font-size: 12px;
}

QPushButton#DocPrevBtn:hover, QPushButton#DocNextBtn:hover {
    border-color: #00BCEB;
    color: #00BCEB;
}

/* ===================================================================
   PRICE LIST VIEW — Sidebar Navigation
   ================================================================ */

QWidget#PriceListSidebarPanel {
    background-color: #252526;
    border-right: 1px solid #2D2D30;
}

QLabel#PriceListSidebarTitle {
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
    color: #00BCEB;
    background-color: transparent;
    padding-bottom: 4px;
}

QScrollArea#PriceListSidebarScroll {
    background-color: transparent;
    border: none;
}

QWidget#PriceListNavContainer {
    background-color: transparent;
}

QPushButton#PriceListNavItem {
    text-align: left;
    padding: 14px 14px;
    font-size: 14px;
    color: #AAAAAA;
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
}

QPushButton#PriceListNavItem:hover {
    background-color: #2D2D30;
    color: #E0E0E0;
}

QPushButton#PriceListNavItem:checked {
    background-color: #2D2D30;
    color: #00BCEB;
    font-weight: bold;
    border-left: 3px solid #00BCEB;
}

QPushButton#PriceListAddBtn {
    background-color: #00BCEB;
    color: #1E1E1E;
    font-weight: bold;
    padding: 8px 12px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#PriceListAddBtn:hover {
    background-color: #33CBF0;
}

QPushButton#PriceListDeleteBtn {
    background-color: #FF4136;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 12px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#PriceListDeleteBtn:hover {
    background-color: #E0362C;
}

QWidget#PriceListContentPanel {
    background-color: #1E1E1E;
}

/* Empty state */
QLabel#PriceListEmptyText {
    font-size: 18px;
    font-weight: bold;
    color: #AAAAAA;
    background-color: transparent;
}

QLabel#PriceListEmptySubtext {
    font-size: 13px;
    color: #888888;
    background-color: transparent;
}

/* Header */
QFrame#PriceListHeader {
    background-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 6px;
}

QLabel#PriceListTitle {
    font-size: 18px;
    font-weight: bold;
    color: #FFFFFF;
    background-color: transparent;
}

QLabel#PriceListDates {
    font-size: 13px;
    color: #AAAAAA;
    background-color: transparent;
}

/* Data table */
QTableWidget#PriceListDataTable {
    background-color: #252526;
    alternate-background-color: #2D2D30;
    color: #E0E0E0;
    gridline-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#PriceListDataTable::item:selected {
    background-color: #003366;
    color: #FFFFFF;
}

/* Footer */
QFrame#PriceListFooter {
    background-color: #2D2D30;
    border: 1px solid #2D2D30;
    border-radius: 6px;
}

QLabel#PriceListFooterLabel {
    background-color: transparent;
    color: #AAAAAA;
    font-size: 12px;
}

QLabel#PriceListFooterHint {
    background-color: transparent;
    color: #B0B0B0;
    font-size: 13px;
}

/* Splitter handle */
QSplitter#PriceListSplitter::handle {
    background-color: #2D2D30;
    width: 1px;
}

/* ── Payment Methods Card List ── */
#PMCardScroll {
    background: transparent;
}

#PMCard {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 6px;
}

#PMCard:hover {
    border-color: #00BCEB;
}

QLabel#PMCardName {
    font-size: 14px;
    font-weight: bold;
    color: #FFFFFF;
    background: transparent;
}

QLabel#PMCardTags {
    font-size: 11px;
    color: #8892B0;
    background: transparent;
}

QLabel#PMCardStatus {
    font-size: 11px;
    font-weight: bold;
    border-radius: 10px;
    padding: 3px 10px;
}

QLabel#PMCardStatus[class="pm-active"] {
    background-color: #0D3B1E;
    color: #39FF14;
}

QLabel#PMCardStatus[class="pm-inactive"] {
    background-color: #3B1A1A;
    color: #FF6B6B;
}

QPushButton#PMCardBtn {
    padding: 5px 16px;
    font-size: 12px;
    font-weight: bold;
    border-radius: 4px;
}

QPushButton#PMCardBtn[class="danger"] {
    background-color: #FF4136;
    color: #FFFFFF;
    border: none;
}

QPushButton#PMCardBtn[class="danger"]:hover {
    background-color: #E0362C;
}

QPushButton#PMCardBtn[class="warning"] {
    background-color: #FFDC00;
    color: #001F3F;
    border: none;
}

QPushButton#PMCardBtn[class="warning"]:hover {
    background-color: #E6C600;
}

QPushButton#PMCardBtn[class="accent"] {
    background-color: #00BCEB;
    color: #001F3F;
    border: none;
}

QPushButton#PMCardBtn[class="accent"]:hover {
    background-color: #00A5D0;
}

/* ═══════════════════════════════════════════════════════════════
   Sale History Dialog
   ═══════════════════════════════════════════════════════════════ */

QDialog#SaleHistoryDialog {
    background-color: #1E1E1E;
}

/* Quick Filter Buttons */
QPushButton#QuickFilterBtn {
    background-color: #252526;
    color: #AAAAAA;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#QuickFilterBtn:hover {
    background-color: #2D2D30;
    color: #FFFFFF;
}

QPushButton#QuickFilterBtn:checked {
    background-color: #00BCEB;
    color: #001F3F;
    border-color: #00BCEB;
    font-weight: 600;
}

/* Search Input */
QLineEdit#SaleHistorySearch {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 14px;
    color: #FFFFFF;
}

QLineEdit#SaleHistorySearch:focus {
    border-color: #00BCEB;
}

/* Sales Table */
QTableWidget#SaleHistoryTable {
    background-color: #252526;
    alternate-background-color: #2A2A2E;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    gridline-color: #3E3E42;
    selection-background-color: #003366;
    selection-color: #FFFFFF;
}

/* Details Panel */
QWidget#SaleHistoryDetails {
    background-color: #1E1E1E;
}

QFrame#SaleInfoFrame {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 4px;
}

/* Line Items Table */
QTableWidget#SaleHistoryItems {
    background-color: #252526;
    alternate-background-color: #2A2A2E;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    gridline-color: #3E3E42;
}

/* Action Buttons */
QPushButton#SaleHistoryReprint {
    background-color: #00BCEB;
    color: #001F3F;
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: 600;
}

QPushButton#SaleHistoryReprint:hover {
    background-color: #00A5D0;
}

QPushButton#SaleHistoryReprint:disabled {
    background-color: #3E3E42;
    color: #666666;
}

QPushButton#SaleHistoryRefund {
    background-color: #FF4136;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: 600;
}

QPushButton#SaleHistoryRefund:hover {
    background-color: #E0362D;
}

QPushButton#SaleHistoryRefund:disabled {
    background-color: #3E3E42;
    color: #666666;
}

/* Refund Inline Panel */
QFrame#RefundInlinePanel {
    background-color: #3D1010;
    border: 1px solid #FF4136;
    border-radius: 6px;
}

/* ═══════════════════════════════════════════════════════════════
   Database Setup Dialog
   ═══════════════════════════════════════════════════════════════ */

QDialog#DatabaseSetupDialog {
    background-color: #1E1E1E;
}

QFrame#SetupCard {
    background-color: #252526;
    border: 1px solid #3E3E42;
    border-radius: 8px;
}

QFrame#SetupCard:hover {
    border-color: #00BCEB;
}
