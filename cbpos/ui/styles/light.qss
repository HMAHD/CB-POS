}

/* ===================================================================
   UNIFIED COMPONENTS - Light Theme
   ================================================================ */

/* === GENERIC TABLE VIEWS === */
QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    gridline-color: #E5E7EB;
    selection-background-color: #EFF6FF;
    selection-color: #1E40AF;
}

QTableView::item {
    padding: 8px;
    border: none;
}

QTableView::item:hover {
    background-color: #F3F4F6;
}

/* === BUTTONS ===
   A second generic QPushButton rule used to live here, meant to exclude
   NumpadBtn/ActionGridBtn/NavTile/SignOutBtn/IconButton via a :not()
   selector chain -- invalid in Qt Style Sheets (Qt doesn't support :not()),
   so Qt silently dropped all 4 of its rules (base/hover/pressed/disabled)
   and logged "Could not parse application stylesheet" the first time any
   QPushButton was polished. Since it never actually applied, every plain
   button in the app has always been styled solely by the real, valid
   generic QPushButton rule near the top of this file, in the earlier
   Buttons section. Deleted rather than fixed into valid CSS: making it
   valid would have made it start winning the cascade over that
   already-shipped rule (both being plain-type selectors, later-in-file
   wins), silently reskinning ~80 buttons across the app that were never
   meant to change. */

/* === SEARCH/INPUT FIELDS === */
QLineEdit {
    background-color: #FFFFFF;
    color: #374151;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #0066CC;
    selection-color: white;
}

QLineEdit:focus {
    border-color: #0066CC;
    background-color: #FFFFFF;
}

QLineEdit:disabled {
    background-color: #F9FAFB;
    color: #9CA3AF;
}

/* In-cell editors (#569). Item-view editors are plain QLineEdit /
   QSpinBox children of the view's viewport, so without this they inherit
   the full-size form style above (8px padding, 2px focus border, 36px
   spinbox min-height) and the typed value and caret are clipped out of
   a ~30px row. Descendant selectors outrank the bare type rules; the
   :focus variants are needed because QLineEdit:focus would otherwise win
   on specificity. The spinbox's own internal QLineEdit is reset so it
   doesn't draw a second border inside the spinbox.
   The editor's geometry is the item's text rect, so the generic
   ::item vertical padding (8-12px) would leave it ~13px tall: drop the
   vertical padding on the current (focused) item only. Rows have a
   fixed height and text is vertically centred, so nothing moves. */
QAbstractItemView::item:focus {
    padding-top: 0px;
    padding-bottom: 0px;
}

QAbstractItemView QLineEdit,
QAbstractItemView QLineEdit:focus,
QAbstractItemView QSpinBox,
QAbstractItemView QSpinBox:focus,
QAbstractItemView QSpinBox:hover,
QAbstractItemView QDoubleSpinBox,
QAbstractItemView QDoubleSpinBox:focus,
QAbstractItemView QDoubleSpinBox:hover,
QAbstractItemView QDateEdit,
QAbstractItemView QDateEdit:focus {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #0D6EFD;
    border-radius: 0px;
    padding: 0px 4px;
    margin: 0px;
    font-size: 13px;
    min-height: 0px;
}

QAbstractItemView QSpinBox,
QAbstractItemView QSpinBox:focus,
QAbstractItemView QSpinBox:hover,
QAbstractItemView QDoubleSpinBox,
QAbstractItemView QDoubleSpinBox:focus,
QAbstractItemView QDoubleSpinBox:hover {
    padding-right: 4px;
}

QAbstractItemView QAbstractSpinBox QLineEdit,
QAbstractItemView QAbstractSpinBox QLineEdit:focus {
    border: none;
    padding: 0px;
    background: transparent;
}

QAbstractItemView QSpinBox::up-button, QAbstractItemView QDoubleSpinBox::up-button,
QAbstractItemView QSpinBox::down-button, QAbstractItemView QDoubleSpinBox::down-button {
    /* No steppers in a ~32px row: there's no room for both, and these
       cells are typed into. Arrow keys still step the value. */
    width: 0px;
    border: none;
}

QAbstractItemView QSpinBox::up-arrow, QAbstractItemView QDoubleSpinBox::up-arrow,
QAbstractItemView QSpinBox::down-arrow, QAbstractItemView QDoubleSpinBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
}

/* ========================================
   NETWORK SETTINGS PAGE - CARD BASED DESIGN
   ======================================== */

/* Hero Status Card (Top Banner) */
QFrame#StatusCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    padding: 20px;
}

QLabel#StatusIcon {
    background-color: transparent;
    font-size: 32px;
    min-width: 50px;
}

/* Every QLabel below needs its own "background: transparent" -- none of
   them set a background-color, so without it Qt's global
   "QWidget { background-color: #F8F9FA; }" rule still wins for that one
   property despite these more specific ID selectors, showing up as a
   separate off-white block behind the text on every white card here. */
QLabel#StatusTitle {
    font-size: 18px;
    font-weight: bold;
    color: #111827;
    background: transparent;
}

QLabel#StatusSubtitle {
    color: #6B7280;
    font-size: 14px;
    margin-top: 4px;
    background: transparent;
}

QLabel#StatusModeLabel {
    color: #6B7280;
    font-size: 12px;
    margin-bottom: 4px;
    background: transparent;
}

QComboBox#StatusModeSelector {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 150px;
}

/* Server Configuration Card */
QFrame#NetworkCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    padding: 15px;
    margin-top: 10px;
}

QLabel#CardTitle {
    font-size: 16px;
    font-weight: bold;
    color: #111827;
    margin-bottom: 10px;
    background: transparent;
}

QLabel#IPHelper {
    color: #0066CC;
    font-size: 13px;
    background-color: rgba(0, 102, 204, 0.1);
    border-left: 3px solid #0066CC;
    padding: 8px 12px;
    border-radius: 4px;
}

QLabel#FormLabel {
    color: #374151;
    font-size: 13px;
    font-weight: bold;
    min-width: 110px;
    padding-right: 8px;
    background: transparent;
}

/* Network Input Fields */
QLineEdit#InputNetwork,
QSpinBox#InputNetwork,
QComboBox#InputNetwork {
    background-color: #FFFFFF;
    color: #374151;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}

QLineEdit#InputNetwork:focus,
QSpinBox#InputNetwork:focus,
QComboBox#InputNetwork:focus {
    border-color: #0066CC;
    background-color: #F9FAFB;
}

/* Higher specificity than "QWidget#SettingsContent QSpinBox" (above) is
   required here, or that rule's min-height wins and stretches this
   spinbox (and its up/down buttons) far taller than its sibling
   QLineEdit/QComboBox fields. */
QWidget#SettingsContent QSpinBox#InputNetwork {
    min-height: 18px;
    max-height: 18px;
}

QSpinBox#InputNetwork::up-button,
QSpinBox#InputNetwork::down-button {
    width: 20px;
    height: 12px;
}

QSpinBox#InputNetwork::up-arrow,
QSpinBox#InputNetwork::down-arrow {
    width: 8px;
    height: 8px;
}

/* Test Connection Button (Cyan Outline) */
QPushButton#BtnTestNetwork {
    background-color: transparent;
    border: 2px solid #00BCEB;
    color: #00BCEB;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 13px;
    min-height: 38px;
}

QPushButton#BtnTestNetwork:hover {
    background-color: rgba(0, 188, 235, 0.1);
}

QPushButton#BtnTestNetwork:pressed {
    background-color: rgba(0, 188, 235, 0.2);
}

QPushButton#BtnTestNetwork:disabled {
    background-color: transparent;
    border-color: #9CA3AF;
    color: #9CA3AF;
}

QLabel#TestStatus {
    font-size: 14px;
    font-weight: bold;
    padding-left: 10px;
    background: transparent;
}

/* Migration Card (Purple Accent) */
QFrame#MigrationCard {
    background-color: #FFFFFF;
    border: 2px solid #6C5CE7;
    border-radius: 8px;
    padding: 15px;
}

QLabel#MigrationInfo {
    background-color: transparent;
    color: #6B7280;
    font-size: 13px;
    line-height: 1.4;
}

/* Migration Button (Purple Solid - Brand Accent) */
QPushButton#BtnMigrate {
    background-color: #6C5CE7;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 14px 24px;
    font-weight: bold;
    font-size: 14px;
    min-height: 45px;
}

QPushButton#BtnMigrate:hover {
    background-color: #5B4CD9;
}

QPushButton#BtnMigrate:pressed {
    background-color: #4A3BB8;
}

QPushButton#BtnMigrate:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
}

/* Warning Footer */
QLabel#NetworkWarning {
    background-color: rgba(255, 193, 7, 0.1);
    color: #D97706;
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: 6px;
    padding: 12px;
    font-size: 12px;
}

/* SMTP Setup Guide Dialog */
QFrame#SmtpGuideStep {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QLabel#SmtpGuideStepNum {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
    border-radius: 16px;
}

/* === DATA SAFETY VIEW === */
/* Data Safety backup list: compact per-row Restore/Delete buttons (#620) */
QPushButton#BackupRowRestore, QPushButton#BackupRowDelete {
    padding: 4px 12px;
}

QLabel#RestoreWarning {
    background-color: rgba(220, 53, 69, 0.08);
    border: 1px solid #DC3545;
    border-radius: 6px;
    padding: 12px 16px;
    color: #842029;
    font-size: 12px;
}

/* === SETTINGS PAGE SHARED STYLES === */

/* Warning hint text (restart required, tax warning) */
QLabel[class="warning-hint"] {
    color: #B02A37;  /* #DC3545 is 4.3:1 on #F8F9FA at 12px (#566) */
    font-size: 12px;
    background: transparent;
}

/* Positive counterpart of warning-hint (hardware test passed, #624) */
QLabel[class="success-hint"] {
    color: #146C43;  /* #198754 is only ~4.5:1 on #F8F9FA at 12px */
    font-size: 12px;
    background: transparent;
}

/* Inline field validation error (e.g. Settings > Documents number format) */
QLabel[class="error"] {
    color: #DC3545;
    font-size: 12px;
    background: transparent;
}

/* Link-style text button */
QPushButton[class="link"] {
    background: transparent;
    color: #0D6EFD;
    border: none;
    padding: 4px 12px;
    font-weight: bold;
    font-size: 13px;
}
QPushButton[class="link"]:hover {
    color: #0A58CA;
}

/* Icon-only transparent button */
QPushButton#BtnInfoIcon {
    background: transparent;
    border: none;
}
QPushButton#BtnInfoIcon:hover {
    background: rgba(13, 110, 253, 0.1);
    border-radius: 14px;
}

/* Settings scroll area transparency */
QScrollArea#SettingsScrollArea {
    background: transparent;
    border: none;
}
QWidget#SettingsScrollInner {
    background: transparent;
}

/* Settings page section headers */
QLabel#SettingsSectionTitle {
    color: #0D6EFD;
    font-size: 13px;
    font-weight: bold;
    letter-spacing: 0.5px;
    background: transparent;
}
QFrame#SettingsSectionLine {
    background-color: #CCCCCC;
    max-height: 1px;
    min-height: 1px;
}

/* Receipt live preview */
QLabel#ReceiptPreviewTitle {
    color: #888888;
    font-size: 11px;
    background: transparent;
    padding: 4px 0;
}
QTextBrowser#ReceiptPreviewBrowser {
    background-color: #d0d0d0;
    color: #000000;
    border: 1px solid #CCCCCC;
    border-radius: 6px;
}

/* ── BackupRestoreDialog & ValuationDialog (light theme) ───────── */
QDialog#BackupRestoreDialog {
    background-color: #F8F9FA;
}
QDialog#BackupRestoreDialog QTabWidget::pane { border: none; background: #F8F9FA; }
QDialog#BackupRestoreDialog QTabBar::tab {
    background: #E9ECEF; color: #6C757D; padding: 10px 22px;
    border-top-left-radius: 6px; border-top-right-radius: 6px;
    margin-right: 2px; font-size: 13px; border: none;
}
QDialog#BackupRestoreDialog QTabBar::tab:selected { background: #FFFFFF; color: #0D6EFD; font-weight: bold; }
QDialog#BackupRestoreDialog QTabBar::tab:hover { background: #DEE2E6; color: #212529; }

QLabel#DialogTitle { color: #0D6EFD; font-size: 20px; font-weight: bold; margin-bottom: 8px; }
QLabel#DialogSubtitle { color: #6C757D; font-size: 12px; margin-bottom: 16px; }
QLabel#SectionTitle { font-size: 16px; font-weight: bold; color: #212529; margin-top: 20px; }

QLabel[class="value"] { color: #212529; font-size: 13px; font-weight: bold; }
QLabel[class="status-ok"] { color: #198754; font-weight: bold; font-size: 13px; }
QLabel[class="status-err"] { color: #DC3545; font-weight: bold; font-size: 13px; }
QLabel[class="card-value"] { color: #212529; font-size: 28px; font-weight: bold; }
QLabel[class="card-value-positive"] { color: #198754; font-size: 28px; font-weight: bold; }
QLabel[class="card-value-negative"] { color: #DC3545; font-size: 28px; font-weight: bold; }

QGroupBox[class="card"] {
    background-color: #FFFFFF; border: 1px solid #DEE2E6; border-radius: 8px;
    margin-top: 16px; padding: 20px 16px 16px 16px; font-weight: bold; color: #0D6EFD;
}
QGroupBox[class="card"]::title { subcontrol-origin: margin; left: 16px; padding: 0 8px; }

QFrame#ValueCard { background-color: #FFFFFF; border: 1px solid #DEE2E6; border-radius: 8px; padding: 15px; }
QFrame#Separator { background-color: #DEE2E6; }

QTableWidget#BackupTable, QTableWidget#ValuationTable {
    background-color: #FFFFFF; border: 1px solid #DEE2E6; border-radius: 6px;
    gridline-color: #E9ECEF; color: #212529; selection-background-color: #E7F1FF; font-size: 12px;
}
QTableWidget#BackupTable::item, QTableWidget#ValuationTable::item { padding: 6px; }
QLabel#RestoreWarning {
    background-color: rgba(220, 53, 69, 0.08); border: 1px solid #DC3545;
    border-radius: 6px; padding: 12px 16px; color: #842029; font-size: 12px;
}

/* ── Label Print Dialog ── */
QDialog#LabelPrintDialog {
    background-color: #F8F9FA;
}

QTableWidget#LabelQueueTable {
    font-size: 14px;
}

QTableWidget#LabelQueueTable::item {
    padding: 8px;
}

/* Same in-cell editor fix as QAbstractItemView::item:focus (#569) --
   this ID rule would otherwise out-rank it and keep the Qty editor short. */
QTableWidget#LabelQueueTable::item:focus {
    padding-top: 0px;
    padding-bottom: 0px;
}

/* ── Label Preview Dialog ── */
QDialog#LabelPreviewDialog {
    background-color: #E9ECEF;
}

QDialog#LabelPreviewDialog QLabel {
    background: transparent;
}

QLabel#LabelPreviewHeader {
    font-size: 14px;
    font-weight: bold;
    color: #0D6EFD;
}

QLabel#LabelPreviewHint {
    font-size: 11px;
    color: #6C757D;
}

/* ── CSV Import Dialog ── */
QDialog#CsvImportDialog {
    background-color: #F8F9FA;
}

QDialog#CsvImportDialog QLabel {
    background: transparent;
    color: #212529;
}

/* ── Add/Edit Supplier Dialog ── */
QDialog#SupplierDialog {
    background-color: #F8F9FA;
}

QDialog#SupplierDialog QLabel {
    background: transparent;
    color: #212529;
}

/* ── Toggle Hint — compact inline description below checkboxes ── */
/* Reusable: set objectName("ToggleHint") on any QLabel used as a toggle hint */
QLabel#ToggleHint {
    color: #8C959F;
    font-size: 11px;
    background: transparent;
    padding: 0px;
}

/* ── Product Image Preview placeholder ── */
QLabel#ProductImagePreview {
    border: 1px solid #DEE2E6;
    background-color: #FFFFFF;
    color: #8C959F;
    border-radius: 4px;
    font-size: 12px;
}

/* ═══════════════════════════════════════════════════════════════════════
   REPORT VIEWER — Data Observatory (Light)
   ═══════════════════════════════════════════════════════════════════════ */

#ReportViewer {
    background-color: #F8F9FA;
}

/* ── Splitter ── */
#ReportSplitter::handle {
    background-color: #E9ECEF;
    width: 1px;
}

/* ── Sidebar ── */
#ReportSidebarPanel {
    background-color: #FFFFFF;
    border-right: 1px solid #E9ECEF;
}

#ReportSidebarTitle {
    color: #0D6EFD;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 3px;
    padding: 18px 20px 14px 20px;
    background: transparent;
    border-bottom: 1px solid #E9ECEF;
}

#ReportSidebarScroll {
    background: transparent;
    border: none;
}

#ReportNavContainer {
    background: transparent;
}

/* Category header */
#ReportCategoryLabel {
    color: #ADB5BD;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
    background: transparent;
}

#ReportCategoryCount {
    color: #ADB5BD;
    background-color: #F8F9FA;
    font-size: 10px;
    font-weight: bold;
    border-radius: 8px;
    min-height: 16px;
    max-height: 16px;
}

/* Report nav items */
QPushButton#ReportNavItem {
    background-color: transparent;
    color: #6C757D;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
    font-size: 14px;
    text-align: left;
    padding: 11px 12px 11px 14px;
}

QPushButton#ReportNavItem:hover {
    background-color: #F8F9FA;
    color: #212529;
    border-left: 3px solid #CED4DA;
}

QPushButton#ReportNavItem:checked {
    background-color: #E9ECEF;
    color: #0D6EFD;
    border-left: 3px solid #0D6EFD;
    font-weight: bold;
}

/* ── Content Panel ── */
#ReportContentPanel {
    background-color: #F8F9FA;
}

/* ── Report Header ── */
#ReportHeader {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E9ECEF;
}

#ReportTitle {
    color: #212529;
    font-size: 20px;
    font-weight: bold;
    background: transparent;
}

#ReportDescription {
    color: #0D6EFD;
    font-size: 13px;
    background: transparent;
}

/* ── Filter Bar ── */
#ReportFilterBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E9ECEF;
    min-height: 48px;
}

#ReportFilterWidget {
    background: transparent;
}

#ReportFilterLabel {
    color: #6C757D;
    font-size: 13px;
    background: transparent;
}

#ReportDateEdit {
    background-color: #F8F9FA;
    color: #212529;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 6px 10px;
    min-width: 120px;
    font-size: 13px;
}

#ReportDateEdit:focus {
    border: 1px solid #0D6EFD;
}

#ReportDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #CED4DA;
    background-color: #E9ECEF;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

#ReportDateEdit::drop-down:hover {
    background-color: #CED4DA;
}

#ReportFilterCombo {
    background-color: #F8F9FA;
    color: #212529;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 6px 10px;
    min-width: 130px;
    font-size: 13px;
}

#ReportFilterCombo:focus {
    border: 1px solid #0D6EFD;
}

#RunReportBtn {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 13px;
    border: none;
    border-radius: 6px;
    padding: 8px 28px;
    min-width: 130px;
}

#RunReportBtn:hover {
    background-color: #0B5ED7;
}

#RunReportBtn:pressed {
    background-color: #0A58CA;
}

#RunReportBtn:disabled {
    background-color: #E9ECEF;
    color: #ADB5BD;
}

/* ── Data Table ── */
#ReportDataView {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    color: #212529;
    border: none;
    gridline-color: #E9ECEF;
    selection-background-color: #E9ECEF;
    selection-color: #0D6EFD;
    font-size: 13px;
}

#ReportDataView::item {
    padding: 6px 12px;
    min-height: 18px;
}

/* ── Action Bar ── */
#ReportActionBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E9ECEF;
    min-height: 44px;
}

#ReportRowCount {
    color: #6C757D;
    font-size: 13px;
    background: transparent;
    font-weight: bold;
}

#ReportPrintBtn,
#ReportExportExcelBtn,
#ReportExportPdfBtn,
#ReportEmailBtn {
    background-color: #F8F9FA;
    color: #6C757D;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 7px 18px;
    font-size: 13px;
}

#ReportPrintBtn:hover,
#ReportExportExcelBtn:hover,
#ReportExportPdfBtn:hover,
#ReportEmailBtn:hover {
    background-color: #E9ECEF;
    color: #212529;
    border-color: #0D6EFD;
}

#ReportPrintBtn:pressed,
#ReportExportExcelBtn:pressed,
#ReportExportPdfBtn:pressed,
#ReportEmailBtn:pressed {
    background-color: #0D6EFD;
    color: #FFFFFF;
}

/* ===================================================================
   CREDIT BOOK VIEW — Drill-down Navigation (Light)
   ================================================================ */

QLabel#CreditPageTitle, QLabel#PayablePageTitle {
    font-size: 22px;
    font-weight: bold;
    color: #0D6EFD;
    background-color: transparent;
}

QLineEdit#CreditSearchInput, QLineEdit#PayableSearchInput {
    padding: 8px 12px;
    font-size: 13px;
    border: 1px solid #CED4DA;
    border-radius: 6px;
    background-color: #FFFFFF;
    color: #212529;
}

QLineEdit#CreditSearchInput:focus, QLineEdit#PayableSearchInput:focus {
    border-color: #0D6EFD;
}

QPushButton#CreditAddBtn {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#CreditAddBtn:hover {
    background-color: #0B5ED7;
}

QTableWidget#CreditCustomerTable, QTableWidget#CreditLedgerTable,
QTableWidget#PayableSupplierTable, QTableWidget#PayableLedgerTable {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    color: #212529;
    gridline-color: #E9ECEF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#CreditCustomerTable::item:selected, QTableWidget#CreditLedgerTable::item:selected,
QTableWidget#PayableSupplierTable::item:selected, QTableWidget#PayableLedgerTable::item:selected {
    background-color: #E9ECEF;
    color: #0D6EFD;
}

QFrame#CreditListFooter, QFrame#CreditLedgerFooter,
QFrame#PayableLedgerFooter {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

QLabel#CreditFooterLabel {
    background-color: transparent;
    font-size: 13px;
    font-weight: bold;
    color: #495057;
}

QLabel#CreditFooterDebt, QLabel#CreditLedgerDebit,
QLabel#PayableLedgerDebit {
    color: #DC3545;
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

QLabel#CreditLedgerCredit, QLabel#PayableLedgerCredit {
    color: #198754;
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

QLabel#CreditLedgerClosing, QLabel#PayableLedgerClosing {
    color: #212529;
    background-color: transparent;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#CreditBackBtn, QPushButton#PayableBackBtn {
    background-color: transparent;
    color: #0D6EFD;
    border: none;
    font-size: 13px;
    font-weight: bold;
    padding: 4px 8px;
}

QPushButton#CreditBackBtn:hover, QPushButton#PayableBackBtn:hover {
    color: #0B5ED7;
}

/* Payable/Credit date-range mismatch hint (#282/#284) */
QFrame#PayableRangeHint, QFrame#CreditRangeHint {
    background-color: rgba(255, 193, 7, 0.12);
    border: 1px solid #FFC107;
    border-radius: 6px;
}

QLabel#PayableRangeHintLabel, QLabel#CreditRangeHintLabel {
    background-color: transparent;
    color: #856404;
    font-size: 12px;
}

QPushButton#PayableRangeHintBtn, QPushButton#CreditRangeHintBtn {
    background-color: #FFC107;
    color: #212529;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 4px 12px;
}

QPushButton#PayableRangeHintBtn:hover, QPushButton#CreditRangeHintBtn:hover {
    background-color: #E0A800;
}

QFrame#CreditHeaderCard, QFrame#PayableHeaderCard {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QFrame#CreditHeaderCard QLabel, QFrame#PayableHeaderCard QLabel {
    background-color: transparent;
}

QLabel#CreditCustName, QLabel#PayableCustName {
    font-size: 18px;
    font-weight: bold;
    color: #212529;
}

QLabel#CreditCustPhone, QLabel#PayableCustPhone {
    font-size: 13px;
    color: #6C757D;
}

QLabel#CreditMetricDebt, QLabel#PayableMetricDebt {
    font-size: 14px;
    font-weight: bold;
    color: #DC3545;
}

QLabel#CreditMetricAvail {
    font-size: 14px;
    font-weight: bold;
    color: #198754;
}

QLabel#CreditMetricLast, QLabel#PayableMetricLast {
    font-size: 13px;
    color: #6C757D;
}

QPushButton#CreditPayBtn, QPushButton#PayablePayBtn {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#CreditPayBtn:hover, QPushButton#PayablePayBtn:hover {
    background-color: #0B5ED7;
}

QPushButton#CreditPrintBtn, QPushButton#CreditEditBtn {
    background-color: #F8F9FA;
    color: #495057;
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid #CED4DA;
    font-size: 13px;
}

QPushButton#CreditPrintBtn:hover, QPushButton#CreditEditBtn:hover {
    border-color: #0D6EFD;
    color: #0D6EFD;
}

QPushButton#CreditAdjustBtn, QPushButton#PayableAdjustBtn {
    background-color: #F8F9FA;
    color: #495057;
    padding: 8px 16px;
    border-radius: 6px;
    border: 1px solid #CED4DA;
    font-size: 13px;
}

QPushButton#CreditAdjustBtn:hover, QPushButton#PayableAdjustBtn:hover {
    border-color: #0D6EFD;
    color: #0D6EFD;
}

QLabel#CreditFilterLabel, QLabel#PayableFilterLabel {
    background-color: transparent;
    color: #6C757D;
    font-size: 13px;
}

QPushButton#CreditAllDatesBtn, QPushButton#PayableAllDatesBtn {
    background-color: #F8F9FA;
    color: #495057;
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid #CED4DA;
    font-size: 12px;
}

QPushButton#CreditAllDatesBtn:hover, QPushButton#PayableAllDatesBtn:hover {
    border-color: #0D6EFD;
}

/* ===================================================================
   PAGE HEADER — Shared icon+title strip for every Management screen (Light)
   ================================================================ */

QWidget#PageHeader {
    background-color: transparent;
}

QLabel#PageHeaderIcon {
    background-color: transparent;
}

QLabel#PageHeaderTitle {
    font-size: 18px;
    font-weight: bold;
    color: #0D6EFD;
    background-color: transparent;
}

/* ===================================================================
   DOCUMENT BROWSER VIEW — Full-width with Detail Panel (Light)
   ================================================================ */

QLabel#DocBrowserTitle {
    font-size: 22px;
    font-weight: bold;
    color: #0D6EFD;
    background-color: transparent;
}

QPushButton#DocNewQuotationBtn {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 16px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#DocNewQuotationBtn:hover {
    background-color: #0B5ED7;
}

QFrame#DocFilterBar {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

QLabel#DocFilterLabel {
    background-color: transparent;
    color: #6C757D;
    font-size: 13px;
}

QLineEdit#DocSearchInput {
    padding: 6px 10px;
    font-size: 13px;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    background-color: #FFFFFF;
    color: #212529;
}

QLineEdit#DocSearchInput:focus {
    border-color: #0D6EFD;
}

QPushButton#DocFilterBtn {
    background-color: #F8F9FA;
    color: #495057;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #CED4DA;
    font-size: 13px;
}

QPushButton#DocFilterBtn:hover {
    border-color: #0D6EFD;
    color: #0D6EFD;
}

QPushButton#DocClearBtn {
    padding: 6px 14px;
    border-radius: 4px;
    font-size: 13px;
}

QTableWidget#DocTable {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    color: #212529;
    gridline-color: #E9ECEF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#DocTable::item:selected {
    background-color: #E9ECEF;
    color: #0D6EFD;
}

QFrame#DocDetailPanel {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QLabel#DocDetailTitle {
    font-size: 16px;
    font-weight: bold;
    color: #0D6EFD;
    background-color: transparent;
}

QPushButton#DocDetailCloseBtn {
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
}

QLabel#DocInfoLabel, QLabel#DocPaymentLabel, QLabel#DocItemsTitle {
    background-color: transparent;
    color: #212529;
    font-size: 13px;
}

QLabel#DocItemsTitle {
    font-weight: bold;
    color: #0D6EFD;
}

QTableWidget#DocItemsTable {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    color: #212529;
    gridline-color: #E9ECEF;
    border: 1px solid #DEE2E6;
    border-radius: 4px;
    font-size: 12px;
}

QPushButton#DocReprintBtn, QPushButton#DocConvertBtn {
    background-color: #F8F9FA;
    color: #495057;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #CED4DA;
    font-size: 13px;
}

QPushButton#DocReprintBtn:hover, QPushButton#DocConvertBtn:hover {
    border-color: #0D6EFD;
    color: #0D6EFD;
}

QPushButton#DocConvertBtn:enabled {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    border: none;
}

QPushButton#DocRefundBtn, QPushButton#DocVoidBtn {
    background-color: #FFF5F5;
    color: #DC3545;
    padding: 6px 14px;
    border-radius: 4px;
    border: 1px solid #F5C2C7;
    font-size: 13px;
}

QPushButton#DocRefundBtn:hover, QPushButton#DocVoidBtn:hover {
    background-color: #F8D7DA;
    border-color: #DC3545;
}

QLabel#DocPageLabel {
    background-color: transparent;
    color: #6C757D;
    font-size: 12px;
}

QPushButton#DocPrevBtn, QPushButton#DocNextBtn {
    background-color: #F8F9FA;
    color: #495057;
    padding: 4px 12px;
    border-radius: 4px;
    border: 1px solid #CED4DA;
    font-size: 12px;
}

QPushButton#DocPrevBtn:hover, QPushButton#DocNextBtn:hover {
    border-color: #0D6EFD;
    color: #0D6EFD;
}

/* ===================================================================
   PRICE LIST VIEW — Sidebar Navigation (Light)
   ================================================================ */

QWidget#PriceListSidebarPanel {
    background-color: #FFFFFF;
    border-right: 1px solid #DEE2E6;
}

QLabel#PriceListSidebarTitle {
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 2px;
    color: #0D6EFD;
    background-color: transparent;
    padding-bottom: 4px;
}

QScrollArea#PriceListSidebarScroll {
    background-color: transparent;
    border: none;
}

QWidget#PriceListNavContainer {
    background-color: transparent;
}

QPushButton#PriceListNavItem {
    text-align: left;
    padding: 14px 14px;
    font-size: 14px;
    color: #6C757D;
    background-color: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0px;
}

QPushButton#PriceListNavItem:hover {
    background-color: #F8F9FA;
    color: #212529;
}

QPushButton#PriceListNavItem:checked {
    background-color: #E9ECEF;
    color: #0D6EFD;
    font-weight: bold;
    border-left: 3px solid #0D6EFD;
}

QPushButton#PriceListAddBtn {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 12px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#PriceListAddBtn:hover {
    background-color: #0B5ED7;
}

QPushButton#PriceListDeleteBtn {
    background-color: #DC3545;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 12px;
    border-radius: 6px;
    border: none;
    font-size: 13px;
}

QPushButton#PriceListDeleteBtn:hover {
    background-color: #C82333;
}

QWidget#PriceListContentPanel {
    background-color: #F8F9FA;
}

QLabel#PriceListEmptyText {
    font-size: 18px;
    font-weight: bold;
    color: #6C757D;
    background-color: transparent;
}

QLabel#PriceListEmptySubtext {
    font-size: 13px;
    color: #ADB5BD;
    background-color: transparent;
}

QFrame#PriceListHeader {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

QLabel#PriceListTitle {
    font-size: 18px;
    font-weight: bold;
    color: #212529;
    background-color: transparent;
}

QLabel#PriceListDates {
    font-size: 13px;
    color: #6C757D;
    background-color: transparent;
}

QTableWidget#PriceListDataTable {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    color: #212529;
    gridline-color: #E9ECEF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
    font-size: 13px;
}

QTableWidget#PriceListDataTable::item:selected {
    background-color: #E9ECEF;
    color: #0D6EFD;
}

QFrame#PriceListFooter {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

QLabel#PriceListFooterLabel {
    background-color: transparent;
    color: #6C757D;
    font-size: 12px;
}

QLabel#PriceListFooterHint {
    background-color: transparent;
    color: #5C636A;
    font-size: 13px;
}

QSplitter#PriceListSplitter::handle {
    background-color: #DEE2E6;
    width: 1px;
}

/* ── Payment Methods Card List ── */
#PMCardScroll {
    background: transparent;
}

#PMCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

#PMCard:hover {
    border-color: #0D6EFD;
}

QLabel#PMCardName {
    font-size: 14px;
    font-weight: bold;
    color: #212529;
    background: transparent;
}

QLabel#PMCardTags {
    font-size: 11px;
    color: #6C757D;
    background: transparent;
}

QLabel#PMCardStatus {
    font-size: 11px;
    font-weight: bold;
    border-radius: 10px;
    padding: 3px 10px;
}

QLabel#PMCardStatus[class="pm-active"] {
    background-color: #D1E7DD;
    color: #0F5132;
    border: 1px solid #BADBCC;
}

QLabel#PMCardStatus[class="pm-inactive"] {
    background-color: #F8D7DA;
    color: #842029;
    border: 1px solid #F5C2C7;
}

QPushButton#PMCardBtn {
    padding: 5px 16px;
    font-size: 12px;
    font-weight: bold;
    border-radius: 4px;
}

QPushButton#PMCardBtn[class="danger"] {
    background-color: #DC3545;
    color: #FFFFFF;
    border: none;
}

QPushButton#PMCardBtn[class="danger"]:hover {
    background-color: #C82333;
}

QPushButton#PMCardBtn[class="warning"] {
    background-color: #FFC107;
    color: #212529;
    border: none;
}

QPushButton#PMCardBtn[class="warning"]:hover {
    background-color: #E0A800;
}

QPushButton#PMCardBtn[class="accent"] {
    background-color: #0D6EFD;
    color: #FFFFFF;
    border: none;
}

QPushButton#PMCardBtn[class="accent"]:hover {
    background-color: #0B5ED7;
}

/* ═══════════════════════════════════════════════════════════════
   Sale History Dialog
   ═══════════════════════════════════════════════════════════════ */

QDialog#SaleHistoryDialog {
    background-color: #F5F5F5;
}

/* Quick Filter Buttons */
QPushButton#QuickFilterBtn {
    background-color: #FFFFFF;
    color: #555555;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton#QuickFilterBtn:hover {
    background-color: #E8E8E8;
    color: #333333;
}

QPushButton#QuickFilterBtn:checked {
    background-color: #0D6EFD;
    color: #FFFFFF;
    border-color: #0D6EFD;
    font-weight: 600;
}

/* Search Input */
QLineEdit#SaleHistorySearch {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 14px;
    color: #333333;
}

QLineEdit#SaleHistorySearch:focus {
    border-color: #0D6EFD;
}

/* Sales Table */
QTableWidget#SaleHistoryTable {
    background-color: #FFFFFF;
    alternate-background-color: #F9F9F9;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    gridline-color: #E0E0E0;
    selection-background-color: #CCE5FF;
    selection-color: #333333;
}

/* Details Panel */
QWidget#SaleHistoryDetails {
    background-color: #F5F5F5;
}

QFrame#SaleInfoFrame {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
}

/* Line Items Table */
QTableWidget#SaleHistoryItems {
    background-color: #FFFFFF;
    alternate-background-color: #F9F9F9;
    border: 1px solid #CCCCCC;
    border-radius: 4px;
    gridline-color: #E0E0E0;
}

/* Action Buttons */
QPushButton#SaleHistoryReprint {
    background-color: #0D6EFD;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: 600;
}

QPushButton#SaleHistoryReprint:hover {
    background-color: #0B5ED7;
}

QPushButton#SaleHistoryReprint:disabled {
    background-color: #CCCCCC;
    color: #888888;
}

QPushButton#SaleHistoryRefund {
    background-color: #DC3545;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 8px 20px;
    font-weight: 600;
}

QPushButton#SaleHistoryRefund:hover {
    background-color: #BB2D3B;
}

QPushButton#SaleHistoryRefund:disabled {
    background-color: #CCCCCC;
    color: #888888;
}

/* Refund Inline Panel */
QFrame#RefundInlinePanel {
    background-color: #FFF3F3;
    border: 1px solid #DC3545;
    border-radius: 6px;
}

/* ═══════════════════════════════════════════════════════════════
   Database Setup Dialog
   ═══════════════════════════════════════════════════════════════ */

QDialog#DatabaseSetupDialog {
    background-color: #F5F5F5;
}

QFrame#SetupCard {
    background-color: #FFFFFF;
    border: 1px solid #CCCCCC;
    border-radius: 8px;
}

QFrame#SetupCard:hover {
    border-color: #0D6EFD;
}

/* ===================================================================
   CRUD MANAGER DIALOGS (Category, Unit) - Light Theme
   =================================================================== */

QDialog#CategoryManagerDialog,
QDialog#UnitManagerDialog {
    background-color: #FFFFFF;
}

QDialog#CategoryManagerDialog QGroupBox,
QDialog#UnitManagerDialog QGroupBox {
    background-color: #F8F9FA;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
    margin-top: 16px;
    padding: 12px;
    padding-top: 24px;
}

QDialog#CategoryManagerDialog QGroupBox::title,
QDialog#UnitManagerDialog QGroupBox::title {
    color: #0D6EFD;
    font-weight: bold;
    font-size: 13px;
}

QDialog#CategoryManagerDialog QGroupBox QLabel,
QDialog#UnitManagerDialog QGroupBox QLabel {
    background-color: transparent;
    color: #1F2937;
}

QDialog#CategoryManagerDialog QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #F8F9FA;
    border: 1px solid #E5E7EB;
    border-radius: 6px;
}

QDialog#CategoryManagerDialog QTreeWidget::item {
    padding: 6px;
    border: none;
}

QDialog#CategoryManagerDialog QTreeWidget::item:selected {
    background-color: #E7F1FF;
    color: #0D6EFD;
}

QDialog#CategoryManagerDialog QTreeWidget::item:hover {
    background-color: #F0F4F8;
}

/* ===================================================================
   RECEIVE PAYMENT DIALOG - Transparent Labels (Light Theme)
   =================================================================== */

QDialog#ReceivePaymentDialog QLabel {
    background-color: transparent;
    color: #1F2937;
}

QFrame#BalanceFrame QLabel {
    background-color: transparent;
    color: #1F2937;
}

/* ===================================================================
   DOCUMENT BROWSER VIEW - Transparent Labels (Light Theme)
   =================================================================== */

QFrame#FilterBar QLabel {
    background-color: transparent;
    color: #374151;
}

QFrame#DocDetailsPanel QLabel {
    background-color: transparent;
    color: #374151;
}

/* ===================================================================
   NETWORK SETTINGS - Light Theme
   =================================================================== */

QPushButton#BtnTestConnection {
    background-color: transparent;
    color: #0D6EFD;
    border: 2px solid #0D6EFD;
    border-radius: 6px;
    padding: 10px 24px;
    font-weight: bold;
    font-size: 14px;
    min-width: 150px;
}

QPushButton#BtnTestConnection:hover {
    background-color: rgba(13, 110, 253, 0.1);
    border-color: #0B5ED7;
}

QPushButton#BtnTestConnection:pressed {
    background-color: rgba(13, 110, 253, 0.2);
}

QLabel#NetworkWarningLabel {
    background-color: #FEF2F2;
    color: #DC3545;
    border: 1px solid rgba(220, 53, 69, 0.3);
    border-radius: 6px;
    padding: 12px;
    font-size: 12px;
}
