/* 
    Ceylon Byte POS - Enterprise Light Theme 
    Palette:
    - Background: #F8F9FA (Global BG) / #FFFFFF (Surface)
    - Text: #212529 (Primary) / #495057 (Secondary)
    - Border: #DEE2E6
    - Accent: #0D6EFD (Bootstrap Blue)
    - Success: #198754 (Bootstrap Green)
    - Warning: #FFC107
    - Error: #DC3545
*/

/* Global Font Enforcement */
* {
    font-family: "{{FONT_FAMILY}}", "Noto Sans";
}

QLabel.PlaceholderLabel {
    color: #6C757D;
}

QLabel.AboutLabel {
    font-size: 16px;
    color: #495057;
}

/* Global Reset */
QWidget {
    background-color: #F8F9FA;
    color: #212529;
    font-size: 14px;
}

/* Inputs - Global Baseline */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 8px;
    font-size: 16px;
    color: #212529;
    selection-background-color: #0D6EFD;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

/* Date pickers - Global Baseline (13 of 15 sites in the app had no styling
   at all before this; only #ReportDateEdit/#PeriodDateEdit had one-off
   rules). A generic type selector styles every QDateEdit automatically,
   including any without an objectName. */
QDateEdit, QTimeEdit, QDateTimeEdit {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 14px;
    color: #212529;
}

QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid #CED4DA;
    background-color: #F1F3F5;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QDateEdit::drop-down:hover {
    background-color: #E9ECEF;
}

/* Context/dropdown menus - Global Baseline. Previously the only QMenu
   rule in this file was scoped to QCalendarWidget QMenu, so every other
   right-click menu in the app (e.g. the Sales screen's cart line-item
   menu) rendered with the OS's native popup chrome instead of this
   theme, even though the surrounding code already manually re-tints
   the menu's icons per theme. A generic selector styles every QMenu at
   once, the same way QDateEdit/QLineEdit above do for their types. */
QMenu {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #CED4DA;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #EFF6FF;
    color: #0D6EFD;
}

QMenu::item:disabled {
    color: #ADB5BD;
}

QMenu::separator {
    height: 1px;
    background-color: #E9ECEF;
    margin: 4px 8px;
}

QMenu::icon {
    padding-left: 8px;
}

QCalendarWidget {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #CED4DA;
    border-radius: 4px;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #F8F9FA;
}

QCalendarWidget QToolButton {
    background-color: transparent;
    color: #212529;
    font-size: 13px;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}

QCalendarWidget QToolButton:hover {
    background-color: #E9ECEF;
}

QCalendarWidget QMenu {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #CED4DA;
}

QCalendarWidget QSpinBox {
    background-color: #F8F9FA;
    color: #212529;
    border: 1px solid #CED4DA;
    border-radius: 4px;
}

QCalendarWidget QAbstractItemView:enabled {
    background-color: #FFFFFF;
    color: #212529;
    selection-background-color: #0D6EFD;
    selection-color: #FFFFFF;
    outline: none;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #ADB5BD;
}

/* The app-wide QHeaderView::section rule (accent underline, bold, meant
   for real tables) also matches QCalendarWidget's internal day-name header
   row -- this scoped override is a deliberate exception (#554) that keeps
   the popup's header compact and neutral instead of a table-style bar. */
QCalendarWidget QHeaderView::section {
    background-color: #F1F3F5;
    color: #495057;
    padding: 4px;
    font-weight: normal;
    font-size: 12px;
    border: none;
    border-bottom: 1px solid #DEE2E6;
}

/* ComboBox - Dropdown Selector */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 8px 12px;
    padding-right: 35px;  /* Space for arrow */
    font-size: 14px;
    color: #212529;
    min-height: 32px;
}

QComboBox:hover {
    border: 1px solid #0D6EFD;
    background-color: #F8F9FA;
}

QComboBox:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #CED4DA;  /* Separator line */
    background: #E9ECEF;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::drop-down:hover {
    background: #D0E2FF;  /* Light blue background on hover */
    border-left: 1px solid #0D6EFD;
}

QComboBox::down-arrow {
    image: url(cbpos/assets/icons/chevron-down-blue.svg);
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #0D6EFD;
    selection-background-color: #0D6EFD;
    selection-color: #FFFFFF;
    color: #212529;
    padding: 4px;

}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 28px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #E9ECEF;
    color: #0D6EFD;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #0D6EFD;
    color: #FFFFFF;
}

/* SpinBox - Number Input (Modern Touch-Friendly Design) */
QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 8px 12px;
    padding-right: 35px;  /* Space for wider buttons */
    font-size: 14px;
    color: #212529;
    min-height: 36px;  /* Touch-friendly height */
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #0D6EFD;
    background-color: #F8F9FA;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

/* UP Button (+) - Clear plus icon */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 30px;
    height: 18px;
    border-left: 1px solid #CED4DA;
    border-bottom: 1px solid #CED4DA;
    background-color: #E9ECEF;
    border-top-right-radius: 4px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #0D6EFD;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed {
    background-color: #0B5ED7;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(cbpos/assets/icons/plus-dark.svg);
    width: 12px;
    height: 12px;
}

/* DOWN Button (-) - Clear minus icon */
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 30px;
    height: 18px;
    border-left: 1px solid #CED4DA;
    border-top: 1px solid #CED4DA;
    background-color: #E9ECEF;
    border-bottom-right-radius: 4px;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #0D6EFD;
}

QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #0B5ED7;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(cbpos/assets/icons/minus-dark.svg);
    width: 12px;
    height: 12px;
}

/* Denomination Widget (Start Shift / Shift Closing cash count, #525) */
QLabel#DenomLabel {
    font-size: 14px;
    font-weight: bold;
    color: #212529;
}

QLabel#DenomRowTotal {
    font-size: 13px;
    color: #6C757D;
}

QLabel#DenomGrandTotalLabel {
    font-size: 16px;
    font-weight: bold;
    color: #0D6EFD;
}

QLabel#DenomGrandTotalValue {
    font-size: 20px;
    font-weight: bold;
    color: #198754;
}

/* Checkboxes - Toggle Style with Checkmark */
QCheckBox {
    spacing: 10px;
    color: #212529;
    background-color: transparent;
}

/* Unchecked State - Empty box with visible border */
QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #ADB5BD;
    border-radius: 4px;
    background-color: transparent;
}

/* Unchecked Hover - Blue glow */
QCheckBox::indicator:unchecked:hover {
    border-color: #0D6EFD;
    background-color: rgba(13, 110, 253, 0.1);
}

/* Checked State - Blue fill with white checkmark */
QCheckBox::indicator:checked {
    background-color: #0D6EFD;
    border-color: #0D6EFD;
    image: url(cbpos/assets/icons/check-white.svg);
}

/* Checked Hover - Darker blue with checkmark */
QCheckBox::indicator:checked:hover {
    background-color: #0B5ED7;
    border-color: #0B5ED7;
    image: url(cbpos/assets/icons/check-white.svg);
}

/* Tree/table item checkboxes (e.g. Permission Manager) rendered plain
   grey native OS squares -- ::indicator on QTreeWidget/QTableWidget
   picks up the exact same themed style as a real QCheckBox (#298). */
QTreeWidget::indicator, QTableWidget::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #ADB5BD;
    border-radius: 4px;
    background-color: transparent;
}

QTreeWidget::indicator:checked, QTableWidget::indicator:checked {
    background-color: #0D6EFD;
    border-color: #0D6EFD;
    image: url(cbpos/assets/icons/check-white.svg);
}

/* Locked cells (e.g. Admin's critical permissions, #614) */
QTreeWidget::indicator:checked:disabled, QTableWidget::indicator:checked:disabled {
    background-color: #ADB5BD;
    border-color: #ADB5BD;
}

/* Buttons */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 10px 20px;
    font-weight: bold;
    color: #495057;
}

QPushButton:hover {
    background-color: #E9ECEF;
    border: 1px solid #ADB5BD;
    color: #212529;
}

QPushButton:pressed {
    background-color: #DEE2E6;
}

/* Keyboard focus (#553). Qt otherwise draws the platform's dotted focus
   rectangle (Windows) inside buttons and around the current cell of
   every item view. Item views show the current row through the
   selection instead; focusable buttons/checkboxes swap the dotted rect
   for a solid theme-accent ring. `outline` (not `border`) is used on
   purpose: it is drawn by the focus-rect primitive, so it still shows on
   buttons whose own #ID rule sets `border` and would out-rank a plain
   QPushButton:focus border. NoFocus buttons (numpads, cards) never get
   focus, so they never show it. */
QAbstractItemView {
    outline: 0;
}

QPushButton:focus, QToolButton:focus {
    outline: 2px solid #0D6EFD;
}

QCheckBox:focus, QRadioButton:focus {
    outline: 1px solid #0D6EFD;
}

/* Accent-filled buttons: an accent ring would vanish into the fill. */
QPushButton[class="accent"]:focus,
QPushButton#BtnSearchSelect:focus,
#RunReportBtn:focus,
QPushButton#CreditAddBtn:focus,
QPushButton#CreditPayBtn:focus,
QPushButton#PayablePayBtn:focus,
QPushButton#DocNewQuotationBtn:focus,
QPushButton#DocConvertBtn:focus,
QPushButton#PriceListAddBtn:focus,
QPushButton#PMCardBtn[class="accent"]:focus,
QPushButton#SaleHistoryReprint:focus {
    outline-color: #FFFFFF;
}

/* Primary Action Button (Green) */
QPushButton#BtnSave, QPushButton#PayBtn, QPushButton[class="primary"] {
    background-color: #198754;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnSave:hover, QPushButton#PayBtn:hover, QPushButton[class="primary"]:hover {
    background-color: #157347;
}

/* Danger Button (Red) */
QPushButton#BtnCancel, QPushButton#VoidBtn, QPushButton[class="danger"] {
    background-color: #DC3545;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnCancel:hover, QPushButton#VoidBtn:hover, QPushButton[class="danger"]:hover {
    background-color: #BB2D3B;
}

/* Accent Button -- was #0099CC, matching neither the dark theme's
   #00BCEB nor CLAUDE.md's documented light accent (#0D6EFD) */
QPushButton[class="accent"] {
    background-color: #0D6EFD;
    color: #FFFFFF;
    border: none;
    font-weight: bold;
}

QPushButton[class="accent"]:hover {
    background-color: #0B5ED7;
}

/* Secondary Button (neutral -- dismiss/close/utility actions). Was
   transparent with a border close to the surface colour, so it read as
   plain text or as disabled (#561). A visible fill + border keeps it
   recognisable as a button without hovering. */
QPushButton[class="secondary"] {
    background-color: #E9ECEF;
    color: #212529;
    border: 1px solid #CED4DA;
}

QPushButton[class="secondary"]:hover {
    background-color: #DEE2E6;
    border: 1px solid #ADB5BD;
}

QPushButton[class="secondary"]:pressed {
    background-color: #CED4DA;
}

QPushButton[class="secondary"]:disabled {
    background-color: #F1F3F5;
    color: #ADB5BD;
    border: 1px solid #DEE2E6;
}

/* Warning Button (Yellow) */
QPushButton[class="warning"] {
    background-color: #FFC107;
    color: #212529;
    border: none;
}

/* --- Dialog Label Classes --- */
QLabel[class="dialog-title"] {
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}

/* The one muted/secondary-text rule (a later one-line duplicate used to
   override this). 13px + >=4.5:1 contrast so Sinhala/Tamil hints stay
   readable (#566). */
QLabel[class="muted"] {
    color: #5C636A;
    font-size: 13px;
    background: transparent;
}

QLabel[class="debit"] {
    font-weight: bold;
    color: #DC3545;
    background: transparent;
}

QLabel[class="credit"] {
    font-weight: bold;
    color: #198754;
    background: transparent;
}

QLabel[class="bold"] {
    font-weight: bold;
    background: transparent;
}

QLabel[class="transparent"] {
    background: transparent;
}

/* Lists, Tables & Trees -- QTreeWidget/QTreeView used to be missing
   here, so a tree with alternating rows fell back to the native
   (white) alternate base under the theme's text color (#567). */
QListWidget, QTableWidget, QTreeWidget, QTreeView {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;

    gridline-color: #F1F3F5;
    alternate-background-color: #F8F9FA;
}

QListWidget::item, QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #F1F3F5;
}

/* Selection = background + text color only. A border here (it used to
   be border-left: 4px) is drawn on *every* cell of the row and eats
   width that ResizeToContents columns don't have, eliding the very row
   the user is acting on (#568). */
QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #E3F2FD; /* Pale Blue */
    color: #0D6EFD;
}

/* Trees: compact items (the 12px list/table padding is too tall for a
   hierarchy), a visible selection, and a deeper indent so children read
   as children. ::branch is deliberately not styled -- any ::branch rule
   makes Qt stop drawing the native expand arrows. */
QTreeView {
    qproperty-indentation: 24;
}

QTreeView::item {
    padding: 6px;
    border: none;
}

QTreeView::item:hover {
    background-color: #F1F3F5;
}

QTreeView::item:selected {
    background-color: #E3F2FD;
    color: #0D6EFD;
}

/* Table headers (#554): ONE app-wide look -- accent text over an accent
   underline. Do not add per-table QHeaderView::section rules; a scoped
   rule outranks this one and silently forks the look again. The only
   deliberate exceptions are QCalendarWidget's day-name row (above) and
   vertical row-number headers (below). Text is #0B5ED7, not the #0D6EFD
   accent: #0D6EFD on #F8F9FA is 4.3:1, under WCAG AA; #0B5ED7 is 5.5:1.
   Numeric columns right-align their header in code (TextAlignmentRole),
   not here -- QSS has no per-column selector. */
QHeaderView::section {
    background-color: #F8F9FA;
    color: #0B5ED7;
    font-weight: bold;
    font-size: 12px;
    padding: 6px 8px;
    border: none;
    border-bottom: 2px solid #0D6EFD;
}

/* Row-number headers: a blue underline under every row would be noise. */
QHeaderView::section:vertical {
    color: #495057;
    font-weight: normal;
    border-bottom: 1px solid #E9ECEF;
}

QTableCornerButton::section {
    background-color: #F8F9FA;
    border: none;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #F8F9FA;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #ADB5BD;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #F8F9FA;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #ADB5BD;
    min-width: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #868E96;
}

/* Without this the page areas either side of the handle can fall back
   to the native (patterned) track on Windows. */
QScrollBar::add-page, QScrollBar::sub-page {
    background: none;
}

/* Tooltips -- no rule existed, so every tooltip used the OS's native
   pale-yellow look regardless of theme (#567). */
QToolTip {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #CED4DA;
    padding: 6px 8px;
}

/* Multi-line text inputs and progress bars had no base rule (#567). */
QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 6px;
    selection-background-color: #0D6EFD;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #0D6EFD;
    background-color: #F8F9FA;
}

QProgressBar {
    background-color: #E9ECEF;
    color: #212529;
    border: 1px solid #DEE2E6;
    border-radius: 4px;
    text-align: center;
    min-height: 18px;
}

QProgressBar::chunk {
    background-color: #0D6EFD;
    border-radius: 3px;
}

/* ScrollArea Transparency Fix */
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #DEE2E6;
    background-color: #FFFFFF;
}

/* Same shape as Dark: bordered inactive tabs with hover feedback (#571). */
QTabBar::tab {
    background: #E9ECEF;
    color: #495057;
    border: 1px solid #DEE2E6;
    border-bottom: none;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:hover:!selected {
    background: #DEE2E6;
    color: #212529;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #0D6EFD;
    font-weight: bold;
    border-bottom: 2px solid #0D6EFD;
}

/* Group Box */
QGroupBox {
    border: 1px solid #DEE2E6;
    border-radius: 4px;
    margin-top: 20px;
    font-weight: bold;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #0D6EFD;
}

/* --- FIX: Force Transparency for Labels & Checkboxes inside GroupBoxes --- */
QGroupBox QLabel {
    background-color: transparent;
    color: #212529;
}

QGroupBox QCheckBox {
    background-color: transparent;
    color: #212529;
}

/* --- Sidebar --- */
/* Sidebar Container - Light Mode */
QFrame#SidebarContainer,
QFrame#Sidebar {
    background-color: #FFFFFF;  /* White Background */
    border-right: 1px solid #DEE2E6;  /* Subtle separator */
}

/* Sidebar Container Text - Dark for Light Mode */
QWidget#SidebarContainer QLabel,
QWidget#SidebarContainer QPushButton {
    color: #212529;  /* Dark Text for Light Mode */
}

/* User Profile Section - Light Mode (KILL THE LINES) */
QWidget#UserProfileContainer {
    background-color: transparent;  /* Blend with sidebar */
    border: none;  /* Remove all borders */
    border: none;  /* Remove focus outline */
}

/* ── POS Side Menu (Hamburger Panel) ─ Light ───────────────────── */
QWidget#POSSideMenu {
    background-color: #FFFFFF;
    border-left: 1px solid #E0E0E0;
}

QWidget#POSSideMenu QLabel {
    background-color: transparent;
    color: #333333;
}

QWidget#POSSideMenu QFrame[frameShape="4"] {
    background-color: #E8E8E8;
}

/* Section Header */
QLabel#MenuSectionHeader {
    color: #AAAAAA;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    background: transparent;
}

/* Nav Tiles — 2-column grid */
QPushButton#NavTile {
    background-color: #F0F2F5;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QPushButton#NavTile:hover {
    background-color: #E9ECEF;
    border-color: #0D6EFD;
}

QPushButton#NavTile[active="true"] {
    background-color: rgba(13, 110, 253, 0.08);
    border-color: #0D6EFD;
}

/* pt scales with DPI (px doesn't) — #207 */
QLabel#NavTileText {
    font-size: 9pt;
}

/* User Profile Row */
QWidget#UserProfileRow {
    background-color: rgba(0, 0, 0, 0.02);
}

QLabel#MenuUsername {
    color: #111111;
    font-size: 14px;
    font-weight: bold;
    background: transparent;
}

QLabel#MenuRole {
    color: #888888;
    font-size: 12px;
    font-weight: normal;
    background: transparent;
}

/* Sign Out button -- one bordered, touch-sized button carrying its own
   icon (#607); hover tints it so the target is obvious. */
QPushButton#SignOutBtn {
    background-color: transparent;
    border: 1px solid rgba(220, 53, 69, 0.35);
    border-radius: 8px;
    color: #555555;
    font-size: 13px;
    font-weight: bold;
    padding: 0 12px;
    min-height: 40px;
}

QPushButton#SignOutBtn:hover {
    background-color: rgba(220, 53, 69, 0.12);
    border-color: #DC3545;
    color: #DC3545;
}

QPushButton#SignOutBtn:pressed {
    background-color: rgba(220, 53, 69, 0.22);
}

/* Icon Buttons (bottom toolbar) */
QPushButton#IconButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
}

QPushButton#IconButton:hover {
    background-color: #F0F0F0;
}

QPushButton#IconButton:pressed {
    background-color: #E0E0E0;
}

QLabel#SidebarLogo {
    color: #111827;
    font-weight: bold;
    font-size: 20px;  /* Larger for better visibility */
}

QToolButton#SidebarToggle {
    border: none;
    background: transparent;
}

/* Sidebar section break -- a resting point between groups of nav items
   (operational screens vs. management/admin ones), instead of one flat,
   undifferentiated 10-item list (#315). The divider line stays visible
   in collapsed mode; the label text hides (no room for it, see
   CollapsibleSidebar._update_all_styles). */
QFrame#SidebarSectionDivider {
    background-color: #E5E7EB;
    border: none;
    margin: 6px 16px 0 16px;
}

QLabel#SidebarSectionLabel {
    color: #9CA3AF;
    font-size: 10px;
    font-weight: bold;
    padding: 6px 20px 4px 20px;
    background: transparent;
}

/* Sidebar Buttons -- a floating rounded pill (inset margin + radius)
   instead of a flat, edge-to-edge square with a hairline accent bar. */
QToolButton#SidebarButton {
    background-color: transparent;
    color: #6B7280;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding-left: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin: 1px 10px;
    min-height: 36px;
    font-size: 15px;  /* Slightly larger for readability */
    font-weight: normal;
}

QToolButton#SidebarButton:hover {
    background-color: #F3F4F6;
    color: #111827;
}

QToolButton#SidebarButton:checked, QToolButton#SidebarButton[active="true"] {
    background-color: rgba(13, 110, 253, 0.10);
    color: #0D6EFD;
    font-weight: bold;
}

/* Collapsed State (via Property) */
QToolButton#SidebarButton[collapsed="true"] {
    padding-left: 0px;
    padding-right: 0px;
    text-align: center;
    margin: 1px 10px;
}

/* Bottom "exit cluster" divider -- pulls POS/Logout visually away from
   the nav list above, so they read as two consequential actions rather
   than two more rows in the same list. */
QFrame#SidebarBottomDivider {
    background-color: #E5E7EB;
    border: none;
    margin: 0 16px;
}

/* Special Sidebar Buttons -- rounded, tinted action chips instead of a
   flat full-width bar (BtnPos) or a centered outlined block (BtnLogout),
   so both read as the same family of "exit cluster" action. */
QToolButton#BtnPos {
    color: #198754;
    background-color: rgba(25, 135, 84, 0.08);
    border: 1px solid rgba(25, 135, 84, 0.35);
    border-radius: 8px;
    min-height: 40px;
    text-align: left;
    padding-left: 16px;
    margin: 4px 10px;
    font-weight: bold;
}

QToolButton#BtnPos:hover {
    background-color: rgba(25, 135, 84, 0.16);
}

QToolButton#BtnPos[collapsed="true"] {
    text-align: center;
    padding-left: 0px;
    margin: 4px 10px;
}

QToolButton#BtnLogout {
    color: #DC3545;
    background-color: rgba(220, 53, 69, 0.08);
    border: 1px solid rgba(220, 53, 69, 0.35);
    border-radius: 8px;
    min-height: 40px;
    text-align: left;
    padding-left: 16px;
    margin: 4px 10px 8px 10px;
    font-weight: bold;
}

QToolButton#BtnLogout:hover {
    background-color: rgba(220, 53, 69, 0.16);
}

QToolButton#BtnLogout[collapsed="true"] {
    text-align: center;
    padding-left: 0px;
    margin: 4px 10px 8px 10px;
}

/* --- Sales View Specifics --- */

/* ===== 1. TOP HEADER BAR (Brand Anchor - Dark Navy in Light Mode) ===== */
QWidget#HeaderWidget {
    background-color: #001F3F;  /* Dark Navy */
    border-bottom: 2px solid #00BCEB;  /* Cyan Accent Line */
}

/* Labels/Icons inside Header - White text on Navy */
QWidget#HeaderWidget QLabel,
QWidget#HeaderWidget QPushButton {
    color: white;  /* White text on Navy */
    background: transparent;
}

QWidget#HeaderWidget QToolButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
    color: white;
}

QWidget#HeaderWidget QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

QLabel#LogoLabel {
    color: #00BCEB;  /* Cyan brand logo */
    font-weight: bold;
    font-size: 16px;
    background: transparent;
}

QLabel#HeaderLogo {
    background: transparent;
}

QLabel#ItemCountLabel {
    color: #666666;
    font-size: 13px;
    background: transparent;
}

QLabel#EmptyCartLabel, QLabel#EmptyTableLabel {
    color: #AAAAAA;
    font-size: 16px;
    background: transparent;
    padding: 40px;
}

/* EmptyStateWidget's own layout already centers and spaces its icon/
   title/subtitle, so these carry no padding of their own (unlike the
   plain-label overlays above, which relied on padding to keep text off
   the container's edges). */
QLabel#EmptyStateIcon {
    background: transparent;
}

QLabel#EmptyStateTitle {
    color: #AAAAAA;
    font-size: 16px;
    background: transparent;
}

QLabel#EmptyStateSubtitle {
    color: #6C757D;
    font-size: 13px;
    background: transparent;
    padding: 0 40px;
}

/* ===== 5. SEARCH BAR & FILTER BUTTONS ===== */
QWidget#SearchWidget {
    background-color: transparent;
}

/* Search Input Field */
QWidget#SearchWidget QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #DEE2E6;
    border-radius: 4px;
    color: #212529;
    padding: 8px;
    font-size: 14px;
}

QWidget#SearchWidget QLineEdit:focus {
    border: 2px solid #00BCEB;  /* Cyan Focus */
}

/* Filter Buttons (*, |||, #) */
QToolButton#SearchModeBtn {
    background-color: #F8F9FA;
    color: #495057;
    border: 1px solid #DEE2E6;
    border-radius: 4px;
}

QToolButton#SearchModeBtn:hover {
    background-color: #E9ECEF;
    color: #212529;
}

QToolButton#SearchModeBtn:checked {
    background-color: #001F3F;  /* Navy Active */
    color: white;
    border: 1px solid #001F3F;
    font-weight: bold;
}

/* ===== 4. PRODUCT TABLE (Cart Table - Readability) ===== */
QTableWidget#CartTable {
    background-color: #FFFFFF;
    gridline-color: #F1F3F5;
}

QTableWidget#CartTable::item {
    color: #212529;
}

QTableWidget#CartTable::item:selected {
    background-color: #E3F2FD;
    color: #0D6EFD;
}

QLabel[class="StrikethroughPrice"] {
    background-color: transparent;
    color: #DC3545;
}

QLabel#UndoToast {
    background-color: rgba(255, 255, 255, 0.96);
    color: #0D6EFD;
    border: 1px solid #0D6EFD;
    border-radius: 6px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: bold;
}

/* No-receipt-printer notice on the Sales screen (#623) */
QFrame#PrinterNotice {
    background-color: #FFF3CD;
    border-bottom: 1px solid #FFC107;
}
QLabel#PrinterNoticeText {
    color: #664D03;
    font-size: 13px;
    background: transparent;
}
QPushButton#PrinterNoticeSetupBtn {
    background-color: transparent;
    color: #664D03;
    border: 1px solid #997404;
    border-radius: 4px;
    padding: 4px 12px;
    font-weight: bold;
}
QPushButton#PrinterNoticeSetupBtn:hover {
    background-color: rgba(255, 193, 7, 0.25);
}
QToolButton#PrinterNoticeCloseBtn {
    background: transparent;
    color: #664D03;
    border: none;
    padding: 4px 8px;
}
QToolButton#PrinterNoticeCloseBtn:hover {
    color: #212529;
}

/* Total Widget */
QWidget#TotalWidget {
    background-color: #F1F3F5;
    border-top: 1px solid #DEE2E6;
    border-radius: 0px;
}

QWidget#TotalWidget QLabel {
    background: transparent;
}

QLabel#SubtotalLabel, QLabel#TaxLabel, QLabel#DiscountLabel {
    color: #495057;
    font-size: 14px;
    background: transparent;
}

QLabel#TotalLabel {
    font-size: 48px;
    font-weight: bold;
    color: #198754;
    background: transparent;
}

QLabel#TotalLabel[compact="true"] {
    font-size: 36px;
}

/* Action Panel */
QWidget#ActionPanel {
    background-color: #FFFFFF;
    border-left: 1px solid #DEE2E6;
}

QWidget#ActionPanel QLabel {
    background: transparent;
}

/* ===== 2. CUSTOMER PANEL (Matching the Header) ===== */
/* Section Headers */
QLabel#ActionSectionLabel {
    color: #212529;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
    padding-left: 2px;
}

QLabel#CustTitle {
    color: #1A1A1A;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}

QFrame#CustomerPanel {
    background-color: #FFFFFF;
    border: 1px solid #D0D5DB;
    border-radius: 8px;
}

QFrame#CustomerPanel QLabel {
    color: #1A1A1A;
    background: transparent;
}

QLabel#CustomerLabel {
    font-weight: bold;
    font-size: 14px;
    color: #1A1A1A;
    background: transparent;
}

/* The "SELECT" Button inside Customer Panel */
QPushButton#BtnCustomerSelect {
    background-color: #00BCEB;  /* Cyan Button */
    color: white;
    border: none;
    border-radius: 3px;
    font-weight: bold;
    padding: 5px;
}

QPushButton#BtnCustomerSelect:hover {
    background-color: #00A8D6;  /* Slightly darker cyan */
}

QPushButton#BtnCustomerSelect:pressed {
    background-color: #0096C7;
}

QFrame#PointsDivider {
    background-color: #E2E5EA;
    border: none;
}

/* Without this, the row paints Qt's global QWidget background
   (#F8F9FA) instead of letting CustomerPanel's own white surface show
   through, showing up as a separate off-white block under the points
   row. */
QWidget#PointsRow {
    background: transparent;
}

/* No fill/border at all -- plain colored text on the card's own white
   surface, matching how every other label in this panel is styled,
   instead of a separate highlighted badge box. */
QFrame#CustomerPanel QLabel#PointsLabel {
    color: #946200;  /* Amber accent, readable on the light card surface */
    font-weight: bold;
    font-size: 12px;
    background: transparent;
}

QPushButton#BtnCustomerClear {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    color: #6C757D;
}

QPushButton#BtnCustomerClear:hover {
    background-color: #E9ECEF;
    color: #DC3545;
}

/* ===== 3. ACTION BUTTONS (Light theme) ===== */
QPushButton#ActionGridBtn {
    background-color: #EDF0F4;
    color: #1A1A1A;
    border: 1px solid #D0D5DB;
    border-radius: 6px;
    padding: 0px;
}

QPushButton#ActionGridBtn:hover {
    background-color: #DEE3EA;
    border-color: #0D6EFD;
}

QPushButton#ActionGridBtn:pressed {
    background-color: #0D6EFD;
    color: #FFFFFF;
}

/* pt scales with DPI (px doesn't) — #207: these were inline px in Python,
   invisible at 150-200% Windows scaling. */
QPushButton#ActionGridBtn QLabel#lblText {
    font-size: 9pt;
    font-weight: 500;
}

QPushButton#ActionGridBtn QLabel#lblShortcut {
    font-size: 7pt;
}

/* Color accents — bottom border */
QPushButton#ActionGridBtn[btnColor="#FFDC00"] { border-bottom: 2px solid #FFC107; }
QPushButton#ActionGridBtn[btnColor="#FF4136"] { border-bottom: 2px solid #DC3545; }

QPushButton#ActionGridBtn:pressed QLabel,
QPushButton#ActionGridBtn:pressed QLabel#lblText,
QPushButton#ActionGridBtn:pressed QLabel#lblShortcut {
    color: #FFFFFF;
}

/* Pay Button */
QPushButton#BtnPay {
    background-color: #198754;
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    border: none;
    border-radius: 8px;
}

QPushButton#BtnPay:hover {
    background-color: #157347;
}

QPushButton#BtnPay:pressed {
    background-color: #0F5132;
}

/* Brief flash when PAY is clicked on an empty cart (#209) */
QPushButton#BtnPay[state="error"] {
    background-color: #DC3545;
    border: 2px solid #B02A37;
}

/* Dashboard Cards */
QWidget#InfoCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QLabel#InfoCardTitle {
    font-size: 12px;
    color: #6C757D;
}

/* Settings View — sidebar uses SidebarContainer + SidebarButton (shared with Management) */
QWidget#SettingsContent {
    background-color: #FFFFFF;
    color: #212529;
}

/* Settings Content Area - Improved Input Styling */
QWidget#SettingsContent QLineEdit,
QWidget#SettingsContent QComboBox,
QWidget#SettingsContent QSpinBox,
QWidget#SettingsContent QDoubleSpinBox,
QWidget#SettingsContent QTextEdit {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding-left: 10px;
    min-height: 32px;
    font-size: 14px;
}

QWidget#SettingsContent QLineEdit:focus,
QWidget#SettingsContent QComboBox:focus,
QWidget#SettingsContent QSpinBox:focus,
QWidget#SettingsContent QDoubleSpinBox:focus,
QWidget#SettingsContent QTextEdit:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

/* Settings Form Labels */
QWidget#SettingsContent QLabel {
    color: #495057;
    font-size: 14px;
}

/* The rule above (#ID-scoped) out-ranks the shared muted/warning-hint
   classes, which turned every Settings hint -- including the tax
   warning -- into plain body text (#566). */
QWidget#SettingsContent QLabel[class="muted"] {
    color: #5C636A;
    font-size: 13px;
}

QWidget#SettingsContent QLabel[class="warning-hint"] {
    color: #B02A37;
    font-size: 12px;
}

/* Hardware test passed (Settings -> Hardware Test Print / Open Drawer, #624) */
QWidget#SettingsContent QLabel[class="success-hint"] {
    color: #146C43;  /* #198754 is only ~4.5:1 on #F8F9FA at 12px */
    font-size: 12px;
}

/* Disabled state (#564). Once a stylesheet styles an input, Qt stops
   drawing its native greyed-out look, so a disabled spinbox/combo/check
   looked fully editable. The SettingsContent copies are needed because
   that #ID-scoped input rule above out-ranks the generic ones. */
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled,
QDateEdit:disabled,
QTimeEdit:disabled,
QDateTimeEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QWidget#SettingsContent QLineEdit:disabled,
QWidget#SettingsContent QComboBox:disabled,
QWidget#SettingsContent QSpinBox:disabled,
QWidget#SettingsContent QDoubleSpinBox:disabled,
QWidget#SettingsContent QTextEdit:disabled {
    background-color: #E9ECEF;
    color: #ADB5BD;
    border: 1px solid #DEE2E6;
}

QSpinBox::up-button:disabled, QSpinBox::down-button:disabled,
QDoubleSpinBox::up-button:disabled, QDoubleSpinBox::down-button:disabled,
QComboBox::drop-down:disabled {
    background-color: #E9ECEF;
}

QCheckBox:disabled, QRadioButton:disabled,
QLabel:disabled,
QWidget#SettingsContent QLabel:disabled {
    color: #ADB5BD;
}

QCheckBox::indicator:disabled {
    border-color: #CED4DA;
    background-color: #E9ECEF;
}

QCheckBox::indicator:checked:disabled {
    background-color: #ADB5BD;
    border-color: #ADB5BD;
}

QLabel[class="SectionHeader"] {
    font-size: 18px;
    font-weight: bold;
    color: #0D6EFD;
    margin-bottom: 20px;
}

QFrame#SettingsFooter {
    background-color: #F8F9FA;
    border-top: 1px solid #DEE2E6;
}

/* --- Dialogs --- */

/* ── Payment Dialog ── */
QDialog#PaymentDialog {
    background-color: #F8F9FA;
    color: #212529;
}

QDialog#PaymentDialog QLabel {
    background: transparent;
    color: #212529;
}

QLabel#PaymentRemainingLabel {
    font-size: 28px;
    color: #DC3545;
    font-weight: bold;
    background-color: rgba(220, 53, 69, 0.06);
    border: 2px solid #DC3545;
    border-radius: 8px;
    padding: 10px;
}

QLabel#PaymentRemainingLabel[state="change"] {
    color: #198754;
    background-color: rgba(25, 135, 84, 0.06);
    border-color: #198754;
}

QLabel#PaymentFieldLabel {
    color: #6C757D;
    font-size: 13px;
    font-weight: bold;
}

QLabel#PaymentMethodLabel {
    font-weight: bold;
    font-size: 18px;
    color: #0D6EFD;
}

QLineEdit#PaymentAmountInput {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #CED4DA;
    border-radius: 6px;
    padding: 8px;
    font-size: 28px;
}

QLineEdit#PaymentAmountInput:focus {
    border-color: #0D6EFD;
}

QComboBox#PaymentCustomerCombo {
    font-size: 14px;
    padding: 5px;
    color: #212529;
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
}

QPushButton#BtnAddPayment {
    background-color: #E9ECEF;
    color: #212529;
    font-weight: bold;
    font-size: 14px;
    padding: 10px;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

QPushButton#BtnAddPayment:hover {
    background-color: #DEE2E6;
    border-color: #0D6EFD;
}

QListWidget#PaymentList {
    font-size: 14px;
    color: #212529;
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

/* Overrides the generic "QListWidget::item, QTableWidget::item { padding:
   12px; border-bottom: 1px; }" rule above for this specific list. That
   box model is applied by the view AFTER setSizeHint() already reserved
   a rect for the row, invisible to the Python layout code -- it was
   insetting the embedded row widget by 12+12+1=25px inside whatever
   height setSizeHint() reserved, squeezing a 61px-tall row down to a
   36px-tall widget and badly clipping both the remove button and the
   row's own text. The separator is a real child widget inside the row
   now (see PaymentListItemSeparator), so this list needs none of the
   generic rule's own decoration. */
QListWidget#PaymentList::item {
    padding: 0;
    border-bottom: none;
}

QWidget#PaymentListItemWidget, QWidget#PaymentListItemRow {
    background: transparent;
}

QFrame#PaymentListItemSeparator {
    background-color: #F0F0F0;
}

QLabel#PaymentListItemLabel {
    color: #212529;
    font-size: 14px;
    background: transparent;
}

QPushButton#BtnRemovePayment {
    background-color: transparent;
    border: 1px solid #DC3545;
    border-radius: 6px;
    padding: 4px;
}

QPushButton#BtnRemovePayment:hover {
    background-color: rgba(220, 53, 69, 0.15);
    border-color: #BB2D3B;
}

QFrame#PaymentSeparator {
    background-color: #DEE2E6;
    max-height: 1px;
}

QPushButton#BtnFinishSale {
    background-color: #E9ECEF;
    color: #6C757D;
    font-size: 16px;
    font-weight: bold;
    border: none;
    border-radius: 8px;
}

QPushButton#BtnFinishSale:enabled {
    background-color: #198754;
    color: #FFFFFF;
}

QPushButton#BtnFinishSale:enabled:hover {
    background-color: #157347;
}

QLabel#PaymentMethodsHeader {
    font-size: 13px;
    font-weight: bold;
    color: #6C757D;
    letter-spacing: 1px;
}

/* Payment Method Buttons */
QPushButton#PayMethodBtn {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    padding: 0px;
}

QPushButton#PayMethodBtn:hover {
    background-color: #E9ECEF;
    border-color: #0D6EFD;
}

QPushButton#PayMethodBtn[selected="true"] {
    border: 2px solid #0D6EFD;
    background-color: #F0F4FF;
}

QPushButton#PayMethodBtn[methodType="cash"] {
    background-color: #198754;
    border-color: #198754;
}

QPushButton#PayMethodBtn[methodType="cash"]:hover {
    background-color: #157347;
}

QPushButton#PayMethodBtn[methodType="cash"][selected="true"] {
    border: 2px solid #146C43;
}

QPushButton#PayMethodBtn QLabel#PayMethodShortcut {
    color: #6C757D;
    font-size: 9px;
    font-weight: normal;
    background: transparent;
}

QPushButton#PayMethodBtn QLabel#PayMethodName {
    color: #212529;
    font-size: 13px;
    font-weight: bold;
    background: transparent;
}

QPushButton#PayMethodBtn[methodType="cash"] QLabel#PayMethodName,
QPushButton#PayMethodBtn[methodType="cash"] QLabel#PayMethodShortcut {
    color: #FFFFFF;
}

/* ── Advanced Search Dialog ── */
QDialog#AdvancedSearchDialog {
    background-color: #F8F9FA;
    color: #212529;
}

QDialog#AdvancedSearchDialog QLabel {
    background: transparent;
    color: #212529;
}

QLabel#AdvSearchTitle {
    font-size: 20px;
    font-weight: bold;
    color: #212529;
}

QLabel#SearchFilterLabel {
    color: #6C757D;
    font-size: 14px;
}

QLabel#SearchResultCount {
    color: #6C757D;
    font-size: 13px;
}

QTableWidget#SearchResultsTable {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    gridline-color: #DEE2E6;
    color: #212529;
}

QTableWidget#SearchResultsTable::item:selected {
    background-color: rgba(13, 110, 253, 0.15);
}

QPushButton#BtnSearchSelect {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
}

QPushButton#BtnSearchSelect:hover {
    background-color: #0B5ED7;
}

/* Quantity Dialog */
QDialog#QuantityDialog, QDialog#VoidReasonDialog, QDialog#BackupPasswordDialog {
    background-color: #FFFFFF;
}

QLabel#QtyProductName {
    color: #212529;
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}

QLineEdit#QtyInput {
    background-color: #F8F9FA;
    color: #212529;
    font-size: 24px;
    font-weight: bold;
    border: 2px solid #CED4DA;
    border-radius: 6px;
    padding: 8px;
}

QLineEdit#QtyInput:focus {
    border: 2px solid #0D6EFD;
}

/* Discount Dialog */
QDialog#DiscountDialog {
    background-color: #FFFFFF;
    color: #212529;
}

QDialog#DiscountDialog QLabel[class="dialog-title"] {
    font-size: 18px;
    font-weight: bold;
    color: #212529;
    padding: 0 0 4px;
}

QFrame#DiscountTypeFrame {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 6px;
}

/* Checkable QPushButtons, not QRadioButtons -- see discount_dialog.py.
   QPushButton centers its own text, which a segmented control needs. */
QPushButton#RbPercent, QPushButton#RbFixed {
    background-color: transparent;
    color: #212529;
    font-size: 15px;
    font-weight: bold;
    padding: 10px 12px;
    border: none;
    border-radius: 4px;
}

QPushButton#RbPercent:hover, QPushButton#RbFixed:hover {
    background-color: rgba(13, 110, 253, 0.08);
}

QPushButton#RbPercent:checked, QPushButton#RbFixed:checked {
    background-color: #0D6EFD;
    color: #FFFFFF;
}

QDoubleSpinBox#DiscountValueInput {
    font-size: 36px;
    font-weight: bold;
    padding: 12px;
    border: 2px solid #0D6EFD;
    border-radius: 8px;
    background-color: #FFFFFF;
    color: #212529;
    min-height: 50px;
}

QDoubleSpinBox#DiscountValueInput::up-button,
QDoubleSpinBox#DiscountValueInput::down-button {
    width: 0px;
}

QPushButton[class="PresetBtn"] {
    background-color: #F8F9FA;
    color: #0D6EFD;
    font-weight: bold;
    font-size: 15px;
    border: 1px solid #0D6EFD;
    border-radius: 6px;
    padding: 8px;
}

QPushButton[class="PresetBtn"]:hover {
    background-color: #E7F1FF;
}

QPushButton[class="PresetBtn"]:pressed {
    background-color: #0D6EFD;
    color: white;
}

QPushButton[class="PresetBtn"]:disabled {
    background-color: #F0F0F0;
    color: #AAA;
    border-color: #DDD;
}

/* Scoped to DiscountDialog specifically -- #BtnCancel is a shared object name
   used by several other dialogs, which already get the solid "Danger" style
   above. An unscoped rule here would collide with those (and, before the
   :not() selector elsewhere in this file was fixed to be valid CSS, a stray
   parse failure happened to mask this collision by accident). */
QDialog#DiscountDialog QPushButton#BtnCancel {
    background-color: transparent;
    color: #DC3545;
    font-weight: bold;
    font-size: 15px;
    border: 2px solid #DC3545;
    border-radius: 6px;
}

QDialog#DiscountDialog QPushButton#BtnCancel:hover {
    background-color: #DC3545;
    color: white;
}

QPushButton#BtnApplyDiscount {
    background-color: #198754;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 15px;
    border: none;
    border-radius: 6px;
}

QPushButton#BtnApplyDiscount:hover {
    background-color: #157347;
}

QPushButton#BtnApplyDiscount:pressed {
    background-color: #0F5132;
}

/* Customer Editor */
QDialog#CustomerEditor, QDialog#CustomerQuickAddDialog {
    background-color: #FFFFFF;
    color: #212529;
}

/* ── Receipt Options Dialog — Light ─────────────────────────────── */
QDialog#ReceiptOptionsDialog {
