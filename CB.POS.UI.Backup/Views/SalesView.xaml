<Page
    x:Class="CB.POS.UI.Views.SalesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <TextBlock Text="Sales View" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Page>
                        <TextBox x:Name="BarcodeInput"
                                 Text="{x:Bind ViewModel.InputBarcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Scan Barcode... [F1]"
                                 FontSize="22"
                                 KeyDown="OnBarcodeKeyDown"
                                 VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" 
                                   Orientation="Horizontal" 
                                   Spacing="8"
                                   Margin="12,0,0,0">
                            <FontIcon Glyph="&#xE721;" 
                                     FontSize="24"
                                     Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="F1" 
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Cart Items ListView -->
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.CartItems, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedCartItem, Mode=TwoWay}"
                          SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="dto:CartItemDto">
                            <Grid Padding="16,12" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Product Name (Left) -->
                                <TextBlock Grid.Column="0"
                                          Text="{x:Bind ProductName}"
                                          FontSize="20"
                                          FontWeight="Bold"
                                          VerticalAlignment="Center"
                                          TextWrapping="NoWrap"
                                          TextTrimming="CharacterEllipsis" />

                                <!-- Quantity x Price = Total (Right) -->
                                <StackPanel Grid.Column="1" 
                                           Orientation="Horizontal" 
                                           Spacing="16"
                                           VerticalAlignment="Center">
                                    <TextBlock FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="{x:Bind Quantity}" />
                                        <Run Text="x" />
                                        <Run Text="{x:Bind UnitPrice}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind TotalPrice}" 
                                              FontSize="20" 
                                              FontWeight="Bold" 
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              Width="80"
                                              TextAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                
                <!-- Action Bar (Bottom of Left Column) -->
                <Border Grid.Row="2" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Void Item [Del]" 
                                    Command="{x:Bind ViewModel.VoidItemCommand}"
                                    Style="{StaticResource DefaultButtonStyle}" />
                            <Button Content="Clear Cart" 
                                    Command="{x:Bind ViewModel.ClearCartCommand}"
                                    Style="{StaticResource DefaultButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT COLUMN: Totals & Payment -->
        <Border Grid.Column="1"
                CornerRadius="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Bill Details -->
                <StackPanel Grid.Row="0" Padding="24" Spacing="16">
                    <TextBlock Text="Order Summary" 
                              Style="{StaticResource SubtitleTextBlockStyle}" 
                              Margin="0,0,0,16"/>

                    <Grid>
                        <TextBlock Text="Subtotal" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.SubTotal, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right"/>
                    </Grid>
                    
                    <Grid>
                        <TextBlock Text="Tax (5%)" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.TaxAmount, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right"/>
                    </Grid>
                    
                    <MenuFlyoutSeparator />
                    
                    <Grid>
                        <TextBlock Text="TOTAL" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="{x:Bind ViewModel.GrandTotal, Mode=OneWay}" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource SystemFillColorSuccessBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>

                <!-- Payment Buttons -->
                <StackPanel Grid.Row="1" Padding="24" Spacing="12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <Button Content="CASH PAYMENT [F5]" 
                            Command="{x:Bind ViewModel.CheckoutCommand}"
                            Style="{StaticResource AccentButtonStyle}" 
                            HorizontalAlignment="Stretch" 
                            Height="60" 
                            FontSize="20" 
                            FontWeight="Bold"
                            CornerRadius="4"/>
                            
                    <Button Content="CARD PAYMENT" 
                            HorizontalAlignment="Stretch" 
                            Height="48" 
                            FontSize="16"
                            CornerRadius="4"/>
                            
                    <Button Content="UPI / QR" 
                            HorizontalAlignment="Stretch" 
                            Height="48" 
                            FontSize="16"
                            CornerRadius="4"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
