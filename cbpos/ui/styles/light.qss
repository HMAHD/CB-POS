/* 
    Ceylon Byte POS - Enterprise Light Theme 
    Palette:
    - Background: #F8F9FA (Global BG) / #FFFFFF (Surface)
    - Text: #212529 (Primary) / #495057 (Secondary)
    - Border: #DEE2E6
    - Accent: #0D6EFD (Bootstrap Blue)
    - Success: #198754 (Bootstrap Green)
    - Warning: #FFC107
    - Error: #DC3545
*/

/* Global Font Enforcement */
* {
    font-family: "{{FONT_FAMILY}}", "Noto Sans", "Segoe UI", "Arial";
}

QLabel.PlaceholderLabel {
    color: #6C757D;
}

QLabel.AboutLabel {
    font-size: 16px;
    color: #495057;
}

/* Global Reset */
QWidget {
    background-color: #F8F9FA;
    color: #212529;
    font-size: 14px;
}

/* Inputs - Global Baseline */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 8px;
    font-size: 16px;
    color: #212529;
    selection-background-color: #0D6EFD;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

/* ComboBox - Dropdown Selector */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 8px 12px;
    padding-right: 35px;  /* Space for arrow */
    font-size: 14px;
    color: #212529;
    min-height: 32px;
}

QComboBox:hover {
    border: 1px solid #0D6EFD;
    background-color: #F8F9FA;
}

QComboBox:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 30px;
    border-left: 1px solid #CED4DA;  /* Separator line */
    background: #E9ECEF;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

QComboBox::drop-down:hover {
    background: #0D6EFD;  /* Blue background on hover */
}

QComboBox::down-arrow {
    image: url(cbpos/assets/icons/chevron-down-blue.svg);
    width: 14px;
    height: 14px;
}

QComboBox::drop-down:hover QComboBox::down-arrow,
QComboBox:hover::down-arrow {
    image: url(cbpos/assets/icons/chevron-down-white.svg);
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #0D6EFD;
    selection-background-color: #0D6EFD;
    selection-color: #FFFFFF;
    color: #212529;
    padding: 4px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 28px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #E9ECEF;
    color: #0D6EFD;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #0D6EFD;
    color: #FFFFFF;
}

/* SpinBox - Number Input (Modern Touch-Friendly Design) */
QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 8px 12px;
    padding-right: 35px;  /* Space for wider buttons */
    font-size: 14px;
    color: #212529;
    min-height: 36px;  /* Touch-friendly height */
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border: 1px solid #0D6EFD;
    background-color: #F8F9FA;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

/* UP Button (+) - Clear plus icon */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 30px;
    height: 18px;
    border-left: 1px solid #CED4DA;
    border-bottom: 1px solid #CED4DA;
    background-color: #E9ECEF;
    border-top-right-radius: 4px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background-color: #0D6EFD;
}

QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed {
    background-color: #0B5ED7;
}

QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(cbpos/assets/icons/plus-dark.svg);
    width: 12px;
    height: 12px;
}

QSpinBox::up-button:hover::up-arrow, QDoubleSpinBox::up-button:hover::up-arrow {
    image: url(cbpos/assets/icons/plus-white.svg);
}

/* DOWN Button (-) - Clear minus icon */
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 30px;
    height: 18px;
    border-left: 1px solid #CED4DA;
    border-top: 1px solid #CED4DA;
    background-color: #E9ECEF;
    border-bottom-right-radius: 4px;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #0D6EFD;
}

QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background-color: #0B5ED7;
}

QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(cbpos/assets/icons/minus-dark.svg);
    width: 12px;
    height: 12px;
}

QSpinBox::down-button:hover::down-arrow, QDoubleSpinBox::down-button:hover::down-arrow {
    image: url(cbpos/assets/icons/minus-white.svg);
}

/* Checkboxes - Toggle Style with Checkmark */
QCheckBox {
    spacing: 10px;
    color: #212529;
    background-color: transparent;
}

/* Unchecked State - Empty box with visible border */
QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid #ADB5BD;
    border-radius: 4px;
    background-color: transparent;
}

/* Unchecked Hover - Blue glow */
QCheckBox::indicator:unchecked:hover {
    border-color: #0D6EFD;
    background-color: rgba(13, 110, 253, 0.1);
}

/* Checked State - Blue fill with white checkmark */
QCheckBox::indicator:checked {
    background-color: #0D6EFD;
    border-color: #0D6EFD;
    image: url(cbpos/assets/icons/check-white.svg);
}

/* Checked Hover - Darker blue with checkmark */
QCheckBox::indicator:checked:hover {
    background-color: #0B5ED7;
    border-color: #0B5ED7;
    image: url(cbpos/assets/icons/check-white.svg);
}

/* Buttons */
QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding: 10px 20px;
    font-weight: bold;
    color: #495057;
    text-transform: uppercase;
}

QPushButton:hover {
    background-color: #E9ECEF;
    border: 1px solid #ADB5BD;
    color: #212529;
}

QPushButton:pressed {
    background-color: #DEE2E6;
}

/* Primary Action Button (Green) */
QPushButton#BtnSave, QPushButton#PayBtn, QPushButton[class="primary"] {
    background-color: #198754;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnSave:hover, QPushButton#PayBtn:hover, QPushButton[class="primary"]:hover {
    background-color: #157347;
}

/* Danger Button (Red) */
QPushButton#BtnCancel, QPushButton#VoidBtn, QPushButton[class="danger"] {
    background-color: #DC3545;
    color: #FFFFFF;
    border: none;
}

QPushButton#BtnCancel:hover, QPushButton#VoidBtn:hover, QPushButton[class="danger"]:hover {
    background-color: #BB2D3B;
}

/* Accent Button (Cyan) */
QPushButton[class="accent"] {
    background-color: #0099CC;
    color: #FFFFFF;
    border: none;
    font-weight: bold;
}

QPushButton[class="accent"]:hover {
    background-color: #0088B5;
}

/* Warning Button (Yellow) */
QPushButton[class="warning"] {
    background-color: #FFC107;
    color: #212529;
    border: none;
}

/* --- Dialog Label Classes --- */
QLabel[class="dialog-title"] {
    font-size: 16px;
    font-weight: bold;
    background: transparent;
}

QLabel[class="muted"] {
    color: #6C757D;
    background: transparent;
}

QLabel[class="debit"] {
    font-weight: bold;
    color: #DC3545;
    background: transparent;
}

QLabel[class="credit"] {
    font-weight: bold;
    color: #198754;
    background: transparent;
}

QLabel[class="bold"] {
    font-weight: bold;
    background: transparent;
}

QLabel[class="transparent"] {
    background: transparent;
}

/* Lists & Tables */
QListWidget, QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    outline: none;
    gridline-color: #F1F3F5;
    alternate-background-color: #F8F9FA;
}

QListWidget::item, QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #F1F3F5;
    color: #212529;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #E3F2FD; /* Pale Blue */
    color: #0D6EFD;
    border-left: 4px solid #0D6EFD;
}

QHeaderView::section {
    background-color: #E9ECEF; /* Light Gray Header */
    color: #495057;
    padding: 10px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #DEE2E6;
    text-transform: uppercase;
}

QTableCornerButton::section {
    background-color: #E9ECEF;
    border: none;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #F8F9FA;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #ADB5BD;
    min-height: 20px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ScrollArea Transparency Fix */
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #DEE2E6;
    background-color: #FFFFFF;
}

QTabBar::tab {
    background: #E9ECEF;
    color: #495057;
    padding: 10px 20px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #0D6EFD;
    font-weight: bold;
    border-bottom: 2px solid #0D6EFD;
}

/* Group Box */
QGroupBox {
    border: 1px solid #DEE2E6;
    border-radius: 4px;
    margin-top: 20px;
    font-weight: bold;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #0D6EFD;
}

/* --- FIX: Force Transparency for Labels & Checkboxes inside GroupBoxes --- */
QGroupBox QLabel {
    background-color: transparent;
    color: #212529;
}

QGroupBox QCheckBox {
    background-color: transparent;
    color: #212529;
}

/* --- Sidebar --- */
/* Sidebar Container - Light Mode */
QFrame#SidebarContainer,
QFrame#Sidebar {
    background-color: #FFFFFF;  /* White Background */
    border-right: 1px solid #DEE2E6;  /* Subtle separator */
}

/* Sidebar Container Text - Dark for Light Mode */
QWidget#SidebarContainer QLabel,
QWidget#SidebarContainer QPushButton {
    color: #212529;  /* Dark Text for Light Mode */
}

/* User Profile Section - Light Mode (KILL THE LINES) */
QWidget#UserProfileContainer {
    background-color: transparent;  /* Blend with sidebar */
    border: none;  /* Remove all borders */
    outline: none;  /* Remove outline */
}

/* POS Side Menu (Hamburger Menu) - Light Mode */
QWidget#POSSideMenu {
    background-color: #FFFFFF;  /* White background */
    border-left: 1px solid #DEE2E6;  /* Subtle left border */
}

/* POS Side Menu - Labels (Username, Role) */
QWidget#POSSideMenu QLabel {
    background-color: transparent;
    color: #212529;  /* Dark text for light background */
}

/* POS Side Menu - Separator Lines */
QWidget#POSSideMenu QFrame[frameShape="4"] {
    background-color: #DEE2E6;  /* Light gray separator */
}

/* POS Side Menu - Menu Buttons */
QPushButton#MenuButton {
    background-color: transparent;
    color: #212529;
    border: none;
    text-align: left;
    padding-left: 15px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#MenuButton:hover {
    background-color: #F8F9FA;
    color: #0D6EFD;
}

QPushButton#MenuButton[destructive="true"] {
    color: #DC3545;  /* Bootstrap red for destructive actions */
}

QPushButton#MenuButton[destructive="true"]:hover {
    background-color: rgba(220, 53, 69, 0.1);
    color: #DC3545;
}

/* POS Side Menu - Icon Buttons (Bottom Toolbar) */
QPushButton#IconButton {
    background-color: transparent;
    border: none;
    border-radius: 8px;
}

QPushButton#IconButton:hover {
    background-color: #F8F9FA;
}

QPushButton#IconButton:pressed {
    background-color: #E9ECEF;
}

/* POS Side Menu - Username Label */
QLabel#MenuUsername {
    color: #212529;
    font-size: 16px;
    font-weight: bold;
    background-color: transparent;
}

/* POS Side Menu - Role Label */
QLabel#MenuRole {
    color: #6C757D;  /* Muted gray */
    font-size: 13px;
    font-weight: normal;
    background-color: transparent;
}

QLabel#SidebarLogo {
    color: #111827;
    font-weight: bold;
    font-size: 20px;  /* Larger for better visibility */
}

QToolButton#SidebarToggle {
    border: none;
    background: transparent;
}

/* Sidebar Buttons */
QToolButton#SidebarButton {
    background-color: transparent;
    color: #6B7280;
    border: none;
    border-left: 4px solid transparent;
    text-align: left;
    padding-left: 20px;
    font-size: 15px;  /* Slightly larger for readability */
    font-weight: normal;
}

QToolButton#SidebarButton:hover {
    background-color: #F3F4F6;
    color: #111827;
}

QToolButton#SidebarButton:checked, QToolButton#SidebarButton[active="true"] {
    background-color: #EFF6FF;  /* Pale blue */
    color: #0066CC;
    border-left: 4px solid #0066CC;
    font-weight: 600;
}

/* Collapsed State (via Property) */
QToolButton#SidebarButton[collapsed="true"] {
    padding-left: 0px;
    padding-right: 0px;
    text-align: center;
}

/* Special Sidebar Buttons */
QToolButton#BtnPos {
    color: #198754;
    border-top: 1px solid #DEE2E6;
    text-align: left;
    padding-left: 24px;
}

QToolButton#BtnPos:hover {
    background-color: #E8F5E9; /* Pale Green */
}

QToolButton#BtnPos[collapsed="true"] {
    text-align: center;
    padding-left: 0px;
}

/* Sign Out Button - Professional Outlined Design */
QToolButton#BtnLogout {
    color: #DC3545;  /* Bootstrap Red */
    background-color: transparent;
    border: 1px solid #DC3545;  /* Red Border */
    border-radius: 6px;
    padding: 8px 12px;
    margin: 10px 15px;  /* Spacing from edges */
    font-weight: bold;
    text-align: center;  /* Center text */
}

QToolButton#BtnLogout:hover {
    background-color: #DC3545;
    color: white;  /* White text on Red background */
}

QToolButton#BtnLogout[collapsed="true"] {
    text-align: center;
    padding: 8px;
    margin: 10px 10px;
}

/* --- Sales View Specifics --- */

/* ===== 1. TOP HEADER BAR (Brand Anchor - Dark Navy in Light Mode) ===== */
QWidget#HeaderWidget {
    background-color: #001F3F;  /* Dark Navy */
    border-bottom: 2px solid #00BCEB;  /* Cyan Accent Line */
}

/* Labels/Icons inside Header - White text on Navy */
QWidget#HeaderWidget QLabel,
QWidget#HeaderWidget QPushButton {
    color: white;  /* White text on Navy */
    background: transparent;
}

QWidget#HeaderWidget QToolButton {
    background: transparent;
    border: none;
    color: white;
}

QLabel#LogoLabel {
    color: #00BCEB;  /* Cyan brand logo */
    font-weight: bold;
    font-size: 16px;
    background: transparent;
}

/* ===== 5. SEARCH BAR & FILTER BUTTONS ===== */
QWidget#SearchWidget {
    background-color: transparent;
}

/* Search Input Field */
QWidget#SearchWidget QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #DEE2E6;
    border-radius: 4px;
    color: #212529;
    padding: 8px;
    font-size: 14px;
}

QWidget#SearchWidget QLineEdit:focus {
    border: 2px solid #00BCEB;  /* Cyan Focus */
}

/* Filter Buttons (*, |||, #) */
QToolButton#SearchModeBtn {
    background-color: #F8F9FA;
    color: #495057;
    border: 1px solid #DEE2E6;
    border-radius: 4px;
}

QToolButton#SearchModeBtn:hover {
    background-color: #E9ECEF;
    color: #212529;
}

QToolButton#SearchModeBtn:checked {
    background-color: #001F3F;  /* Navy Active */
    color: white;
    border: 1px solid #001F3F;
    font-weight: bold;
}

/* ===== 4. PRODUCT TABLE (Cart Table - Readability) ===== */
QTableWidget#CartTable {
    background-color: #FFFFFF;
    gridline-color: #F1F3F5;
}

QTableWidget#CartTable QHeaderView::section {
    background-color: #E9ECEF;  /* Darker Gray Header */
    color: #212529;  /* Almost Black Text */
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #DEE2E6;
    padding: 8px;
}

QTableWidget#CartTable::item {
    color: #212529;
}

QTableWidget#CartTable::item:selected {
    background-color: #E3F2FD;
    color: #0D6EFD;
}

QLabel[class="StrikethroughPrice"] {
    background-color: transparent;
    color: #DC3545;
}

/* Total Widget */
QWidget#TotalWidget {
    background-color: #F1F3F5;
    border-top: 1px solid #DEE2E6;
    border-radius: 0px;
}

QWidget#TotalWidget QLabel {
    background: transparent;
}

QLabel#SubtotalLabel, QLabel#TaxLabel {
    color: #495057;
    font-size: 14px;
    background: transparent;
}

QLabel#TotalLabel {
    font-size: 48px;
    font-weight: bold;
    color: #198754;
    background: transparent;
}

/* Action Panel */
QWidget#ActionPanel {
    background-color: #FFFFFF;
    border-left: 1px solid #DEE2E6;
}

QWidget#ActionPanel QLabel {
    background: transparent;
}

/* ===== 2. CUSTOMER PANEL (Matching the Header) ===== */
QFrame#CustomerPanel {
    background-color: #001F3F;  /* Dark Navy */
    border: 1px solid #001F3F;
    border-radius: 4px;
}

QFrame#CustomerPanel QLabel {
    color: white;  /* White text */
    background: transparent;
}

QLabel#CustomerLabel {
    font-weight: bold;
    font-size: 14px;
    color: white;  /* White text on Navy */
    background: transparent;
}

/* The "SELECT" Button inside Customer Panel */
QPushButton#BtnCustomerSelect {
    background-color: #00BCEB;  /* Cyan Button */
    color: white;
    border: none;
    border-radius: 3px;
    font-weight: bold;
    padding: 5px;
}

QPushButton#BtnCustomerSelect:hover {
    background-color: #00A8D6;  /* Slightly darker cyan */
}

QPushButton#BtnCustomerSelect:pressed {
    background-color: #0096C7;
}

QLabel#PointsLabel {
    color: white;  /* White text on Navy */
    font-weight: bold;
    font-size: 12px;
    background: transparent;
}

/* ===== 3. ACTION BUTTONS (Dark Navy - High Visibility) ===== */
QPushButton[class="ActionGridBtn"] {
    background-color: #001F3F;  /* Dark Navy Background */
    color: white;  /* White Text */
    border: 1px solid #001F3F;
    border-radius: 8px;
    padding: 10px;
    font-weight: bold;
}

/* Hover Effect */
QPushButton[class="ActionGridBtn"]:hover {
    background-color: #003366;  /* Lighter Navy Hover */
    border-color: #00BCEB;  /* Cyan Border Accent */
}

/* Pressed Effect */
QPushButton[class="ActionGridBtn"]:pressed {
    background-color: #00BCEB;  /* Cyan Active */
}

/* Custom Colors for Action Buttons (Bottom Border Accents) */
QPushButton[class="ActionGridBtn"][btnColor="#FFDC00"] {
    border-bottom: 3px solid #FFC107;
}
QPushButton[class="ActionGridBtn"][btnColor="#FF4136"] {
    border-bottom: 3px solid #DC3545;
}

/* Internal Labels in Grid Buttons */
QPushButton[class="ActionGridBtn"] QLabel {
    background: transparent;
    color: white;  /* White text on Navy */
}

QPushButton[class="ActionGridBtn"] QLabel#lblShortcut {
    color: #AAAAAA;  /* Light gray for shortcuts */
    font-size: 10px;
    font-weight: bold;
    background: transparent;
}

QPushButton[class="ActionGridBtn"] QLabel#lblText {
    color: white;  /* White text */
    font-size: 12px;
    font-weight: bold;
    background: transparent;
}

/* All labels stay white on hover and press for consistency */
QPushButton[class="ActionGridBtn"]:hover QLabel,
QPushButton[class="ActionGridBtn"]:hover QLabel#lblText,
QPushButton[class="ActionGridBtn"]:hover QLabel#lblShortcut,
QPushButton[class="ActionGridBtn"]:pressed QLabel,
QPushButton[class="ActionGridBtn"]:pressed QLabel#lblText,
QPushButton[class="ActionGridBtn"]:pressed QLabel#lblShortcut {
    color: white;
}

/* Pay Button */
QPushButton#BtnPay {
    background-color: #198754;
    color: #FFFFFF;
    font-size: 24px;
    font-weight: bold;
    border: none;
    border-radius: 5px;
}

QPushButton#BtnPay:hover {
    background-color: #157347;
}

QPushButton#BtnPay:pressed {
    background-color: #0F5132;
}

/* Dashboard Cards */
QWidget#InfoCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QLabel#InfoCardTitle {
    font-size: 12px;
    color: #6C757D;
}

/* Settings View */
QListWidget#SettingsSidebar {
    background-color: #F3F4F6;
    border: none;
    border-right: 1px solid #DEE2E6;
    outline: none;
}

QListWidget#SettingsSidebar::item {
    color: #495057;
    padding: 12px 20px;
    padding-left: 20px;
    border: none;
    border-left: 3px solid transparent;
    background-color: transparent;
}

QListWidget#SettingsSidebar::item:hover {
    background-color: #E9ECEF;
    color: #212529;
}

QListWidget#SettingsSidebar::item:selected {
    background-color: #E3F2FD;
    color: #0D6EFD;
    border-left: 3px solid #0D6EFD;
    font-weight: bold;
}

QWidget#SettingsContent {
    background-color: #FFFFFF;
    color: #212529;
}

/* Settings Content Area - Improved Input Styling */
QWidget#SettingsContent QLineEdit,
QWidget#SettingsContent QComboBox,
QWidget#SettingsContent QSpinBox,
QWidget#SettingsContent QDoubleSpinBox,
QWidget#SettingsContent QTextEdit {
    background-color: #FFFFFF;
    color: #212529;
    border: 1px solid #CED4DA;
    border-radius: 4px;
    padding-left: 10px;
    min-height: 32px;
    font-size: 14px;
}

QWidget#SettingsContent QLineEdit:focus,
QWidget#SettingsContent QComboBox:focus,
QWidget#SettingsContent QSpinBox:focus,
QWidget#SettingsContent QDoubleSpinBox:focus,
QWidget#SettingsContent QTextEdit:focus {
    border: 2px solid #0D6EFD;
    background-color: #F8F9FA;
}

/* Settings Form Labels */
QWidget#SettingsContent QLabel {
    color: #495057;
    font-size: 14px;
}

QLabel[class="SectionHeader"] {
    font-size: 18px;
    font-weight: bold;
    color: #0D6EFD;
    margin-bottom: 20px;
}

QFrame#SettingsFooter {
    background-color: #F8F9FA;
    border-top: 1px solid #DEE2E6;
}

/* --- Dialogs --- */

/* Payment Dialog */
QDialog#PaymentDialog {
    background-color: #FFFFFF;
    color: #212529;
}

QLabel#PaymentRemainingLabel {
    font-size: 24px;
    color: #DC3545;
    font-weight: bold;
    border: 1px solid #DC3545;
    padding: 10px;
}

QLabel#PaymentRemainingLabel[state="change"] {
    color: #198754;
    border: 1px solid #198754;
}

QWidget#PaymentEntryGroup {
    background-color: #F8F9FA;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
}

QLabel#PaymentMethodLabel {
    font-weight: bold;
    font-size: 16px;
    color: #0D6EFD;
}

QComboBox#PaymentCustomerCombo {
    font-size: 18px;
    padding: 5px;
    color: #212529;
    background-color: #FFFFFF;
}

QPushButton#BtnAddPayment {
    background-color: #0D6EFD;
    color: #FFFFFF;
    font-weight: bold;
    padding: 10px;
}

QListWidget#PaymentList {
    font-size: 16px;
    color: #212529;
    background-color: #FFFFFF;
}

QPushButton#BtnFinishSale {
    background-color: #E9ECEF;
    color: #495057;
    padding: 15px;
    font-weight: bold;
}

QPushButton#BtnFinishSale:enabled {
    background-color: #198754;
    color: #FFFFFF;
}

QLabel#PaymentMethodsHeader {
    font-size: 18px;
    font-weight: bold;
    color: #495057;
}

QWidget#PaymentMethodsScroll {
    background: transparent;
    border: none;
}

QPushButton[class="PaymentMethodBtn"] {
    background-color: #FFFFFF;
    color: #0D6EFD;
    font-weight: bold;
    font-size: 14px;
    border: 2px solid #0D6EFD;
    border-radius: 8px;
}

QPushButton[class="PaymentMethodBtn"]:hover {
    background-color: #E3F2FD;
}

QPushButton[class="PaymentMethodBtnCash"] {
    background-color: #198754;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 14px;
    border: 2px solid #198754;
    border-radius: 8px;
}

QLabel#PaymentShortcutLabel {
    background: rgba(0,0,0,0.5);
    color: white;
    padding: 2px;
}

/* Discount Dialog */
QDialog#DiscountDialog {
    background-color: #FFFFFF;
    color: #212529;
}

QRadioButton#RbPercent, QRadioButton#RbFixed {
    font-size: 16px;
    font-weight: bold;
}

QDoubleSpinBox#DiscountValueInput {
    font-size: 32px;
    font-weight: bold;
    padding: 10px;
    border: 2px solid #0D6EFD;
    border-radius: 5px;
    background-color: #FFFFFF;
    color: #212529;
}

QDoubleSpinBox#DiscountValueInput::up-button, QDoubleSpinBox#DiscountValueInput::down-button {
    width: 0px;
}

QPushButton[class="PresetBtn"] {
    background-color: #E9ECEF;
    color: #212529;
    font-weight: bold;
    font-size: 16px;
    border-radius: 5px;
    border: 1px solid #CED4DA;
}

QPushButton[class="PresetBtn"]:hover {
    background-color: #DEE2E6;
}

QPushButton#BtnApplyDiscount {
    background-color: #198754;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 16px;
    border-radius: 5px;
}

/* Customer Editor */
QDialog#CustomerEditor, QDialog#CustomerQuickAddDialog {
    background-color: #FFFFFF;
    color: #212529;
}

/* Receipt Options */
QDialog#ReceiptOptionsDialog {
    background-color: #FFFFFF;
    color: #212529;
}

QLabel#ReceiptTitle {
    font-size: 24px;
    font-weight: bold;
    color: #198754;
}

QLabel#ReceiptInfo {
    font-size: 16px;
    color: #6C757D;
}

QPushButton[class="ReceiptOptionBtn"] {
    color: #212529;
    font-weight: bold;
    font-size: 16px;
    padding: 10px;
    border-radius: 5px;
}

QPushButton[class="ReceiptOptionBtn"]:hover {
    opacity: 0.9;
}

QPushButton[class="ReceiptOptionBtn"][btnColor="cyan"] { background-color: #0D6EFD; color: #FFFFFF; }
QPushButton[class="ReceiptOptionBtn"][btnColor="orange"] { background-color: #FFC107; color: #212529; }
QPushButton[class="ReceiptOptionBtn"][btnColor="gray"] { background-color: #6C757D; color: #FFFFFF; }

/* ===================================================================
   LOGIN VIEW STYLES - Light Theme
   ================================================================ */

/* === LOGIN LEFT PANEL === */
QWidget#LoginLeftPanel {
    background-color: #001226;  /* Deep navy branding panel */
}

/* Ensure all labels in login left panel have transparent backgrounds */
QWidget#LoginLeftPanel QLabel {
    background-color: transparent;
}

QLabel#WelcomeText {
    font-size: 24px;
    color: #00BCEB;  /* Cyan accent */
    font-weight: bold;
    margin-top: 20px;
}

QLabel#FooterLabel {
    color: #CCCCCC;  /* Lighter gray for better visibility on navy */
    font-size: 12px;
}

QLabel#LogoText {
    color: white;
    font-size: 36px;
    font-weight: bold;
}

/* === PIN INPUT FIELD === */
QLineEdit#PinInput {
    background-color: white;
    border: 2px solid #00BCEB;  /* Cyan border */
    border-radius: 8px;
    padding: 15px;
    font-size: 32px;
    font-weight: bold;
    letter-spacing: 8px;  /* Space out PIN dots */
    color: #001F3F;
}

QLineEdit#PinInput:focus {
    border: 2px solid #0099CC;  /* Darker cyan on focus */
    background-color: #F0F9FF;  /* Subtle blue tint */
}

/* === NUMPAD BUTTONS === */
/* Base styling for all numpad buttons */
QPushButton#NumpadBtn {
    background-color: #F5F5F5;
    border: 2px solid #E0E0E0;
    border-radius: 8px;
    color: #001F3F;
    font-size: 24px;
    font-weight: bold;
}

QPushButton#NumpadBtn:hover {
    background-color: #E8E8E8;
    border-color: #00BCEB;
}

QPushButton#NumpadBtn:pressed {
    background-color: #D0D0D0;
}

/* Clear button (Red) */
QPushButton#NumpadBtn[btnType="clear"] {
    color: #DC3545;  /* Red for clear */
    border-color: #DC3545;
    background-color: #FFF5F5;
}

QPushButton#NumpadBtn[btnType="clear"]:hover {
    background-color: #FFE8E8;
    border-color: #BB2D3B;
}

/* Enter button (Green) */
QPushButton#NumpadBtn[btnType="enter"] {
    color: #198754;  /* Green for enter */
    border-color: #198754;
    background-color: #F0FFF4;
}

QPushButton#NumpadBtn[btnType="enter"]:hover {
    background-color: #E0FFE8;
    border-color: #146C43;
}

/* ===================================================================
   DASHBOARD / MANAGEMENT VIEW STYLES - Light Theme
   ================================================================ */

/* === INFO CARDS === */
QFrame#InfoCard {
    background-color: #FFFFFF;  /* Clean white - no gradient */
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

QLabel#CardIcon {
    background-color: transparent;
}

QLabel#CardTitle {
    background-color: transparent;
    color: #6B7280;  /* Muted gray for labels */
    font-size: 11px;
    font-weight: normal;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QLabel#CardValue {
    background-color: transparent;
    color: #111827;  /* Dark gray for values */
    font-size: 32px;
    font-weight: bold;
}

QLabel#CardTrend {
    background-color: transparent;
    font-size: 10px;
    font-weight: normal;
}

QLabel#CardTrend[trendType="positive"] {
    color: #10B981;  /* Clean green */
}

QLabel#CardTrend[trendType="negative"] {
    color: #EF4444;  /* Clean red */
}

/* === CHART PLACEHOLDER === */
QFrame#ChartPlaceholder {
    background-color: #FFFFFF;  /* Same as cards */
    border: 1px solid #E5E7EB;
    border-radius: 8px;
}

QLabel#ChartPlaceholderText {
    color: #9CA3AF;
    font-size: 14px;
    font-weight: normal;
    background-color: transparent;
}

/* === SECTION TITLES === */
QLabel#SectionTitle {
    color: #111827;
    font-size: 14px;
    font-weight: 600;
    margin-top: 10px;
    margin-bottom: 8px;
    background-color: transparent;
}

/* === ACTIVITY TABLE === */
QTableWidget#ActivityTable {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    gridline-color: transparent;
}

QTableWidget#ActivityTable::item {
    padding: 10px;
    border-bottom: 1px solid #F3F4F6;
    color: #374151;
}

QTableWidget#ActivityTable::item:selected {
    background-color: #EFF6FF;
    color: #1E40AF;
}

QTableWidget#ActivityTable::item:hover {
    background-color: #F9FAFB;
}

QTableWidget#ActivityTable QHeaderView::section {
    background-color: #F9FAFB;
    color: #4B5563;
    font-weight: 600;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border: none;
    padding: 10px;
}

/* ===================================================================
   UNIFIED COMPONENTS - Light Theme
   ================================================================ */

/* === GENERIC TABLE VIEWS === */
QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #F9FAFB;
    border: 1px solid #E5E7EB;
    border-radius: 8px;
    gridline-color: #E5E7EB;
    selection-background-color: #EFF6FF;
    selection-color: #1E40AF;
}

QTableView::item {
    padding: 8px;
    border: none;
}

QTableView::item:hover {
    background-color: #F3F4F6;
}

QTableView QHeaderView::section {
    background-color: #F9FAFB;
    color: #4B5563;
    font-weight: 600;
    font-size: 10px;
    text-transform: uppercase;
    border: none;
    padding: 10px;
}

/* === BUTTONS === */
/* Generic button styling - excludes special buttons with IDs */
QPushButton:not(#NumpadBtn):not(#ActionGridBtn):not(#MenuButton):not(#IconButton) {
    background-color: #F3F4F6;
    color: #374151;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    font-size: 13px;
    min-height: 32px;
}

QPushButton:not(#NumpadBtn):not(#ActionGridBtn):not(#MenuButton):not(#IconButton):hover {
    background-color: #E5E7EB;
    border-color: #0066CC;
}

QPushButton:not(#NumpadBtn):not(#ActionGridBtn):not(#MenuButton):not(#IconButton):pressed {
    background-color: #D1D5DB;
}

QPushButton:not(#NumpadBtn):not(#ActionGridBtn):not(#MenuButton):not(#IconButton):disabled {
    background-color: #F9FAFB;
    color: #9CA3AF;
    border-color: #E5E7EB;
}

/* === SEARCH/INPUT FIELDS === */
QLineEdit {
    background-color: #FFFFFF;
    color: #374151;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
    selection-background-color: #0066CC;
    selection-color: white;
}

QLineEdit:focus {
    border-color: #0066CC;
    background-color: #FFFFFF;
}

QLineEdit:disabled {
    background-color: #F9FAFB;
    color: #9CA3AF;
}

/* ========================================
   NETWORK SETTINGS PAGE - CARD BASED DESIGN
   ======================================== */

/* Hero Status Card (Top Banner) */
QFrame#StatusCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    padding: 20px;
}

QLabel#StatusIcon {
    font-size: 32px;
    min-width: 50px;
}

QLabel#StatusTitle {
    font-size: 18px;
    font-weight: bold;
    color: #111827;
}

QLabel#StatusSubtitle {
    color: #6B7280;
    font-size: 14px;
    margin-top: 4px;
}

QLabel#StatusModeLabel {
    color: #6B7280;
    font-size: 12px;
    margin-bottom: 4px;
}

QComboBox#StatusModeSelector {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    padding: 6px 12px;
    min-width: 150px;
}

/* Server Configuration Card */
QFrame#NetworkCard {
    background-color: #FFFFFF;
    border: 1px solid #DEE2E6;
    border-radius: 8px;
    padding: 15px;
    margin-top: 10px;
}

QLabel#CardTitle {
    font-size: 16px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 10px;
}

QLabel#IPHelper {
    color: #0066CC;
    font-size: 13px;
    background-color: rgba(0, 102, 204, 0.1);
    border-left: 3px solid #0066CC;
    padding: 8px 12px;
    border-radius: 4px;
}

QLabel#FormLabel {
    color: #374151;
    font-size: 13px;
    font-weight: 500;
    min-width: 110px;
    padding-right: 8px;
}

/* Network Input Fields */
QLineEdit#InputNetwork,
QSpinBox#InputNetwork,
QComboBox#InputNetwork {
    background-color: #FFFFFF;
    color: #374151;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 13px;
}

QLineEdit#InputNetwork:focus,
QSpinBox#InputNetwork:focus,
QComboBox#InputNetwork:focus {
    border-color: #0066CC;
    background-color: #F9FAFB;
}

/* Test Connection Button (Cyan Outline) */
QPushButton#BtnTestNetwork {
    background-color: transparent;
    border: 2px solid #00BCEB;
    color: #00BCEB;
    border-radius: 6px;
    padding: 10px 20px;
    font-weight: bold;
    font-size: 13px;
    min-height: 38px;
}

QPushButton#BtnTestNetwork:hover {
    background-color: rgba(0, 188, 235, 0.1);
}

QPushButton#BtnTestNetwork:pressed {
    background-color: rgba(0, 188, 235, 0.2);
}

QPushButton#BtnTestNetwork:disabled {
    background-color: transparent;
    border-color: #9CA3AF;
    color: #9CA3AF;
}

QLabel#TestStatus {
    font-size: 14px;
    font-weight: 600;
    padding-left: 10px;
}

/* Migration Card (Purple Accent) */
QFrame#MigrationCard {
    background-color: #FFFFFF;
    border: 2px solid #6C5CE7;
    border-radius: 8px;
    padding: 15px;
}

QLabel#MigrationInfo {
    background-color: transparent;
    color: #6B7280;
    font-size: 13px;
    line-height: 1.4;
}

/* Migration Button (Purple Solid - Brand Accent) */
QPushButton#BtnMigrate {
    background-color: #6C5CE7;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 14px 24px;
    font-weight: bold;
    font-size: 14px;
    min-height: 45px;
}

QPushButton#BtnMigrate:hover {
    background-color: #5B4CD9;
}

QPushButton#BtnMigrate:pressed {
    background-color: #4A3BB8;
}

QPushButton#BtnMigrate:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
}

/* Warning Footer */
QLabel#NetworkWarning {
    background-color: rgba(255, 193, 7, 0.1);
    color: #D97706;
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: 6px;
    padding: 12px;
    font-size: 12px;
}
